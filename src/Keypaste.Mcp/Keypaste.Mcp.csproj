<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Mcp</RootNamespace>
    <AssemblyName>keypaste-mcp</AssemblyName>
    <!-- See Keypaste.Cli.csproj for why both of these are committed rather than passed at publish. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
    <!-- This project emits none today; the baseline gate is what keeps that true. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Keypaste.Core/Keypaste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The first and only runtime dependency in src/ (DECISIONS.md D-0019). ModelContextProtocol.Core
      rather than the main ModelContextProtocol package: the stdio transport, the server, and the
      tool types all live here, so the extra packages the main one brings would buy a generic host
      this server does not want.

      IsAotCompatible stays on for this project. That was verified rather than assumed, against the
      real assembly and with a negative control — see D-0019.
    -->
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keypaste.Mcp.Tests" />
  </ItemGroup>

</Project>
