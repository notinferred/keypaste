<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Keypaste.Mcp</RootNamespace>
    <!-- A RID-specific publish of Keypaste.Cli reaches this project through ProjectReference, as it reaches Keypaste.Core. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Keypaste.Core/Keypaste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ModelContextProtocol.Core rather than the main ModelContextProtocol package: the stdio transport,
      the server and the tool types all live here, and the main package adds a generic host this
      server does not want. It shares the keypaste binary under D-0419; its AOT compatibility was
      verified against the real assembly with a negative control (D-0019).
    -->
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keypaste.Mcp.Tests" />
    <InternalsVisibleTo Include="Keypaste.PoolStarver" />
  </ItemGroup>

</Project>
