<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Keypaste.Core</RootNamespace>
    <AssemblyName>Keypaste.Core</AssemblyName>
    <Description>keypaste core library. All vault logic lives here; CLI, MCP and GUI are thin clients over it.</Description>
    <!--
      A library needs no RID of its own, but `dotnet publish -r <rid>` flows the RID through
      ProjectReference as a global property, so restore resolves this project against it too.
      Without the list here, a locked-mode restore fails on the referenced project rather than
      the published one - which reads as a mystery. Keep in step with Keypaste.Cli, Keypaste.Mcp
      and Keypaste.App.
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- No PackageReference. Deliberate: see Directory.Packages.props. -->

  <ItemGroup>
    <!--
      Vendored KDBX4 implementation. Not a NuGet package: no maintained, adopted KDBX4
      package for .NET exists (DECISIONS.md D-0007). Provenance, licence, and the complete
      list of local modifications: third_party/KeePassLib/UPSTREAM.md.

      Only Internal/KeePassInterop.cs may reference it. Everything else in this assembly
      speaks in keypaste's own types.
    -->
    <ProjectReference Include="../../third_party/KeePassLib/KeePassLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The word list a passphrase is drawn from, vendored verbatim. Provenance and licence:
      third_party/eff-large-wordlist/UPSTREAM.md. Its SHA-256 is pinned in WordList.Digest and
      checked against these bytes at first use, so the file ships with the assembly rather than
      being read from disk - a published binary has no repository to compare against (D-0235).

      LogicalName is required, not decorative: the file lives outside this project directory, so
      the name MSBuild would derive holds the `..` of the relative path.
    -->
    <EmbeddedResource Include="../../third_party/eff-large-wordlist/eff_large_wordlist.txt"
                      LogicalName="Keypaste.Core.eff_large_wordlist.txt" />
    <!--
      The common passwords a password is rated against, gzipped from upstream's bytes. Provenance and
      licence: third_party/seclists-common-passwords/UPSTREAM.md. The SHA-256 of what it decompresses
      to is pinned in Recommendations.CommonPasswords.Digest and checked at first use (D-0499).
    -->
    <EmbeddedResource Include="../../third_party/seclists-common-passwords/10k-most-common.txt.gz"
                      LogicalName="Keypaste.Core.10k-most-common.txt.gz" />
    <!--
      Mozilla's Public Suffix List, its internationalised rules written as A-labels, from which browser fill takes a host's
      registrable domain (D-0615). Provenance and licence: third_party/publicsuffix/UPSTREAM.md.
    -->
    <EmbeddedResource Include="../../third_party/publicsuffix/public_suffix_list.dat"
                      LogicalName="Keypaste.Core.public_suffix_list.dat" />
  </ItemGroup>

  <!--
    The reference libargon2 that Internal/NativeArgon2.cs hands KeePassLib on Windows and macOS (D-0522), which
    scripts/build-argon2.sh builds from its pinned source into artifacts/native/<rid>/. It flows into the output and
    publish directory of every project that references Core: the app, the CLI and the tests. A build without it derives
    the same keys with KeePassLib's managed Argon2.
  -->
  <PropertyGroup>
    <KeypasteArgon2Rid>$(RuntimeIdentifier)</KeypasteArgon2Rid>
    <KeypasteArgon2Rid Condition="'$(KeypasteArgon2Rid)' == ''">$(NETCoreSdkRuntimeIdentifier)</KeypasteArgon2Rid>
    <KeypasteArgon2Dir>$(ArtifactsPath)/native/$(KeypasteArgon2Rid)/</KeypasteArgon2Dir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(KeypasteArgon2Dir)argon2.dll" Condition="Exists('$(KeypasteArgon2Dir)argon2.dll')"
          Link="argon2.dll" Visible="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(KeypasteArgon2Dir)libargon2.1.dylib" Condition="Exists('$(KeypasteArgon2Dir)libargon2.1.dylib')"
          Link="libargon2.1.dylib" Visible="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Buffers.Binary" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Text" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Keypaste.Core.Tests" />
    <!-- V-F.6 saves from its own process, so the retry budget it pins has to be reachable
         from there too. A tests/ helper; nothing shipped references it. -->
    <InternalsVisibleTo Include="Keypaste.VaultSaver" />
    <!-- V-V.2b asks whether a restore kept the entry's UUID, and no CLI verb prints one, so the
         claim is unassertable from either front end without EntryUuid. That one seam; a tests/
         project, in neither solution, that nothing shipped references. -->
    <InternalsVisibleTo Include="Keypaste.Consistency.Tests" />
    <!-- 1.4b3's merge gate has KeePassXC merge the copy the app holds open, and no front end writes an
         open copy anywhere but its own file, so Vault.WriteCopyTo is that one seam (D-0641); a tests/ helper. -->
    <InternalsVisibleTo Include="Keypaste.AppDriver" />
    <!-- V-V.3b asks what the Trash screen says about a vault whose owner turned the recycle bin
         off in KeePassXC, and SetRecyclesDeletedEntries is the only way to build one without a
         KeePassXC installation. That one seam; a tests/ project. D-0255 owns why it is a seam
         rather than public API. -->
    <InternalsVisibleTo Include="Keypaste.App.Tests" />
    <!-- V-V.1a2 asks what the CLI says when its XML keyfile loader falls back to hashing the file,
         which only a NativeAOT build does and no test runs as. VaultKeyfile.SimulateXmlFallback is
         that one seam (D-0294). -->
    <InternalsVisibleTo Include="Keypaste.Cli.Tests" />
    <!-- Their vaults take TestKeyDerivation's token cost like every other test project's (D-0469). -->
    <InternalsVisibleTo Include="Keypaste.Mcp.Tests" />
    <InternalsVisibleTo Include="Keypaste.App.Windows.Tests" />
  </ItemGroup>

</Project>
