<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Keypaste.App.App"
             RequestedThemeVariant="Default">

  <!-- Default follows the operating system, through IPlatformSettings.GetColorValues(). Settings
       offers System / Light / Dark and writes the choice to ~/.keypaste/app.toml. -->

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://keypaste-app/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://keypaste-app/Theme/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
