<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.ExportImportView"
             x:DataType="vm:ExportImportViewModel">

  <!-- The export import dialog, drawn over the shell on the modal backdrop as the KeePass database's is: the file,
       where each item lands and what does not, the choice for names the vault already has, and after the import what
       it did and that the file is to be deleted. -->

  <UserControl.Styles>
    <Style Selector="Button.dialog-action">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.dialog-action.primary">
      <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style Selector="Border.map-row">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ContentPresenter:nth-last-child(1) > Border.map-row">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- Scrolls so a dialog taller than the window keeps its buttons in reach. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Classes="dialog"
            KeyboardNavigation.TabNavigation="Cycle"
            Width="520"
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel Spacing="16">

        <Grid ColumnDefinitions="Auto,*,Auto">
          <ctl:KpIcon Grid.Column="0" Icon="file-input" Size="18" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
          <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.ImportAnotherAppsExport}" VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Classes="icon ghost sm"
                  ToolTip.Tip="{x:Static res:Strings.Close}"
                  Command="{Binding CancelCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.Close}">
            <ctl:KpIcon Icon="x" Size="15" />
          </Button>
        </Grid>

        <!-- The file card, on a dashed hairline. -->
        <Panel>
          <Rectangle RadiusX="10" RadiusY="10"
                     Stroke="{DynamicResource KpBorderStrong}"
                     StrokeThickness="1"
                     StrokeDashArray="4,3" />
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="14">
            <ctl:KpIcon Grid.Column="0" Icon="file-code" Size="22" Margin="0,0,12,0" Foreground="{DynamicResource KpTextMuted}" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="mono lg" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" />
              <TextBlock
                         Classes="muted size-12"
                         Text="{Binding CardDetail}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !IsUnreadable}" />
              <TextBlock
                         Classes="danger size-12"
                         ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding IsUnreadable}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsPreviewing}">
              <ctl:KpIcon Icon="lock-open" Size="13" Foreground="{DynamicResource KpTextMuted}" />
              <TextBlock Classes="muted size-12" Text="{x:Static res:Strings.NotEncrypted}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsImported}">
              <ctl:KpIcon Icon="circle-check" Size="13" Foreground="{DynamicResource KpOk}" />
              <TextBlock Classes="ok size-12" Text="{x:Static res:Strings.Imported}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsUnreadable}">
              <ctl:KpIcon Icon="alert-triangle" Size="13" Foreground="{DynamicResource KpDanger}" />
              <TextBlock Classes="danger size-12" Text="{x:Static res:Strings.CantRead}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Panel>

        <!-- The preview: the group it lands under, the choice for names the vault already has, and every item's row. -->
        <StackPanel Spacing="16" IsVisible="{Binding IsPreviewing}">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{x:Static res:Strings.CopyIntoThisGroup}" />
            <TextBox x:Name="ExportInto"
                     Classes="mono size-12"
                     Text="{Binding Into}"
                     AutomationProperties.Name="{x:Static res:Strings.GroupToCopyInto}" />
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding HasHeld}">
            <TextBlock Classes="label" Text="{Binding HeldLabel}" />
            <Border Classes="segmented inset">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="ExportHeldNames" Content="{x:Static res:Strings.KeepBoth}" IsChecked="{Binding KeepHeld}" />
                <RadioButton Classes="segment" GroupName="ExportHeldNames" Content="{x:Static res:Strings.SkipThem}" IsChecked="{Binding SkipHeld}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="{x:Static res:Strings.KeepBothLandsEachBesideYoursUnderX77358f}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{x:Static res:Strings.WhereEachItemLands}" />
            <Border BorderBrush="{DynamicResource KpBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource KpRadiusButton}"
                    ClipToBounds="True">
              <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExportRows" ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExportPreviewRow">
                      <Border Classes="map-row">
                        <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                          <TextBlock Grid.Column="0"
                                     Classes="mono secondary size-12"
                                     Text="{Binding Item}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Item}"
                                     VerticalAlignment="Center" />
                          <ctl:KpIcon Grid.Column="1"
                                      Icon="arrow-right"
                                      Size="12"
                                      HorizontalAlignment="Center"
                                      Foreground="{DynamicResource KpTextMuted}" />
                          <TextBlock Grid.Column="2"
                                     Classes="mono size-12"
                                     Classes.muted="{Binding Skipped}"
                                     Text="{Binding Lands}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Lands}"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     Margin="0,4,0,0"
                                     TextWrapping="Wrap"
                                     Classes="muted size-12"
                                     Text="{Binding Note}"
                                     IsVisible="{Binding HasNote}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- After the import: what it did. -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsImported}">
          <ctl:KpIcon Icon="circle-check" Size="15" Foreground="{DynamicResource KpOk}" />
          <TextBlock Classes="size-13-5"
                     FontWeight="Medium"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextPrimary}"
                     Text="{Binding ImportedText}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Everything that does not land, before and after the import, each with why. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasNotImported}">
          <TextBlock Classes="label" Text="{Binding NotImportedLabel}" />
          <Border BorderBrush="{DynamicResource KpBorderDefault}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource KpRadiusButton}"
                  ClipToBounds="True">
            <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="ExportNotImported" ItemsSource="{Binding NotImported}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExportLossRow">
                    <Border Classes="map-row">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="mono secondary size-12"
                                   Text="{Binding Item}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasItem}" />
                        <TextBlock Classes="muted size-12" TextWrapping="Wrap" Text="{Binding What}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

        <!-- The export is plaintext on disk, and keypaste leaves it there (D-0592). -->
        <Border Classes="card" Padding="14" IsVisible="{Binding IsImported}">
          <Grid ColumnDefinitions="Auto,*">
            <ctl:KpIcon Grid.Column="0" Icon="trash-2" Size="15" Margin="0,1,10,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource KpTextMuted}" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Classes="size-13"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource KpTextPrimary}"
                         Text="{Binding FileName, StringFormat={x:Static res:Strings.DeleteValueNow}}" />
              <TextBlock
                         Classes="secondary size-12-5"
                         TextWrapping="Wrap"
                         Text="{x:Static res:Strings.ItHoldsYourPasswordsUnencryptedAndKeypasteXdcf75b}" />
              <TextBlock Classes="mono muted size-12" TextWrapping="Wrap" Text="{Binding FilePath}" />
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Classes="danger size-12-5"
                   TextWrapping="Wrap"
                   ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                   IsVisible="{Binding HasTrailingMessage}" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="ExportCancel"
                  Classes="ghost dialog-action"
                  Content="{x:Static res:Strings.Cancel}"
                  IsVisible="{Binding !IsImported}"
                  Command="{Binding CancelCommand}" />
          <Button x:Name="ExportChooseAnother"
                  Classes="dialog-action"
                  IsVisible="{Binding CanChooseAnother}"
                  Content="{x:Static res:Strings.ChooseAnotherFile}"
                  Command="{Binding ChooseAnotherCommand}" />
          <Button x:Name="ExportConfirm"
                  Classes="primary dialog-action"
                  IsVisible="{Binding IsPreviewing}"
                  Content="{Binding ConfirmText}"
                  Command="{Binding ConfirmCommand}" />
          <Button x:Name="ExportDone"
                  Classes="primary dialog-action"
                  IsVisible="{Binding IsImported}"
                  Content="{x:Static res:Strings.Done}"
                  Command="{Binding CancelCommand}" />
        </StackPanel>

      </StackPanel>
    </Border>
  </ScrollViewer>

</UserControl>
