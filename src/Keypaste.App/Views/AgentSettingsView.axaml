<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.AgentSettingsView"
             x:DataType="vm:AgentSettingsViewModel">

  <!-- One agent's rules, as the Change… its summary row opened: what it gets of each kind of value, whether it may ask to
       run commands, and the answers remembered for it. No primary action, so the screen keeps its one amber element. -->

  <UserControl.Styles>
    <Style Selector="ContentPresenter:nth-child(n+2) > Border.remembered">
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One of several; the raised segment says which holds. -->
    <DataTemplate x:Key="Segment" x:DataType="vm:SettingChoice">
      <ctl:ChoiceSegment Name="RunChoice" Classes="segment"
                         IsChecked="{Binding IsChosen, Mode=OneWay}"
                         Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).ChooseCommand}"
                         CommandParameter="{Binding}"
                         AutomationProperties.Name="{Binding Words}">
        <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
      </ctl:ChoiceSegment>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Segments">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="12">

    <TextBlock Name="SettingsProblem" Classes="body danger" ctl:Announcer.Says="{Binding Problem}" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />

    <StackPanel Classes="section" IsVisible="{Binding ChangesAsks}" ctl:ShowInView.OnShow="True">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel ItemSpacing="6" VerticalAlignment="Center">
          <TextBlock Classes="section-heading" Text="{Binding Shown, StringFormat={x:Static res:Strings.WhenValueAsks}}" />
          <TextBlock Classes="caption" Text="{x:Static res:Strings.DefaultFollowsSettingsAgents}" />
          <Button Name="ShowDefaults" Classes="link" Content="{x:Static res:Strings.ChangeDefaults}"
                  Command="{Binding $parent[views:AgentActivityView].((vm:AgentActivityViewModel)DataContext).ShowDefaultsCommand, FallbackValue={x:Null}}" />
        </WrapPanel>
        <Button Grid.Column="1" Name="AsksDone" Classes="sm" Content="{x:Static res:Strings.Done}" Command="{Binding DoneCommand}" />
      </Grid>
      <Border Classes="group">
        <ItemsControl Name="CategoryRules" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <ctl:GroupedRows />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentCategoryRow">
              <ctl:FieldRow Label="{Binding Name}">
                <Border Classes="segmented" HorizontalAlignment="Left">
                  <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource Segments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AgentCategoryChoice">
                        <ctl:ChoiceSegment Name="CategoryChoice" Classes="segment"
                                           IsChecked="{Binding IsChosen, Mode=OneWay}"
                                           Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).ChooseCategoryCommand}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="{Binding Words}">
                          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
                        </ctl:ChoiceSegment>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </ctl:FieldRow>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Border Name="AgentAllowConfirmation" Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True"
              ctl:FormKeys.Cancel="{Binding CancelAllowCommand}">
        <StackPanel Spacing="8">
          <TextBlock Name="AgentAllowConfirmationText" Text="{Binding ConfirmText}" TextWrapping="Wrap" Classes="primary size-13" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.EachReleaseIsRecordedInTheLogAndYouCanSetAskAgainHere}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="AgentCancelAllow" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelAllowCommand}" />
            <Button Name="AgentConfirmAllow" Classes="sm" Content="{Binding ConfirmAction}" Command="{Binding ConfirmAllowCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Classes="section" IsVisible="{Binding ChangesRun}" ctl:ShowInView.OnShow="True">
      <Border Classes="group">
        <ctl:GroupedRows>
          <ctl:FieldRow Label="{x:Static res:Strings.MayRunCommands}">
            <Border Classes="segmented" HorizontalAlignment="Left">
              <ItemsControl Name="RunChoices" ItemsSource="{Binding RunChoices}" ItemsPanel="{StaticResource Segments}" ItemTemplate="{StaticResource Segment}" />
            </Border>
            <ctl:FieldRow.Actions>
              <Button Name="RunDone" Classes="sm" Content="{x:Static res:Strings.Done}" Command="{Binding DoneCommand}" />
            </ctl:FieldRow.Actions>
          </ctl:FieldRow>
        </ctl:GroupedRows>
      </Border>
    </StackPanel>

    <StackPanel Classes="section" IsVisible="{Binding ChangesAnswers}" ctl:ShowInView.OnShow="True">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="section-heading" Text="{x:Static res:Strings.AlwaysAnswers}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Name="AnswersDone" Classes="sm" Content="{x:Static res:Strings.Done}" Command="{Binding DoneCommand}" />
      </Grid>
      <Border Classes="group">
        <ItemsControl Name="RememberedAnswers" ItemsSource="{Binding Remembered}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RememberedRow">
              <Border Classes="remembered" Padding="16,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Name="RemoveAnswer" Classes="ghost sm" Content="{x:Static res:Strings.Remove}"
                          Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>

    <TextBlock Name="SettingsMessage" Classes="body" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />

  </StackPanel>
</UserControl>
