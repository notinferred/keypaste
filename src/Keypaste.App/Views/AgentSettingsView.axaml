<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.AgentSettingsView"
             x:DataType="vm:AgentSettingsViewModel">

  <!-- One agent's settings: whether it may ask to run commands, each run still asked, its own rule for each kind of
       value and the answers remembered for it. The panel holds no primary action, so the screen keeps its one amber element. -->

  <UserControl.Styles>
    <Style Selector="Button.choice">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.choice.chosen /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
    <!-- Tighter than the log's filter, so three modes stay on one line beside the sidebar in the narrowest column the panel gets. -->
    <Style Selector="ToggleButton.segment">
      <Setter Property="Padding" Value="6,2" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One of several, as the log's filter draws it. Its check says which holds without relying on colour. -->
    <DataTemplate x:Key="Segment" x:DataType="vm:SettingChoice">
      <ctl:ChoiceSegment Classes="segment"
                         IsChecked="{Binding IsChosen, Mode=OneWay}"
                         Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).ChooseCommand}"
                         CommandParameter="{Binding}"
                         AutomationProperties.Name="{Binding Words}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ctl:KpIcon Icon="check" Size="14" IsVisible="{Binding IsChosen}" Foreground="{DynamicResource KpTextPrimary}" />
          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
        </StackPanel>
      </ctl:ChoiceSegment>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="Segments">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="16">

    <TextBlock Name="IdentityText" Classes="caption" Text="{Binding Identity}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />

    <TextBlock Name="SettingsProblem" Classes="body danger" ctl:Announcer.Says="{Binding Problem}" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="120,*" ColumnSpacing="16">
      <TextBlock Classes="label" Text="{x:Static res:Strings.MayRunCommands}" Margin="0,6,0,0" />
      <Border Grid.Column="1" Classes="segmented">
        <ItemsControl Name="RunChoices" ItemsSource="{Binding RunChoices}" ItemsPanel="{StaticResource Segments}" ItemTemplate="{StaticResource Segment}" />
      </Border>
    </Grid>

    <StackPanel Spacing="8">
      <TextBlock Classes="label" Text="What it gets" />
      <ItemsControl Name="CategoryRules" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AgentCategoryRow">
            <StackPanel Spacing="4" Margin="0,0,0,8">
              <TextBlock Classes="caption" Text="{Binding Name}" />
              <Border Classes="segmented" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Choices}" ItemsPanel="{StaticResource Segments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgentCategoryChoice">
                      <ctl:ChoiceSegment Classes="segment"
                                         IsChecked="{Binding IsChosen, Mode=OneWay}"
                                         Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).ChooseCategoryCommand}"
                                         CommandParameter="{Binding}"
                                         AutomationProperties.Name="{Binding Words}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="check" Size="14" IsVisible="{Binding IsChosen}" Foreground="{DynamicResource KpTextPrimary}" />
                          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
                        </StackPanel>
                      </ctl:ChoiceSegment>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Name="AgentAllowConfirmation" Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True"
              ctl:FormKeys.Cancel="{Binding CancelAllowCommand}">
        <StackPanel Spacing="8">
          <TextBlock Name="AgentAllowConfirmationText" Text="{Binding ConfirmText}" TextWrapping="Wrap" Classes="primary size-13" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.EachReleaseIsRecordedInTheLogAndYouCanSetAskAgainHere}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="AgentCancelAllow" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelAllowCommand}" />
            <Button Name="AgentConfirmAllow" Classes="sm" Content="{Binding ConfirmAction}" Command="{Binding ConfirmAllowCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Classes="label" Text="Always answers" />
      <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasRemembered}"
                 Text="None yet. Always allow and Always block on a prompt keep an answer for one item here." />
      <ItemsControl Name="RememberedAnswers" ItemsSource="{Binding Remembered}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RememberedRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,6">
              <TextBlock Classes="body" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost sm" Content="Remove"
                      Command="{Binding $parent[UserControl].((vm:AgentSettingsViewModel)DataContext).RemoveCommand}"
                      CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Name="SettingsMessage" Classes="body" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />

  </StackPanel>
</UserControl>
