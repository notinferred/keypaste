<UserControl xmlns:res="using:Keypaste.App.Resources"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.FirstLaunchView"
             x:DataType="vm:FirstLaunchViewModel"
             Background="{DynamicResource KpBgApp}">

  <!-- The terms of use, once: one line, the terms and the source, crash reports' own yes, then Quit or Agree. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Width="360"
                Margin="24,40,24,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
      <ctl:BrandMark Width="56" HorizontalAlignment="Center" />

      <StackPanel Spacing="6">
        <TextBlock Classes="dialog-title" AutomationProperties.HeadingLevel="1" Text="{x:Static res:Strings.TermsOfUse}" />
        <TextBlock Name="AgreementText"
                   Classes="secondary size-13"
                   TextWrapping="Wrap"
                   ctl:Announcer.Says="{Binding Opening}"
                   Text="{Binding Agreement}" />
        <views:TermsLink DataContext="{Binding Terms}" HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <CheckBox Name="SendCrashReports"
                  Content="{x:Static res:Strings.SendCrashReports}"
                  IsChecked="{Binding SendCrashReports}"
                  AutomationProperties.HelpText="{x:Static res:Strings.AReportHoldsTheVersionSystemScreenX3de709}" />
        <Border Name="CrashReportsInfo"
                Background="Transparent"
                VerticalAlignment="Center"
                ToolTip.Tip="{x:Static res:Strings.AReportHoldsTheVersionSystemScreenX3de709}">
          <ctl:KpIcon Icon="info" Size="14" Foreground="{DynamicResource KpTextMuted}" />
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="Quit" Classes="ghost" Content="{x:Static res:Strings.Quit}" Command="{Binding QuitCommand}" />
        <Button Name="Agree" Classes="primary" IsDefault="True" Content="{x:Static res:Strings.Agree}" Command="{Binding AgreeCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

</UserControl>
