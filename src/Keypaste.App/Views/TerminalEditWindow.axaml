<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.TerminalEditWindow"
                    x:DataType="vm:TerminalEditViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: a terminal asks to change this vault"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card for a terminal's edit to the held vault, asked every time: no Always allow. The question names the item on
       one line, cut where it is long, and the changes sit in a box of fixed height that scrolls, so no edit moves the buttons
       (THREATS.md T-2). Return presses Allow once it is armed, never
       Delete for good; Escape denies. -->

  <Border Classes="claim" Classes.arming="{Binding IsArming}">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <StackPanel Spacing="4">
          <TextBlock Name="TitleText" Classes="claim-title size-15" Text="{Binding Question}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
            <ctl:KpIcon Classes="claim-muted" Icon="terminal" Size="14" VerticalAlignment="Center" />
            <TextBlock Name="CommandText" Classes="mono" Text="{Binding Command}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <Border Classes="claim-block" Height="64">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ChangesList" ItemsSource="{Binding Changes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="change size-13" Text="{Binding}" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource KpTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <ctl:KpIcon Classes="claim-warn" Icon="alert-triangle" Size="14" />
          <TextBlock Grid.Column="1" Name="WarningText" Classes="claim-line size-13" Text="{Binding Warning}" />
        </Grid>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                IsVisible="{Binding IsChoosing}" Command="{Binding DenyCommand}" />
        <Button Name="Allow" Classes="claim keyed" Classes.primary="{Binding !DeletesForGood}" Classes.danger="{Binding DeletesForGood}"
                Content="{Binding AllowLabel}" Tag="{Binding AllowKey}"
                IsVisible="{Binding IsChoosing}" Command="{Binding AllowOnceCommand}" />
      </StackPanel>
      <ProgressBar Name="TimeBar" Classes="claim-time" Value="{Binding TimeLeft}" AutomationProperties.Name="{Binding DeniesIn}" />
    </StackPanel>
  </Border>

</views:PromptWindow>
