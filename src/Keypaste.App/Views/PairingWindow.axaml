<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.PairingWindow"
                    x:DataType="vm:PairingViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: a browser asks to pair"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card whose requester line says Not verified: the build is what the browser named, never proof of it (THREATS.md
       T-48), so it waits under Details, the code is the person's check, drawn large, and no key is drawn. Fixed heights, as in the other cards. No button is
       the default: Enter pairs nothing, and Escape denies. -->

  <Border Classes="claim" Classes.arming="{Binding IsArming}">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <TextBlock Name="TitleText" Classes="claim-title size-15" Text="{Binding Title}" />

        <Border Classes="claim-block" Padding="20,12">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <TextBlock Name="CodeText" Classes="size-20" Text="{Binding Code}" FontFamily="{DynamicResource KpMono}" FontWeight="SemiBold" LineHeight="32"
                       LetterSpacing="4" Foreground="{DynamicResource KpTextPrimary}" HorizontalAlignment="Center"
                       AutomationProperties.Name="{Binding Code, StringFormat='Code {0}'}" />
            <TextBlock Name="CheckText" Classes="claim-line size-13" Text="{Binding Check}" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="6">
          <TextBlock Classes="label" Text="Name" />
          <TextBox Name="NameBox" Text="{Binding Name}" MaxLength="64" AutomationProperties.Name="Name of this pairing" />
          <TextBlock Name="NameProblemText" Height="18" Classes="size-13" Foreground="{DynamicResource KpDanger}"
                     ctl:Announcer.Says="{Binding NameProblem}" Text="{Binding NameProblem}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Spacing="8">
          <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
              <TextBlock Classes="size-13" Text="Details" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Grid Classes="claim-facts size-13" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="20,0,0,0"
                IsVisible="{Binding #DetailsToggle.IsChecked}">
            <TextBlock Classes="fact" Text="Extension" />
            <TextBlock Grid.Column="1" Name="IdentityText" Text="{Binding Identity}" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                IsCancel="True" Command="{Binding DenyCommand}" />
        <Button Name="Allow" Classes="claim primary" Content="Pair"
                Command="{Binding AllowOnceCommand}" />
      </StackPanel>
      <ProgressBar Name="TimeBar" Classes="claim-time" Value="{Binding TimeLeft}" AutomationProperties.Name="{Binding DeniesIn}" />
    </StackPanel>
  </Border>

</views:PromptWindow>
