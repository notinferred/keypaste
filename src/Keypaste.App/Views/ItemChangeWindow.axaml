<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.ItemChangeWindow"
                    x:DataType="vm:ItemChangeViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent asks to change an item"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card for a change to an item, asked every time: no Always allow. The agent's words sit in a box of fixed height
       that scrolls (THREATS.md T-2). Return presses Allow once it is armed, never Delete for good; Escape denies. -->

  <Border Classes="claim">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <StackPanel Spacing="4">
          <TextBlock Name="TitleText" Classes="claim-title size-16" Text="{Binding Question}" />
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
            <ctl:KpIcon Classes="claim-muted" Icon="key" Size="14" VerticalAlignment="Center" />
            <TextBlock Name="ItemText" Classes="claim-muted size-12-5" Text="{Binding Item}" MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="claim-label size-11" Text="{Binding SaysLabel}" />
            <Border Classes="claim-quote">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DockPanel Classes="claim-quote-text">
                  <Border Classes="claim-quote-bar" />
                  <StackPanel Spacing="4">
                    <TextBlock Name="ScrubbedText" Classes="claim-muted size-12-5" Text="{Binding Scrubbed}"
                               IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="claim-muted size-12-5" Text="{Binding Truncation}"
                               IsVisible="{Binding Truncation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="ReasonText" Classes="size-13" Text="{Binding Quoted}" />
                  </StackPanel>
                </DockPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>

        <TextBlock Name="ExplainerText" Classes="claim-line size-12-5" Text="{Binding Explainer}" />

          <StackPanel Spacing="8">
            <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                <TextBlock Classes="size-12-5" Text="Details" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Grid Classes="claim-facts size-12-5" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="4" Margin="20,0,0,0" IsVisible="{Binding #DetailsToggle.IsChecked}">
              <TextBlock Grid.Row="0" Classes="fact" Text="Tool" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding Tool}" />
              <TextBlock Grid.Row="1" Classes="fact" Text="Change" />
              <TextBlock Grid.Row="1" Grid.Column="1" Name="ChangeText" Text="{Binding Change}" />
              <TextBlock Grid.Row="2" Classes="fact" Text="Label" />
              <TextBlock Grid.Row="2" Grid.Column="1" Name="LabelText" Text="{Binding Label}" />
              <TextBlock Grid.Row="3" Classes="fact" Text="Item" />
              <TextBlock Grid.Row="3" Grid.Column="1" Name="EntryText" Classes="mono" Text="{Binding Entry}" />
              <TextBlock Grid.Row="4" Classes="fact" Text="Calls itself" />
              <TextBlock Grid.Row="4" Grid.Column="1" Name="ClientText" Text="{Binding Client}" />
              <TextBlock Grid.Row="5" Classes="fact" Text="Process" />
              <TextBlock Grid.Row="5" Grid.Column="1" Name="ProcessText" Classes="mono" Text="{Binding Process}" />
            </Grid>
          </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <ctl:HeaderRow Classes="claim-foot" Spacing="8">
        <ctl:SteadyDigits Name="CountdownText" Classes="claim-muted size-12-5" Text="{Binding DeniesIn}" VerticalAlignment="Center"
                          TextWrapping="NoWrap" IsVisible="{Binding IsChoosing}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                  IsVisible="{Binding IsChoosing}" Command="{Binding DenyCommand}" />
          <Button Name="Allow" Classes="claim keyed" Classes.primary="{Binding !DeletesForGood}" Classes.danger="{Binding DeletesForGood}"
                  Content="{Binding AllowLabel}" Tag="{Binding AllowKey}"
                  IsVisible="{Binding IsChoosing}" Command="{Binding AllowOnceCommand}" />
        </StackPanel>
      </ctl:HeaderRow>
    </StackPanel>
  </Border>

</views:PromptWindow>
