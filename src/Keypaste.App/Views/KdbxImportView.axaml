<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.KdbxImportView"
             x:DataType="vm:KdbxImportViewModel">

  <!-- The KDBX import dialog, drawn over the shell on the modal backdrop: the file, what unlocks it,
       where each of its groups lands, and whether to keep editing the file itself instead. -->

  <UserControl.Resources>

    <!-- The design's 32x18 switch: amber track and an ink knob when on. -->
    <ControlTheme x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,*" Background="Transparent">
            <Border Name="Track"
                    Width="32" Height="18"
                    CornerRadius="10"
                    VerticalAlignment="Top"
                    Margin="0,2,8,0"
                    Background="{DynamicResource KpBgActive}"
                    BorderBrush="{DynamicResource KpBorderControl}"
                    BorderThickness="1">
              <Border Name="Knob"
                      Width="14" Height="14"
                      CornerRadius="7"
                      HorizontalAlignment="Left"
                      Margin="2,0,0,0"
                      Background="{DynamicResource KpTextMuted}" />
            </Border>
            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource KpTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpTextPrimary}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Knob">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#Track">
        <Setter Property="BoxShadow" Value="{DynamicResource KpFieldGlow}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>

    <!-- A 16px include box: hairline when off, a quiet filled box with a check when on. -->
    <ControlTheme x:Key="IncludeBox" TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Box"
                  Width="16" Height="16"
                  CornerRadius="{DynamicResource KpRadiusChip}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource KpBorderControl}"
                  Background="Transparent">
            <ctl:KpIcon Name="Check" Icon="check" Size="14" IsVisible="False"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource KpTextPrimary}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
      </Style>
      <Style Selector="^:checked /template/ ctl|KpIcon#Check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCheckBackgroundStrokeUncheckedPointerOver}" />
      </Style>
      <Style Selector="^:focus-visible /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource KpFocusRing}" />
      </Style>
    </ControlTheme>

    <!-- The field a destination is typed into: text until hovered or focused, and a red-bordered
         field while it blocks the import, so the fix is visible where the problem is. -->
    <ControlTheme x:Key="DestinationField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="-8,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpBorderControl}" />
      </Style>
      <Style Selector="^.blocked /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpDanger}" />
      </Style>
      <Style Selector="^:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KpFocusRing}" />
      </Style>
    </ControlTheme>

  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.dialog-action">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.dialog-action.primary">
      <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style Selector="Border.map-row">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ContentPresenter:nth-last-child(1) > Border.map-row">
      <Setter Property="BorderThickness" Value="0" />
    </Style>

  </UserControl.Styles>

  <Border Classes="dialog"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="520"
          MaxWidth="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
        <ctl:KpIcon Grid.Column="0" Icon="file-input" Size="20" Margin="0,0,8,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.ImportAKeePassDatabase}" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Classes="icon ghost sm"
                ToolTip.Tip="{x:Static res:Strings.Cancel}"
                Command="{Binding CancelCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Cancel}">
          <ctl:KpIcon Icon="x" Size="16" />
        </Button>
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Classes="ghost dialog-action" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
        <Button x:Name="ChooseAnother"
                Classes="dialog-action"
                IsVisible="{Binding CanChooseAnother}"
                Content="{x:Static res:Strings.ChooseAnotherFile}"
                Command="{Binding ChooseAnotherCommand}" />
        <Button Classes="dialog-action"
                Classes.primary="{Binding UnlockIsPrimary}"
                IsVisible="{Binding NeedsUnlock}"
                Command="{Binding UnlockCommand}"
                AutomationProperties.Name="{x:Static res:Strings.Unlock}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="refresh-cw" Size="14" IsVisible="{Binding Busy}" Classes.spinning="{Binding Busy}" />
            <TextBlock Text="{Binding UnlockText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="ImportConfirm"
                Classes="primary dialog-action"
                IsVisible="{Binding ShowsConfirm}"
                Content="{Binding ConfirmText}"
                Command="{Binding ConfirmCommand}" />
      </StackPanel>

      <!-- A choice with no sign of itself on a small screen would pass unseen, so it stays with the answers. -->
      <StackPanel DockPanel.Dock="Bottom" Spacing="16" Margin="0,16,0,0">
      <StackPanel Spacing="6" IsVisible="{Binding IsReadable}">
        <ToggleButton Theme="{StaticResource Switch}" IsChecked="{Binding KeepEditingInPlace}" AutomationProperties.Name="{x:Static res:Strings.KeepEditingThisFileInPlaceSoX072ed7}">
          <TextBlock Classes="size-13"
                     FontWeight="Normal"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextPrimary}"
                     Text="{x:Static res:Strings.KeepEditingThisFileInPlaceSoX072ed7}" />
        </ToggleButton>
        <TextBlock Classes="caption"
                   Margin="40,0,0,0"
                   Text="{Binding InPlaceNote}"
                   IsVisible="{Binding KeepEditingInPlace}" />
      </StackPanel>

      <TextBlock ctl:MachineRuns.InText="True" Classes="danger size-13"
                 TextWrapping="Wrap"
                 ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                 IsVisible="{Binding HasTrailingMessage}" />
      </StackPanel>

      <!-- A small screen scrolls what lies between the head and the answers, so Cancel and Import stay in view. The margins give the scroll bar the card's edge. -->
      <ScrollViewer Margin="-4,-4,-12,-4" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="4,4,12,4" Spacing="16">

      <!-- The file card, on a dashed hairline. -->
      <Panel>
        <Rectangle RadiusX="10" RadiusY="10"
                   Stroke="{DynamicResource KpBorderStrong}"
                   StrokeThickness="1"
                   StrokeDashArray="4,3" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="16">
          <ctl:KpIcon Grid.Column="0" Icon="file-lock-2" Size="20" Margin="0,0,12,0" Foreground="{DynamicResource KpTextMuted}" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="mono size-13" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
            <TextBlock
                       Classes="muted size-13"
                       Text="{Binding CardDetail}"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding IsReadable}" />
            <TextBlock ctl:MachineRuns.InText="True"
                       Classes="danger size-13"
                       ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsUnreadable}" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsDecrypted}">
            <ctl:KpIcon Icon="lock-open" Size="14" Foreground="{DynamicResource KpOk}" />
            <TextBlock Classes="ok size-13" Text="{x:Static res:Strings.Decrypted}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsLocked}">
            <ctl:KpIcon Icon="lock" Size="14" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.Locked}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="4"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsUnreadable}">
            <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpDanger}" />
            <TextBlock Classes="danger size-13" Text="{x:Static res:Strings.CantRead}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Panel>

      <!-- What opens the file. The password, typed or pasted, goes to a buffer and is cleared once it has been tried. -->
      <StackPanel Spacing="8" IsVisible="{Binding NeedsUnlock}">
        <TextBlock Classes="label" Text="{x:Static res:Strings.PasswordForThisFile}" />
        <ctl:MaskedInput x:Name="ImportPassword"
                         Sink="{Binding}"
                         AllowsPaste="True"
                         MaskedLength="{Binding PasswordLength}"
                         FontFamily="{DynamicResource KpMono}"
                         Classes="size-14"
                         AutomationProperties.Name="{x:Static res:Strings.PasswordForThisFile}" />
        <TextBlock ctl:MachineRuns.InText="True"
                   Classes="danger size-13"
                   TextWrapping="Wrap"
                   ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                   IsVisible="{Binding HasMessage}" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ctl:KpIcon Grid.Column="0" Icon="file-key" Size="14" Margin="0,0,8,0"
                      Foreground="{DynamicResource KpTextMuted}" />
          <TextBlock Grid.Column="1"
                     Classes="mono secondary size-12"
                     Text="{Binding KeyfileName}"
                     ToolTip.Tip="{Binding KeyfilePath}"
                     IsVisible="{Binding HasKeyfile}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Classes="muted size-13"
                     Text="{x:Static res:Strings.NoKeyFile}"
                     IsVisible="{Binding !HasKeyfile}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <Button Classes="link" Content="{x:Static res:Strings.Choose}" Command="{Binding ChooseKeyfileCommand}" />
            <Button Classes="link" Content="{x:Static res:Strings.Remove}" IsVisible="{Binding HasKeyfile}" Command="{Binding ClearKeyfileCommand}" />
          </StackPanel>
        </Grid>
        <!-- A YubiKey slot the file needs as well, as the unlock screen asks one. -->
        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding OffersHardwareKey}">
          <ctl:KpIcon Grid.Column="0" Icon="usb" Size="14" Margin="0,0,8,0"
                      Foreground="{DynamicResource KpTextMuted}" />
          <TextBlock Grid.Column="1"
                     Classes="secondary size-13"
                     Text="{Binding HardwareKeyLabel}"
                     IsVisible="{Binding UsesHardwareKey}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Classes="muted size-13"
                     Text="{x:Static res:Strings.NoYubiKey}"
                     IsVisible="{Binding !UsesHardwareKey}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
            <Button Classes="link" Content="{x:Static res:Strings.UseAYubiKey}" IsVisible="{Binding !UsesHardwareKey}" Command="{Binding UseHardwareKeyCommand}" />
            <Button Classes="link" Content="{Binding OtherSlotLabel}" IsVisible="{Binding UsesHardwareKey}" Command="{Binding SwitchSlotCommand}" />
            <Button Classes="link" Content="{x:Static res:Strings.Remove}" IsVisible="{Binding UsesHardwareKey}" Command="{Binding ClearHardwareKeyCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.UnlockWithoutAYubiKey}" />
          </StackPanel>
        </Grid>
        <!-- Waiting is an amber dot with its halo, the dialog's one amber element while it shows (DESIGN). -->
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWaitingForTouch}">
          <Border Classes="dot waiting" VerticalAlignment="Center" />
          <TextBlock Text="{x:Static res:Strings.TouchYourYubiKey}" Classes="size-13" VerticalAlignment="Center"
                     Foreground="{DynamicResource KpTextPrimary}" />
          <Button Classes="link" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTouchCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.StopWaitingForTheYubiKey}" />
        </StackPanel>
      </StackPanel>

      <!-- Where each group of the file lands in the open vault. -->
      <StackPanel Spacing="8" IsVisible="{Binding ShowsRows}">
        <TextBlock Classes="label" Text="{x:Static res:Strings.MapGroupsIntoThisVault}" />
        <Border BorderBrush="{DynamicResource KpBorderDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource KpRadiusButton}"
                ClipToBounds="True">
          <ScrollViewer MaxHeight="232" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportRowViewModel">
                  <Border Classes="map-row">
                    <Grid ColumnDefinitions="Auto,*,20,*" RowDefinitions="Auto,Auto">
                      <CheckBox Grid.Column="0"
                                Theme="{StaticResource IncludeBox}"
                                IsChecked="{Binding Include}"
                                AutomationProperties.Name="{Binding SourceGroup, StringFormat={x:Static res:Strings.CopyGroupValue}}"
                                ToolTip.Tip="{x:Static res:Strings.CopyThisGroup}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="mono secondary size-12"
                                   Text="{Binding SourceGroup}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="label muted"
                                   Text="{Binding CountText}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <ctl:KpIcon Grid.Column="2"
                                  Icon="arrow-right"
                                  Size="14"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource KpTextMuted}" />
                      <TextBox Grid.Column="3"
                               Theme="{StaticResource DestinationField}"
                               Classes.blocked="{Binding Blocks}"
                               Classes="size-13"
                               FontWeight="Normal"
                               Text="{Binding Destination}"
                               AutomationProperties.Name="{Binding SourceGroup, StringFormat={x:Static res:Strings.WhereValueGoes}}"
                               IsEnabled="{Binding Include}" />
                      <TextBlock ctl:MachineRuns.InText="True" Grid.Row="1"
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 Margin="0,4,0,0"
                                 TextWrapping="Wrap"
                                 Classes="muted size-13"
                                 Classes.danger="{Binding Blocks}"
                                 Text="{Binding Problem}"
                                 IsVisible="{Binding HasProblem}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Classes="caption" Text="{Binding SkippedText}" IsVisible="{Binding HasSkipped}" />
      </StackPanel>

      </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>

</UserControl>
