<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.LockedVaultView"
             x:DataType="vm:LockedVaultViewModel"
             Background="{DynamicResource KpBgApp}">

  <!-- A locked vault while another stays open: the unlock form in the list's room, asking only for that vault. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <views:UnlockForm Name="LockedVaultForm"
                      Margin="24,40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      DataContext="{Binding Unlock}" />
  </ScrollViewer>

</UserControl>
