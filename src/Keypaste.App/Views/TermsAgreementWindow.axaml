<views:PromptWindow xmlns:res="using:Keypaste.App.Resources"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.TermsAgreementWindow"
                    x:DataType="vm:FirstLaunchViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="{x:Static res:Strings.TermsOfUse}"
                    Width="440"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- The first-launch screen's terms, where Settings' switch finds them not agreed to. No button is the default: Enter agrees to nothing, and Escape cancels. -->
  <Border Classes="prompt">
    <StackPanel Spacing="16">
      <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />

      <StackPanel Spacing="6">
        <TextBlock Classes="prompt-title size-15" Text="{x:Static res:Strings.TermsOfUse}" />
        <TextBlock Name="AgreementText" Classes="secondary size-13" TextWrapping="Wrap" Text="{Binding Agreement}" />
        <views:TermsLink DataContext="{Binding Terms}" HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="Deny" Classes="ghost" Content="{x:Static res:Strings.Cancel}" IsCancel="True" />
        <Button Name="Agree" Classes="primary" Content="{x:Static res:Strings.Agree}" Command="{Binding AgreeCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>

</views:PromptWindow>
