<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.FillWindow"
                    x:DataType="vm:FillViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: fill a login on this site?"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card with no requester line, as the pairing card has: the page and the build are what the extension claims
       (THREATS.md T-48, T-58, T-59), so they wait under Details, and no password is drawn. No button is the default: Enter
       fills nothing, and Escape denies. -->

  <Border Classes="claim">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
          <ctl:BrandMark Height="16" VerticalAlignment="Center" />
          <TextBlock Classes="claim-label size-11" Text="keypaste" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Name="TitleText" Classes="claim-title size-16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="{Binding Question}">
          <Run Text="{Binding QuestionBefore}" /><Run Text="{Binding Site}" FontWeight="Bold" /><Run Text="?" />
        </TextBlock>

        <Border Classes="claim-block" Padding="12,8" IsVisible="{Binding HasLogin}">
          <TextBlock Name="LoginText" Classes="claim-line size-12-5" Text="{Binding Login}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Border>

        <TextBlock Name="FormText" Classes="size-12-5" Text="{Binding Note}" Foreground="{DynamicResource KpDanger}"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNote}" />

        <TextBlock Name="ExplainerText" Classes="claim-muted size-12-5" Text="{Binding Explainer}" TextWrapping="Wrap" />

        <StackPanel Spacing="8">
          <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
              <TextBlock Classes="size-12-5" Text="Details" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Grid Classes="claim-facts size-12-5" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" Margin="20,0,0,0"
                IsVisible="{Binding #DetailsToggle.IsChecked}">
            <TextBlock Classes="fact" Text="Page" />
            <TextBlock Grid.Column="1" Name="OriginText" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Classes="fact" Text="Extension" />
            <TextBlock Grid.Row="1" Grid.Column="1" Name="IdentityText" Text="{Binding Identity}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Classes="fact" Text="Pairing" />
            <TextBlock Grid.Row="2" Grid.Column="1" Name="PairingText" Text="{Binding Pairing}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <ctl:HeaderRow Classes="claim-foot" Spacing="8">
        <ctl:SteadyDigits Name="CountdownText" Classes="claim-muted size-12-5" Text="{Binding DeniesIn}" VerticalAlignment="Center" TextWrapping="NoWrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                  IsCancel="True" Command="{Binding DenyCommand}" />
          <Button Name="Allow" Classes="claim primary" Content="Fill"
                  Command="{Binding AllowOnceCommand}" />
        </StackPanel>
      </ctl:HeaderRow>
    </StackPanel>
  </Border>

</views:PromptWindow>
