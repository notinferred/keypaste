<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.FillWindow"
                    x:DataType="vm:FillViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: fill a login on this site?"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card whose requester line says Not verified: the page and the build are what the extension claims (THREATS.md
       T-48, T-58, T-59), so the page's origin and the build wait under Details, and no password is drawn. The site is never
       cut. No button is the default: Enter fills nothing, and Escape denies. -->

  <Border Classes="claim" Classes.arming="{Binding IsArming}">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <StackPanel Spacing="4">
          <TextBlock Name="TitleText" Classes="claim-title size-15" AutomationProperties.Name="{Binding Question}">
            <Run Text="Fill on " /><Run Text="{Binding Site}" /><Run Text="?" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
            <ctl:KpIcon Classes="claim-muted" Icon="key" Size="14" VerticalAlignment="Center" />
            <TextBlock Name="ItemText" Classes="claim-muted size-13" Text="{Binding Item}" MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Name="LoginText" Classes="claim-muted size-13" Text="{Binding Login}" Margin="20,0,0,0" MaxWidth="380" HorizontalAlignment="Left"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasLogin}" />
        </StackPanel>

        <TextBlock Name="FormText" Classes="size-13" Text="{Binding Note}" Foreground="{DynamicResource KpDanger}"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNote}" />

        <TextBlock Name="CheckText" Classes="claim-line size-13" Text="{Binding Check}" />

        <StackPanel Spacing="8">
          <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
              <TextBlock Classes="size-13" Text="Details" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Grid Classes="claim-facts size-13" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4" Margin="20,0,0,0"
                IsVisible="{Binding #DetailsToggle.IsChecked}">
            <TextBlock Classes="fact" Text="Page" />
            <TextBlock Grid.Column="1" Name="OriginText" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Classes="fact" Text="Extension" />
            <TextBlock Grid.Row="1" Grid.Column="1" Name="IdentityText" Text="{Binding Identity}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Classes="fact" Text="Pairing" />
            <TextBlock Grid.Row="2" Grid.Column="1" Name="PairingText" Text="{Binding Pairing}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Name="ExplainerText" Text="{Binding Explainer}" />
          </Grid>
        </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                IsCancel="True" Command="{Binding DenyCommand}" />
        <Button Name="Allow" Classes="claim primary" Content="Fill"
                Command="{Binding AllowOnceCommand}" />
      </StackPanel>
      <ProgressBar Name="TimeBar" Classes="claim-time" Value="{Binding TimeLeft}" AutomationProperties.Name="{Binding DeniesIn}" />
    </StackPanel>
  </Border>

</views:PromptWindow>
