<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- A settings card: a heading, then rows split by hairlines. -->
    <Style Selector="Border.settings">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.settings-head">
      <Setter Property="Padding" Value="20,16,20,4" />
    </Style>
    <Style Selector="Border.settings-row">
      <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style Selector="Border.settings-row:nth-child(n+3)">
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="TextBlock.row-label">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.75" />
    </Style>
    <Style Selector="SelectableTextBlock.fact-value">
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <!-- A recommendation's state is words, not machine text, so its chip is sans. -->
    <Style Selector="Border.chip.state > TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource KpSans}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <!-- The destructive confirmation, drawn as Items draws its own. -->
    <Style Selector="Border.form.danger">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpDanger}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <!-- Choices read at the size of the row labels they sit under. -->
    <Style Selector="RadioButton, CheckBox">
      <Setter Property="FontSize" Value="13.5" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- What the last action did, kept in view wherever the page is scrolled to. -->
    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding HasMessage}"
            BorderBrush="{DynamicResource KpBorderSubtle}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource KpBgPanel}"
            Padding="32,12">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ctl:KpIcon Icon="info" Size="14" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource KpTextSecondary}" />
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="{DynamicResource KpScreenPadding}" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

        <StackPanel Spacing="6">
          <TextBlock Classes="h1" Text="Settings" />
          <TextBlock Classes="subtitle" Text="Saved on this machine, and in force as soon as you change them." />
        </StackPanel>

        <!-- Recommendations (C.2, V.11, V.9): keys left in notes, named by entry and key, never by value, project
             tags another app dropped, and weak, reused or expired passwords, named by item and problem. No amber here. -->
        <Panel IsVisible="{Binding HasRecommendations}">
        <Border Name="RecommendationsCard"
                Classes="card filled settings"
                DataContext="{Binding Recommendations}"
                x:DataType="vm:RecommendationsViewModel">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="clipboard-check" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Recommendations" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="Keys left in notes, passwords that are weak, reused or past their expiry date, and project tags another app dropped, checked on this machine when you unlock and after each save. Nothing changes until you choose." />
            </Border>
            <Border Classes="settings-row" IsVisible="{Binding IsEmpty}">
              <TextBlock Name="RecommendationsEmpty" Classes="caption" Text="No keys found in notes, no weak, reused or expired passwords, and no project tags dropped." />
            </Border>
            <ItemsControl Name="RecommendationRows" ItemsSource="{Binding Rows}" IsVisible="{Binding HasNoteKeys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecommendationRow">
                  <Border BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          AutomationProperties.Name="{Binding Description}">
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding NeedsReview}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Key, StringFormat='Select {0}'}" />
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Name="RecommendationTokenKind"
                                     Text="{Binding TokenKind}"
                                     IsVisible="{Binding IsToken}"
                                     FontSize="13.5"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource KpTextPrimary}"
                                     VerticalAlignment="Center" />
                          <TextBlock Name="RecommendationKey"
                                     Classes="mono"
                                     FontSize="13"
                                     Text="{Binding Key}"
                                     Foreground="{DynamicResource KpTextPrimary}"
                                     VerticalAlignment="Center" />
                          <Border Classes="chip outline state" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="sm" Content="Move to a field" IsVisible="{Binding NeedsReview}" Command="{Binding MoveCommand}" />
                        <Button Classes="sm ghost" Content="Dismiss" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                        <Button Classes="sm ghost" Content="Review again" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="settings-row" IsVisible="{Binding HasNoteKeys}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <TextBlock Grid.Column="0"
                           Classes="caption"
                           TextWrapping="Wrap"
                           Text="Each value becomes a protected field named by its key, and its line leaves the notes, in one change to each item. The notes as they were stay in the item's history." />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                  <Button Name="SelectAllRecommendations" Classes="sm ghost" Content="Select all" Command="{Binding SelectAllCommand}" />
                  <Button Name="MoveSelected" Classes="sm" Content="Move selected" Command="{Binding MoveSelectedCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <!-- V.11: a tag goes back only after the person has seen the environment and fields it reaches (D-0415). -->
            <ItemsControl Name="LostTagRows" ItemsSource="{Binding LostTags}" IsVisible="{Binding HasLostTags}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LostTagRow">
                  <Border BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,1,0,0" Padding="20,12">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                            AutomationProperties.Name="{Binding Description}">
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Name="LostTag"
                                       Classes="mono"
                                       FontSize="13"
                                       Text="{Binding Tag}"
                                       Foreground="{DynamicResource KpTextPrimary}"
                                       VerticalAlignment="Center" />
                            <Border Classes="chip outline state" VerticalAlignment="Center">
                              <TextBlock Text="{Binding StateLabel}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="caption" Text="{Binding Where}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="sm" Content="Restore tag" IsVisible="{Binding NeedsReview}" Command="{Binding RestoreCommand}" />
                          <Button Classes="sm ghost" Content="Dismiss" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                          <Button Classes="sm ghost" Content="Review again" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                        </StackPanel>
                      </Grid>
                      <Border Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True">
                        <StackPanel Spacing="10">
                          <ItemsControl ItemsSource="{Binding Confirmation}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="sm" Content="Add tag" Command="{Binding ConfirmRestoreCommand}" />
                            <Button Classes="sm ghost" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- V.9: an item whose password is weak or reused, or that has expired, named by item and problem and never by value. -->
            <ItemsControl Name="PasswordRows" ItemsSource="{Binding Passwords}" IsVisible="{Binding HasPasswords}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PasswordRow">
                  <Border BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,1,0,0" Padding="20,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                          AutomationProperties.Name="{Binding Description}">
                      <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Name="PasswordProblem"
                                     Text="{Binding Problem}"
                                     FontSize="13.5"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource KpTextPrimary}"
                                     VerticalAlignment="Center" />
                          <Border Classes="chip outline state" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StateLabel}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Where}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="sm ghost" Content="Open item" Command="{Binding OpenCommand}"
                                AutomationProperties.Name="{Binding OpenLabel}" />
                        <Button Classes="sm ghost" Content="Dismiss" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                        <Button Classes="sm ghost" Content="Review again" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="settings-row" IsVisible="{Binding HasPasswords}">
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="Replace a weak or reused password on its item in Items; a generated one is strong and used nowhere else. An expiry date is changed in KeePassXC or the app that set it." />
            </Border>
            <Border Classes="settings-row" IsVisible="{Binding HasMessage}">
              <TextBlock Name="RecommendationsMessage"
                         Classes="caption"
                         TextWrapping="Wrap"
                         Text="{Binding Message}"
                         Foreground="{DynamicResource KpTextSecondary}" />
            </Border>
          </StackPanel>
        </Border>
        </Panel>

        <!-- Security -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="shield" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Security" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="row-label" Text="Lock the vault after" />
                  <TextBlock Classes="caption"
                             Text="Counted from the last key or click. A machine that sleeps for longer than this wakes locked. Ctrl+L locks now." />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding IdleChoices}"
                          SelectedItem="{Binding Idle}"
                          MinWidth="160"
                          VerticalAlignment="Top">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:IdleChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </Border>
            <Border Classes="settings-row" IsVisible="{Binding MinimizeLockSupported}">
              <StackPanel Spacing="4">
                <ToggleSwitch Content="Lock when the window is minimized"
                              FontWeight="Medium"
                              FontSize="13.5"
                              IsChecked="{Binding LockWhenMinimized}" />
                <TextBlock Classes="caption" Margin="42,0,0,0"
                           Text="Takes effect at once, and at every launch. Switching to another window is not minimizing and still does not lock; on macOS, hiding the app with Cmd+H is not minimizing either." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Startup -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="rotate-cw" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Startup" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="4">
                <ToggleSwitch Name="StayInTray"
                              Content="{Binding StayInTrayLabel}"
                              FontWeight="Medium"
                              FontSize="13.5"
                              IsChecked="{Binding StayInTray}" />
                <TextBlock Classes="caption" Margin="42,0,0,0"
                           Text="Closing the window still locks the vault. Open, Lock and Quit are on the icon's menu. Some Linux desktops show no tray icon." />
              </StackPanel>
            </Border>
            <Border Classes="settings-row" IsVisible="{Binding OpenAtLoginSupported}">
              <StackPanel Spacing="4">
                <ToggleSwitch Name="OpenAtLogin"
                              Content="Open keypaste at login"
                              FontWeight="Medium"
                              FontSize="13.5"
                              IsChecked="{Binding OpenAtLogin}" />
                <TextBlock Classes="caption" Margin="42,0,0,0"
                           Text="It starts locked, and with no window when it stays in the tray. Only your own login is changed." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="sun" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Appearance" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Classes="row-label" Text="Theme" />
                  <TextBlock Classes="caption" Text="System follows the operating system's light or dark setting." />
                </StackPanel>
                <ListBox Grid.Column="1"
                         Name="ThemeChoice"
                         Classes="segmented"
                         VerticalAlignment="Center"
                         ItemsSource="{Binding Themes}"
                         SelectedItem="{Binding Theme}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- What unlocks the vault. Every password field here is a MaskedInput held to D-0099. -->
        <Border Classes="card filled settings" DataContext="{Binding Access}" x:DataType="vm:VaultAccessViewModel">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="key-round" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Vault access" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="row-label" Text="Master password, keyfile and YubiKey" />
                  <TextBlock Name="AccessFactors" Classes="caption" Text="{Binding Factors}"
                             Foreground="{DynamicResource KpTextSecondary}" />
                </StackPanel>

                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                  <ctl:MaskedInput x:Name="CurrentPassword"
                                   AllowsPaste="True"
                                   MaskedLength="{Binding CurrentMaskedLength}"
                                   Placeholder="Current master password"
                                   IsEnabled="{Binding IsEditing}" />

                  <CheckBox Content="Set a new master password"
                            IsChecked="{Binding SetPassword}"
                            IsEnabled="{Binding IsEditing}" />
                  <StackPanel Spacing="8" IsVisible="{Binding SetPassword}">
                    <ctl:MaskedInput x:Name="AccessNewPassword"
                                     AllowsPaste="True"
                                     MaskedLength="{Binding NewMaskedLength}"
                                     Placeholder="New master password"
                                     IsEnabled="{Binding IsEditing}" />
                    <ctl:MaskedInput x:Name="AccessConfirmPassword"
                                     AllowsPaste="True"
                                     MaskedLength="{Binding ConfirmMaskedLength}"
                                     Placeholder="Confirm new master password"
                                     IsEnabled="{Binding IsEditing}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Spacing="2" IsEnabled="{Binding IsEditing}">
                  <TextBlock Classes="label" Text="Keyfile" Margin="0,0,0,4" />
                  <RadioButton GroupName="Keyfile" Content="Keep the keyfile as it is" IsChecked="{Binding KeepKeyfile}" />
                  <RadioButton GroupName="Keyfile" Content="{Binding AttachLabel}" IsChecked="{Binding AttachKeyfile}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,4,0,4" IsVisible="{Binding AttachKeyfile}">
                    <Button Classes="sm" Command="{Binding ChooseKeyfileCommand}" AutomationProperties.Name="Choose keyfile…">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:KpIcon Icon="file-key" Size="14" />
                        <TextBlock Text="Choose keyfile…" />
                      </StackPanel>
                    </Button>
                    <Button Classes="sm" Command="{Binding CreateKeyfileCommand}" AutomationProperties.Name="Create keyfile…">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:KpIcon Icon="plus" Size="14" />
                        <TextBlock Text="Create keyfile…" />
                      </StackPanel>
                    </Button>
                    <TextBlock Classes="mono secondary" Text="{Binding NewKeyfileName}" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding NewKeyfilePath}" />
                  </StackPanel>
                  <RadioButton GroupName="Keyfile" Content="Stop using a keyfile"
                               IsVisible="{Binding HasKeyfile}"
                               IsChecked="{Binding RemoveKeyfile}" />
                </StackPanel>

                <StackPanel Spacing="2" IsEnabled="{Binding IsEditing}" IsVisible="{Binding OffersHardwareKey}">
                  <TextBlock Classes="label" Text="YubiKey" Margin="0,0,0,4" />
                  <RadioButton GroupName="HardwareKey" Content="Keep the YubiKey as it is" IsChecked="{Binding KeepHardwareKey}" />
                  <RadioButton x:Name="AttachHardwareKey"
                               GroupName="HardwareKey"
                               Content="{Binding AttachHardwareKeyLabel}"
                               IsChecked="{Binding AttachHardwareKey}" />
                  <StackPanel Orientation="Horizontal" Spacing="16" Margin="28,4,0,4" IsVisible="{Binding AttachHardwareKey}">
                    <RadioButton GroupName="HardwareKeySlot" Content="Slot 1" IsChecked="{Binding NewSlotOne}" />
                    <RadioButton GroupName="HardwareKeySlot" Content="Slot 2" IsChecked="{Binding NewSlotTwo}" />
                  </StackPanel>
                  <TextBlock Classes="caption" Margin="28,0,0,4" IsVisible="{Binding AttachHardwareKey}"
                             Text="Plug in a YubiKey whose slot is programmed for HMAC-SHA1 challenge-response, as KeePassXC uses it. It is asked once, when the change is saved." />
                  <RadioButton GroupName="HardwareKey" Content="Stop using the YubiKey"
                               IsVisible="{Binding HasHardwareKey}"
                               IsChecked="{Binding RemoveHardwareKey}" />
                </StackPanel>

                <Button Content="Change…" Command="{Binding ReviewCommand}" HorizontalAlignment="Left"
                        IsVisible="{Binding IsEditing}" />

                <Border IsVisible="{Binding IsConfirming}"
                        Classes="card"
                        Background="{DynamicResource KpDangerTint}"
                        BorderBrush="{DynamicResource KpDanger}">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ctl:KpIcon Icon="alert-triangle" Size="16" Foreground="{DynamicResource KpDanger}" />
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                                 Foreground="{DynamicResource KpTextPrimary}" />
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding BackupCost}" Foreground="{DynamicResource KpTextSecondary}" />
                    <TextBlock Classes="caption" Text="{Binding KeyfileWarning}"
                               IsVisible="{Binding HasKeyfileWarning}"
                               Foreground="{DynamicResource KpTextSecondary}" />
                    <TextBlock Name="HardwareKeyWarning"
                               Classes="caption" Text="{Binding HardwareKeyWarning}"
                               IsVisible="{Binding HasHardwareKeyWarning}"
                               Foreground="{DynamicResource KpTextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                      <Button Classes="danger" Content="Change access" Command="{Binding ConfirmCommand}" />
                      <Button Classes="ghost" Content="Leave access as it is" Command="{Binding CancelCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="caption" Text="Changing…" IsVisible="{Binding Busy}" />
                <TextBlock Name="AccessMessage"
                           Classes="caption"
                           Text="{Binding Message}"
                           IsVisible="{Binding HasMessage}"
                           Foreground="{DynamicResource KpTextSecondary}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Backups -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="history" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Backups" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="10">
                <TextBlock Classes="caption" Text="{Binding BackupsRule}" />
                <Border Classes="field" Padding="12,9">
                  <SelectableTextBlock Classes="fact-value" Text="{Binding BackupsPath}" VerticalAlignment="Center" />
                </Border>
                <TextBlock Name="BackupsSummary"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource KpTextPrimary}"
                           Text="{Binding BackupsSummary}" />
                <TextBlock Classes="caption" Text="{Binding RestoreHint}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Export -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="download" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Export" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <TextBlock Grid.Column="0" Classes="caption" Text="{Binding ElsewhereAdvice}" />
                <Button Grid.Column="1" Command="{Binding ExportCommand}" VerticalAlignment="Top" AutomationProperties.Name="Export an encrypted copy…">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ctl:KpIcon Icon="file-lock-2" Size="14" />
                    <TextBlock Text="Export an encrypted copy…" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Agents and the CLI -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="terminal" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Agents and the CLI" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Name="ChosenVaultLine" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding ChosenVaultText}" />
                  <TextBlock Classes="caption" Text="{Binding ChosenVaultRule}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding UseThisVaultCommand}" IsVisible="{Binding !IsThisVaultChosen}" VerticalAlignment="Top" AutomationProperties.Name="Use this vault for agents and the CLI">
                  <TextBlock Text="Use this vault" />
                </Button>
              </Grid>
            </Border>
            <Border Classes="settings-row" IsVisible="{Binding CliLinkSupported}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="row-label" Text="keypaste in a terminal" />
                    <TextBlock Name="CliLinkLine" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding CliLinkText}" />
                    <TextBlock Name="CliLinkNote" Classes="caption" TextWrapping="Wrap" Text="{Binding CliLinkNote}" IsVisible="{Binding HasCliLinkNote}" />
                  </StackPanel>
                  <Panel Grid.Column="1" VerticalAlignment="Top">
                    <Button Name="LinkCli" Command="{Binding LinkCliCommand}" IsVisible="{Binding OffersCliLink}" AutomationProperties.Name="Link the keypaste command">
                      <TextBlock Text="Link" />
                    </Button>
                    <Button Name="ReplaceCli" Command="{Binding BeginReplaceCliCommand}" IsVisible="{Binding OffersCliReplace}" AutomationProperties.Name="Replace the other keypaste">
                      <TextBlock Text="Replace…" />
                    </Button>
                  </Panel>
                </Grid>
                <Border Name="CliReplaceForm" Classes="form danger" IsVisible="{Binding IsConfirmingCliReplace}" ctl:ShowInView.OnShow="True">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding CliReplacePrompt}" TextWrapping="Wrap" FontSize="12.5" Classes="primary" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="ConfirmReplaceCli" Classes="danger sm" Content="Replace" Command="{Binding ConfirmReplaceCliCommand}" />
                      <Button Name="KeepCli" Classes="ghost sm" Content="Keep it" Command="{Binding CancelReplaceCliCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Browser fill: pairing KeePassXC-Browser, armed by this press alone, and the pairings the vault holds (D-0634). -->
        <Border Name="BrowserFillCard" Classes="card filled settings" IsVisible="{Binding HasBrowserFill}">
          <StackPanel DataContext="{Binding BrowserFill}" x:DataType="vm:BrowserFillViewModel">
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="globe" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Browser fill" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="row-label" Text="Pair a browser" />
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="KeePassXC-Browser pairs with keypaste as it pairs with KeePassXC. For the next 2 minutes, one browser can ask to pair, and you confirm it in a window keypaste shows." />
                  </StackPanel>
                  <Panel Grid.Column="1" VerticalAlignment="Top">
                    <Button Name="PairBrowser" Content="Pair a browser" Command="{Binding PairCommand}" IsVisible="{Binding !IsArmed}"
                            AutomationProperties.Name="Pair a browser" />
                    <Button Name="StopPairing" Classes="ghost" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsArmed}"
                            AutomationProperties.Name="Stop pairing" />
                  </Panel>
                </Grid>
                <TextBlock Name="PairingArmedLine" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}"
                           Text="{Binding ArmedText}" IsVisible="{Binding IsArmed}" />
                <TextBlock Name="BrowserFillMessage" Classes="caption" TextWrapping="Wrap" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="10">
                <TextBlock Classes="row-label" Text="Paired browsers" />
                <TextBlock Classes="caption" Text="No browser is paired with this vault." IsVisible="{Binding HasNoRows}" />
                <ItemsControl Name="PairingsList" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PairingItem">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding Name}" TextWrapping="Wrap" />
                          <TextBlock FontFamily="{DynamicResource KpMono}" FontSize="12" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding Identity}" TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding Used}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost sm" Content="Remove" VerticalAlignment="Top"
                                AutomationProperties.Name="Remove this pairing"
                                Command="{Binding $parent[ItemsControl].((vm:BrowserFillViewModel)DataContext).RemoveCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Recent vaults -->
        <Border Classes="card filled settings">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="folder-open" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Recent vaults" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <TextBlock Grid.Column="0" Classes="caption"
                           Text="keypaste remembers the paths of vaults you have opened on this machine, where the keyfile each one opened with is, and which YubiKey slot. It holds no item names, no secrets and no key material." />
                <Button Grid.Column="1" Classes="ghost" Content="Forget them all" Command="{Binding ForgetAllCommand}"
                        VerticalAlignment="Top" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Crash reports: the first run's choice, which this switch shows and changes (D-0594). -->
        <Border Name="CrashReportsCard" Classes="card filled settings" IsVisible="{Binding HasCrashReports}">
          <StackPanel>
            <Border Classes="settings-head">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="bug" Size="16" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Classes="section" Text="Crash reports" />
              </StackPanel>
            </Border>
            <Border Classes="settings-row">
              <StackPanel Spacing="4">
                <ToggleSwitch Name="SendCrashReports"
                              Content="Send crash reports"
                              FontWeight="Medium"
                              FontSize="13.5"
                              IsChecked="{Binding SendCrashReports}" />
                <TextBlock Classes="caption" Margin="42,0,0,0" TextWrapping="Wrap"
                           Text="What failed and where in keypaste's code. Never anything from your vault, a path or who you are. Turning it off deletes the reports waiting to be sent, which Diagnostics lists." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Settings › Advanced, a screen of its own with what the everyday screens leave out (D-0374). -->
        <Border Name="AdvancedCard" Classes="card filled settings">
          <Border Classes="settings-row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <ctl:KpIcon Grid.Column="0" Icon="layers" Size="16" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="row-label" Text="Advanced" />
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="The activity log, share links, scoped tokens and diagnostics." />
              </StackPanel>
              <Button Grid.Column="2" Name="OpenAdvanced" Classes="sm" Content="Open" VerticalAlignment="Center"
                      AutomationProperties.Name="Open Advanced"
                      Command="{Binding OpenAdvancedCommand}" />
            </Grid>
          </Border>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>

</UserControl>
