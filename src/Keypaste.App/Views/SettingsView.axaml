<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Keypaste.App"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.fact-value">
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <!-- The destructive confirmation, drawn as Items draws its own. -->
    <Style Selector="Border.form.danger">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpDanger}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- What the last action did, kept in view wherever the page is scrolled to. -->
    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding HasMessage}"
            BorderBrush="{DynamicResource KpBorderSubtle}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource KpBgPanel}"
            Padding="32,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ctl:KpIcon Icon="info" Size="14" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock ctl:MachineRuns.InText="True" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" TextWrapping="Wrap" Classes="size-13" VerticalAlignment="Center"
                   Foreground="{DynamicResource KpTextSecondary}" />
      </StackPanel>
    </Border>

    <ctl:ListDetail x:Name="Split" ShowsDetail="{Binding SectionIsOpen}">

      <!-- The parts of Settings, and the way on to Advanced, which is a screen of its own. -->
      <Border BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,1,0">
        <StackPanel Margin="12,16,12,8" Spacing="8">
          <TextBlock Classes="list-title" Text="{Binding ListTitle}" />
          <ListBox Name="SettingsSections" Classes="nav"
                   AutomationProperties.Name="{x:Static res:Strings.SettingsSections}"
                   ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" />
          <Button Name="OpenAdvanced"
                  Classes="ghost"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  ToolTip.Tip="{x:Static res:Strings.TheActivityLogShareLinksScopedTokensX927922}"
                  AutomationProperties.Name="{x:Static res:Strings.OpenAdvanced}"
                  Command="{Binding OpenAdvancedCommand}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static res:Strings.Advanced}" VerticalAlignment="Center" />
              <ctl:KpIcon Grid.Column="1" Icon="chevron-right" Size="14" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>

      <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding #Split.ShowsBack}">
          <Button x:Name="BackToSections"
                  Classes="ghost sm"
                  HorizontalAlignment="Left"
                  Margin="24,12,0,0"
                  Command="{Binding CloseSectionCommand}"
                  AutomationProperties.Name="{Binding ListTitle, StringFormat={x:Static res:Strings.BackToValue}}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-left" Size="14" />
              <TextBlock Text="{Binding ListTitle}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

            <TextBlock Classes="list-title" Text="{Binding Section}" ToolTip.Tip="{Binding SectionNote}" />

            <StackPanel Spacing="16" IsVisible="{Binding ShowsGeneral}">

              <Border Classes="group">
                <ctl:GroupedRows>
                  <ctl:FieldRow Label="{x:Static res:Strings.LockAfter}">
                    <ComboBox ItemsSource="{Binding IdleChoices}"
                              AutomationProperties.Name="{x:Static res:Strings.LockAfter}"
                              AutomationProperties.HelpText="{x:Static app:ShortcutText.IdleLock}"
                              ToolTip.Tip="{x:Static app:ShortcutText.IdleLock}"
                              SelectedItem="{Binding Idle}"
                              MinWidth="160"
                              HorizontalAlignment="Left">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:IdleChoice">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ctl:FieldRow>
                  <ctl:FieldRow Label="{x:Static res:Strings.LockWhenMinimized}" IsVisible="{Binding MinimizeLockSupported}">
                    <ctl:FieldRow.Actions>
                      <ToggleSwitch Name="LockWhenMinimized"
                                    AutomationProperties.Name="{x:Static res:Strings.LockWhenTheWindowIsMinimized}"
                                    AutomationProperties.HelpText="{Binding MinimizeHelp}"
                                    ToolTip.Tip="{Binding MinimizeHelp}"
                                    IsChecked="{Binding LockWhenMinimized}" />
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                  <ctl:FieldRow Label="{Binding StayInTrayLabel}">
                    <ctl:FieldRow.Actions>
                      <ToggleSwitch Name="StayInTray"
                                    AutomationProperties.Name="{Binding StayInTrayLabel}"
                                    AutomationProperties.HelpText="{Binding CloseHelp}"
                                    ToolTip.Tip="{Binding CloseHelp}"
                                    IsChecked="{Binding StayInTray}" />
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                  <ctl:FieldRow Label="{x:Static res:Strings.OpenAtLogin}" IsVisible="{Binding OpenAtLoginSupported}">
                    <ctl:FieldRow.Actions>
                      <ToggleSwitch Name="OpenAtLogin"
                                    AutomationProperties.Name="{x:Static res:Strings.OpenKeypasteAtLogin}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.ItStartsLockedAndWithNoWindowX07ac3e}"
                                    ToolTip.Tip="{x:Static res:Strings.ItStartsLockedAndWithNoWindowX07ac3e}"
                                    IsChecked="{Binding OpenAtLogin}" />
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                  <ctl:FieldRow Label="{x:Static res:Strings.Theme}" IsVisible="{Binding OffersTheme}">
                    <ListBox Name="ThemeChoice" AutomationProperties.Name="{x:Static res:Strings.Theme}"
                             ToolTip.Tip="{x:Static res:Strings.ThisDesktopReportsNoLightOrDark}"
                             Classes="segmented"
                             HorizontalAlignment="Left"
                             ItemsSource="{Binding Themes}"
                             SelectedItem="{Binding Theme}" />
                  </ctl:FieldRow>
                </ctl:GroupedRows>
              </Border>

              <!-- The keypaste a terminal finds, which is this computer's and no vault's. -->
              <StackPanel Spacing="12" IsVisible="{Binding CliLinkSupported}">
                <Border Classes="group">
                  <ctl:GroupedRows>
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.KeypasteInATerminal}">
                      <StackPanel Spacing="4">
                        <TextBlock ctl:MachineRuns.InText="True" Name="CliLinkLine" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding CliLinkText}" />
                        <TextBlock ctl:MachineRuns.InText="True" Name="CliLinkNote" Classes="caption" TextWrapping="Wrap" Text="{Binding CliLinkNote}" IsVisible="{Binding HasCliLinkNote}" />
                      </StackPanel>
                      <ctl:FieldRow.Actions>
                        <Panel VerticalAlignment="Top">
                          <Button Name="LinkCli" Command="{Binding LinkCliCommand}" IsVisible="{Binding OffersCliLink}" AutomationProperties.Name="{x:Static res:Strings.LinkTheKeypasteCommand}">
                            <TextBlock Text="{x:Static res:Strings.Link}" />
                          </Button>
                          <Button Name="ReplaceCli" Command="{Binding BeginReplaceCliCommand}" IsVisible="{Binding OffersCliReplace}" AutomationProperties.Name="{x:Static res:Strings.ReplaceTheOtherKeypaste}">
                            <TextBlock Text="{x:Static res:Strings.ReplaceX64ca19}" />
                          </Button>
                        </Panel>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                </Border>
                <Border Name="CliReplaceForm" Classes="form danger" IsVisible="{Binding IsConfirmingCliReplace}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelReplaceCliCommand}">
                  <StackPanel Spacing="8">
                    <TextBlock ctl:MachineRuns.InText="True" Text="{Binding CliReplacePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="KeepCli" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelReplaceCliCommand}" />
                      <Button Name="ConfirmReplaceCli" Classes="danger sm" Content="{x:Static res:Strings.Replace}" Command="{Binding ConfirmReplaceCliCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="12">
                <Border Classes="group">
                  <ctl:GroupedRows>
                    <ctl:FieldRow Label="{x:Static res:Strings.RecentVaults}">
                      <ctl:FieldRow.Actions>
                        <Button Name="AskForgetAll" Classes="ghost sm" Content="{x:Static res:Strings.ForgetRecentVaults}" Command="{Binding AskForgetAllCommand}"
                                ToolTip.Tip="{x:Static res:Strings.KeypasteRemembersThePathsOfVaultsYouXb13291}"
                                IsVisible="{Binding !IsConfirmingForgetAll}" />
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                </Border>
                <Border Name="ForgetAllForm" Classes="form danger" IsVisible="{Binding IsConfirmingForgetAll}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelForgetAllCommand}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:Strings.ForgetEveryRecentVaultTheVaultsThemselvesX0c96fb}" TextWrapping="Wrap" Classes="primary size-13" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="CancelForgetAll" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelForgetAllCommand}" />
                      <Button Name="ConfirmForgetAll" Classes="danger sm" Content="{x:Static res:Strings.ForgetThemAll}" Command="{Binding ForgetAllCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Name="CrashReportsCard" Classes="group" IsVisible="{Binding HasCrashReports}">
                <ctl:GroupedRows>
                  <ctl:FieldRow Label="{x:Static res:Strings.CrashReports}">
                    <ctl:FieldRow.Actions>
                      <ToggleSwitch Name="SendCrashReports"
                                    AutomationProperties.Name="{x:Static res:Strings.SendCrashReports}"
                                    AutomationProperties.HelpText="{x:Static res:Strings.WhatFailedAndWhereInKeypastesCodeX12c043}"
                                    ToolTip.Tip="{x:Static res:Strings.WhatFailedAndWhereInKeypastesCodeX12c043}"
                                    IsChecked="{Binding SendCrashReports}" />
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                </ctl:GroupedRows>
              </Border>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding ShowsThisVault}">

              <!-- What unlocks the vault. Every password field here is a MaskedInput held to D-0099. -->
              <StackPanel Spacing="12" DataContext="{Binding Access}" x:DataType="vm:VaultAccessViewModel">
                <Border Classes="group">
                  <ctl:GroupedRows>
                    <ctl:FieldRow Label="{x:Static res:Strings.VaultAccess}">
                      <TextBlock Name="AccessFactors" Classes="size-13" Text="{Binding Factors}" TextWrapping="Wrap"
                                 ToolTip.Tip="{x:Static res:Strings.MasterPasswordKeyFileAndYubiKey}"
                                 Foreground="{DynamicResource KpTextSecondary}" />
                      <ctl:FieldRow.Actions>
                        <Button Name="OpenAccessForm" Classes="ghost sm" Content="{x:Static res:Strings.ChangeEllipsis}"
                                IsVisible="{Binding !IsFormOpen}" Command="{Binding OpenFormCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.ChangeWhatUnlocksThisVault}" />
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                </Border>

                <StackPanel Name="AccessForm" Spacing="12" IsVisible="{Binding IsFormOpen}" ctl:ShowInView.OnShow="True">
                  <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left" Width="420">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="label" Text="{x:Static res:Strings.CurrentMasterPassword}" />
                      <ctl:MaskedInput x:Name="CurrentPassword"
                                       AllowsPaste="True"
                                       MaskedLength="{Binding CurrentMaskedLength}"
                                       AutomationProperties.Name="{x:Static res:Strings.CurrentMasterPassword}"
                                       IsEnabled="{Binding IsEditing}" />
                    </StackPanel>

                    <CheckBox Classes="size-13-5" Content="{x:Static res:Strings.SetANewMasterPassword}"
                              IsChecked="{Binding SetPassword}"
                              IsEnabled="{Binding IsEditing}" />
                    <StackPanel Spacing="8" IsVisible="{Binding SetPassword}">
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.NewMasterPassword}" />
                        <ctl:MaskedInput x:Name="AccessNewPassword"
                                         AllowsPaste="True"
                                         MaskedLength="{Binding NewMaskedLength}"
                                         AutomationProperties.Name="{x:Static res:Strings.NewMasterPassword}"
                                         IsEnabled="{Binding IsEditing}" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.ConfirmNewMasterPassword}" />
                        <ctl:MaskedInput x:Name="AccessConfirmPassword"
                                         AllowsPaste="True"
                                         MaskedLength="{Binding ConfirmMaskedLength}"
                                         AutomationProperties.Name="{x:Static res:Strings.ConfirmNewMasterPassword}"
                                         IsEnabled="{Binding IsEditing}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="2" IsEnabled="{Binding IsEditing}">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.KeyFile}" Margin="0,0,0,4" />
                    <RadioButton Classes="size-13-5" GroupName="Keyfile" Content="{x:Static res:Strings.KeepTheKeyFileAsItIs}" IsChecked="{Binding KeepKeyfile}" />
                    <RadioButton Classes="size-13-5" GroupName="Keyfile" Content="{Binding AttachLabel}" IsChecked="{Binding AttachKeyfile}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,4,0,4" IsVisible="{Binding AttachKeyfile}">
                      <Button Classes="sm" Command="{Binding ChooseKeyfileCommand}" AutomationProperties.Name="{x:Static res:Strings.ChooseKeyFile}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="file-key" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.ChooseKeyFile}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="sm" Command="{Binding CreateKeyfileCommand}" AutomationProperties.Name="{x:Static res:Strings.CreateKeyFile}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="plus" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.CreateKeyFile}" />
                        </StackPanel>
                      </Button>
                      <TextBlock Classes="mono secondary" Text="{Binding NewKeyfileName}" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding NewKeyfilePath}" />
                    </StackPanel>
                    <RadioButton Classes="size-13-5" GroupName="Keyfile" Content="{x:Static res:Strings.StopUsingAKeyFile}"
                                 IsVisible="{Binding HasKeyfile}"
                                 IsChecked="{Binding RemoveKeyfile}" />
                  </StackPanel>

                  <StackPanel Spacing="2" IsEnabled="{Binding IsEditing}" IsVisible="{Binding OffersHardwareKey}">
                    <TextBlock Classes="label" Text="{x:Static res:Strings.YubiKey}" Margin="0,0,0,4" />
                    <RadioButton Classes="size-13-5" GroupName="HardwareKey" Content="{x:Static res:Strings.KeepTheYubiKeyAsItIs}" IsChecked="{Binding KeepHardwareKey}" />
                    <RadioButton Classes="size-13-5" x:Name="AttachHardwareKey"
                                 GroupName="HardwareKey"
                                 Content="{Binding AttachHardwareKeyLabel}"
                                 IsChecked="{Binding AttachHardwareKey}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="24,4,0,4" IsVisible="{Binding AttachHardwareKey}">
                      <RadioButton Classes="size-13-5" GroupName="HardwareKeySlot" Content="{x:Static res:Strings.Slot1}" IsChecked="{Binding NewSlotOne}" />
                      <RadioButton Classes="size-13-5" GroupName="HardwareKeySlot" Content="{x:Static res:Strings.Slot2}" IsChecked="{Binding NewSlotTwo}" />
                    </StackPanel>
                    <TextBlock Classes="caption" Margin="24,0,0,4" IsVisible="{Binding AttachHardwareKey}"
                               Text="{x:Static res:Strings.PlugInAYubiKeyWhoseSlotIsX754e43}" />
                    <RadioButton Classes="size-13-5" GroupName="HardwareKey" Content="{x:Static res:Strings.StopUsingTheYubiKey}"
                                 IsVisible="{Binding HasHardwareKey}"
                                 IsChecked="{Binding RemoveHardwareKey}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                    <Button Name="CloseAccessForm" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CloseFormCommand}" />
                    <Button Content="{x:Static res:Strings.Change}" Command="{Binding ReviewCommand}" />
                  </StackPanel>

                  <Border IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelCommand}"
                          Classes="card"
                          Background="{DynamicResource KpDangerTint}"
                          BorderBrush="{DynamicResource KpDanger}">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:KpIcon Icon="alert-triangle" Size="16" Foreground="{DynamicResource KpDanger}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="size-13" FontWeight="Medium"
                                   Foreground="{DynamicResource KpTextPrimary}" />
                      </StackPanel>
                      <TextBlock Classes="caption" ctl:MachineRuns.InText="True" Text="{Binding BackupCost}" Foreground="{DynamicResource KpTextSecondary}" />
                      <TextBlock Classes="caption" Text="{Binding KeyfileWarning}"
                                 IsVisible="{Binding HasKeyfileWarning}"
                                 Foreground="{DynamicResource KpTextSecondary}" />
                      <TextBlock Name="HardwareKeyWarning"
                                 Classes="caption" Text="{Binding HardwareKeyWarning}"
                                 IsVisible="{Binding HasHardwareKeyWarning}"
                                 Foreground="{DynamicResource KpTextPrimary}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
                        <Button Classes="danger" Content="{x:Static res:Strings.ChangeAccess}" Command="{Binding ConfirmCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Busy}">
                  <ctl:KpIcon Icon="refresh-cw" Size="14" Foreground="{DynamicResource KpTextMuted}" Classes.spinning="{Binding Busy}" />
                  <TextBlock Classes="caption" Text="{x:Static res:Strings.Changing}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock ctl:MachineRuns.InText="True" Name="AccessMessage"
                           Classes="caption"
                           ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                           IsVisible="{Binding HasMessage}"
                           Foreground="{DynamicResource KpTextSecondary}" />
              </StackPanel>

              <Border Classes="group">
                <ctl:GroupedRows>
                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Backups}">
                    <StackPanel Spacing="4">
                      <TextBlock ctl:MachineRuns.InText="True" Name="BackupsSummary"
                                 Classes="size-13"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding BackupsRule}"
                                 Foreground="{DynamicResource KpTextPrimary}"
                                 Text="{Binding BackupsSummary}" />
                      <SelectableTextBlock Classes="fact-value size-12" Text="{Binding BackupsPath}" />
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RestoreHint}" IsVisible="{Binding HasBackupCopies}" />
                    </StackPanel>
                  </ctl:FieldRow>
                  <ctl:FieldRow Label="{x:Static res:Strings.Export}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="ghost sm" Command="{Binding ExportCommand}"
                              ToolTip.Tip="{Binding ElsewhereAdvice}"
                              AutomationProperties.Name="{x:Static res:Strings.ExportAnEncryptedCopy}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="file-lock-2" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.ExportAnEncryptedCopy}" />
                        </StackPanel>
                      </Button>
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.AgentsAndTheCLI}">
                    <TextBlock ctl:MachineRuns.InText="True" Name="ChosenVaultLine" Classes="size-13" TextWrapping="Wrap"
                               ToolTip.Tip="{Binding ChosenVaultRule}"
                               Foreground="{DynamicResource KpTextPrimary}" Text="{Binding ChosenVaultText}" />
                    <ctl:FieldRow.Actions>
                      <Button Classes="ghost sm" Command="{Binding UseThisVaultCommand}" IsVisible="{Binding !IsThisVaultChosen}" VerticalAlignment="Top" AutomationProperties.Name="{x:Static res:Strings.UseThisVaultForAgentsAndTheXb47c9a}">
                        <TextBlock Text="{x:Static res:Strings.UseThisVault}" />
                      </Button>
                    </ctl:FieldRow.Actions>
                  </ctl:FieldRow>
                </ctl:GroupedRows>
              </Border>
            </StackPanel>

            <StackPanel Spacing="16" IsVisible="{Binding ShowsBrowser}">
              <!-- Browser fill: pairing KeePassXC-Browser, armed by this press alone, and the pairings the vault holds. -->
              <Border Name="BrowserFillCard" IsVisible="{Binding HasBrowserFill}">
                <StackPanel Spacing="12" DataContext="{Binding BrowserFill}" x:DataType="vm:BrowserFillViewModel">
                  <Border Classes="group">
                    <ctl:GroupedRows>
                      <ctl:FieldRow Label="{x:Static res:Strings.BrowserFill}">
                        <StackPanel Spacing="4">
                          <TextBlock Name="PairingArmedLine" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}"
                                     Text="{Binding ArmedText}" IsVisible="{Binding IsArmed}" />
                          <TextBlock ctl:MachineRuns.InText="True" Name="BrowserFillMessage" Classes="caption" TextWrapping="Wrap" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                        </StackPanel>
                        <ctl:FieldRow.Actions>
                          <Panel VerticalAlignment="Top">
                            <Button Name="PairBrowser" Classes="ghost sm" Content="{x:Static res:Strings.PairABrowser}" Command="{Binding PairCommand}" IsVisible="{Binding !IsArmed}"
                                    ToolTip.Tip="{x:Static res:Strings.KeePassXCBrowserPairsWithKeypasteAsItX779e5d}"
                                    AutomationProperties.Name="{x:Static res:Strings.PairABrowser}" />
                            <Button Name="StopPairing" Classes="ghost sm" Content="{x:Static res:Strings.StopPairing}" Command="{Binding StopCommand}" IsVisible="{Binding IsArmed}"
                                    AutomationProperties.Name="{x:Static res:Strings.StopPairing}" />
                          </Panel>
                        </ctl:FieldRow.Actions>
                      </ctl:FieldRow>
                    </ctl:GroupedRows>
                  </Border>

                  <TextBlock Classes="th" Text="{x:Static res:Strings.PairedBrowsers}" Margin="4,0" />
                  <TextBlock Classes="caption" Margin="4,0" Text="{x:Static res:Strings.NoBrowserIsPairedWithThisVault}" IsVisible="{Binding HasNoRows}" />
                  <Border Classes="group" IsVisible="{Binding HasRows}">
                    <ItemsControl Name="PairingsList" ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PairingItem">
                          <ctl:FieldRow Label="{Binding Name}">
                            <StackPanel Spacing="2">
                              <TextBlock FontFamily="{DynamicResource KpMono}" Classes="size-12" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding Identity}" TextWrapping="Wrap" />
                              <TextBlock Classes="caption" Text="{Binding Used}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ctl:FieldRow.Actions>
                              <Panel VerticalAlignment="Top">
                                <Button Classes="ghost sm" Content="{x:Static res:Strings.Remove}"
                                        AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.RemoveThePairingValue}}"
                                        IsVisible="{Binding !IsConfirmingRemove}"
                                        Command="{Binding $parent[ItemsControl].((vm:BrowserFillViewModel)DataContext).AskRemoveCommand}"
                                        CommandParameter="{Binding}" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            IsVisible="{Binding IsConfirmingRemove}" ctl:ShowInView.OnShow="True">
                                  <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}"
                                          Command="{Binding $parent[ItemsControl].((vm:BrowserFillViewModel)DataContext).CancelRemoveCommand}"
                                          CommandParameter="{Binding}" />
                                  <Button Classes="danger sm" Content="{x:Static res:Strings.Remove}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.ConfirmRemovingThePairingValue}}"
                                          Command="{Binding $parent[ItemsControl].((vm:BrowserFillViewModel)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" />
                                </StackPanel>
                              </Panel>
                            </ctl:FieldRow.Actions>
                          </ctl:FieldRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </DockPanel>

    </ctl:ListDetail>
  </DockPanel>

</UserControl>
