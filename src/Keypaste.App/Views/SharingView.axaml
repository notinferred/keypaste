<UserControl xmlns:res="using:Keypaste.App.Resources"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.SharingView"
             x:DataType="vm:SharingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.status">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="TextBlock.status.ok">
      <Setter Property="Foreground" Value="{DynamicResource KpOk}" />
    </Style>
    <Style Selector="TextBlock.status.info">
      <Setter Property="Foreground" Value="{DynamicResource KpInfo}" />
    </Style>
    <!-- A row's Revoke… or Remove shows only while the row is pointed at or holds the keyboard; its menu offers it too. -->
    <Style Selector="Border.share-row Button.row-action">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.share-row:pointerover Button.row-action, Border.share-row:focus-within Button.row-action">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <views:SettingsFrame Section="{x:Static vm:SettingsSectionChoice.ShareLinks}">
    <views:SettingsFrame.Page>
      <!-- The links this vault made: what, to whom and on what terms, and whether each still opens. -->
      <StackPanel Classes="sections">

        <ctl:EmptyState Icon="link" Text="{x:Static res:Strings.NoLinksYet}" Helper="{x:Static res:Strings.ChooseShareInAnItemsMenuToMakeOne}"
                        IsVisible="{Binding IsEmpty}" />

        <StackPanel Classes="section" IsVisible="{Binding !IsEmpty}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Name="CheckedText" Classes="caption" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding CheckedText}"
                       ToolTip.Tip="{x:Static res:Strings.LinksYouMadeFromAnItemsMenuXfaa446}" />
            <Button Grid.Column="1"
                    x:Name="CheckStatus"
                    Classes="sm"
                    Classes.busy="{Binding RefreshCommand.IsRunning}"
                    ToolTip.Tip="{x:Static res:Strings.AskTheShareServerHowManyViewsXbaa6a2}"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.CheckStatus}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:KpIcon Icon="refresh-cw" Size="14" Classes.spinning="{Binding RefreshCommand.IsRunning}" />
                <TextBlock Text="{x:Static res:Strings.CheckStatus}" IsVisible="{Binding !RefreshCommand.IsRunning}" />
                <TextBlock Text="{x:Static res:Strings.CheckingStatus}" IsVisible="{Binding RefreshCommand.IsRunning}" />
              </StackPanel>
            </Button>
          </Grid>

          <Border x:Name="Shares" Classes="group" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SharingRow">
                  <Border Classes="share-row" Background="Transparent" Padding="14,8" MinHeight="52" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,0,1">
                    <Panel VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding $parent[ItemsControl].((vm:SharingViewModel)DataContext).CancelRevokeCommand}">
                        <TextBlock Name="RevokeQuestion" Text="{Binding ConfirmText}" Classes="size-13" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:SharingViewModel)DataContext).CancelRevokeCommand}" />
                        <Button Grid.Column="2" Name="ConfirmRevoke" Classes="danger sm" Content="{x:Static res:Strings.RevokeLink}" AutomationProperties.Name="{Binding What, StringFormat={x:Static res:Strings.RevokeValue}}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:SharingViewModel)DataContext).ConfirmRevokeCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" IsVisible="{Binding !IsConfirming}">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="mono size-13" Text="{Binding What}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding What}" />
                          <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <Border Classes="dot" Classes.ok="{Binding IsOk}" Classes.info="{Binding IsInfo}" />
                          <TextBlock Classes="status size-12" Classes.ok="{Binding IsOk}" Classes.info="{Binding IsInfo}" Text="{Binding Status}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="ghost sm row-action"
                                VerticalAlignment="Center"
                                Content="{Binding RevokeLabel}"
                                Command="{Binding $parent[ItemsControl].((vm:SharingViewModel)DataContext).RevokeRowCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </views:SettingsFrame.Page>
  </views:SettingsFrame>
</UserControl>
