<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             x:Class="Keypaste.App.Views.SharingView"
             x:DataType="vm:SharingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="TextBlock.status.ok">
      <Setter Property="Foreground" Value="{DynamicResource KpOk}" />
    </Style>
    <Style Selector="TextBlock.status.amber">
      <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
    </Style>
    <Style Selector="Border.dot.amber">
      <Setter Property="Background" Value="{DynamicResource KpAccent}" />
    </Style>

    <!-- A 24px target that takes a text line's height in the row. Revoke is the danger tint; Remove only forgets, so it stays quiet. -->
    <Style Selector="Button.row-action">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0,-4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.row-action.quiet /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="Button.row-action.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <!-- The design's max-width 1080, left-aligned: the star column fills up to it. -->
    <Grid Margin="32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1080" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>

        <!-- The links this vault made: what, to whom and on what terms, and whether each still opens. -->
        <StackPanel Grid.Column="0" Spacing="16" MinWidth="296">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Classes="h1" Text="Share links" />
              <TextBlock Classes="subtitle"
                         Text="Links you made from an item's ⋯ menu, end-to-end encrypted. The key lives in the link itself, so our relay never sees it." />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="CheckStatus"
                    Classes="ghost sm"
                    VerticalAlignment="Top"
                    Margin="12,0,0,0"
                    IsVisible="{Binding !IsEmpty}"
                    ToolTip.Tip="Ask the share server how many views each link has left"
                    Command="{Binding RefreshCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:KpIcon Icon="refresh-cw" Size="13" />
                <TextBlock Text="Check status" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="16,14">
            <TextBlock Classes="caption"
                       Text="No links yet. Choose Share… in an item's ⋯ menu to make one; it appears here with its limits, and Check status asks how many views it has left." />
          </Border>

          <Border x:Name="Shares"
                  CornerRadius="{DynamicResource KpRadiusCard}"
                  BorderBrush="{DynamicResource KpBorderSubtle}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SharingRow">
                  <Border Padding="16,14"
                          BorderBrush="{DynamicResource KpBorderSubtle}"
                          BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                      <TextBlock Grid.Row="0" Grid.Column="0"
                                 Classes="mono lg"
                                 Text="{Binding What}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding What}" />
                      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                  HorizontalAlignment="Right">
                        <Border Classes="dot" Classes.ok="{Binding IsOk}" Classes.amber="{Binding IsAccent}" />
                        <TextBlock Classes="status" Classes.ok="{Binding IsOk}" Classes.amber="{Binding IsAccent}"
                                   Text="{Binding Status}" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Grid.Column="0"
                                 FontSize="12"
                                 Foreground="{DynamicResource KpTextMuted}"
                                 Text="{Binding Detail}"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Row="1" Grid.Column="1"
                              Classes="row-action"
                              Classes.danger="{Binding Opens}"
                              Classes.quiet="{Binding !Opens}"
                              Content="{Binding RevokeLabel}"
                              Command="{Binding $parent[ItemsControl].((vm:SharingViewModel)DataContext).RevokeRowCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Classes="caption"
                     IsVisible="{Binding HasUnchecked}"
                     Text="Opening this screen asks the share server nothing. Check status asks how many views each link has left." />
        </StackPanel>

      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
