<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.ShareDialogView"
             x:DataType="vm:SharingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.form, ComboBox.form">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBox.form">
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="ListBox.choice">
      <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem">
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- A 16px check: the text colour with a tick in the ground's colour when on, a hairline square when off. -->
    <Style Selector="CheckBox.passphrase">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
            <Border Name="Box"
                    Width="16" Height="16"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource KpBorderControl}"
                    Background="{DynamicResource KpBgApp}"
                    VerticalAlignment="Center">
              <ctl:KpIcon Name="Tick" Icon="check" Size="12" IsVisible="False"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource KpOnAccent}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"
                              Classes="size-13"
                              Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.passphrase:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource KpTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpTextPrimary}" />
    </Style>
    <Style Selector="CheckBox.passphrase:checked /template/ ctl|KpIcon#Tick">
      <Setter Property="Foreground" Value="{DynamicResource KpBgApp}" />
    </Style>
    <Style Selector="CheckBox.passphrase:checked /template/ ctl|KpIcon#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.passphrase:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <Style Selector="CheckBox.passphrase:focus-visible /template/ Border#Box">
      <Setter Property="BoxShadow" Value="{DynamicResource KpFieldGlow}" />
    </Style>
  </UserControl.Styles>

  <!-- Share…, from an item's ⋯ menu. The first time, the terms of use show here before the form, and until then no link can be made. -->
  <Panel>
  <Border Name="ShareTerms"
          Classes="dialog"
          IsVisible="{Binding IsReadingTerms}"
          ctl:FormKeys.Confirm="{Binding ContinueCommand}"
          ctl:FormKeys.Cancel="{Binding CancelCommand}"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*">
        <ctl:KpIcon Grid.Column="0" Icon="link" Size="16" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.ShareALink}" VerticalAlignment="Center" />
      </Grid>

      <StackPanel Spacing="8">
        <TextBlock Name="TermsNotice"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Text="{x:Static res:Strings.KeypasteKeepsYourVaultOnThisComputerX3838cf}" />
        <views:TermsLink DataContext="{Binding Terms}" HorizontalAlignment="Left" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Button x:Name="CancelTerms"
                Classes="ghost lg"
                Content="{x:Static res:Strings.Cancel}"
                Command="{Binding CancelCommand}" />
        <Button x:Name="ContinueToShare"
                Grid.Column="1"
                Classes="primary lg"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="{x:Static res:Strings.Continue}"
                Command="{Binding ContinueCommand}" />
      </Grid>
    </StackPanel>
  </Border>

  <!-- The link it makes goes to the clipboard and nowhere else on screen. -->
  <Border Name="ShareDialog"
          Classes="dialog"
          IsVisible="{Binding !IsReadingTerms}"
          ctl:FormKeys.Confirm="{Binding CreateCommand}"
          ctl:FormKeys.Cancel="{Binding CancelCommand}"
          ctl:FormKeys.Draft="{Binding Draft}"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="14">

      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:KpIcon Grid.Column="0" Icon="link" Size="16" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.ShareALink}" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="CloseShare"
                Classes="icon ghost sm"
                ToolTip.Tip="{x:Static res:Strings.Cancel}"
                AutomationProperties.Name="{x:Static res:Strings.Cancel}"
                Command="{Binding CancelCommand}">
          <ctl:KpIcon Icon="x" Size="15" />
        </Button>
      </Grid>

      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="{x:Static res:Strings.EndToEndEncryptedTheKeyLivesX3e20ff}" />

      <Grid ColumnDefinitions="*,10,112" RowDefinitions="Auto,6,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{x:Static res:Strings.What}" />
        <Border Grid.Row="2" Grid.Column="0"
                Height="34"
                Padding="10,0"
                CornerRadius="{DynamicResource KpRadiusField}"
                Background="{DynamicResource KpBgApp}"
                BorderBrush="{DynamicResource KpBorderDefault}"
                BorderThickness="1">
          <TextBlock Name="ShareWhat"
                     Classes="mono size-12-5"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding SelectedWhat}"
                     ToolTip.Tip="{Binding SelectedWhat}" />
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{x:Static res:Strings.Field}" />
        <ComboBox Grid.Row="2" Grid.Column="2"
                  x:Name="ShareField" AutomationProperties.Name="{x:Static res:Strings.Field}"
                  Classes="form"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FieldOptions}"
                  SelectedItem="{Binding Field}" />
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="{x:Static res:Strings.Recipient}" />
        <TextBox x:Name="Recipient" AutomationProperties.Name="{x:Static res:Strings.Recipient}"
                 Classes="form"
                 Text="{Binding Recipient}"
                 MaxLength="128"
                 PlaceholderText="{x:Static res:Strings.ForYourListOnlyNeverSent}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,10,*">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Expires}" />
          <ListBox x:Name="Expires" AutomationProperties.Name="{x:Static res:Strings.Expires}"
                   Classes="segmented choice"
                   ItemsSource="{Binding TtlChoices}"
                   SelectedItem="{Binding Ttl}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding Converter={x:Static vm:SharingViewModel.TtlInWords}}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Classes="label" Text="{x:Static res:Strings.Views}" />
          <ListBox x:Name="Views" AutomationProperties.Name="{x:Static res:Strings.Views}"
                   Classes="segmented choice"
                   ItemsSource="{Binding ViewChoices}"
                   SelectedItem="{Binding Views}" />
        </StackPanel>
      </Grid>

      <CheckBox x:Name="RequirePassphrase"
                Classes="passphrase"
                IsChecked="{Binding RequirePassphrase}"
                Content="{x:Static res:Strings.RequireAPassphraseSentSeparately}" />

      <StackPanel Spacing="6" IsVisible="{Binding RequirePassphrase}">
        <ctl:MaskedInput x:Name="SharePassphrase"
                         MinHeight="34"
                         Height="34"
                         Classes="size-14"
                         AllowsPaste="True"
                         Sink="{Binding Passphrase}"
                         MaskedLength="{Binding Passphrase.MaskedLength}"
                         Placeholder="{x:Static res:Strings.AtLeast20CharactersSuchAsSixGeneratedWords}" />
        <TextBlock Classes="caption"
                   Text="{x:Static res:Strings.NotStoredSendItAnotherWayThanXdd068f}" />
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Button x:Name="CancelShare"
                Classes="ghost lg"
                Content="{x:Static res:Strings.Cancel}"
                Command="{Binding CancelCommand}" />
        <Button x:Name="CreateLink"
                Grid.Column="1"
                Classes="primary lg"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding CreateCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CreateAndCopyLink}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="link" Size="14" IsVisible="{Binding !CreateCommand.IsRunning}" />
            <ctl:KpIcon Icon="refresh-cw" Size="14" IsVisible="{Binding CreateCommand.IsRunning}" Classes.spinning="{Binding CreateCommand.IsRunning}" />
            <TextBlock Text="{x:Static res:Strings.CreateAndCopyLink}" IsVisible="{Binding !CreateCommand.IsRunning}" />
            <TextBlock Text="{x:Static res:Strings.CreatingLink}" IsVisible="{Binding CreateCommand.IsRunning}" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsUnavailable}">
        <Border Grid.Column="0" Classes="dot" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1"
                   x:Name="Unavailable"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding Unavailable}" />
        <Button Grid.Column="2"
                Classes="link"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding CanRetry}"
                Content="{x:Static res:Strings.TryAgain}"
                Command="{Binding RetryCommand}" />
      </Grid>

      <TextBlock x:Name="ShareError"
                 Classes="caption danger"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}"
                 ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" />
    </StackPanel>
  </Border>
  </Panel>
</UserControl>
