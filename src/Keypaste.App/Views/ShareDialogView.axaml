<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             x:Class="Keypaste.App.Views.ShareDialogView"
             x:DataType="vm:SharingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox.form, ComboBox.form">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="TextBox.form">
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="ListBox.choice">
      <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem">
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The design's 16px check: amber with an ink tick when on, a hairline square when off. -->
    <Style Selector="CheckBox.passphrase">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
            <Border Name="Box"
                    Width="16" Height="16"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource KpBorderStrong}"
                    Background="{DynamicResource KpBgApp}"
                    VerticalAlignment="Center">
              <ctl:KpIcon Name="Tick" Icon="check" Size="12" IsVisible="False"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource KpOnAccent}" />
            </Border>
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"
                              FontSize="13"
                              Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.passphrase:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource KpAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpAccent}" />
    </Style>
    <Style Selector="CheckBox.passphrase:checked /template/ ctl|KpIcon#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.passphrase:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource KpAccentHover}" />
    </Style>
    <Style Selector="CheckBox.passphrase:focus-visible /template/ Border#Box">
      <Setter Property="BoxShadow" Value="{StaticResource KpFieldGlow}" />
    </Style>
  </UserControl.Styles>

  <!-- Share…, from an item's ⋯ menu. The link it makes goes to the clipboard and nowhere else on screen. -->
  <Border Name="ShareDialog"
          Classes="dialog"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="14">

      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:KpIcon Grid.Column="0" Icon="link" Size="16" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="Share a link" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="CloseShare"
                Classes="icon ghost sm"
                ToolTip.Tip="Cancel"
                AutomationProperties.Name="Cancel"
                Command="{Binding CancelCommand}">
          <ctl:KpIcon Icon="x" Size="15" />
        </Button>
      </Grid>

      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 Text="End-to-end encrypted. The key lives in the link itself, so the relay never sees it." />

      <Grid ColumnDefinitions="*,10,112" RowDefinitions="Auto,6,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="What" />
        <Border Grid.Row="2" Grid.Column="0"
                Height="34"
                Padding="10,0"
                CornerRadius="{DynamicResource KpRadiusField}"
                Background="{DynamicResource KpBgApp}"
                BorderBrush="{DynamicResource KpBorderDefault}"
                BorderThickness="1">
          <TextBlock Name="ShareWhat"
                     Classes="mono"
                     FontSize="12.5"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding SelectedWhat}"
                     ToolTip.Tip="{Binding SelectedWhat}" />
        </Border>
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="Field" />
        <ComboBox Grid.Row="2" Grid.Column="2"
                  x:Name="ShareField"
                  Classes="form"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding FieldOptions}"
                  SelectedItem="{Binding Field}" />
      </Grid>

      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="Recipient" />
        <TextBox x:Name="Recipient"
                 Classes="form"
                 Text="{Binding Recipient}"
                 MaxLength="128"
                 PlaceholderText="For your list only; never sent" />
      </StackPanel>

      <Grid ColumnDefinitions="*,10,*">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Classes="label" Text="Expires" />
          <ListBox x:Name="Expires"
                   Classes="segmented choice"
                   ItemsSource="{Binding TtlChoices}"
                   SelectedItem="{Binding Ttl}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Classes="label" Text="Views" />
          <ListBox x:Name="Views"
                   Classes="segmented choice"
                   ItemsSource="{Binding ViewChoices}"
                   SelectedItem="{Binding Views}" />
        </StackPanel>
      </Grid>

      <CheckBox x:Name="RequirePassphrase"
                Classes="passphrase"
                IsChecked="{Binding RequirePassphrase}"
                Content="Require a passphrase, sent separately" />

      <StackPanel Spacing="6" IsVisible="{Binding RequirePassphrase}">
        <ctl:MaskedInput x:Name="SharePassphrase"
                         MinHeight="34"
                         Height="34"
                         FontSize="14"
                         AllowsPaste="True"
                         Sink="{Binding Passphrase}"
                         MaskedLength="{Binding Passphrase.MaskedLength}"
                         Placeholder="Passphrase, at least 20 characters, such as six generated words" />
        <TextBlock Classes="caption"
                   Text="Not stored. Send it another way than the link." />
      </StackPanel>

      <Button x:Name="CreateLink"
              Classes="primary lg"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ctl:KpIcon Icon="link" Size="14" />
          <TextBlock Text="Create and copy link" />
        </StackPanel>
      </Button>

      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsUnavailable}">
        <Border Grid.Column="0" Classes="dot" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1"
                   x:Name="Unavailable"
                   Classes="caption"
                   TextWrapping="Wrap"
                   Text="{Binding Unavailable}" />
        <Button Grid.Column="2"
                Classes="link"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding CanRetry}"
                Content="Try again"
                Command="{Binding RetryCommand}" />
      </Grid>

      <TextBlock x:Name="ShareError"
                 Classes="caption danger"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}"
                 Text="{Binding Error}" />
    </StackPanel>
  </Border>
</UserControl>
