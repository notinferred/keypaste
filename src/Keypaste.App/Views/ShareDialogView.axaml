<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.ShareDialogView"
             x:DataType="vm:SharingViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.choice">
      <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.choice > ListBoxItem">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

  </UserControl.Styles>

  <!-- Share…, from an item's ⋯ menu. The link it makes goes to the clipboard and nowhere else on screen. -->
  <Border Name="ShareDialog"
          Classes="dialog"
          ctl:FormKeys.Confirm="{Binding CreateCommand}"
          ctl:FormKeys.Cancel="{Binding CancelCommand}"
          ctl:FormKeys.Draft="{Binding Draft}"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <!-- The form scrolls under zoom; its actions and what they report stay in reach. -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
        <!-- Why no link was made, above the actions on the danger tint; where trying again could help, the primary is Try again. -->
        <Border Classes="group padded" Background="{DynamicResource KpDangerTint}" IsVisible="{Binding IsUnavailable}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ctl:KpIcon Icon="alert-triangle" Size="14" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource KpDanger}" />
            <TextBlock Grid.Column="1"
                       x:Name="Unavailable"
                       Classes="size-13"
                       TextWrapping="Wrap"
                       ctl:Announcer.Says="{Binding Unavailable}"
                       Text="{Binding Unavailable}" />
          </Grid>
        </Border>

        <Border Classes="group padded" Background="{DynamicResource KpDangerTint}" IsVisible="{Binding HasError}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ctl:KpIcon Icon="alert-triangle" Size="14" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource KpDanger}" />
            <TextBlock Grid.Column="1"
                       x:Name="ShareError"
                       Classes="size-13"
                       TextWrapping="Wrap"
                       ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <Button x:Name="CancelShare"
                  Classes="ghost lg"
                  Content="{x:Static res:Strings.Cancel}"
                  Command="{Binding CancelCommand}" />
          <Button Classes.busy="{Binding CreateCommand.IsRunning}" x:Name="CreateLink"
                  Grid.Column="1"
                  Classes="primary lg"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsVisible="{Binding !CanRetry}"
                  Command="{Binding CreateCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.CreateAndCopyLink}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:KpIcon Icon="link" Size="14" IsVisible="{Binding !CreateCommand.IsRunning}" />
              <ctl:KpIcon Icon="refresh-cw" Size="14" IsVisible="{Binding CreateCommand.IsRunning}" Classes.spinning="{Binding CreateCommand.IsRunning}" />
              <TextBlock Text="{x:Static res:Strings.CreateAndCopyLink}" IsVisible="{Binding !CreateCommand.IsRunning}" />
              <TextBlock Text="{x:Static res:Strings.CreatingLink}" IsVisible="{Binding CreateCommand.IsRunning}" />
            </StackPanel>
          </Button>
          <Button x:Name="RetryShare"
                  Grid.Column="1"
                  Classes="primary lg"
                  Classes.busy="{Binding RetryCommand.IsRunning}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  IsVisible="{Binding CanRetry}"
                  Content="{x:Static res:Strings.TryAgain}"
                  Command="{Binding RetryCommand}" />
        </Grid>
      </StackPanel>
      <!-- The margins leave a focused field its glow and the scroll bar the dialog's edge. -->
      <ScrollViewer Margin="-4,-4,-12,-4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,12,4" Spacing="12">

          <Grid ColumnDefinitions="Auto,*,Auto">
            <ctl:KpIcon Grid.Column="0" Icon="link" Size="16" Margin="0,0,8,0" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.ShareALink}" VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Name="CloseShare"
                    Classes="icon ghost sm"
                    ToolTip.Tip="{x:Static res:Strings.Cancel}"
                    AutomationProperties.Name="{x:Static res:Strings.Cancel}"
                    Command="{Binding CancelCommand}">
              <ctl:KpIcon Icon="x" Size="16" />
            </Button>
          </Grid>

          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Text="{x:Static res:Strings.EndToEndEncryptedTheKeyLivesX3e20ff}" />

          <!-- The item the link carries, fixed, as its tile and title, and which of its fields. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <ctl:Monogram Title="{Binding ItemTitle}" Id="{Binding ItemHue}" Size="30" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Name="ShareWhat"
                       Classes="row-title"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ItemTitle}"
                       ToolTip.Tip="{Binding SelectedWhat}" />
            <TextBlock Grid.Column="2" Classes="label" VerticalAlignment="Center" Text="{x:Static res:Strings.Field}" />
            <ComboBox Grid.Column="3"
                      x:Name="ShareField" AutomationProperties.Name="{x:Static res:Strings.Field}"
                      MinWidth="112"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding FieldOptions}"
                      SelectedItem="{Binding Field}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding Converter={x:Static vm:SharingViewModel.FieldInWords}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <!-- A recipient is a name for the person's own list of links, never sent, so it waits behind a disclosure. -->
          <StackPanel Spacing="6">
            <ToggleButton x:Name="AddRecipient"
                          Classes="ghost sm"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{x:Static res:Strings.Recipient}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-right" Size="14" IsVisible="{Binding !#AddRecipient.IsChecked}" />
                <ctl:KpIcon Icon="chevron-down" Size="14" IsVisible="{Binding #AddRecipient.IsChecked}" />
                <TextBlock Text="{x:Static res:Strings.Recipient}" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <TextBox x:Name="Recipient" AutomationProperties.Name="{x:Static res:Strings.Recipient}"
                     IsVisible="{Binding #AddRecipient.IsChecked}"
                     ToolTip.Tip="{x:Static res:Strings.ForYourListOnlyNeverSent}"
                     Text="{Binding Recipient}"
                     MaxLength="128" />
          </StackPanel>

          <Grid ColumnDefinitions="*,10,*">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Classes="label" Text="{x:Static res:Strings.Expires}" />
              <ListBox x:Name="Expires" AutomationProperties.Name="{x:Static res:Strings.Expires}"
                       Classes="segmented choice"
                       ItemsSource="{Binding TtlChoices}"
                       SelectedItem="{Binding Ttl}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding Converter={x:Static vm:SharingViewModel.TtlInWords}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Classes="label" Text="{x:Static res:Strings.Views}" />
              <ListBox x:Name="Views" AutomationProperties.Name="{x:Static res:Strings.Views}"
                       Classes="segmented choice"
                       ItemsSource="{Binding ViewChoices}"
                       SelectedItem="{Binding Views}" />
            </StackPanel>
          </Grid>

          <CheckBox x:Name="RequirePassphrase"
                    IsChecked="{Binding RequirePassphrase}"
                    Content="{x:Static res:Strings.RequireAPassphraseSentSeparately}" />

          <StackPanel Spacing="6" IsVisible="{Binding RequirePassphrase}">
            <TextBlock Classes="label" Text="{x:Static res:Strings.Passphrase}" />
            <ctl:MaskedInput x:Name="SharePassphrase"
                             Classes="size-14"
                             AllowsPaste="True"
                             Sink="{Binding Passphrase}"
                             MaskedLength="{Binding Passphrase.MaskedLength}"
                             ToolTip.Tip="{x:Static res:Strings.NotStoredSendItAnotherWayThanXdd068f}"
                             AutomationProperties.Name="{x:Static res:Strings.Passphrase}" />
            <TextBlock Classes="caption"
                       Text="{x:Static res:Strings.AtLeast20CharactersSuchAsSixGeneratedWords}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
