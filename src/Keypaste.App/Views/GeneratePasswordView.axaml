<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.GeneratePasswordView"
             x:DataType="vm:GeneratePasswordViewModel"
             IsVisible="False">

  <!-- The one generator, as a small sheet over the window wherever a password is made: a form's field, whose value changes only on Apply,
       or Generate password… on its own, for a password to copy, start an item with or add to the chosen item as a field. -->
  <Border Classes="backdrop" Padding="24">
    <Border Name="GenerateDialog"
            Classes="dialog"
            KeyboardNavigation.TabNavigation="Cycle"
            Width="400"
            MaxWidth="400"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <views:GeneratorPanel />
      </ScrollViewer>
    </Border>
  </Border>

</UserControl>
