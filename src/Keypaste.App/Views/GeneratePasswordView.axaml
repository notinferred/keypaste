<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.GeneratePasswordView"
             x:DataType="vm:GeneratePasswordViewModel">

  <!-- Generate password…, from File and Items' New menu: the generator's panel on its own, for a password to copy,
       start an item with or add to the chosen item as a field. -->
  <Border Name="GenerateDialog"
          Classes="dialog"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <views:GeneratorPanel />
    </ScrollViewer>
  </Border>

</UserControl>
