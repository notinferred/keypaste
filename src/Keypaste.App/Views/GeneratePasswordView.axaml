<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.GeneratePasswordView"
             x:DataType="vm:GeneratePasswordViewModel">

  <UserControl.Styles>
    <!-- The Value field's box, as the item pane draws it. -->
    <Style Selector="Border.value">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,4,4,4" />
      <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusField}" />
    </Style>
  </UserControl.Styles>

  <!-- Generate password…, from File and Items' New menu (V.12): a password to copy, start an item with or add to the
       chosen item as a field. The value is drawn only while revealed, as every secret is. -->
  <Border Name="GenerateDialog"
          Classes="dialog"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="14">

      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:KpIcon Grid.Column="0" Icon="wand-2" Size="16" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="{x:Static res:Strings.GenerateAPassword}" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="CloseGenerator"
                Classes="icon ghost sm"
                ToolTip.Tip="{x:Static res:Strings.Close}"
                AutomationProperties.Name="{x:Static res:Strings.Close}"
                Command="{Binding CancelCommand}">
          <ctl:KpIcon Icon="x" Size="15" />
        </Button>
      </Grid>

      <views:GeneratorOptions DataContext="{Binding Generator}" />

      <Border Classes="value">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
          <ctl:RevealedValue Grid.Column="0"
                             Name="GeneratedValue"
                             Source="{Binding}"
                             MaskedLength="{Binding MaskedLength}"
                             AutomationProperties.Name="{x:Static res:Strings.ThePassword}"
                             FontFamily="{DynamicResource KpMono}"
                             VerticalAlignment="Center"
                             ClipToBounds="True"
                             Foreground="{DynamicResource KpTextPrimary}" />
          <ctl:RevealButton Grid.Column="1"
                            Name="RevealGenerated"
                            Classes="ghost sm"
                            VerticalAlignment="Center"
                            Target="{Binding #GeneratedValue}"
                            ShowsWord="True"
                            Subject="{x:Static res:Strings.ThePasswordAsAnObject}" />
          <Button Grid.Column="2"
                  Name="Regenerate"
                  Classes="icon ghost sm"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{x:Static res:Strings.GenerateAnother}"
                  AutomationProperties.Name="{x:Static res:Strings.GenerateAnother}"
                  Command="{Binding RegenerateCommand}">
            <ctl:KpIcon Icon="refresh-cw" Size="14" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding CanAddField}">
        <TextBlock Classes="label" Text="{Binding Item, StringFormat={x:Static res:Strings.AddToValueAsAField}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Name="GeneratedFieldName"
                   Classes="mono"
                   Width="260"
                   PlaceholderText="API_KEY"
                   AutomationProperties.Name="{x:Static res:Strings.FieldName}"
                   Text="{Binding FieldName}" />
          <Button Name="AddGeneratedField" Content="{x:Static res:Strings.AddAsAField}" Command="{Binding AddFieldCommand}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="{x:Static res:Strings.CopyPutsItOnTheClipboardWhichX66e478}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="CancelGenerator" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
        <Button Name="GeneratedNewItem" Content="{x:Static res:Strings.NewItemLabel}" AutomationProperties.Name="{x:Static res:Strings.NewItem}" Command="{Binding NewItemCommand}" />
        <Button Name="CopyGenerated" Classes="primary" Content="{x:Static res:Strings.Copy}" Command="{Binding CopyCommand}" />
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
