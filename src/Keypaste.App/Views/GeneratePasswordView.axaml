<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.GeneratePasswordView"
             x:DataType="vm:GeneratePasswordViewModel">

  <UserControl.Styles>
    <!-- The Value field's box, as the item pane draws it. -->
    <Style Selector="Border.value">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,4,4,4" />
      <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusField}" />
    </Style>
  </UserControl.Styles>

  <!-- Generate password…, from File and Items' New menu (V.12): a password to copy, start an item with or add to the
       chosen item as a field. The value is drawn only while Reveal is held, as every secret is (D-0232). -->
  <Border Name="GenerateDialog"
          Classes="dialog"
          KeyboardNavigation.TabNavigation="Cycle"
          Width="440"
          MaxWidth="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
    <StackPanel Spacing="14">

      <Grid ColumnDefinitions="Auto,*,Auto">
        <ctl:KpIcon Grid.Column="0" Icon="wand-2" Size="16" Margin="0,0,10,0" Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Grid.Column="1" Classes="dialog-title" Text="Generate a password" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Name="CloseGenerator"
                Classes="icon ghost sm"
                ToolTip.Tip="Close"
                AutomationProperties.Name="Close"
                Command="{Binding CancelCommand}">
          <ctl:KpIcon Icon="x" Size="15" />
        </Button>
      </Grid>

      <views:GeneratorOptions DataContext="{Binding Generator}" />

      <Border Classes="value">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
          <ctl:RevealedValue Grid.Column="0"
                             Name="GeneratedValue"
                             Source="{Binding}"
                             MaskedLength="{Binding MaskedLength}"
                             AutomationProperties.Name="Hold to reveal the password"
                             FontFamily="{DynamicResource KpMono}"
                             FontSize="14"
                             VerticalAlignment="Center"
                             ClipToBounds="True"
                             Foreground="{DynamicResource KpTextPrimary}" />
          <ctl:RevealButton Grid.Column="1"
                            Name="RevealGenerated"
                            Classes="ghost sm"
                            VerticalAlignment="Center"
                            Target="{Binding #GeneratedValue}"
                            ToolTip.Tip="Hold to reveal"
                            AutomationProperties.Name="Reveal the password">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:KpIcon Icon="eye" Size="14" />
              <TextBlock Text="Reveal" VerticalAlignment="Center" />
            </StackPanel>
          </ctl:RevealButton>
          <Button Grid.Column="2"
                  Name="Regenerate"
                  Classes="icon ghost sm"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Generate another"
                  AutomationProperties.Name="Generate another"
                  Command="{Binding RegenerateCommand}">
            <ctl:KpIcon Icon="refresh-cw" Size="14" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Spacing="8" IsVisible="{Binding CanAddField}">
        <TextBlock Classes="label" Text="{Binding Item, StringFormat='Add to {0} as a field'}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Name="GeneratedFieldName"
                   Classes="mono"
                   Width="260"
                   PlaceholderText="FIELD_NAME"
                   AutomationProperties.Name="Field name"
                   Text="{Binding FieldName}" />
          <Button Name="AddGeneratedField" Content="Add as a field" Command="{Binding AddFieldCommand}" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="Copy puts it on the clipboard, which clears itself. New item starts one with this password." />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="CancelGenerator" Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Name="GeneratedNewItem" Content="New item" Command="{Binding NewItemCommand}" />
        <Button Name="CopyGenerated" Classes="primary" Content="Copy" Command="{Binding CopyCommand}" />
      </StackPanel>

    </StackPanel>
  </Border>

</UserControl>
