<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.ItemPickWindow"
                    x:DataType="vm:ItemPickViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent is asking for a credential"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card where more than one item answers to the agent's name: the question, the agent's words, then the items for
       the person to pick one, and nothing is picked for them. The list is as tall as its items up to its most and scrolls past
       that; the agent's words keep a fixed height and scroll (THREATS.md T-2). Return presses Allow once only once an item is
       picked and the card is armed; Escape denies. -->

  <Border Classes="claim" Classes.arming="{Binding IsArming}">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <StackPanel Spacing="4">
          <TextBlock Name="TitleText" Classes="claim-title size-15">
            <Run Text="Give " /><Run Text="{Binding Agent}" /><Run Text="{Binding Asked}" /><Run Classes="claim-name size-15" Text="{Binding Key}" /><Run Text="?" />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
            <ctl:KpIcon Classes="claim-muted" Icon="key" Size="14" VerticalAlignment="Center" />
            <TextBlock Name="ItemText" Classes="claim-muted size-13" Text="{Binding Item}" MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Name="SaysText" Classes="claim-label size-11" Text="{Binding SaysLabel}" Background="Transparent" ToolTip.Tip="{Binding QuoteNote}" />
            <Border Classes="claim-quote">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DockPanel Classes="claim-quote-text">
                  <Border Classes="claim-quote-bar" />
                  <TextBlock Name="ReasonText" Classes="size-13" Text="{Binding Quoted}" />
                </DockPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Name="SendWhichText" Classes="section-heading" Text="Send which?" />
            <Border Classes="claim-block" MaxHeight="164" Padding="4">
              <ListBox Name="Candidates" ItemsSource="{Binding Rows}" SelectedItem="{Binding Picked}" SelectionMode="Single"
                       Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Items that answer to this name">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickRow">
                    <DockPanel Height="44" AutomationProperties.Name="{Binding Spoken}">
                      <ctl:KpIcon DockPanel.Dock="Right" Classes="claim-muted" Icon="lock" Size="14" VerticalAlignment="Center"
                                  IsVisible="{Binding Protected}" ToolTip.Tip="Protected &#x00B7; asked every time" />
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="row-title" Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="claim-muted size-13" Text="{Binding Details}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </StackPanel>

          <TextBlock Name="ConsequenceText" Classes="claim-line size-13" Text="{Binding Consequence}" />

          <!-- Held open while any item is protected, so picking one moves nothing. -->
          <Panel Height="20" IsVisible="{Binding AnyProtected}">
            <StackPanel Name="ProtectedLine" Orientation="Horizontal" Spacing="6" IsVisible="{Binding PickedIsProtected}">
              <ctl:KpIcon Classes="claim-muted" Icon="lock" Size="14" VerticalAlignment="Center" />
              <TextBlock Classes="claim-line size-13" Text="Protected &#x00B7; asked every time" VerticalAlignment="Center" />
            </StackPanel>
          </Panel>

            <StackPanel Spacing="8">
              <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                  <TextBlock Classes="size-13" Text="Details" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <Grid Classes="claim-facts size-13" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="12" RowSpacing="4" Margin="20,0,0,0" IsVisible="{Binding #DetailsToggle.IsChecked}">
                <TextBlock Grid.Row="0" Classes="fact" Text="Tool" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding Tool}" />
                <TextBlock Grid.Row="1" Classes="fact" Text="Label" />
                <TextBlock Grid.Row="1" Grid.Column="1" Name="LabelText" Text="{Binding Label}" />
                <TextBlock Grid.Row="2" Classes="fact" Text="Asked for" />
                <TextBlock Grid.Row="2" Grid.Column="1" Name="EntryText" Classes="mono" Text="{Binding Entry}" />
                <TextBlock Grid.Row="3" Classes="fact" Text="Calls itself" />
                <TextBlock Grid.Row="3" Grid.Column="1" Name="ClientText" Text="{Binding Client}" />
                <TextBlock Grid.Row="4" Classes="fact" Text="Process" />
                <TextBlock Grid.Row="4" Grid.Column="1" Name="ProcessText" Classes="mono" Text="{Binding Process}" />
                <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Name="NoAlwaysText" Text="{Binding NoAlways}"
                           IsVisible="{Binding NoAlways, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </Grid>
            </StackPanel>
        </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc" Command="{Binding DenyCommand}" />
        <Button Name="AlwaysAllow" Classes="claim" Content="Always allow" ToolTip.Tip="{Binding AlwaysTip}"
                IsVisible="{Binding OffersAlways}" Command="{Binding AlwaysAllowCommand}" />
        <Button Name="AllowOnce" Classes="claim keyed primary" Content="Allow once" Tag="&#x21A9;" Command="{Binding AllowOnceCommand}" />
      </StackPanel>
      <ProgressBar Name="TimeBar" Classes="claim-time" Value="{Binding TimeLeft}" AutomationProperties.Name="{Binding DeniesIn}" />
    </StackPanel>
  </Border>

</views:PromptWindow>
