<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.LockedNoticeWindow"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent asked for a locked vault"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    ShowActivated="False">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Said when an agent asks while the app is locked. The bridge sends nothing, so the vault is named from this computer's
       own settings. It has no field and does not take focus, so typing meant for another window reaches nothing here; Close is
       its default for Return and Escape, and Unlock… is armed only after a moment. It wears the claim card with keypaste's
       wordmark and no requester line: keypaste says it, and no agent is named. -->

  <Border Name="Card" Classes="claim arming">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <ctl:BrandWordmark Height="13" HorizontalAlignment="Left" />

        <StackPanel Spacing="4">
          <TextBlock Name="HeadText" Classes="claim-title size-15" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="NoticeText" Classes="claim-line size-13" Text="An agent's request was refused. Unlock to let agents ask." />
        </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Dismiss" Classes="claim keyed" Content="Close" Tag="esc" IsCancel="True" IsDefault="True" />
        <Button Name="Open" Classes="claim primary" Content="Unlock&#x2026;" AutomationProperties.Name="Unlock&#x2026;" IsEnabled="False" />
      </StackPanel>
    </StackPanel>
  </Border>

</views:PromptWindow>
