<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.EntriesView"
             x:DataType="vm:EntriesViewModel">

  <UserControl.Resources>
    <views:DepthToIndent x:Key="Indent" />
    <views:HistoryToPaneWidth x:Key="PaneWidth" />
  </UserControl.Resources>

  <!-- The columns move when a revision is being compared: the group tree steps aside so the detail
       pane can show a revision's fields beside the current ones. Both outer columns are Auto, so
       what moves them is the pane's width and the tree's visibility. -->
  <Grid RowDefinitions="Auto,*">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <!-- The dividers' columns are Auto so their margins separate the panes rather than overlap them. -->
      <ColumnDefinition Width="Auto" />
      <!-- The main window's MinWidth is what keeps this column's minimum beside the tree and pane. -->
      <ColumnDefinition Width="*" MinWidth="100" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- The group tree. A flat, indented ListBox rather than a TreeView: arrow keys, Home/End and
         type-ahead work for free, and a vault three groups deep does not need expand state. -->
    <TextBlock Grid.Row="0" Grid.Column="0"
               Text="Groups"
               Width="180"
               FontSize="11"
               Margin="0,0,0,8"
               IsVisible="{Binding !Detail.History.IsOpen}"
               Foreground="{DynamicResource KpTextMuted}" />

    <Grid Grid.Row="1" Grid.Column="0"
          Width="180"
          RowDefinitions="*,Auto"
          IsVisible="{Binding !Detail.History.IsOpen}">

      <ListBox Grid.Row="0"
               Name="Groups"
               ItemsSource="{Binding Groups}"
               SelectedItem="{Binding SelectedGroup}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GroupNode">
            <TextBlock Text="{Binding Label}"
                       Margin="{Binding Depth, Converter={StaticResource Indent}}"
                       TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- A group is a thing on the tree, so its controls are where the tree is. New makes a child
           of whatever is selected, or a top-level group under "All entries"; Rename is unavailable
           there, because the root is not a group somebody named. -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button x:Name="NewGroup" Content="New group" FontSize="11"
                Command="{Binding BeginCreateGroupCommand}" />
        <Button x:Name="RenameGroup" Content="Rename" FontSize="11"
                Command="{Binding BeginRenameGroupCommand}" />
      </StackPanel>

    </Grid>

    <Rectangle Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
               x:Name="TreeDivider"
               Width="1" Fill="{DynamicResource KpBorderSubtle}" Margin="12,0"
               IsVisible="{Binding !Detail.History.IsOpen}" />

    <!-- The toolbar spans the list and the entry's pane, since the list's column alone is narrower
         than its buttons once an entry is open (F.22). -->
    <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBox Grid.Column="0"
               Name="Search"
               Text="{Binding Search}"
               PlaceholderText="Search entries"
               BorderThickness="1" />
      <Button Grid.Column="1" x:Name="AddEntry" Content="Add" Margin="8,0,0,0" Command="{Binding BeginAddCommand}" />
      <Button Grid.Column="2" x:Name="Organize" Content="Organize" Margin="8,0,0,0"
              Command="{Binding OrganizeCommand}" />
      <Button Grid.Column="3" x:Name="DeleteEntry" Content="Delete" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
    </Grid>

    <!-- The list. Titles and groups, and nothing from inside an entry: see EntryRow. -->
    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">

      <!-- What the last deletion did, and the way back for the one still on screen. Every other
           recovery is on Trash, which is where this one goes once the screen moves on. -->
      <Border Grid.Row="0"
              IsVisible="{Binding HasNotice}"
              Background="{DynamicResource KpAccentQuiet}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12,8"
              Margin="0,0,0,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding Notice}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource KpTextSecondary}" />
          <Button Grid.Column="1"
                  Content="Restore"
                  Margin="8,0,0,0"
                  IsVisible="{Binding CanUndoDelete}"
                  Command="{Binding UndoDeleteCommand}" />
        </Grid>
      </Border>

      <!-- Calm, not a dialog. KpDanger is reserved for the destructive confirmation. -->
      <Border Grid.Row="1"
              IsVisible="{Binding HasError}"
              Background="{DynamicResource KpAccentQuiet}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12,8"
              Margin="0,0,0,8">
        <TextBlock Text="{Binding Error}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource KpTextSecondary}" />
      </Border>

      <!-- The one place KpDanger appears on this screen. What the deletion costs depends on the
           vault: DeletePrompt reads its recycle-bin setting and says which case this is. -->
      <Border Grid.Row="2"
              IsVisible="{Binding IsConfirmingDelete}"
              BorderBrush="{DynamicResource KpDanger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding DeletePrompt}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextPrimary}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                    Foreground="{DynamicResource KpDanger}" />
            <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              IsVisible="{Binding IsAdding}"
              Background="{DynamicResource KpSurface2}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBox Text="{Binding NewEntryPath}" PlaceholderText="servers/production" />
          <CheckBox Content="Generate a password" IsChecked="{Binding GeneratePassword}" />
          <StackPanel Spacing="4" IsVisible="{Binding GeneratePassword}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <RadioButton GroupName="NewEntrySecretKind" Content="Characters" IsChecked="{Binding Generator.UseCharacters}" />
              <RadioButton GroupName="NewEntrySecretKind" Content="Words" IsChecked="{Binding Generator.UseWords}" />
              <NumericUpDown Width="104"
                             IsVisible="{Binding Generator.UseWords}"
                             Minimum="{Binding Generator.MinimumWords}"
                             Maximum="{Binding Generator.MaximumWords}"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding Generator.WordCount}" />
              <TextBox Width="44"
                       MaxLength="1"
                       IsVisible="{Binding Generator.UseWords}"
                       Text="{Binding Generator.Separator}" />
            </StackPanel>
            <TextBlock FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource KpTextMuted}"
                       Text="{Binding Generator.Strength}" />
            <TextBlock FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Generator.UseWords}"
                       Foreground="{DynamicResource KpTextMuted}"
                       Text="{Binding Generator.Provenance}" />
            <TextBlock FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Generator.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource KpTextSecondary}"
                       Text="{Binding Generator.Error}" />
          </StackPanel>
          <ctl:MaskedInput x:Name="NewEntryPassword"
                           IsVisible="{Binding !GeneratePassword}"
                           AllowsPaste="True"
                           Sink="{Binding NewPassword}"
                           MaskedLength="{Binding NewPassword.MaskedLength}"
                           Placeholder="Existing password" />
          <TextBlock FontSize="11"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !GeneratePassword}"
                     Foreground="{DynamicResource KpTextMuted}"
                     Text="Type it or press Ctrl/Cmd+V to paste. Leave it empty for an entry with no password." />
          <TextBlock FontSize="11"
                     TextWrapping="Wrap"
                     IsVisible="{Binding NewPassword.Note.Length}"
                     Foreground="{DynamicResource KpTextMuted}"
                     Text="{Binding NewPassword.Note}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Create" Command="{Binding ConfirmAddCommand}" />
            <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Renaming and moving on one form, behind one Save. The two are a single core write
           (Vault.Relocate), and splitting them into two submits would let a rename commit in the
           open vault while the move beside it was refused, for the next save to write out. -->
      <Border Grid.Row="2"
              IsVisible="{Binding IsOrganizing}"
              Background="{DynamicResource KpSurface2}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding OrganizePrompt}"
                     FontSize="11"
                     FontFamily="{DynamicResource KpMono}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource KpTextMuted}" />
          <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
          <TextBox x:Name="OrganizeTitle" Text="{Binding DraftTitle}" />
          <TextBlock Text="Group" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
          <ComboBox x:Name="OrganizeGroup"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding MoveTargets}"
                    SelectedItem="{Binding MoveTarget}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GroupNode">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextMuted}"
                     Text="{Binding AccessNote}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OrganizeSave" Content="Save" Command="{Binding ConfirmOrganizeCommand}" />
            <Button Content="Cancel" Command="{Binding CancelOrganizeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              IsVisible="{Binding IsCreatingGroup}"
              Background="{DynamicResource KpSurface2}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding CreateGroupPrompt}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextMuted}" />
          <TextBox x:Name="NewGroupName" Text="{Binding DraftGroupName}" PlaceholderText="servers" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CreateGroup" Content="Create" Command="{Binding ConfirmCreateGroupCommand}" />
            <Button Content="Cancel" Command="{Binding CancelGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              IsVisible="{Binding IsRenamingGroup}"
              Background="{DynamicResource KpSurface2}"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding RenameGroupPrompt}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextMuted}" />
          <TextBox x:Name="RenameGroupName" Text="{Binding DraftGroupName}" />
          <TextBlock FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextMuted}"
                     Text="{Binding AccessNote}" />
          <!-- The specific case of the line above: renaming a project is also how the name
               `keypaste run` takes changes. -->
          <TextBlock x:Name="ProjectRenameNote"
                     FontSize="11" TextWrapping="Wrap"
                     IsVisible="{Binding ShowsProjectRenameNote}"
                     Foreground="{DynamicResource KpTextMuted}"
                     Text="{Binding ProjectRenameNote}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RenameGroupSave" Content="Rename" Command="{Binding ConfirmRenameGroupCommand}" />
            <Button Content="Cancel" Command="{Binding CancelGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <ListBox Grid.Row="3"
               Name="Rows"
               ItemsSource="{Binding Rows}"
               SelectedItem="{Binding Selected}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EntryRow">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
              <!-- When an agent last received it: amber in use, green recent, grey idle. A time, never a value. -->
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Margin="12,0,0,0"
                          IsVisible="{Binding LastUsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Border Classes="dot" Classes.warn="{Binding IsInUse}" Classes.ok="{Binding IsRecent}" Classes.idle="{Binding IsIdle}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding LastUsedText}" FontSize="11" FontFamily="{DynamicResource KpMono}"
                           Foreground="{DynamicResource KpTextMuted}" />
              </StackPanel>
              <!-- Why the row is in a result whose reason is nowhere else on it. A field name from
                   a fixed vocabulary; the value that matched is never drawn. -->
              <TextBlock Grid.Column="1"
                         Text="{Binding Why}"
                         FontSize="11"
                         Margin="12,0,0,0"
                         IsVisible="{Binding Why.Length}"
                         Foreground="{DynamicResource KpAccent}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding Where}"
                         FontSize="11"
                         Margin="12,0,0,0"
                         Foreground="{DynamicResource KpTextMuted}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </Grid>

    <Rectangle Grid.Row="1" Grid.Column="3"
               x:Name="PaneDivider"
               Width="1" Fill="{DynamicResource KpBorderSubtle}" Margin="12,0" />

    <!-- The detail pane. Username, URL and notes for the one entry somebody chose; the password is
         dots until its cell is held, and no binding here carries it (D-0300). -->
    <ContentControl Grid.Row="1" Grid.Column="4"
                    x:Name="EntryPane"
                    Width="{Binding Detail.History.IsOpen, Converter={StaticResource PaneWidth}}"
                    Content="{Binding Detail}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:EntryDetailViewModel">
          <ScrollViewer>
            <StackPanel Spacing="12">

              <StackPanel Spacing="2">
                <TextBlock x:Name="EntryTitle" Text="{Binding DisplayTitle}" FontSize="16"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource KpTextPrimary}" />
                <TextBlock Text="{Binding DisplayPath}" FontSize="11"
                           FontFamily="{DynamicResource KpMono}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource KpTextMuted}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <Grid ColumnDefinitions="*,Auto">
                  <ctl:RevealedValue Grid.Column="0"
                                     x:Name="CurrentPassword"
                                     Source="{Binding}"
                                     MaskedLength="{Binding MaskedLength}"
                                     AutomationProperties.Name="Hold to reveal the password"
                                     FontFamily="{DynamicResource KpMono}"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource KpTextSecondary}" />
                  <Button Grid.Column="1" x:Name="CopyPassword" Content="Copy"
                          Command="{Binding CopyPasswordCommand}" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayUsername}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource KpTextPrimary}" />
                  <Button Grid.Column="1" Content="Copy" Command="{Binding CopyUsernameCommand}" />
                </Grid>
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="URL" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Text="{Binding DisplayUrl}" TextWrapping="Wrap"
                           Foreground="{DynamicResource KpTextPrimary}" />
              </StackPanel>

              <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
                <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Text="{Binding DisplayNotes}" TextWrapping="Wrap"
                           Foreground="{DynamicResource KpTextPrimary}" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="8"
                          IsVisible="{Binding !IsEditing}">
                <Button Content="Edit" Command="{Binding EditCommand}" />
                <Button x:Name="RotateFromPane" Content="Rotate" Command="{Binding RotateCommand}" />
                <Button x:Name="OrganizeFromPane" Content="Rename or move"
                        Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OrganizeCommand}" />
              </StackPanel>

              <!-- Rotate asks first: the old value stays in history and the new one is never shown here. -->
              <StackPanel Spacing="6" IsVisible="{Binding IsConfirmingRotate}">
                <TextBlock Text="{Binding RotatePrompt}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource KpTextPrimary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ConfirmRotate" Content="Rotate" Command="{Binding ConfirmRotateCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelRotateCommand}" />
                </StackPanel>
              </StackPanel>

              <!-- Agent access: who received this entry and what grant covers it now, never a value. -->
              <Border Theme="{StaticResource KpCard}" IsVisible="{Binding !IsEditing}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Agent access" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                  <TextBlock x:Name="AgentAccessSummary" Text="{Binding AgentAccessSummary}" TextWrapping="Wrap"
                             Foreground="{DynamicResource KpTextPrimary}" />
                  <TextBlock Text="{Binding LastUsedText, StringFormat='last used {0}'}" FontSize="11"
                             FontFamily="{DynamicResource KpMono}" Foreground="{DynamicResource KpTextMuted}" />
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" IsVisible="{Binding !IsEditing}">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Created" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CreatedText" Text="{Binding Created}" FontSize="11"
                           FontFamily="{DynamicResource KpMono}" Foreground="{DynamicResource KpTextSecondary}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotated" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RotatedText" Text="{Binding Rotated}" FontSize="11"
                           FontFamily="{DynamicResource KpMono}" Foreground="{DynamicResource KpTextSecondary}" />
              </Grid>

              <!-- History. Read when the toggle asks for it, never on selection: one reading
                   materialises every superseded password (EntryHistoryViewModel). -->
              <StackPanel Spacing="8" IsVisible="{Binding !IsEditing}">

                <Button x:Name="HistoryToggle"
                        Content="{Binding History.ToggleLabel}"
                        Command="{Binding History.ToggleCommand}"
                        HorizontalAlignment="Left" />

                <StackPanel Spacing="8" IsVisible="{Binding History.IsOpen}">

                  <TextBlock x:Name="HistoryEmpty"
                             IsVisible="{Binding History.ShowsEmptyNote}"
                             Text="{Binding History.EmptyNote}"
                             TextWrapping="Wrap"
                             FontSize="11"
                             Foreground="{DynamicResource KpTextMuted}" />

                  <ListBox x:Name="Revisions"
                           MaxHeight="160"
                           ItemsSource="{Binding History.Rows}"
                           SelectedItem="{Binding History.Selected}"
                           Background="Transparent"
                           BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:EntryRevisionRow">
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Grid.Column="0"
                                     Text="{Binding When}"
                                     FontFamily="{DynamicResource KpMono}"
                                     FontSize="12"
                                     Foreground="{DynamicResource KpTextPrimary}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding DisplayTitle}"
                                     FontSize="12"
                                     Margin="12,0,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource KpTextMuted}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- The chosen revision beside the entry as it is now. Its password can be read
                       only while it is held, and copied as the current one is. -->
                  <Grid IsVisible="{Binding History.HasSelection}"
                        ColumnDefinitions="*,12,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding History.Selected.When}"
                               FontFamily="{DynamicResource KpMono}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource KpTextPrimary}" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Now"
                               FontSize="12"
                               Foreground="{DynamicResource KpTextPrimary}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Password" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource KpTextMuted}" />
                    <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="*,Auto">
                      <ctl:RevealedValue Grid.Column="0"
                                         x:Name="RevisionPassword"
                                         Source="{Binding History.Selected}"
                                         MaskedLength="{Binding History.Selected.MaskedLength}"
                                         AutomationProperties.Name="{Binding History.Selected.RevealLabel}"
                                         FontFamily="{DynamicResource KpMono}"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource KpTextSecondary}" />
                      <Button Grid.Column="1" x:Name="CopyRevisionPassword" Content="Copy"
                              Command="{Binding History.Selected.CopyPasswordCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="{Binding PasswordMask}"
                               FontFamily="{DynamicResource KpMono}"
                               Foreground="{DynamicResource KpTextSecondary}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Username" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource KpTextMuted}" />
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="{Binding History.Selected.DisplayUsername}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource KpTextPrimary}" />
                    <TextBlock Grid.Row="4" Grid.Column="2"
                               Text="{Binding DisplayUsername}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource KpTextPrimary}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="URL" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource KpTextMuted}" />
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="{Binding History.Selected.DisplayUrl}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource KpTextPrimary}" />
                    <TextBlock Grid.Row="6" Grid.Column="2"
                               Text="{Binding DisplayUrl}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource KpTextPrimary}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Notes" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource KpTextMuted}" />
                    <TextBlock Grid.Row="8" Grid.Column="0"
                               Text="{Binding History.Selected.DisplayNotes}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource KpTextPrimary}" />
                    <TextBlock Grid.Row="8" Grid.Column="2"
                               Text="{Binding DisplayNotes}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource KpTextPrimary}" />

                  </Grid>

                  <StackPanel Spacing="4" IsVisible="{Binding History.HasSelection}">
                    <Button x:Name="RestoreRevision"
                            Content="Restore this"
                            Command="{Binding History.RestoreCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource KpTextMuted}"
                               Text="Restoring makes these the entry's values. The ones it replaces are kept here." />
                  </StackPanel>

                </StackPanel>

              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                <TextBlock Text="Username" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBox Text="{Binding DraftUsername}" />
                <TextBlock Text="URL" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBox Text="{Binding DraftUrl}" />
                <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <TextBox Text="{Binding DraftNotes}" AcceptsReturn="True" MinHeight="80" />
                <TextBlock Text="Password" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                <ctl:MaskedInput x:Name="ReplacementPassword"
                                 AllowsPaste="True"
                                 Sink="{Binding NewPassword}"
                                 MaskedLength="{Binding NewPassword.MaskedLength}"
                                 Placeholder="New password" />
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource KpTextMuted}"
                           Text="Leave this empty to keep the current password. A replacement keeps the old one in this entry's history." />
                <TextBlock FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding NewPassword.Note.Length}"
                           Foreground="{DynamicResource KpTextMuted}"
                           Text="{Binding NewPassword.Note}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save" Command="{Binding SaveCommand}" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

  </Grid>

</UserControl>
