<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Keypaste.App"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.EntriesView"
             x:DataType="vm:EntriesViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="FieldReplaceGlyph"><ctl:KpIcon Icon="rotate-cw" Size="14" /></DataTemplate>
    <DataTemplate x:Key="FieldRemoveGlyph"><ctl:KpIcon Icon="trash-2" Size="14" /></DataTemplate>
    <DataTemplate x:Key="AttachmentSaveGlyph"><ctl:KpIcon Icon="download" Size="14" /></DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- A row's kind icon is muted until its row is selected. -->
    <Style Selector="ListBoxItem ctl|KpIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="ListBoxItem:selected ctl|KpIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>

    <Style Selector="ToggleButton.tree">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tree /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="ToggleButton.tree:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.tree:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>

    <!-- The small button inside a value field: Reveal. -->
    <Style Selector="Button.in-field">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.form">
      <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The destructive confirmation, the one place KpDanger appears on this screen. -->
    <Style Selector="Border.form.danger">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpDanger}" />
    </Style>

    <Style Selector="ToggleButton.tree:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
    </Style>

    <!-- A favorite's star takes the accent, as Mail's flag marks a message. -->
    <Style Selector="Button.favorite ctl|KpIcon">
      <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
    </Style>

    <!-- A note is one ink step up; amber stays for the action inside it. -->
    <Style Selector="Border.note">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusField}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.note.problem">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
    </Style>

  </UserControl.Styles>


  <!-- The list on the left and the chosen item on the right. -->
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8,8,8,0">

      <!-- What the last deletion did, and the way back for the one still on screen. Every other
           recovery is on Trash, which is where this one goes once the screen moves on. -->
      <Border Classes="note" IsVisible="{Binding HasNotice}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock ctl:MachineRuns.InText="True" Grid.Column="0"
                     ctl:Announcer.Says="{Binding Notice}" Text="{Binding Notice}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Classes="secondary size-13" />
          <Button Grid.Column="1"
                  Classes="link"
                  Content="{x:Static res:Strings.Restore}"
                  Margin="12,0,0,0"
                  IsVisible="{Binding OffersRestore}"
                  Command="{Binding UndoCommand}" />
        </Grid>
      </Border>

      <!-- Calm, not a dialog; drawn as Env's banner draws a problem. -->
      <Border Classes="note problem" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ctl:KpIcon Icon="alert-triangle" Size="14" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource KpDanger}" />
          <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1" ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="secondary size-13" />
          <Button x:Name="DismissError" Grid.Column="2" Classes="ghost sm" Margin="12,0,0,0" Content="{x:Static res:Strings.Dismiss}" Command="{Binding DismissErrorCommand}" />
        </Grid>
      </Border>

    </StackPanel>

    <ctl:ListDetail x:Name="Split" ListWidth="280" DetailLeast="380" ShowsDetail="{Binding HasOpenPane}">

      <!-- The list: its header with the title and sort, the search, then the two-line rows. Drawn above the detail so its menus can lie over it. -->
      <Border x:Name="ListColumn" ZIndex="1" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" ZIndex="1" Margin="12,8,12,8" Spacing="8">
            <!-- The place's title, how many items it lists and the vault it is in, muted, on one line with the sort, as Outlook names a folder and its account. -->
            <Grid Height="28" Margin="4,0,0,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
              <TextBlock x:Name="ListTitle"
                         Classes="list-title"
                         Text="{Binding ListTitle}"
                         ToolTip.Tip="{Binding ListTitle}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="150"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="ListCount"
                         Grid.Column="1"
                         Classes="size-11 muted"
                         Margin="6,0,0,0"
                         Text="{Binding ListCount}"
                         IsVisible="{Binding ListCount, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Classes="size-11 muted"
                         Margin="6,0,0,0"
                         Text="·"
                         IsVisible="{Binding ListSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="ListSubtitle"
                         Grid.Column="3"
                         Classes="size-11 muted"
                         Margin="6,0,8,0"
                         Text="{Binding ListSubtitle}"
                         TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
              <Button x:Name="SortMenu"
                      Grid.Column="4"
                      Classes="icon sm"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{x:Static res:Strings.SortThisList}"
                      AutomationProperties.Name="{x:Static res:Strings.SortThisList}">
                <ctl:KpIcon Icon="list-filter" Size="16" />
                <Button.Flyout>
                  <ctl:ButtonMenu Placement="BottomEdgeAlignedRight" ItemsSource="{Binding SortChoices}">
                    <ctl:ButtonMenu.ItemContainerTheme>
                      <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:SortChoice">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                        <Setter Property="Command" Value="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).SortByCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding Column}" />
                        <Setter Property="Icon">
                          <Template>
                            <ctl:KpIcon Icon="{Binding Arrow}" Size="14" />
                          </Template>
                        </Setter>
                      </ControlTheme>
                    </ctl:ButtonMenu.ItemContainerTheme>
                  </ctl:ButtonMenu>
                </Button.Flyout>
              </Button>
            </Grid>
            <!-- The app's only search, over the place the list shows, with the chord that reaches it from anywhere at its end. -->
            <TextBox x:Name="ListSearch"
                     Classes="search"
                     Text="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).Search, FallbackValue={x:Null}}"
                     PlaceholderText="{x:Static res:Strings.Search}"
                     ToolTip.Tip="{Binding Source={x:Static vm:ShellViewModel.SearchShortcut}, StringFormat='Search, {0}'}"
                     AutomationProperties.Name="{x:Static res:Strings.Search}">
              <TextBox.InnerLeftContent>
                <ctl:KpIcon Icon="search" Size="14" Margin="2,0,6,0" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Border x:Name="ListSearchShortcut" Classes="keycap" Margin="6,0,0,0" IsHitTestVisible="False">
                  <TextBlock Text="{x:Static vm:ShellViewModel.SearchShortcut}" />
                </Border>
              </TextBox.InnerRightContent>
            </TextBox>
          </StackPanel>

          <Panel>
          <!-- An empty list says why, so a filter with no match does not read as a failed load. -->
          <ctl:EmptyState x:Name="ListEmpty"
                          Icon="key-round"
                          Text="{Binding ListEmptyNote}"
                          IsVisible="{Binding ShowsListEmpty}">
            <WrapPanel ItemSpacing="8" LineSpacing="8" ItemsAlignment="Center">
              <Button Classes="sm"
                      Name="ClearSearch"
                      Content="{x:Static res:Strings.ClearSearch}"
                      IsVisible="{Binding ListEmptyOffersClearSearch}"
                      Command="{Binding ClearSearchCommand}"
                      AutomationProperties.Name="{x:Static res:Strings.ClearSearch}" />
              <!-- The first run: a new vault is empty, and a person's first act may be to bring their items in from another app. -->
              <Button x:Name="ImportFromEmpty"
                      Classes="sm"
                      IsVisible="{Binding ListEmptyOffersImport}"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ImportCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.ImportFromAnotherApp}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <ctl:KpIcon Icon="file-input" Size="14" />
                  <TextBlock Grid.Column="1" Text="{x:Static res:Strings.ImportFromAnotherAppLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </WrapPanel>
          </ctl:EmptyState>

            <ListBox Name="Rows"
                     AutomationProperties.Name="{x:Static res:Strings.Items}"
                     Classes="rows two-line monograms"
                     Padding="6,0,6,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding ListedRows}"
                     SelectedItem="{Binding Selected}">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:RowSection">
                  <TextBlock Classes="row-section" Text="{Binding Title}" />
                </DataTemplate>
                <DataTemplate DataType="vm:EntryRow">
                  <!-- When it last changed is the row's tooltip, and the pane's Modified line; the row draws no time. -->
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Background="Transparent"
                        ToolTip.Tip="{Binding ChangedTip}">
                    <!-- The tile is the service's mark, the item's kind or its first letter; its kind is its tooltip. -->
                    <Panel Name="KindMark" Background="Transparent" VerticalAlignment="Center" ToolTip.Tip="{Binding KindLabel}" AutomationProperties.Name="{Binding KindLabel}">
                      <ctl:Monogram Title="{Binding DisplayTitle}" Id="{Binding Hue}" Mark="{Binding Mark}" Size="30" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="row-title" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <!-- Why it is in a result, what tells it from another of its title, its username, or its kind; never a password or a field's value. -->
                      <TextBlock Name="RowSecondLine"
                                 Classes="caption" TextWrapping="NoWrap"
                                 Text="{Binding SecondLine}"
                                 ToolTip.Tip="{Binding SecondLine}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- A dot while an agent uses it. Not the accent: several rows can be in use at once. -->
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top" Margin="0,2,0,0">
                      <Border Classes="dot info" HorizontalAlignment="Right" IsVisible="{Binding IsInUse}" ToolTip.Tip="{Binding LastUsedText}" />
                      <!-- The item's vault, where the list holds several vaults' items. -->
                      <TextBlock Name="RowVault"
                                 Classes="size-11 muted"
                                 HorizontalAlignment="Right"
                                 MaxWidth="90"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding VaultName}"
                                 IsVisible="{Binding ShowsVaultName}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <!-- What the chosen thing shows, or a choice of one, or, narrow, the Back that replaced the list. -->
      <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding #Split.ShowsBack}">
          <Button x:Name="BackToList"
                  Classes="ghost sm"
                  HorizontalAlignment="Left"
                  Margin="24,12,0,0"
                  Command="{Binding CloseItemCommand}"
                  AutomationProperties.Name="{Binding ListTitle, StringFormat={x:Static res:Strings.BackToValue}}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-left" Size="14" />
              <TextBlock Text="{Binding ListTitle}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>

        <Panel>
        <TextBlock Classes="subtitle"
                   Text="{x:Static res:Strings.ChooseAnItemToSeeItHere}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ShowsPlaceholder}" />

      <!-- The entry's pane: grouped rows of what it holds. The password is dots until Reveal shows it, and no binding here carries it. -->
      <ContentControl x:Name="EntryPane"
                      Content="{Binding Detail}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:EntryDetailViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          ctl:FieldRow.LabelWidth="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).PaneLabels.Width, Mode=TwoWay, FallbackValue=130}">
              <Grid Margin="24,20">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="640" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">

                  <!-- The header, drawn above everything after it so its menu can lie over them. -->
                  <StackPanel ZIndex="1">
                    <StackPanel Spacing="16">
                      <!-- The item's tile, title and what it is, as Mail heads a message. -->
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <ctl:Monogram Title="{Binding DisplayTitle}" Id="{Binding Hue}" Mark="{Binding Mark}" Size="52" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock x:Name="EntryTitle"
                                     Classes="title"
                                     Text="{Binding DisplayTitle}"
                                     TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="ItemKind" Classes="caption" TextWrapping="NoWrap" Text="{Binding KindLabel}" IsVisible="{Binding !IsEditing}" />
                            <TextBlock Classes="caption" TextWrapping="NoWrap" Text="{x:Static res:Strings.EditingItem}" IsVisible="{Binding IsEditing}" />
                            <TextBlock Classes="caption" TextWrapping="NoWrap" Text="·" />
                            <TextBlock x:Name="ItemVault" Classes="caption" TextWrapping="NoWrap" Text="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).ItemVaultTitle, FallbackValue={x:Null}}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <!-- The item's actions under its title: Copy password, the view's one filled accent, Edit, and the rest behind ⋯. -->
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="CopyPassword"
                                  Classes.primary="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).CopyPasswordIsPrimary, FallbackValue={x:False}}"
                                  Command="{Binding CopyPasswordCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.CopyPassword}">
                            <Button.IsVisible>
                              <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsEditing" />
                                <Binding Path="HasPassword" />
                              </MultiBinding>
                            </Button.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <ctl:KpIcon Icon="copy" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.CopyPassword}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="EditItem" IsVisible="{Binding !IsEditing}" Content="{x:Static res:Strings.Edit}" Command="{Binding EditCommand}" AutomationProperties.Name="{x:Static res:Strings.EditFields}" />
                          <Button x:Name="CancelEdit" Classes="ghost" IsVisible="{Binding IsEditing}" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
                          <Button x:Name="SaveEdit" Classes="primary" IsVisible="{Binding IsEditing}" Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="FavoriteItem"
                                Classes="icon ghost"
                                Classes.favorite="{Binding IsFavorite}"
                                IsVisible="{Binding !IsEditing}"
                                Command="{Binding ToggleFavoriteCommand}"
                                ToolTip.Tip="{Binding FavoriteLabel}"
                                AutomationProperties.Name="{Binding FavoriteLabel}">
                          <ctl:KpIcon Icon="star" Size="16" />
                        </Button>
                        <Button x:Name="EntryMenu"
                                Classes="more"
                                IsVisible="{Binding !IsEditing}"
                                ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                AutomationProperties.Name="{x:Static res:Strings.MoreActions}">
                          <ctl:KpIcon Icon="ellipsis" Size="16" />
                          <Button.Flyout>
                            <ctl:ButtonMenu Placement="BottomEdgeAlignedRight">
                              <MenuItem x:Name="RotateFromPane" Header="{x:Static res:Strings.Rotate}" IsVisible="{Binding HasPassword}" Command="{Binding RotateCommand}" />
                              <MenuItem x:Name="GeneratePassword" Header="{x:Static res:Strings.GenerateANewPasswordLabel}" IsVisible="{Binding HasPassword}" Command="{Binding GeneratePasswordCommand}"
                                        AutomationProperties.Name="{x:Static res:Strings.GenerateANewPassword}" />
                              <MenuItem x:Name="OrganizeFromPane" Header="{x:Static res:Strings.RenameLabel}" Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OrganizeCommand}"
                                        AutomationProperties.Name="{x:Static res:Strings.Rename}" />
                              <MenuItem x:Name="DuplicateEntry" Header="{x:Static res:Strings.Duplicate}" Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).DuplicateCommand}" />
                              <!-- History is read when this asks for it, never on selection: one reading materialises every superseded password (EntryHistoryViewModel). -->
                              <MenuItem x:Name="ShareEntry" Header="{x:Static res:Strings.Share}" Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ShareCommand, FallbackValue={x:Null}}" CommandParameter="{Binding Name}" />
                              <Separator />
                              <MenuItem x:Name="AddTotp" Header="{x:Static res:Strings.AddOneTimeCode}" IsVisible="{Binding CanAddTotp}" Command="{Binding BeginSetTotpCommand}" />
                              <MenuItem x:Name="AddField" Header="{x:Static res:Strings.AddFieldLabel}" Command="{Binding BeginAddFieldCommand}"
                                        AutomationProperties.Name="{x:Static res:Strings.AddField}" />
                              <MenuItem x:Name="AddAttachment" Header="{x:Static res:Strings.AddAttachmentLabel}" Command="{Binding Attachments.AddCommand}"
                                        AutomationProperties.Name="{x:Static res:Strings.AddAttachment}" />
                              <Separator />
                              <MenuItem x:Name="CopyReference" Header="{x:Static res:Strings.CopyReference}" IsVisible="{Binding HasReference}" Command="{Binding CopyReferenceCommand}" ToolTip.Tip="{Binding Reference}" />
                              <MenuItem x:Name="CopyKeePassId" Header="{x:Static res:Strings.CopyKeePassId}" IsVisible="{Binding HasKeePassId}" Command="{Binding CopyKeePassIdCommand}" />
                              <Separator />
                              <MenuItem x:Name="DeleteEntry" Header="{x:Static res:Strings.Delete}" Classes="danger" Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).DeleteCommand}" />
                            </ctl:ButtonMenu>
                          </Button.Flyout>
                        </Button>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                    <Border x:Name="NothingTellsItApart" Classes="note" Margin="0,8,0,0" IsVisible="{Binding NothingTellsItApart}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="secondary size-13" Text="{x:Static res:Strings.SharedNameNothingTells}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="ghost sm"
                                Content="{x:Static res:Strings.RenameLabel}"
                                Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OrganizeCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.Rename}" />
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- Rotate asks first: the old value stays in history and the new one is never shown here. -->
                  <Border Classes="note" IsVisible="{Binding IsConfirmingRotate}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRotateCommand}" ctl:FormKeys.Cancel="{Binding CancelRotateCommand}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding RotatePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRotateCommand}" />
                        <Button x:Name="ConfirmRotate" Classes="primary" Content="{x:Static res:Strings.Rotate}" Command="{Binding ConfirmRotateCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- The screen's forms about this entry: deleting it, and renaming or moving it. -->
                  <StackPanel Spacing="12"
                              x:DataType="vm:EntriesViewModel"
                              DataContext="{Binding $parent[views:EntriesView].DataContext}"
                              IsVisible="{Binding IsConfirmingDelete}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelDeleteCommand}">
                    <!-- Asked only where the vault has its Trash turned off; with one, Delete moves the item there at once. -->
                    <Border Classes="form danger">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelDeleteCommand}" />
                          <Button Classes="danger" Content="{x:Static res:Strings.DeleteForGood}" Command="{Binding ConfirmDeleteCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Renaming in the item's own group, behind one Save. -->
                  <Border Classes="form"
                          x:DataType="vm:EntriesViewModel"
                          DataContext="{Binding $parent[views:EntriesView].DataContext}"
                          IsVisible="{Binding IsOrganizing}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmOrganizeCommand}" ctl:FormKeys.Cancel="{Binding CancelOrganizeCommand}" ctl:FormKeys.Draft="{Binding OrganizeDraft}">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="dialog-title label" Text="{Binding RenamePrompt}" />
                      <StackPanel Spacing="6">
                        <TextBox x:Name="OrganizeTitle" AutomationProperties.Name="{x:Static res:Strings.Title}" Text="{Binding DraftTitle}" />
                        <TextBlock x:Name="OrganizeTitleProblem"
                                   Classes="caption danger"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasOrganizeTitleProblem}"
                                   ctl:Announcer.Says="{Binding OrganizeTitleProblem}" Text="{Binding OrganizeTitleProblem}" />
                      </StackPanel>
                      <TextBlock x:Name="RenameAgentNote" Classes="caption" TextWrapping="Wrap" Text="{Binding RenameAgentNote}" IsVisible="{Binding RenameAgentNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelOrganizeCommand}" />
                        <Button x:Name="OrganizeSave" Classes="primary" Content="{x:Static res:Strings.Save}" Command="{Binding ConfirmOrganizeCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- History, once somebody asked for it: under the header, where the menu that opened it is. -->
                  <Border Classes="form">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="History.IsOpen" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                          <ctl:KpIcon Icon="history" Size="14" Foreground="{DynamicResource KpTextMuted}" />
                          <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.History}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="link" Content="{Binding History.ToggleLabel}" Command="{Binding History.ToggleCommand}" />
                      </Grid>

                      <TextBlock x:Name="HistoryEmpty"
                                 Classes="caption"
                                 IsVisible="{Binding History.ShowsEmptyNote}"
                                 Text="{Binding History.EmptyNote}" />

                      <ListBox x:Name="Revisions"
                               AutomationProperties.Name="{x:Static res:Strings.EarlierVersions}"
                               MaxHeight="180"
                               ItemsSource="{Binding History.Rows}"
                               SelectedItem="{Binding History.Selected}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:EntryRevisionRow">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Grid.Column="0" Classes="mono size-12" Text="{Binding When}" />
                              <TextBlock Grid.Column="1"
                                         x:Name="RevisionChanges"
                                         Text="{Binding Changes}"
                                         Margin="12,0,0,0"
                                         Classes="muted size-13"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- What the chosen revision held against the entry as it is now, only where they differ. Its password
                           can be read only while Reveal shows it, and copied as the current one is. Custom fields by
                           name and protection, and the tags: never a field's value. -->
                      <StackPanel Spacing="12" IsVisible="{Binding History.HasSelection}">
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.PasswordDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Password}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" VerticalAlignment="Center" />
                          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding !History.Selected.HasPassword}" />
                            <ctl:RevealedValue Grid.Column="0"
                                               x:Name="RevisionPassword"
                                               Source="{Binding History.Selected}"
                                               MaskedLength="{Binding History.Selected.MaskedLength}"
                                               AutomationProperties.Name="{Binding History.Selected.Subject}"
                                               FontFamily="{DynamicResource KpMono}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource KpTextSecondary}" />
                            <ctl:RevealButton Grid.Column="1"
                                              x:Name="RevealRevisionPassword"
                                              Classes="ghost in-field size-12"
                                              Margin="0,0,6,0"
                                              IsVisible="{Binding History.Selected.HasPassword}"
                                              Target="{Binding #RevisionPassword}"
                                              ShowsWord="True"
                                              Subject="{Binding History.Selected.Subject}" />
                            <Button Grid.Column="2" x:Name="CopyRevisionPassword" Classes="sm" Content="{x:Static res:Strings.Copy}"
                                    IsVisible="{Binding History.Selected.HasPassword}"
                                    AutomationProperties.Name="{x:Static res:Strings.CopyThisRevisionsPassword}"
                                    Command="{Binding History.Selected.CopyPasswordCommand}" />
                          </Grid>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono secondary size-14" Text="{Binding PasswordMask}" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding !HasPassword}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.UsernameDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Username}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding History.Selected.DisplayUsername}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayUsername, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding DisplayUsername}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayUsername, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.UrlDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.URL}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding History.Selected.DisplayUrl}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding DisplayUrl}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.NotesDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Notes}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="size-13" Text="{Binding History.Selected.DisplayNotes}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayNotes, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="size-13" Text="{Binding DisplayNotes}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayNotes, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.FieldNamesDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.CustomFields}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="RevisionFields" Classes="mono size-12" Text="{Binding History.Selected.FieldsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding History.Selected.FieldsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono size-12" Text="{Binding FieldsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding FieldsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.TagsDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Tags}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="RevisionTags" Classes="mono size-12" Text="{Binding History.Selected.TagsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding History.Selected.TagsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono size-12" Text="{Binding TagsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding TagsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                      </StackPanel>

                      <StackPanel Spacing="6" IsVisible="{Binding History.HasSelection}">
                        <Button x:Name="RestoreRevision"
                                Classes="sm"
                                Content="{x:Static res:Strings.RestoreThisRevision}"
                                Command="{Binding History.RestoreCommand}"
                                HorizontalAlignment="Left" />

                        <!-- A restore that puts back other project tags is written only after the person has seen what
                             it does to the item's projects, as every tag change is. -->
                        <Border Classes="form" IsVisible="{Binding History.IsConfirmingRestore}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding History.ConfirmRestoreCommand}" ctl:FormKeys.Cancel="{Binding History.CancelRestoreCommand}">
                          <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding History.RestoreLines}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding History.CancelRestoreCommand}" />
                              <Button Classes="primary" Content="{x:Static res:Strings.Restore}" Command="{Binding History.ConfirmRestoreCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                    </StackPanel>
                  </Border>

                  <!-- What the item holds, as grouped rows; each only once it holds something, and Edit adds the rest. Secrets stay dots until Reveal shows them and no binding here carries them. -->
                  <Border Classes="group" x:Name="ItemFields">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="HasStandardRows" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ctl:GroupedRows>
                    <ctl:FieldRow Label="{x:Static res:Strings.Username}" IsVisible="{Binding HasUsername}">
                      <ctl:PressToCopy x:Name="CopyUsername" Command="{Binding CopyUsernameCommand}" ToolTip.Tip="{x:Static app:ShortcutText.CopyUsername}" AutomationProperties.Name="{x:Static res:Strings.CopyUsername}">
                        <TextBlock Classes="size-13" Text="{Binding DisplayUsername}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </ctl:PressToCopy>
                    </ctl:FieldRow>

                    <ctl:FieldRow Label="{x:Static res:Strings.Password}" IsVisible="{Binding HasPassword}">
                      <ctl:PressToCopy x:Name="CopyPasswordValue" Command="{Binding CopyPasswordCommand}" ToolTip.Tip="{x:Static app:ShortcutText.CopyPassword}" AutomationProperties.Name="{x:Static res:Strings.CopyThePassword}">
                        <!-- Not a TextBlock: its automation peer publishes its text as the element's name. RevealedValue draws the characters itself, only while revealed. -->
                        <ctl:RevealedValue x:Name="CurrentPassword"
                                           Source="{Binding}"
                                           MaskedLength="{Binding MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.ThePassword}"
                                           FontFamily="{DynamicResource KpMono}"
                                           Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                           WrapsShownValue="True"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           ClipToBounds="True"
                                           Foreground="{DynamicResource KpTextPrimary}" />
                      </ctl:PressToCopy>
                      <ctl:FieldRow.Actions>
                        <ctl:RevealButton Classes="ghost icon sm"
                                          Target="{Binding #CurrentPassword}"
                                          Subject="{x:Static res:Strings.ThePasswordAsAnObject}" />
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <!-- The TOTP code is masked and computed at the reveal or the copy, as the password is read; only the seconds until the next code are bound. -->
                    <ctl:FieldRow Label="{x:Static res:Strings.TOTP}" IsVisible="{Binding ShowsTotp}">
                      <ctl:PressToCopy x:Name="CopyTotp" Command="{Binding Totp.CopyCommand}" ToolTip.Tip="{x:Static app:ShortcutText.CopyOneTimeCode}" AutomationProperties.Name="{x:Static res:Strings.CopyTheTOTPCode}">
                        <ctl:RevealedValue x:Name="CurrentTotp"
                                           Source="{Binding Totp}"
                                           MaskedLength="{Binding Totp.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.TheTOTPCode}"
                                           FontFamily="{DynamicResource KpMono}"
                                           Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                           WrapsShownValue="True"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           ClipToBounds="True"
                                           Foreground="{DynamicResource KpTextPrimary}" />
                      </ctl:PressToCopy>
                      <ctl:FieldRow.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock x:Name="TotpCountdown"
                                     Classes="mono secondary"
                                     Text="{Binding Totp.Countdown}"
                                     ToolTip.Tip="{x:Static res:Strings.SecondsUntilTheNextCode}"
                                     VerticalAlignment="Center" />
                          <ctl:RevealButton Classes="ghost icon sm"
                                            Target="{Binding #CurrentTotp}"
                                            Subject="{x:Static res:Strings.TheTotpCodeAsAnObject}" />
                          <Button x:Name="ReplaceTotp"
                                  Classes="ghost icon sm" Content="{x:Static res:Strings.Replace}" ContentTemplate="{StaticResource FieldReplaceGlyph}"
                                  Command="{Binding BeginSetTotpCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.ReplaceTheOneTimeCode}"
                                  AutomationProperties.Name="{x:Static res:Strings.ReplaceTheOneTimeCode}" />
                          <Button x:Name="RemoveTotp"
                                  Classes="ghost icon sm" Content="{x:Static res:Strings.Remove}" ContentTemplate="{StaticResource FieldRemoveGlyph}"
                                  IsVisible="{Binding CanRemoveTotp}"
                                  Command="{Binding BeginRemoveTotpCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.RemoveTheOneTimeCode}"
                                  AutomationProperties.Name="{x:Static res:Strings.RemoveTheOneTimeCode}" />
                        </StackPanel>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <ctl:FieldRow Classes="top-label" Label="{x:Static res:Strings.TOTP}" IsVisible="{Binding ShowsTotpProblem}">
                      <TextBlock x:Name="TotpRefusal"
                                 Classes="caption"
                                 TextWrapping="Wrap"
                                 ctl:Announcer.Says="{Binding TotpProblem}" Text="{Binding TotpProblem}" />
                      <ctl:FieldRow.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                          <Button Classes="ghost icon sm" Content="{x:Static res:Strings.Replace}" ContentTemplate="{StaticResource FieldReplaceGlyph}"
                                  Command="{Binding BeginSetTotpCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.ReplaceTheOneTimeCode}"
                                  AutomationProperties.Name="{x:Static res:Strings.ReplaceTheOneTimeCode}" />
                          <Button Classes="ghost icon sm" Content="{x:Static res:Strings.Remove}" ContentTemplate="{StaticResource FieldRemoveGlyph}"
                                  IsVisible="{Binding CanRemoveTotp}"
                                  Command="{Binding BeginRemoveTotpCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.RemoveTheOneTimeCode}"
                                  AutomationProperties.Name="{x:Static res:Strings.RemoveTheOneTimeCode}" />
                        </StackPanel>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <!-- A web address opens in the browser from the row's action; anything else is text and says why. -->
                    <ctl:FieldRow Label="{x:Static res:Strings.URL}" IsVisible="{Binding HasUrl}">
                      <StackPanel Spacing="4">
                        <ctl:PressToCopy x:Name="CopyUrl" Command="{Binding CopyUrlCommand}" ToolTip.Tip="{x:Static res:Strings.CopyUrl}" AutomationProperties.Name="{x:Static res:Strings.CopyUrl}">
                          <TextBlock Classes="size-13" Classes.accent="{Binding OpensUrl}" Text="{Binding DisplayUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </ctl:PressToCopy>
                        <TextBlock x:Name="UrlNote"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowsUrlNote}"
                                   Text="{x:Static res:Strings.KeypasteOpensOnlyWebAddressesStartingHttpX58cb44}" />
                      </StackPanel>
                      <ctl:FieldRow.Actions>
                        <Button x:Name="OpenUrl"
                                Classes="ghost icon sm"
                                IsVisible="{Binding OpensUrl}"
                                Command="{Binding OpenUrlCommand}"
                                ToolTip.Tip="{x:Static res:Strings.OpenInYourBrowser}"
                                AutomationProperties.Name="{x:Static res:Strings.OpenUrl}">
                          <ctl:KpIcon Icon="external-link" Size="14" />
                        </Button>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <Border Classes="group">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="ShowsNotes" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ctl:GroupedRows>
                    <ctl:FieldRow Classes="top-label" Label="{x:Static res:Strings.Notes}">
                      <SelectableTextBlock Name="NotesText" Text="{Binding DisplayNotes}" TextWrapping="Wrap" LineHeight="19.5" Classes="secondary size-13" CopyingToClipboard="OnNotesCopying" />
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <!-- Custom fields: a name and a fixed mask each. A value, plain or protected, is read only while it is revealed or copied, as the password is. -->
                  <StackPanel Spacing="6">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="!IsEditing" />
                      <Binding Path="HasListedFields" />
                    </MultiBinding>
                  </StackPanel.IsVisible>
                  <TextBlock Classes="section-heading" Text="{x:Static res:Strings.CustomFields}" />
                  <Border Classes="group">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="HasListedFields" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ItemsControl x:Name="CustomFields" ItemsSource="{Binding ListedFields}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EntryFieldRow">
                        <!-- Replace and Rename turn the field's own row into the input, with Cancel and the act under it. -->
                        <ctl:FieldRow Label="{Binding DisplayName}" ToolTip.Tip="{Binding Kind}" ToolTip.ServiceEnabled="{Binding ShowsValue}" Classes.stacked="{Binding !ShowsValue}">
                          <Panel>
                            <ctl:PressToCopy x:Name="CopyFieldValue"
                                             IsVisible="{Binding ShowsValue}"
                                             Command="{Binding CopyValueCommand}"
                                             ToolTip.Tip="{x:Static res:Strings.CopyTheValueTheClipboardClearsItself}"
                                             AutomationProperties.Name="{Binding DisplayName, StringFormat={x:Static res:Strings.CopyValue}}">
                              <!-- Not a TextBlock: its automation peer would publish its text as the element's name. -->
                              <ctl:RevealedValue x:Name="FieldValue"
                                                 Source="{Binding}"
                                                 MaskedLength="{Binding MaskedLength}"
                                                 AutomationProperties.Name="{Binding DisplayName}"
                                                 FontFamily="{DynamicResource KpMono}"
                                                 Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                                 WrapsShownValue="True"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ClipToBounds="True"
                                                 Foreground="{DynamicResource KpTextPrimary}" />
                            </ctl:PressToCopy>

                            <ContentControl Content="{Binding ReplaceForm}">
                              <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:EntryFieldRow">
                            <StackPanel Spacing="8" Margin="0,4"
                                        ctl:ShowInView.OnShow="True"
                                        ctl:FormKeys.Confirm="{Binding Owner.ConfirmReplaceFieldCommand}"
                                        ctl:FormKeys.Cancel="{Binding Owner.CancelReplaceFieldCommand}"
                                        ctl:FormKeys.Draft="{Binding Owner.ReplaceFieldDraft}">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ctl:MaskedInput x:Name="ReplacementFieldValue"
                                                 AllowsPaste="True"
                                                 Sink="{Binding Owner.ReplacementFieldValue}"
                                                 MaskedLength="{Binding Owner.ReplacementFieldValue.MaskedLength}"
                                                 AutomationProperties.Name="{x:Static res:Strings.NewValue}" />
                                <Button Grid.Column="1" x:Name="ReplacementFieldGenerate"
                                        Classes="icon ghost"
                                        Command="{Binding Owner.OpenFieldGeneratorCommand}"
                                        CommandParameter="{Binding Owner.ReplacementFieldValue}"
                                        ToolTip.Tip="{x:Static res:Strings.GenerateAValue}"
                                        AutomationProperties.Name="{x:Static res:Strings.GenerateAValue}">
                                  <ctl:KpIcon Icon="wand-2" Size="16" />
                                </Button>
                              </Grid>
                              <TextBlock Classes="caption" IsVisible="{Binding Owner.ReplacementFieldValue.Note.Length}" Text="{Binding Owner.ReplacementFieldValue.Note}" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding Owner.CancelReplaceFieldCommand}" />
                                <Button x:Name="ReplaceFieldSave" Classes="primary" Content="{x:Static res:Strings.Replace}" Command="{Binding Owner.ConfirmReplaceFieldCommand}" />
                              </StackPanel>
                            </StackPanel>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- A field named as a project variable, or one the item's own {S:…} names, is renamed only after
                                 the person has seen what the rename breaks, as a project tag change is. -->
                            <ContentControl Content="{Binding RenameForm}">
                              <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:EntryFieldRow">
                            <StackPanel Spacing="8" Margin="0,4"
                                        ctl:ShowInView.OnShow="True"
                                        ctl:FormKeys.Confirm="{Binding Owner.ConfirmRenameFieldCommand}"
                                        ctl:FormKeys.Cancel="{Binding Owner.CancelRenameFieldCommand}"
                                        ctl:FormKeys.Draft="{Binding Owner.RenameFieldDraft}">
                              <TextBox x:Name="RenamedFieldName"
                                       AutomationProperties.Name="{x:Static res:Strings.FieldName}"
                                       Text="{Binding Owner.DraftFieldRename}" />
                              <TextBlock x:Name="RenamedFieldProblem"
                                         Classes="caption danger"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding Owner.HasRenamedFieldProblem}"
                                         ctl:Announcer.Says="{Binding Owner.RenamedFieldProblem}" Text="{Binding Owner.RenamedFieldProblem}" />
                              <ItemsControl x:Name="FieldRenameLines" ItemsSource="{Binding Owner.FieldRenameLines}" IsVisible="{Binding Owner.IsConfirmingFieldRename}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding Owner.CancelRenameFieldCommand}" />
                                <Button x:Name="RenameFieldSave" Classes="primary" Content="{x:Static res:Strings.Rename}" Command="{Binding Owner.ConfirmRenameFieldCommand}" />
                              </StackPanel>
                            </StackPanel>
                                </DataTemplate>
                              </ContentControl.ContentTemplate>
                            </ContentControl>
                          </Panel>
                          <ctl:FieldRow.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ShowsValue}">
                              <ctl:KpIcon x:Name="FieldProtected" Icon="shield-check" Size="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource KpTextMuted}" IsVisible="{Binding IsProtected}" ToolTip.Tip="{Binding Kind}" AutomationProperties.Name="{Binding Kind}" />
                              <ctl:RevealButton Classes="ghost icon sm"
                                                Target="{Binding #FieldValue}"
                                                Subject="{Binding DisplayName}" />
                              <!-- Opens the row's own context menu, whose commands the Item menu holds too. It names the field, never a value. -->
                              <Button x:Name="FieldMenu" Classes="ghost icon sm"
                                      IsVisible="{Binding IsWritable}"
                                      AutomationProperties.AutomationId="{Binding Name, StringFormat='FieldMenu:{0}'}"
                                      ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat={x:Static res:Strings.MoreActionsForValue}}">
                                <ctl:KpIcon Icon="ellipsis" Size="14" />
                              </Button>
                            </StackPanel>
                          </ctl:FieldRow.Actions>
                        </ctl:FieldRow>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </Border>
                  </StackPanel>

                  <!-- Attachments, tags and agent access: one group at the end. Attachments by name and size, never their content; nothing here opens or runs one. -->
                  <Border Classes="group" x:Name="ItemExtras" IsVisible="{Binding !IsEditing}">
                    <ctl:GroupedRows>

                    <ItemsControl x:Name="AttachmentRows" ItemsSource="{Binding Attachments.Rows}" IsVisible="{Binding Attachments.HasRows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryAttachmentRow">
                          <ctl:FieldRow Classes="mono-label" Label="{Binding DisplayName}">
                            <TextBlock Classes="caption" Text="{Binding SizeText}" VerticalAlignment="Center" />
                            <ctl:FieldRow.Actions>
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="ghost icon sm" Content="{x:Static res:Strings.Save}" ContentTemplate="{StaticResource AttachmentSaveGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.SaveACopyToAFile}"
                                        AutomationProperties.Name="{Binding SaveLabel}"
                                        Command="{Binding SaveCommand}" />
                                <Button Classes="ghost icon sm" Content="{x:Static res:Strings.Replace}" ContentTemplate="{StaticResource FieldReplaceGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.ReplaceWithAnotherFile}"
                                        AutomationProperties.Name="{Binding ReplaceLabel}"
                                        Command="{Binding ReplaceCommand}" />
                                <Button Classes="ghost icon sm" Content="{x:Static res:Strings.Remove}" ContentTemplate="{StaticResource FieldRemoveGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.RemoveThisAttachment}"
                                        AutomationProperties.Name="{Binding RemoveLabel}"
                                        Command="{Binding RemoveCommand}" />
                              </StackPanel>
                            </ctl:FieldRow.Actions>
                          </ctl:FieldRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The entry's own tags. A project tag reads as its project and environment, with a shield when every agent request for the entry is asked about. -->
                    <ctl:FieldRow Classes="top-label" Label="{x:Static res:Strings.Tags}">
                      <ctl:FieldRow.Actions>
                        <ToggleButton x:Name="AddTagToggle"
                                      VerticalAlignment="Top"
                                      Classes="chip-add"
                                      ToolTip.Tip="{x:Static res:Strings.AddTag}"
                                      AutomationProperties.Name="{x:Static res:Strings.AddTag}">
                          <ctl:KpIcon Icon="plus" Size="14" />
                        </ToggleButton>
                      </ctl:FieldRow.Actions>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding #AddTagToggle.IsChecked}">
                          <!-- Suggests the vault's project tags the item lacks as one is typed; choosing one fills the box, and Add tag still asks first for a project tag. -->
                          <AutoCompleteBox x:Name="NewTag"
                                           AutomationProperties.Name="{x:Static res:Strings.Tags}"
                                           Classes="mono"
                                           Text="{Binding DraftTag, Mode=TwoWay}"
                                           ItemsSource="{Binding TagSuggestions}"
                                           FilterMode="ContainsOrdinal"
                                           PlaceholderText="env:project:prod"
                                           Width="220" />
                          <Button Name="AddTag" Classes="ghost sm" Content="{x:Static res:Strings.AddTag}" Command="{Binding AddTagCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ChipTags}" IsVisible="{Binding ChipTags.Count}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryTagChip">
                              <Border Classes="chip tag" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Spoken}">
                                <DockPanel>
                                  <Button DockPanel.Dock="Right" Classes="chip-remove"
                                          AutomationProperties.Name="{Binding RemoveLabel}"
                                          ToolTip.Tip="{Binding RemoveLabel}"
                                          Command="{Binding RemoveCommand}">
                                    <ctl:KpIcon Icon="x" Size="14" />
                                  </Button>
                                  <ctl:KpIcon DockPanel.Dock="Left" Margin="0,0,4,0" Icon="shield-check" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsProtected}" />
                                  <ctl:KpIcon DockPanel.Dock="Left" Margin="0,0,4,0" Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsMalformed}" />
                                  <TextBlock Margin="0,0,4,0" Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ctl:FieldRow>

                    <!-- Agent access: who received this entry, when last and how often, never a value, shown only when agents can see the entry; Activity tells the rest. -->
                    <ctl:FieldRow x:Name="AgentAccessCard"
                                  Classes="top-label"
                                  Label="{x:Static res:Strings.AgentAccess}"
                                  IsVisible="{Binding ShowsAgentAccess}"
                                  ToolTip.Tip="{Binding AgentAccessTip}">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="AgentAccessSummary"
                                   Classes="size-13"
                                   IsVisible="{Binding ShowsAgentAccessSummary}"
                                   Text="{Binding AgentAccessSummary}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AgentLines}" IsVisible="{Binding AgentLines.Count}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="size-13" Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <ctl:FieldRow.Actions>
                        <Button x:Name="OpenActivity"
                                Classes="ghost icon sm"
                                VerticalAlignment="Top"
                                Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OpenActivityCommand}"
                                ToolTip.Tip="{x:Static res:Strings.Activity}"
                                AutomationProperties.Name="{x:Static res:Strings.Activity}">
                          <ctl:KpIcon Icon="chevron-right" Size="14" />
                        </Button>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <!-- Each project environment the item's own tags put it in, and where an agent gets it only once a person answers. Names, never a value. -->
                    <ctl:FieldRow x:Name="EnvironmentsCard" Classes="top-label" Label="{x:Static res:Strings.Environments}" IsVisible="{Binding ShowsEnvironments}">
                      <ItemsControl x:Name="EnvironmentLines" ItemsSource="{Binding Environments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EnvironmentRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                              <DockPanel>
                                <ctl:KpIcon DockPanel.Dock="Left" Icon="shield-check" Size="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding Tag.IsProtected, FallbackValue={x:False}}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Classes="size-13"
                                           Margin="12,0,0,0"
                                           Classes.muted="{Binding !RequiresApproval}"
                                           Classes.secondary="{Binding RequiresApproval}"
                                           Text="{Binding Status}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Classes="size-13"
                                           Text="{Binding Label}"
                                           ToolTip.Tip="{Binding Tag.Tip, FallbackValue={x:Null}}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                              </DockPanel>
                              <Button Grid.Column="1"
                                      Classes="chip-remove"
                                      Margin="8,0,0,0"
                                      IsVisible="{Binding HasTag}"
                                      Command="{Binding Tag.RemoveCommand, FallbackValue={x:Null}}"
                                      ToolTip.Tip="{Binding Tag.RemoveLabel, FallbackValue={x:Null}}"
                                      AutomationProperties.Name="{Binding Tag.RemoveLabel, FallbackValue={x:Null}}">
                                <ctl:KpIcon Icon="x" Size="14" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <StackPanel Spacing="8" IsVisible="{Binding !IsEditing}">
                    <TextBlock x:Name="AttachmentNote"
                               Classes="secondary size-13"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Attachments.HasNote}"
                               Text="{Binding Attachments.Note}" />
                    <Border Classes="form danger" IsVisible="{Binding Attachments.IsRemoving}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding Attachments.CancelRemoveCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Attachments.RemovePrompt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding Attachments.CancelRemoveCommand}" />
                          <Button x:Name="RemoveAttachmentConfirm" Classes="danger" Content="{x:Static res:Strings.Remove}" Command="{Binding Attachments.ConfirmRemoveCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <!-- A project tag is written only after the person has seen the environment and the fields it
                         reaches. -->
                    <Border Classes="form" IsVisible="{Binding IsConfirmingTagChange}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmTagChangeCommand}" ctl:FormKeys.Cancel="{Binding CancelTagChangeCommand}">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding TagChangeLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTagChangeCommand}" />
                          <Button Name="ConfirmTagChange" Classes="primary" Content="{Binding TagChangeAction}" Command="{Binding ConfirmTagChangeCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="form" IsVisible="{Binding IsAddingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmAddFieldCommand}" ctl:FormKeys.Cancel="{Binding CancelAddFieldCommand}" ctl:FormKeys.Draft="{Binding AddFieldDraft}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.AddAField}" />
                        <StackPanel Spacing="6">
                          <TextBlock Classes="label" Text="{x:Static res:Strings.FieldName}" />
                          <TextBox x:Name="NewFieldName" AutomationProperties.Name="{x:Static res:Strings.FieldName}"
                                   Classes="mono"
                                   Text="{Binding DraftFieldName}"
                                   PlaceholderText="STRIPE_SECRET_KEY"
                                   Width="320"
                                   HorizontalAlignment="Left" />
                          <TextBlock x:Name="NewFieldNameProblem"
                                     Classes="caption danger"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasNewFieldNameProblem}"
                                     ctl:Announcer.Says="{Binding NewFieldNameProblem}" Text="{Binding NewFieldNameProblem}" />
                        </StackPanel>
                        <TextBlock Classes="label" Text="{x:Static res:Strings.FieldValue}" />
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ctl:MaskedInput x:Name="NewFieldValue"
                                           AllowsPaste="True"
                                           Sink="{Binding NewFieldValue}"
                                           MaskedLength="{Binding NewFieldValue.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.FieldValue}" />
                          <Button Grid.Column="1" x:Name="NewFieldGenerate"
                                Classes="icon ghost"
                                VerticalAlignment="Center"
                                Command="{Binding OpenFieldGeneratorCommand}"
                                CommandParameter="{Binding NewFieldValue}"
                                ToolTip.Tip="{x:Static res:Strings.GenerateAValue}"
                                AutomationProperties.Name="{x:Static res:Strings.GenerateAValue}">
                          <ctl:KpIcon Icon="wand-2" Size="16" />
                        </Button>
                        </Grid>
                        <TextBlock Classes="caption" IsVisible="{Binding NewFieldValue.Note.Length}" Text="{Binding NewFieldValue.Note}" />
                        <ToggleSwitch x:Name="NewFieldProtected"
                                      AutomationProperties.Name="{x:Static res:Strings.ProtectThisField}"
                                      IsChecked="{Binding NewFieldProtected}"
                                      OnContent="Protected"
                                      OffContent="Plain" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelAddFieldCommand}" />
                          <Button Name="ConfirmAddField" Classes="primary" Content="{x:Static res:Strings.Add}" Command="{Binding ConfirmAddFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="form danger" IsVisible="{Binding IsRemovingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelRemoveFieldCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding RemoveFieldPrompt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="KeepField" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRemoveFieldCommand}" />
                          <Button Classes="danger" Content="{x:Static res:Strings.Remove}" Command="{Binding ConfirmRemoveFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Core keeps the setup as KeePassXC 2.8 keeps a TOTP, and refuses one it cannot compute, naming no value. -->
                    <Border Classes="form" IsVisible="{Binding IsSettingTotp}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmSetTotpCommand}" ctl:FormKeys.Cancel="{Binding CancelSetTotpCommand}" ctl:FormKeys.Draft="{Binding SetTotpDraft}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.OneTimeCode}" />
                        <TextBlock Classes="label" Text="{x:Static res:Strings.SetupKeyOrOtpauthLink}" />
                        <ctl:MaskedInput x:Name="NewTotp"
                                         AllowsPaste="True"
                                         Width="420"
                                         HorizontalAlignment="Left"
                                         Sink="{Binding NewTotp}"
                                         MaskedLength="{Binding NewTotp.MaskedLength}"
                                         AutomationProperties.Name="{x:Static res:Strings.SetupKeyOrOtpauthLink}" />
                        <TextBlock x:Name="TotpSetupProblem"
                                   Classes="caption danger"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasTotpSetupProblem}"
                                   ctl:Announcer.Says="{Binding TotpSetupProblem}" Text="{Binding TotpSetupProblem}" />
                        <TextBlock Classes="caption" IsVisible="{Binding NewTotp.Note.Length}" Text="{Binding NewTotp.Note}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelSetTotpCommand}" />
                          <Button x:Name="SaveTotp" Classes="primary" Content="{x:Static res:Strings.Save}" Command="{Binding ConfirmSetTotpCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="form danger" IsVisible="{Binding IsRemovingTotp}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelRemoveTotpCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.RemoveTheOneTimeCodeFromThisItem}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="KeepTotp" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRemoveTotpCommand}" />
                          <Button x:Name="ConfirmRemoveTotp" Classes="danger" Content="{x:Static res:Strings.Remove}" Command="{Binding ConfirmRemoveTotpCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Where paired browsers fill it, and its earlier versions. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding FillsOn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ctl:KpIcon Icon="app-window" Size="14" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FillsOn" Classes="caption" TextWrapping="NoWrap" Text="{Binding FillsOn}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Grid.Column="1" x:Name="HistoryToggle" Classes="link accent" Command="{Binding History.ToggleCommand}" AutomationProperties.Name="{Binding History.ToggleLabel}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <ctl:KpIcon Icon="history" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.HistoryLink}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- When it last changed, with when it was made and rotated as the tooltip, and when it expires; an expiry KeePassXC set reads Expired in danger text once the session's clock passes it. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="2" Margin="2,0,0,0">
                      <TextBlock x:Name="ModifiedText" Classes="caption" TextWrapping="NoWrap" Text="{Binding ModifiedLine}" ToolTip.Tip="{Binding TimesTip}" Background="Transparent" />
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasExpiry}">
                        <TextBlock Classes="caption" TextWrapping="NoWrap" Text="{Binding ExpiryLabel}" />
                        <TextBlock x:Name="ExpiryText"
                                   Classes="caption"
                                   TextWrapping="NoWrap"
                                   Classes.danger="{Binding IsExpired}"
                                   Text="{Binding Expiry}" />
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>

                  <!-- Edit in place: the rows above, as inputs. Return saves unless the field takes lines; Escape asks about a draft. -->
                  <Border Classes="group" x:Name="ItemEdit" IsVisible="{Binding IsEditing}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding SaveCommand}" ctl:FormKeys.Cancel="{Binding CancelCommand}" ctl:FormKeys.Draft="{Binding EditDraft}">
                    <ctl:GroupedRows>
                    <ctl:FieldRow Classes="adaptive" Label="{x:Static res:Strings.Username}">
                      <ctl:UsernameBox x:Name="DraftUsername"
                                       Text="{Binding DraftUsername, Mode=TwoWay}"
                                       ItemsSource="{Binding UsedUsernames}"
                                       ItemFilter="{Binding UsernameFilter}"
                                       Suggestions="{Binding SuggestedUsernames}"
                                       ctl:Announcer.Says="{Binding SuggestedUsernamesSpoken}"
                                       AutomationProperties.Name="{x:Static res:Strings.Username}" />
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="adaptive" Label="{x:Static res:Strings.Password}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ctl:MaskedInput x:Name="ReplacementPassword"
                                           Grid.Column="0"
                                           AllowsPaste="True"
                                           Sink="{Binding NewPassword}"
                                           PlaceholderText="{x:Static res:Strings.Unchanged}"
                                           MaskedLength="{Binding NewPassword.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.NewPassword}" />
                          <Button x:Name="ReplacementPasswordGenerate"
                                  Grid.Column="1"
                                  Classes="icon ghost"
                                  VerticalAlignment="Center"
                                  Command="{Binding OpenGeneratorCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.GenerateAPassword}"
                                  AutomationProperties.Name="{x:Static res:Strings.GenerateAPassword}">
                            <ctl:KpIcon Icon="wand-2" Size="16" />
                          </Button>
                        </Grid>
                        <TextBlock Classes="caption" IsVisible="{Binding NewPassword.Note.Length}" Text="{Binding NewPassword.Note}" />
                      </StackPanel>
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="adaptive" Label="{x:Static res:Strings.URL}">
                      <TextBox Text="{Binding DraftUrl}" AutomationProperties.Name="{x:Static res:Strings.URL}" />
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="adaptive top-label" Label="{x:Static res:Strings.Notes}">
                      <TextBox Text="{Binding DraftNotes}" AutomationProperties.Name="{x:Static res:Strings.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top" />
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

        </Panel>
      </DockPanel>
    </ctl:ListDetail>

  </DockPanel>

</UserControl>
