<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Keypaste.App"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.EntriesView"
             x:DataType="vm:EntriesViewModel">

  <UserControl.Resources>
    <views:DepthToIndent x:Key="Indent" />
    <DataTemplate x:Key="FieldReplaceGlyph"><ctl:KpIcon Icon="rotate-cw" Size="14" /></DataTemplate>
    <DataTemplate x:Key="FieldRemoveGlyph"><ctl:KpIcon Icon="trash-2" Size="14" /></DataTemplate>
    <DataTemplate x:Key="AttachmentSaveGlyph"><ctl:KpIcon Icon="download" Size="14" /></DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>

    <!-- A row's kind icon is muted until its row is selected. -->
    <Style Selector="ListBoxItem ctl|KpIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="ListBoxItem:selected ctl|KpIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>

    <!-- The group tree: 30px rows, quieter than the sidebar's destinations. -->
    <Style Selector="ListBox.groups > ListBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <Style Selector="ListBox.groups > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    </Style>
    <Style Selector="ListBox.groups > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.groups > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.groups > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.tree">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tree /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>
    <Style Selector="ToggleButton.tree:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.tree:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>

    <!-- The header's Copy and Rotate: 30px, 12px sides. -->
    <Style Selector="Button.action">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- The small button inside a value field: Reveal. -->
    <Style Selector="Button.in-field">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.form">
      <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <!-- The destructive confirmation, the one place KpDanger appears on this screen. -->
    <Style Selector="Border.form.danger">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpDanger}" />
    </Style>

    <Style Selector="ToggleButton.tree:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
    </Style>

    <!-- A custom field's row buttons: 24px icons, as a variable's are on Env profiles. -->
    <Style Selector="Button.row-action">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    </Style>

    <!-- A note is one ink step up; amber stays for the action inside it. -->
    <Style Selector="Border.note">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusField}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.note.problem">
      <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
    </Style>

  </UserControl.Styles>


  <!-- The list on the left and the chosen item on the right; a comparison of two revisions takes the whole view. -->
  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="8,8,8,0">

      <!-- What the last deletion did, and the way back for the one still on screen. Every other
           recovery is on Trash, which is where this one goes once the screen moves on. -->
      <Border Classes="note" IsVisible="{Binding HasNotice}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock ctl:MachineRuns.InText="True" Grid.Column="0"
                     ctl:Announcer.Says="{Binding Notice}" Text="{Binding Notice}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Classes="secondary size-13" />
          <Button Grid.Column="1"
                  Classes="link"
                  Content="{x:Static res:Strings.Restore}"
                  Margin="12,0,0,0"
                  IsVisible="{Binding OffersRestore}"
                  Command="{Binding UndoCommand}" />
        </Grid>
      </Border>

      <!-- Calm, not a dialog; drawn as Env's banner draws a problem. -->
      <Border Classes="note problem" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="Auto,*">
          <ctl:KpIcon Icon="alert-triangle" Size="14" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource KpDanger}" />
          <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1" ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" TextWrapping="Wrap" Classes="secondary size-13" />
        </Grid>
      </Border>

      <Border Classes="form" IsVisible="{Binding IsCreatingGroup}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmCreateGroupCommand}" ctl:FormKeys.Cancel="{Binding CancelGroupCommand}" ctl:FormKeys.Draft="{Binding GroupDraft}">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="{Binding CreateGroupPrompt}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.GroupName}" />
            <TextBox x:Name="NewGroupName" Text="{Binding DraftGroupName}" PlaceholderText="{x:Static res:Strings.Servers}" AutomationProperties.Name="{x:Static res:Strings.GroupName}" />
            <TextBlock x:Name="NewGroupProblem" ctl:ShowInView.Scrolls="True"
                       Classes="caption danger"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasGroupProblem}"
                       ctl:Announcer.Says="{Binding GroupProblem}" Text="{Binding GroupProblem}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelGroupCommand}" />
            <Button x:Name="CreateGroup" Classes="primary sm" Content="{x:Static res:Strings.Create}" Command="{Binding ConfirmCreateGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="form" IsVisible="{Binding IsRenamingGroup}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRenameGroupCommand}" ctl:FormKeys.Cancel="{Binding CancelGroupCommand}" ctl:FormKeys.Draft="{Binding GroupDraft}">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="{Binding RenameGroupPrompt}" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.TheGroupsNewName}" />
            <TextBox x:Name="RenameGroupName" AutomationProperties.Name="{x:Static res:Strings.TheGroupsNewName}" Text="{Binding DraftGroupName}" />
            <TextBlock x:Name="RenameGroupProblem" ctl:ShowInView.Scrolls="True"
                       Classes="caption danger"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasGroupProblem}"
                       ctl:Announcer.Says="{Binding GroupProblem}" Text="{Binding GroupProblem}" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding AccessNote}" />
          <!-- A group under env is where keypaste puts a project's new keys. -->
          <TextBlock x:Name="ProjectRenameNote"
                     Classes="caption"
                     IsVisible="{Binding ShowsProjectRenameNote}"
                     Text="{Binding ProjectRenameNote}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelGroupCommand}" />
            <Button x:Name="RenameGroupSave" Classes="primary sm" Content="{x:Static res:Strings.Rename}" Command="{Binding ConfirmRenameGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- A group moves with everything in it, to the places an item can move to. -->
      <Border Classes="form" IsVisible="{Binding IsMovingGroup}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmMoveGroupCommand}" ctl:FormKeys.Cancel="{Binding CancelGroupCommand}">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" Text="{Binding MoveGroupPrompt}" TextWrapping="Wrap" />
          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="{x:Static res:Strings.MoveTo}" />
            <ComboBox x:Name="MoveGroupTarget" AutomationProperties.Name="{x:Static res:Strings.MoveTo}"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding MoveTargets}"
                      SelectedItem="{Binding GroupMoveTarget}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupNode">
                  <TextBlock Text="{Binding Label}"
                             Margin="{Binding Depth, Converter={StaticResource Indent}}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="MoveGroupProblem" ctl:ShowInView.Scrolls="True"
                       Classes="caption danger"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasGroupProblem}"
                       ctl:Announcer.Says="{Binding GroupProblem}" Text="{Binding GroupProblem}" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding AccessNote}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelGroupCommand}" />
            <Button x:Name="MoveGroupSave" Classes="primary sm" Content="{x:Static res:Strings.Move}" Command="{Binding ConfirmMoveGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Only where the vault has no recycle bin: a recycled group goes at once, and Undo brings it back. -->
      <Border Classes="form danger" IsVisible="{Binding IsConfirmingGroupDelete}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelGroupCommand}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="GroupDeletePrompt" Text="{Binding GroupDeletePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="KeepGroup" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelGroupCommand}" />
            <Button x:Name="DeleteGroupConfirm" Classes="danger sm" Content="{x:Static res:Strings.DeleteForGood}" IsVisible="{Binding GroupCanBeDeleted}" Command="{Binding ConfirmDeleteGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>

    <ctl:ListDetail x:Name="Split" ShowsList="{Binding ShowsList}" ShowsDetail="{Binding HasOpenPane}">

      <!-- The list: its header with the title, sort and New, then the search, then the two-line rows. Drawn above the detail so its menus can lie over it. -->
      <Border x:Name="ListColumn" ZIndex="1" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" ZIndex="1" Margin="12,16,12,8" Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
              <TextBlock x:Name="ListTitle"
                         Classes="list-title"
                         Text="{Binding ListTitle}"
                         ToolTip.Tip="{Binding ListTitle}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <!-- A group is renamed where its name is; the tree it is chosen from is the sidebar's. -->
              <Button Grid.Column="1"
                      x:Name="RenameGroup"
                      Classes="icon ghost sm"
                      ToolTip.Tip="{x:Static res:Strings.RenameGroup}"
                      AutomationProperties.Name="{x:Static res:Strings.RenameGroup}"
                      IsVisible="{Binding CanRenameGroup}"
                      Command="{Binding BeginRenameGroupCommand}">
                <ctl:KpIcon Icon="folder-pen" Size="14" />
              </Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ToggleButton x:Name="SortMenu"
                              Classes="more"
                              ToolTip.Tip="{x:Static res:Strings.SortThisList}"
                              AutomationProperties.Name="{x:Static res:Strings.SortThisList}">
                  <ctl:KpIcon Icon="chevrons-up-down" Size="14" />
                </ToggleButton>
                <ToggleButton x:Name="AddEntry"
                              Classes="more"
                              ToolTip.Tip="{x:Static res:Strings.NewItemProjectOrImport}"
                              AutomationProperties.Name="{x:Static res:Strings.New}">
                  <ctl:KpIcon Icon="plus" Size="14" />
                </ToggleButton>
              </StackPanel>
            </Grid>

            <!-- The app's only search. It searches what the header names. -->
            <TextBox x:Name="ShellSearch"
                     Classes="search"
                     Text="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).Search, FallbackValue={x:Null}}"
                     PlaceholderText="{x:Static res:Strings.Search}"
                     AutomationProperties.Name="{x:Static res:Strings.Search}">
              <TextBox.InnerLeftContent>
                <ctl:KpIcon Icon="search" Size="14" Margin="2,0,6,0" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Border Classes="keycap" Margin="0,0,4,0">
                  <TextBlock Text="{x:Static vm:ShellViewModel.SearchShortcut}" />
                </Border>
              </TextBox.InnerRightContent>
            </TextBox>

            <!-- The menus take no room, so an open one lies over the rows rather than pushing them down. -->
            <Canvas Height="0">
              <Border x:Name="SortMenuPanel"
                      Classes="menu"
                      Canvas.Right="0"
                      Canvas.Top="-36"
                      MinWidth="180"
                      IsVisible="{Binding #SortMenu.IsChecked}">
                <ItemsControl ItemsSource="{Binding SortChoices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SortChoice">
                      <Button Classes="ghost menu-item"
                              Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).SortByCommand}"
                              CommandParameter="{Binding Column}"
                              AutomationProperties.Name="{Binding Spoken}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          <ctl:KpIcon Grid.Column="1" Icon="{Binding Arrow}" Size="14" IsVisible="{Binding Arrow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
          <Border x:Name="AddMenuPanel"
                  Classes="menu"
                  Canvas.Right="0"
                  Canvas.Top="-36"
                  MinWidth="200"
                  IsVisible="{Binding #AddEntry.IsChecked}">
            <StackPanel Spacing="2">
              <Button x:Name="NewItem" Classes="ghost menu-item" Command="{Binding BeginAddCommand}" AutomationProperties.Name="{x:Static res:Strings.NewItem}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="key-round" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.NewItemLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="NewGroup"
                      Classes="ghost menu-item"
                      Command="{Binding BeginCreateGroupCommand}"
                      AutomationProperties.Name="{x:Static res:Strings.NewGroup}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="folder-plus" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.NewGroupLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="NewGeneratedPassword"
                      Classes="ghost menu-item"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).OpenGeneratorCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.GeneratePassword}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="wand-2" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.GeneratePasswordXf22f07}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="NewProject"
                      Classes="ghost menu-item"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).NewProjectCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.NewProject}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="folder-git-2" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.NewProjectLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImportEnv"
                      Classes="ghost menu-item"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ImportEnvCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.ImportEnv}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="file-code" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.ImportEnvLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImportKdbx"
                      Classes="ghost menu-item"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ImportCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.ImportFromAnotherApp}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ctl:KpIcon Icon="file-input" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.ImportFromAnotherAppLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
            </Canvas>
          </StackPanel>

          <Panel>
          <!-- An empty list says why, so a filter with no match does not read as a failed load. -->
          <StackPanel Spacing="12"
                      Margin="24,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowsListEmpty}">
            <TextBlock x:Name="ListEmpty"
                       Classes="subtitle"
                       TextAlignment="Center"
                       Text="{Binding ListEmptyNote}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Classes="sm"
                      Name="SearchAllItems"
                      Content="{x:Static res:Strings.SearchAllItems}"
                      IsVisible="{Binding ListEmptyOffersSearchAll}"
                      Command="{Binding SearchAllItemsCommand}"
                      AutomationProperties.Name="{x:Static res:Strings.SearchAllItems}" />
              <Button Classes="sm"
                      Name="ClearSearch"
                      Content="{x:Static res:Strings.ClearSearch}"
                      IsVisible="{Binding ListEmptyOffersClearSearch}"
                      Command="{Binding ClearSearchCommand}"
                      AutomationProperties.Name="{x:Static res:Strings.ClearSearch}" />
              <!-- The first run: a new vault is empty, and a person's first act may be to bring their items in from another app. -->
              <Button x:Name="ImportFromEmpty"
                      Classes="sm"
                      IsVisible="{Binding ListEmptyOffersImport}"
                      Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ImportCommand, FallbackValue={x:Null}}"
                      AutomationProperties.Name="{x:Static res:Strings.ImportFromAnotherApp}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:KpIcon Icon="file-input" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.ImportFromAnotherAppLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

            <ListBox Name="Rows"
                     AutomationProperties.Name="{x:Static res:Strings.Items}"
                     Classes="rows two-line"
                     Padding="4,0,4,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- The tile answers the pointer only on its strokes, so a background carries its tip. -->
                    <Panel Name="KindMark" Background="Transparent" ToolTip.Tip="{Binding KindLabel}" AutomationProperties.Name="{Binding KindLabel}">
                      <Border Classes="row-tile">
                        <ctl:KpIcon Classes="kind" Icon="{Binding Icon}" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="row-title" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- Tells apart two items of one name. -->
                        <TextBlock Grid.Column="1"
                                   Name="SharedNameTell"
                                   Text="{Binding SharedNameTell}"
                                   ToolTip.Tip="{Binding SharedNameTell}"
                                   Classes="mono muted size-12"
                                   MaxWidth="110"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding SharesItsName}" />
                      </Grid>
                      <!-- Why it is in a result, its username, or where it lives; never a password or a field's value. -->
                      <TextBlock Name="RowSecondLine"
                                 Classes="mono muted size-12"
                                 Text="{Binding SecondLine}"
                                 ToolTip.Tip="{Binding SecondLine}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- When an agent last received it, with a dot only while it is in use. A time, never a value. Not amber:
                         several rows can be in use at once, and a view has one amber element. -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding LastUsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock Classes="size-13 muted" Text="{Binding LastUsedText}" VerticalAlignment="Center" />
                      <Border Classes="dot info" IsVisible="{Binding IsInUse}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <!-- What the chosen thing shows, or a choice of one, or, narrow, the Back that replaced the list. -->
      <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding #Split.ShowsBack}">
          <Button x:Name="BackToList"
                  Classes="ghost sm"
                  HorizontalAlignment="Left"
                  Margin="24,12,0,0"
                  Command="{Binding CloseItemCommand}"
                  AutomationProperties.Name="{Binding ListTitle, StringFormat={x:Static res:Strings.BackToValue}}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-left" Size="14" />
              <TextBlock Text="{Binding ListTitle}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>

        <Panel>
        <TextBlock Classes="subtitle"
                   Text="{x:Static res:Strings.ChooseAnItemToSeeItHere}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ShowsPlaceholder}" />
      <!-- A new item starts from a kind and a title; the button on its left adds the other fields (N.4). -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding IsAdding}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmAddCommand}" ctl:FormKeys.Cancel="{Binding CancelAddCommand}" ctl:FormKeys.Draft="{Binding NewItemDraft}">
        <Grid Margin="32,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="756" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="16">

            <TextBlock Classes="list-title" Text="{x:Static res:Strings.NewItem}" />

            <Grid ColumnDefinitions="Auto,12,*" DataContext="{Binding NewItem}" x:DataType="vm:NewItemViewModel">

              <StackPanel Grid.Column="0" ZIndex="1">
                <ToggleButton x:Name="AddFieldMenu"
                              Classes="more"
                              IsEnabled="{Binding HasFieldOptions}"
                              ToolTip.Tip="{x:Static res:Strings.AddAField}"
                              AutomationProperties.Name="{x:Static res:Strings.AddAField}">
                  <ctl:KpIcon Icon="plus" Size="14" />
                </ToggleButton>
                <Canvas Height="0">
                  <Border x:Name="AddFieldMenuPanel"
                          Classes="menu"
                          Canvas.Left="0"
                          Canvas.Top="6"
                          MinWidth="200"
                          IsVisible="{Binding #AddFieldMenu.IsChecked}">
                    <ItemsControl ItemsSource="{Binding FieldOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NewItemFieldOption">
                          <Button Classes="ghost menu-item"
                                  Command="{Binding $parent[ItemsControl].((vm:NewItemViewModel)DataContext).AddFieldCommand}"
                                  CommandParameter="{Binding Field}"
                                  AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="{Binding Icon}" Size="14" />
                              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Canvas>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="16">

              <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="{x:Static res:Strings.KindOfItem}" />
                <ListBox x:Name="NewItemTemplate"
                         AutomationProperties.Name="{x:Static res:Strings.KindOfItem}"
                         Classes="segmented"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemplateChoice">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ctl:KpIcon Icon="{Binding Icon}" Size="14" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <Border Classes="group">
                <ctl:GroupedRows>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Title}">
                    <StackPanel Spacing="6">
                      <TextBox x:Name="NewItemTitle" AutomationProperties.Name="{x:Static res:Strings.Title}" MinHeight="40" Text="{Binding Title}" PlaceholderText="{x:Static res:Strings.Github}" />
                      <TextBlock x:Name="NewItemTitleProblem" ctl:ShowInView.Scrolls="True"
                                 Classes="caption danger"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasTitleProblem}"
                                 ctl:Announcer.Says="{Binding TitleProblem}" Text="{Binding TitleProblem}" />
                      <TextBlock Classes="caption" IsVisible="{Binding ShowsGoesIn}" Text="{Binding GoesIn}" />
                    </StackPanel>
                  </ctl:FieldRow>

                  <ctl:FieldRow x:Name="KeyNameRow" Classes="stacked" Label="{x:Static res:Strings.KeyName}" IsVisible="{Binding ShowsKey}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveKeyCommand}" ToolTip.Tip="{x:Static res:Strings.RemoveKey}" AutomationProperties.Name="{x:Static res:Strings.RemoveKey}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <StackPanel Spacing="6">
                      <TextBox x:Name="NewItemKeyName" AutomationProperties.Name="{x:Static res:Strings.KeyName}" Classes="mono" MinHeight="40" Text="{Binding KeyName}" PlaceholderText="OPENAI_API_KEY" />
                      <TextBlock x:Name="NewItemKeyNameProblem" ctl:ShowInView.Scrolls="True"
                                 Classes="caption danger"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasKeyNameProblem}"
                                 ctl:Announcer.Says="{Binding KeyNameProblem}" Text="{Binding KeyNameProblem}" />
                      <TextBlock Classes="caption" Text="{x:Static res:Strings.TheNameAProjectReadsItUnderX9a2ebe}" />
                    </StackPanel>
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.KeyValue}" IsVisible="{Binding ShowsKey}">
                    <StackPanel Spacing="6">
                      <ctl:MaskedInput x:Name="NewItemKeyValue"
                                       AllowsPaste="True"
                                       Sink="{Binding KeyValue}"
                                       MaskedLength="{Binding KeyValue.MaskedLength}"
                                       AutomationProperties.Name="{x:Static res:Strings.KeyValue}" />
                      <TextBlock x:Name="NewItemKeyValueProblem" ctl:ShowInView.Scrolls="True"
                                 Classes="caption danger"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasKeyValueProblem}"
                                 ctl:Announcer.Says="{Binding KeyValueProblem}" Text="{Binding KeyValueProblem}" />
                      <TextBlock Classes="caption"
                                 IsVisible="{Binding KeyValue.Note.Length}"
                                 Text="{Binding KeyValue.Note}" />
                    </StackPanel>
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Host}" IsVisible="{Binding ShowsHost}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveHostCommand}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Host}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Host}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <TextBox x:Name="NewItemHost" AutomationProperties.Name="{x:Static res:Strings.Host}" Classes="mono" MinHeight="40" Text="{Binding Host}" PlaceholderText="db.example.com:5432" />
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Username}" IsVisible="{Binding ShowsUsername}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Username}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Username}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Username}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <TextBox x:Name="NewEntryUsername" AutomationProperties.Name="{x:Static res:Strings.Username}" Classes="mono" MinHeight="40" Text="{Binding Username}" />
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Password}" IsVisible="{Binding ShowsPassword}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Password}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Password}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Password}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ctl:MaskedInput x:Name="NewEntryPassword"
                                         Grid.Column="0"
                                         AllowsPaste="True"
                                         Sink="{Binding Password}"
                                         MaskedLength="{Binding Password.MaskedLength}"
                                         AutomationProperties.Name="{x:Static res:Strings.Password}" />
                        <Button x:Name="NewEntryGenerate"
                                Grid.Column="1"
                                Classes="icon ghost"
                                VerticalAlignment="Center"
                                Command="{Binding OpenGeneratorCommand}"
                                ToolTip.Tip="{x:Static res:Strings.GenerateAPassword}"
                                AutomationProperties.Name="{x:Static res:Strings.GenerateAPassword}">
                          <ctl:KpIcon Icon="wand-2" Size="16" />
                        </Button>
                      </Grid>
                      <Border x:Name="NewItemGeneratorPanel" Classes="menu" Padding="12" IsVisible="{Binding HasGeneratorPanel}">
                        <views:GeneratorPanel DataContext="{Binding GeneratorPanel}" />
                      </Border>
                      <TextBlock Classes="caption"
                                 IsVisible="{Binding GeneratePassword}"
                                 Text="{x:Static res:Strings.GeneratedTypeOrPasteToUseYourX7a2ef9}" />
                      <TextBlock Classes="caption"
                                 IsVisible="{Binding !GeneratePassword}"
                                 Text="{x:Static app:ShortcutText.PastePassword}" />
                      <TextBlock Classes="caption"
                                 IsVisible="{Binding Password.Note.Length}"
                                 Text="{Binding Password.Note}" />
                    </StackPanel>
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.URL}" IsVisible="{Binding ShowsUrl}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Url}" ToolTip.Tip="{Binding Source={x:Static res:Strings.URL}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.URL}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <TextBox x:Name="NewEntryUrl" AutomationProperties.Name="{x:Static res:Strings.URL}" Classes="mono" MinHeight="40" Text="{Binding Url}" PlaceholderText="{x:Static res:Strings.ExampleWebAddress}" />
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Group}" IsVisible="{Binding ShowsGroup}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Group}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Group}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Group}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <ComboBox x:Name="NewItemFolder" AutomationProperties.Name="{x:Static res:Strings.Group}"
                              MinHeight="40"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Folders}"
                              SelectedItem="{Binding Folder}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderChoice">
                          <TextBlock Text="{Binding Label}"
                                     Margin="{Binding Depth, Converter={StaticResource Indent}}"
                                     TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Notes}" IsVisible="{Binding ShowsNotes}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Notes}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Notes}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Notes}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <TextBox x:Name="NewItemNotes" AutomationProperties.Name="{x:Static res:Strings.Notes}"
                             MinHeight="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Text="{Binding Notes}" />
                  </ctl:FieldRow>

                  <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Tags}" IsVisible="{Binding ShowsTags}">
                    <ctl:FieldRow.Actions>
                      <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveFieldCommand}" CommandParameter="{x:Static vm:NewItemField.Tags}" ToolTip.Tip="{Binding Source={x:Static res:Strings.Tags}, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Source={x:Static res:Strings.Tags}, StringFormat={x:Static res:Strings.RemoveValue}}">
                        <ctl:KpIcon Icon="x" Size="14" />
                      </Button>
                    </ctl:FieldRow.Actions>
                    <StackPanel Spacing="8">
                      <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding Tags.Count}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EntryTagChip">
                            <Border Classes="chip tag" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Spoken}">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <ctl:KpIcon Icon="shield-check" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsProtected}" />
                                <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsMalformed}" />
                                <TextBlock Text="{Binding Display}" />
                                <Button Classes="chip-remove"
                                        AutomationProperties.Name="{Binding RemoveLabel}"
                                        ToolTip.Tip="{Binding RemoveLabel}"
                                        Command="{Binding RemoveCommand}">
                                  <ctl:KpIcon Icon="x" Size="14" />
                                </Button>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8" ctl:FormKeys.Confirm="{Binding AddTagCommand}">
                        <!-- Suggests the vault's project tags as one is typed; choosing one fills the box for Add tag. -->
                        <AutoCompleteBox x:Name="NewItemTag"
                                         AutomationProperties.Name="{x:Static res:Strings.Tags}"
                                         Classes="mono"
                                         Text="{Binding DraftTag, Mode=TwoWay}"
                                         ItemsSource="{Binding TagSuggestions}"
                                         FilterMode="ContainsOrdinal"
                                         PlaceholderText="env:project:prod"
                                         Width="220" />
                        <Button Classes="ghost sm" Content="{x:Static res:Strings.AddTag}" Command="{Binding AddTagCommand}" />
                      </StackPanel>
                      <TextBlock x:Name="NewItemTagProblem"
                                 Classes="caption danger"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasTagProblem}"
                                 ctl:Announcer.Says="{Binding TagProblem}" Text="{Binding TagProblem}" />
                    </StackPanel>
                  </ctl:FieldRow>

                </ctl:GroupedRows>
              </Border>

              <!-- Fields the person named: a plain one holds its text, a protected one is masked and read once, at Create. -->
              <Border Classes="group" IsVisible="{Binding CustomFields.Count}">
                <ItemsControl x:Name="NewItemCustomFields" ItemsSource="{Binding CustomFields}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <ctl:GroupedRows />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewItemCustomField">
                      <ctl:FieldRow Classes="stacked" Label="{Binding Kind}">
                        <ctl:FieldRow.Actions>
                          <Button Classes="icon ghost sm" VerticalAlignment="Top" Command="{Binding RemoveCommand}" ToolTip.Tip="{Binding Kind, StringFormat={x:Static res:Strings.RemoveValue}}" AutomationProperties.Name="{Binding Kind, StringFormat={x:Static res:Strings.RemoveValue}}">
                            <ctl:KpIcon Icon="x" Size="14" />
                          </Button>
                        </ctl:FieldRow.Actions>
                        <StackPanel Spacing="8">
                          <TextBlock Classes="label" Text="{x:Static res:Strings.FieldName}" />
                          <TextBox Classes="mono" MinHeight="40" Text="{Binding Name}" PlaceholderText="STRIPE_SECRET_KEY" AutomationProperties.Name="{x:Static res:Strings.FieldName}" />
                          <TextBlock Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding HasNameProblem}" ctl:Announcer.Says="{Binding NameProblem}" Text="{Binding NameProblem}" />
                          <TextBlock Classes="label" Text="{x:Static res:Strings.FieldValue}" />
                          <ctl:MaskedInput AllowsPaste="True"
                                           IsVisible="{Binding IsProtected}"
                                           Sink="{Binding Secret}"
                                           MaskedLength="{Binding Secret.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.FieldValue}" />
                          <TextBox MinHeight="40" IsVisible="{Binding !IsProtected}" Text="{Binding Value}" AutomationProperties.Name="{x:Static res:Strings.FieldValue}" />
                        </StackPanel>
                      </ctl:FieldRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <TextBlock ctl:MachineRuns.InText="True" x:Name="NewItemError"
                         Classes="caption danger"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasError}"
                         ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelAddCommand}" />
              <Button x:Name="CreateItem" Classes="primary" Content="{x:Static res:Strings.Create}" Command="{Binding ConfirmAddCommand}" />
            </StackPanel>

          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- The entry's pane: grouped rows of what it holds. The password is dots until Reveal shows it, and no binding here carries it. -->
      <ContentControl x:Name="EntryPane"
                      IsVisible="{Binding !IsAdding}"
                      Content="{Binding Detail}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:EntryDetailViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="32,24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="640" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="16">

                  <!-- The header, drawn above everything after it so its menu can lie over them. -->
                  <StackPanel ZIndex="1">
                    <ctl:HeaderRow Spacing="16">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock x:Name="ItemKind" Classes="muted size-13" Text="{Binding KindLabel}" IsVisible="{Binding !IsEditing}" />
                          <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.EditingItem}" IsVisible="{Binding IsEditing}" />
                          <Border Width="2" Height="2" CornerRadius="4" VerticalAlignment="Center" Background="{DynamicResource KpTextMuted}" IsVisible="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).PaneNamesGroup, FallbackValue={x:False}}" />
                          <TextBlock x:Name="PaneLocation"
                                     Text="{Binding Location}"
                                     Classes="muted size-13"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).PaneNamesGroup, FallbackValue={x:False}}" />
                        </StackPanel>
                        <TextBlock x:Name="EntryTitle"
                                   Classes="title"
                                   Text="{Binding DisplayTitle}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button x:Name="EditItem" Classes="action" IsVisible="{Binding !IsEditing}" Content="{x:Static res:Strings.Edit}" Command="{Binding EditCommand}" AutomationProperties.Name="{x:Static res:Strings.EditFields}" />
                        <ToggleButton x:Name="EntryMenu"
                                      Classes="more"
                                      IsVisible="{Binding !IsEditing}"
                                      ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                      AutomationProperties.Name="{x:Static res:Strings.MoreActions}">
                          <ctl:KpIcon Icon="ellipsis" Size="14" />
                        </ToggleButton>
                        <Button x:Name="CopyPassword"
                                Classes="action"
                                Classes.primary="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).CopyPasswordIsPrimary, FallbackValue={x:False}}"
                                Command="{Binding CopyPasswordCommand}"
                                AutomationProperties.Name="{x:Static res:Strings.CopyPassword}">
                          <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="!IsEditing" />
                              <Binding Path="HasPassword" />
                            </MultiBinding>
                          </Button.IsVisible>
                          <TextBlock Text="{x:Static res:Strings.CopyPassword}" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="CancelEdit" Classes="ghost action" IsVisible="{Binding IsEditing}" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" />
                        <Button x:Name="SaveEdit" Classes="primary action" IsVisible="{Binding IsEditing}" Content="{x:Static res:Strings.Save}" Command="{Binding SaveCommand}" />
                      </StackPanel>
                    </ctl:HeaderRow>
                    <StackPanel x:Name="NothingTellsItApart" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding NothingTellsItApart}">
                      <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.SharedNameNothingTells}" TextWrapping="Wrap" />
                      <Button Classes="ghost sm"
                              HorizontalAlignment="Left"
                              Content="{x:Static res:Strings.RenameOrMoveLabel}"
                              Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OrganizeCommand}"
                              AutomationProperties.Name="{x:Static res:Strings.RenameOrMove}" />
                    </StackPanel>

                    <!-- The ⋯ menu. A canvas takes no room, so the open menu lies over the fields below
                         rather than pushing them down. -->
                    <Canvas Height="0">
                      <Border x:Name="EntryMenuPanel"
                              Classes="menu"
                              Canvas.Right="0"
                              Canvas.Top="6"
                              MinWidth="200"
                              IsVisible="{Binding #EntryMenu.IsChecked}">
                        <StackPanel Spacing="2">
                          <Button x:Name="RotateFromPane" Classes="ghost menu-item" IsVisible="{Binding HasPassword}" Command="{Binding RotateCommand}" AutomationProperties.Name="{x:Static res:Strings.Rotate}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="refresh-cw" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.Rotate}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="GeneratePassword" Classes="ghost menu-item" IsVisible="{Binding HasPassword}" Command="{Binding GeneratePasswordCommand}" AutomationProperties.Name="{x:Static res:Strings.GenerateANewPassword}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="wand-2" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.GenerateANewPasswordLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="OrganizeFromPane"
                                  Classes="ghost menu-item"
                                  Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).OrganizeCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.RenameOrMove}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="folder-input" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.RenameOrMoveLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="DuplicateEntry"
                                  Classes="ghost menu-item"
                                  Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).DuplicateCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.Duplicate}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="copy" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.Duplicate}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <!-- History is read when this asks for it, never on selection: one reading
                               materialises every superseded password (EntryHistoryViewModel). -->
                          <Button x:Name="ShareEntry"
                                  Classes="ghost menu-item"
                                  Command="{Binding $parent[views:ShellView].((vm:ShellViewModel)DataContext).ShareCommand, FallbackValue={x:Null}}"
                                  CommandParameter="{Binding Name}"
                                  AutomationProperties.Name="{x:Static res:Strings.Share}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="share-2" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.Share}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="HistoryToggle" Classes="ghost menu-item" Command="{Binding History.ToggleCommand}" AutomationProperties.Name="{Binding History.ToggleLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="history" Size="14" />
                              <TextBlock Text="{Binding History.ToggleLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <!-- What names the entry rather than what it holds, kept here out of the preview (N.5). -->
                          <Border Classes="divider" Margin="6,2" />
                          <StackPanel x:Name="EntryIdentity" Margin="8,4" Spacing="2">
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Reference}" IsVisible="{Binding HasReference}" />
                            <TextBlock x:Name="ReferenceText"
                                       Classes="mono secondary size-12"
                                       MaxWidth="300"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding HasReference}"
                                       Text="{Binding Reference}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{x:Static res:Strings.UseThisInEnvKeypasteWithKeypasteX22e6e9}" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.KeePassItemID}" Margin="0,4,0,0" />
                            <TextBlock x:Name="KdbxEntryText"
                                       Classes="mono secondary size-12"
                                       MaxWidth="300"
                                       HorizontalAlignment="Left"
                                       Text="{Binding KdbxEntry}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button x:Name="CopyReference"
                                  Classes="ghost menu-item"
                                  IsVisible="{Binding HasReference}"
                                  Command="{Binding CopyReferenceCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.CopyTheReference}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="copy" Size="14" />
                              <TextBlock Text="{x:Static res:Strings.CopyTheReference}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Border Classes="divider" Margin="6,2" />
                          <Button x:Name="DeleteEntry"
                                  Classes="ghost menu-item danger"
                                  Foreground="{DynamicResource KpDanger}"
                                  Command="{Binding $parent[views:EntriesView].((vm:EntriesViewModel)DataContext).DeleteCommand}"
                                  AutomationProperties.Name="{x:Static res:Strings.Delete}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ctl:KpIcon Icon="trash-2" Size="14" Foreground="{DynamicResource KpDanger}" />
                              <TextBlock Text="{x:Static res:Strings.Delete}" VerticalAlignment="Center" Foreground="{DynamicResource KpDanger}" />
                            </StackPanel>
                          </Button>
                        </StackPanel>
                      </Border>
                    </Canvas>
                  </StackPanel>

                  <!-- Rotate asks first: the old value stays in history and the new one is never shown here. -->
                  <Border Classes="note" IsVisible="{Binding IsConfirmingRotate}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRotateCommand}" ctl:FormKeys.Cancel="{Binding CancelRotateCommand}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding RotatePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRotateCommand}" />
                        <Button x:Name="ConfirmRotate" Classes="primary sm" Content="{x:Static res:Strings.Rotate}" Command="{Binding ConfirmRotateCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- The screen's forms about this entry: deleting it, and renaming or moving it. -->
                  <StackPanel Spacing="12"
                              x:DataType="vm:EntriesViewModel"
                              DataContext="{Binding $parent[views:EntriesView].DataContext}"
                              IsVisible="{Binding IsConfirmingDelete}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelDeleteCommand}">
                    <!-- What the deletion costs depends on the vault: DeletePrompt reads its recycle-bin
                         setting and says which case this is. -->
                    <Border Classes="form danger">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" Classes="primary size-13" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelDeleteCommand}" />
                          <Button Classes="danger sm" Content="{x:Static res:Strings.DeleteForGood}" Command="{Binding ConfirmDeleteCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- Renaming and moving on one form, behind one Save. The two are a single core write
                       (Vault.Relocate), and splitting them into two submits would let a rename commit in
                       the open vault while the move beside it was refused, for the next save to write out. -->
                  <Border Classes="form"
                          x:DataType="vm:EntriesViewModel"
                          DataContext="{Binding $parent[views:EntriesView].DataContext}"
                          IsVisible="{Binding IsOrganizing}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmOrganizeCommand}" ctl:FormKeys.Cancel="{Binding CancelOrganizeCommand}" ctl:FormKeys.Draft="{Binding OrganizeDraft}">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.RenameOrMove}" />
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.Title}" />
                        <TextBox x:Name="OrganizeTitle" AutomationProperties.Name="{x:Static res:Strings.Title}" Text="{Binding DraftTitle}" />
                        <TextBlock x:Name="OrganizeTitleProblem"
                                   Classes="caption danger"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasOrganizeTitleProblem}"
                                   ctl:Announcer.Says="{Binding OrganizeTitleProblem}" Text="{Binding OrganizeTitleProblem}" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.Group}" />
                        <ComboBox x:Name="OrganizeGroup" AutomationProperties.Name="{x:Static res:Strings.Group}"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding MoveTargets}"
                                  SelectedItem="{Binding MoveTarget}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GroupNode">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding AccessNote}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelOrganizeCommand}" />
                        <Button x:Name="OrganizeSave" Classes="primary sm" Content="{x:Static res:Strings.Save}" Command="{Binding ConfirmOrganizeCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- History, once somebody asked for it: under the header, where the menu that opened it is. -->
                  <Border Classes="form">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="History.IsOpen" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Spacing="12">

                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                          <ctl:KpIcon Icon="history" Size="14" Foreground="{DynamicResource KpTextMuted}" />
                          <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.History}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="link" Content="{Binding History.ToggleLabel}" Command="{Binding History.ToggleCommand}" />
                      </Grid>

                      <TextBlock x:Name="HistoryEmpty"
                                 Classes="caption"
                                 IsVisible="{Binding History.ShowsEmptyNote}"
                                 Text="{Binding History.EmptyNote}" />

                      <ListBox x:Name="Revisions"
                               AutomationProperties.Name="{x:Static res:Strings.EarlierVersions}"
                               MaxHeight="180"
                               ItemsSource="{Binding History.Rows}"
                               SelectedItem="{Binding History.Selected}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:EntryRevisionRow">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Grid.Column="0" Classes="mono size-12" Text="{Binding When}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DisplayTitle}"
                                         IsVisible="{Binding TitleDiffers}"
                                         Margin="12,0,0,0"
                                         Classes="muted size-13"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>

                      <!-- What the chosen revision held against the entry as it is now, only where they differ. Its password
                           can be read only while Reveal shows it, and copied as the current one is. Custom fields by
                           name and protection, and the tags: never a field's value. -->
                      <StackPanel Spacing="12" IsVisible="{Binding History.HasSelection}">
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.PasswordDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Password}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" VerticalAlignment="Center" />
                          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding !History.Selected.HasPassword}" />
                            <ctl:RevealedValue Grid.Column="0"
                                               x:Name="RevisionPassword"
                                               Source="{Binding History.Selected}"
                                               MaskedLength="{Binding History.Selected.MaskedLength}"
                                               AutomationProperties.Name="{Binding History.Selected.Subject}"
                                               FontFamily="{DynamicResource KpMono}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource KpTextSecondary}" />
                            <ctl:RevealButton Grid.Column="1"
                                              x:Name="RevealRevisionPassword"
                                              Classes="ghost in-field size-12"
                                              Margin="0,0,6,0"
                                              IsVisible="{Binding History.Selected.HasPassword}"
                                              Target="{Binding #RevisionPassword}"
                                              ShowsWord="True"
                                              Subject="{Binding History.Selected.Subject}" />
                            <Button Grid.Column="2" x:Name="CopyRevisionPassword" Classes="sm" Content="{x:Static res:Strings.Copy}"
                                    IsVisible="{Binding History.Selected.HasPassword}"
                                    AutomationProperties.Name="{x:Static res:Strings.CopyThisRevisionsPassword}"
                                    Command="{Binding History.Selected.CopyPasswordCommand}" />
                          </Grid>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono secondary size-14" Text="{Binding PasswordMask}" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding !HasPassword}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.UsernameDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Username}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding History.Selected.DisplayUsername}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayUsername, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding DisplayUsername}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayUsername, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.UrlDiffers}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.URL}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding History.Selected.DisplayUrl}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono" Text="{Binding DisplayUrl}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.NotesDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Notes}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock Classes="size-13" Text="{Binding History.Selected.DisplayNotes}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding History.Selected.DisplayNotes, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="size-13" Text="{Binding DisplayNotes}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.Empty}" IsVisible="{Binding DisplayNotes, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.FieldNamesDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.CustomFields}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="RevisionFields" Classes="mono size-12" Text="{Binding History.Selected.FieldsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding History.Selected.FieldsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono size-12" Text="{Binding FieldsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding FieldsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding History.Selected.TagsDiffer}">
                          <TextBlock Grid.ColumnSpan="2" Classes="label" Text="{x:Static res:Strings.Tags}" Margin="0,0,0,2" />
                          <TextBlock Grid.Row="1" Classes="caption" Text="{x:Static res:Strings.Then}" />
                          <Panel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="RevisionTags" Classes="mono size-12" Text="{Binding History.Selected.TagsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding History.Selected.TagsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                          <TextBlock Grid.Row="2" Classes="caption" Text="{x:Static res:Strings.Now}" />
                          <Panel Grid.Row="2" Grid.Column="1">
                            <TextBlock Classes="mono size-12" Text="{Binding TagsSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{x:Static res:Strings.None}" IsVisible="{Binding TagsSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                          </Panel>
                        </Grid>
                        <TextBlock x:Name="RevisionUnchanged" Classes="caption" TextWrapping="Wrap" Text="{Binding History.Selected.Unchanged}" IsVisible="{Binding History.Selected.HasUnchanged}" />
                      </StackPanel>

                      <StackPanel Spacing="6" IsVisible="{Binding History.HasSelection}">
                        <Button x:Name="RestoreRevision"
                                Classes="sm"
                                Content="{x:Static res:Strings.RestoreThisRevision}"
                                Command="{Binding History.RestoreCommand}"
                                HorizontalAlignment="Left" />
                        <TextBlock Classes="caption"
                                   TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.RestoringMakesTheseTheItemsValuesAndX0e783d}" />

                        <!-- A restore that puts back other project tags is written only after the person has seen what
                             it does to the item's projects, as every tag change is. -->
                        <Border Classes="form" IsVisible="{Binding History.IsConfirmingRestore}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding History.ConfirmRestoreCommand}" ctl:FormKeys.Cancel="{Binding History.CancelRestoreCommand}">
                          <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding History.RestoreLines}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding History.CancelRestoreCommand}" />
                              <Button Classes="primary" Content="{x:Static res:Strings.Restore}" Command="{Binding History.ConfirmRestoreCommand}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>

                    </StackPanel>
                  </Border>

                  <!-- What the item holds, as grouped rows; each only once it holds something, and Edit adds the rest. Secrets stay dots until Reveal shows them and no binding here carries them. -->
                  <Border Classes="group" x:Name="ItemFields">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="HasStandardRows" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ctl:GroupedRows>
                    <ctl:FieldRow Label="{x:Static res:Strings.Username}" IsVisible="{Binding HasUsername}">
                      <ctl:PressToCopy x:Name="CopyUsername" Command="{Binding CopyUsernameCommand}" ToolTip.Tip="{x:Static res:Strings.CopyUsername}" AutomationProperties.Name="{x:Static res:Strings.CopyUsername}">
                        <TextBlock Classes="mono size-13" Text="{Binding DisplayUsername}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </ctl:PressToCopy>
                    </ctl:FieldRow>

                    <ctl:FieldRow Label="{x:Static res:Strings.Password}" IsVisible="{Binding HasPassword}">
                      <ctl:PressToCopy x:Name="CopyPasswordValue" Command="{Binding CopyPasswordCommand}" ToolTip.Tip="{x:Static res:Strings.CopyThePassword}" AutomationProperties.Name="{x:Static res:Strings.CopyThePassword}">
                        <!-- Not a TextBlock: its automation peer publishes its text as the element's name. RevealedValue draws the characters itself, only while revealed. -->
                        <ctl:RevealedValue x:Name="CurrentPassword"
                                           Source="{Binding}"
                                           MaskedLength="{Binding MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.ThePassword}"
                                           FontFamily="{DynamicResource KpMono}"
                                           Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                           WrapsShownValue="True"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           ClipToBounds="True"
                                           Foreground="{DynamicResource KpTextPrimary}" />
                      </ctl:PressToCopy>
                      <ctl:FieldRow.Actions>
                        <ctl:RevealButton Classes="ghost row-action"
                                          Target="{Binding #CurrentPassword}"
                                          Subject="{x:Static res:Strings.ThePasswordAsAnObject}" />
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <!-- The TOTP code is masked and computed at the reveal or the copy, as the password is read; only the seconds until the next code are bound. -->
                    <ctl:FieldRow Label="{x:Static res:Strings.TOTP}" IsVisible="{Binding ShowsTotp}">
                      <ctl:PressToCopy x:Name="CopyTotp" Command="{Binding Totp.CopyCommand}" ToolTip.Tip="{x:Static res:Strings.CopyTheCodeTheClipboardClearsItself}" AutomationProperties.Name="{x:Static res:Strings.CopyTheTOTPCode}">
                        <ctl:RevealedValue x:Name="CurrentTotp"
                                           Source="{Binding Totp}"
                                           MaskedLength="{Binding Totp.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.TheTOTPCode}"
                                           FontFamily="{DynamicResource KpMono}"
                                           Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                           WrapsShownValue="True"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           ClipToBounds="True"
                                           Foreground="{DynamicResource KpTextPrimary}" />
                      </ctl:PressToCopy>
                      <ctl:FieldRow.Actions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock x:Name="TotpCountdown"
                                     Classes="mono secondary"
                                     Text="{Binding Totp.Countdown}"
                                     ToolTip.Tip="{x:Static res:Strings.SecondsUntilTheNextCode}"
                                     VerticalAlignment="Center" />
                          <ctl:RevealButton Classes="ghost row-action"
                                            Target="{Binding #CurrentTotp}"
                                            Subject="{x:Static res:Strings.TheTotpCodeAsAnObject}" />
                        </StackPanel>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>

                    <ctl:FieldRow Classes="top-label" Label="{x:Static res:Strings.TOTP}" IsVisible="{Binding ShowsTotpProblem}">
                      <TextBlock x:Name="TotpRefusal"
                                 Classes="caption"
                                 TextWrapping="Wrap"
                                 ctl:Announcer.Says="{Binding TotpProblem}" Text="{Binding TotpProblem}" />
                    </ctl:FieldRow>

                    <!-- A web address opens in the browser from the row's action; anything else is text and says why. -->
                    <ctl:FieldRow Label="{x:Static res:Strings.URL}" IsVisible="{Binding HasUrl}">
                      <StackPanel Spacing="4">
                        <ctl:PressToCopy x:Name="CopyUrl" Command="{Binding CopyUrlCommand}" ToolTip.Tip="{x:Static res:Strings.CopyUrl}" AutomationProperties.Name="{x:Static res:Strings.CopyUrl}">
                          <TextBlock Classes="mono size-13" Text="{Binding DisplayUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </ctl:PressToCopy>
                        <TextBlock x:Name="UrlNote"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ShowsUrlNote}"
                                   Text="{x:Static res:Strings.KeypasteOpensOnlyWebAddressesStartingHttpX58cb44}" />
                      </StackPanel>
                      <ctl:FieldRow.Actions>
                        <Button x:Name="OpenUrl"
                                Classes="ghost row-action"
                                IsVisible="{Binding OpensUrl}"
                                Command="{Binding OpenUrlCommand}"
                                ToolTip.Tip="{x:Static res:Strings.OpenInYourBrowser}"
                                AutomationProperties.Name="{x:Static res:Strings.OpenUrl}">
                          <ctl:KpIcon Icon="external-link" Size="14" />
                        </Button>
                      </ctl:FieldRow.Actions>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <Border Classes="group">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="ShowsNotes" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ctl:GroupedRows>
                    <ctl:FieldRow Classes="top-label" Label="{x:Static res:Strings.Notes}">
                      <TextBlock Text="{Binding DisplayNotes}" TextWrapping="Wrap" LineHeight="19.5" Classes="secondary size-13" />
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <!-- Custom fields: a name and a fixed mask each. A value, plain or protected, is read only while it is revealed or copied, as the password is. -->
                  <Border Classes="group">
                    <Border.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsEditing" />
                        <Binding Path="HasFields" />
                      </MultiBinding>
                    </Border.IsVisible>
                    <ItemsControl x:Name="CustomFields" ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EntryFieldRow">
                        <ctl:FieldRow Classes="mono-label" Label="{Binding DisplayName}" ToolTip.Tip="{Binding Kind}">
                          <ctl:PressToCopy x:Name="CopyFieldValue"
                                           Command="{Binding CopyValueCommand}"
                                           ToolTip.Tip="{x:Static res:Strings.CopyTheValueTheClipboardClearsItself}"
                                           AutomationProperties.Name="{Binding DisplayName, StringFormat={x:Static res:Strings.CopyValue}}">
                            <!-- Not a TextBlock, for the reason CurrentPassword is not one. -->
                            <ctl:RevealedValue x:Name="FieldValue"
                                               Source="{Binding}"
                                               MaskedLength="{Binding MaskedLength}"
                                               AutomationProperties.Name="{Binding DisplayName}"
                                               FontFamily="{DynamicResource KpMono}"
                                               Width="{Binding $parent[ctl:PressToCopy].ValueWidth}"
                                           WrapsShownValue="True"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               ClipToBounds="True"
                                               Foreground="{DynamicResource KpTextPrimary}" />
                          </ctl:PressToCopy>
                          <ctl:FieldRow.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <ctl:RevealButton Classes="ghost row-action"
                                                Target="{Binding #FieldValue}"
                                                Subject="{Binding DisplayName}" />
                              <!-- Opens the row's own context menu, whose commands the Item menu holds too. It names the field, never a value. -->
                              <Button x:Name="FieldMenu" Classes="ghost row-action"
                                      IsVisible="{Binding IsWritable}"
                                      ToolTip.Tip="{x:Static res:Strings.MoreActions}"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat={x:Static res:Strings.MoreActionsForValue}}">
                                <ctl:KpIcon Icon="ellipsis" Size="14" />
                              </Button>
                            </StackPanel>
                          </ctl:FieldRow.Actions>
                        </ctl:FieldRow>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </Border>

                  <!-- Attachments, tags and agent access: one group at the end. Attachments by name and size, never their content; nothing here opens or runs one. -->
                  <Border Classes="group" x:Name="ItemExtras" IsVisible="{Binding !IsEditing}">
                    <ctl:GroupedRows>

                    <ItemsControl x:Name="AttachmentRows" ItemsSource="{Binding Attachments.Rows}" IsVisible="{Binding Attachments.HasRows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryAttachmentRow">
                          <ctl:FieldRow Classes="mono-label" Label="{Binding DisplayName}">
                            <TextBlock Classes="caption" Text="{Binding SizeText}" VerticalAlignment="Center" />
                            <ctl:FieldRow.Actions>
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="ghost row-action" Content="{x:Static res:Strings.Save}" ContentTemplate="{StaticResource AttachmentSaveGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.SaveACopyToAFile}"
                                        AutomationProperties.Name="{Binding SaveLabel}"
                                        Command="{Binding SaveCommand}" />
                                <Button Classes="ghost row-action" Content="{x:Static res:Strings.Replace}" ContentTemplate="{StaticResource FieldReplaceGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.ReplaceWithAnotherFile}"
                                        AutomationProperties.Name="{Binding ReplaceLabel}"
                                        Command="{Binding ReplaceCommand}" />
                                <Button Classes="ghost row-action" Content="{x:Static res:Strings.Remove}" ContentTemplate="{StaticResource FieldRemoveGlyph}"
                                        ToolTip.Tip="{x:Static res:Strings.RemoveThisAttachment}"
                                        AutomationProperties.Name="{Binding RemoveLabel}"
                                        Command="{Binding RemoveCommand}" />
                              </StackPanel>
                            </ctl:FieldRow.Actions>
                          </ctl:FieldRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The entry's own tags. A project tag reads as its project and environment, with a shield when every agent request for the entry is asked about. -->
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Tags}">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <!-- Suggests the vault's project tags the item lacks as one is typed; choosing one fills the box, and Add tag still asks first for a project tag. -->
                          <AutoCompleteBox x:Name="NewTag"
                                           AutomationProperties.Name="{x:Static res:Strings.Tags}"
                                           Classes="mono"
                                           Text="{Binding DraftTag, Mode=TwoWay}"
                                           ItemsSource="{Binding TagSuggestions}"
                                           FilterMode="ContainsOrdinal"
                                           PlaceholderText="env:project:prod"
                                           Width="220" />
                          <Button Classes="ghost sm" Content="{x:Static res:Strings.AddTag}" Command="{Binding AddTagCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EntryTagChip">
                              <Border Classes="chip tag" Margin="0,0,6,6" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Spoken}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <ctl:KpIcon Icon="shield-check" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsProtected}" />
                                  <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpTextSecondary}" IsVisible="{Binding IsMalformed}" />
                                  <TextBlock Text="{Binding Display}" />
                                  <Button Classes="chip-remove"
                                          AutomationProperties.Name="{Binding RemoveLabel}"
                                          ToolTip.Tip="{Binding RemoveLabel}"
                                          Command="{Binding RemoveCommand}">
                                    <ctl:KpIcon Icon="x" Size="14" />
                                  </Button>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ctl:FieldRow>

                    <!-- Agent access: who received this entry and when, never a value, shown only when agents can see the entry. -->
                    <ctl:FieldRow x:Name="AgentAccessCard" Classes="top-label" Label="{x:Static res:Strings.AgentAccess}" IsVisible="{Binding ShowsAgentAccess}">
                      <StackPanel Spacing="4">
                        <TextBlock x:Name="AgentAccessSummary"
                                   Classes="size-13"
                                   IsVisible="{Binding ShowsAgentAccessSummary}"
                                   Text="{Binding AgentAccessSummary}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AgentLines}" IsVisible="{Binding AgentLines.Count}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="size-13" Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="caption"
                                   IsVisible="{Binding HasBeenUsed}"
                                   Text="{Binding LastUsedText, StringFormat={x:Static res:Strings.LastUsedValue}}" />
                        <TextBlock x:Name="SharedNameActivity"
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding SharesItsName}"
                                   Text="{x:Static res:Strings.SharedNameActivity}" />
                      </StackPanel>
                    </ctl:FieldRow>

                    <!-- Each project environment the item's own tags put it in, and where an agent gets it only once a person answers. Names, never a value. -->
                    <ctl:FieldRow x:Name="EnvironmentsCard" Classes="top-label" Label="{x:Static res:Strings.Environments}" IsVisible="{Binding ShowsEnvironments}">
                      <ItemsControl ItemsSource="{Binding Environments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EnvironmentRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                              <TextBlock Grid.Column="0"
                                         Classes="mono"
                                         Text="{Binding Label}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Classes="size-13"
                                         Margin="12,0,0,0"
                                         Classes.muted="{Binding !RequiresApproval}"
                                         Classes.secondary="{Binding RequiresApproval}"
                                         Text="{Binding Status}"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                  <StackPanel Spacing="8" IsVisible="{Binding !IsEditing}">
                    <TextBlock x:Name="AttachmentNote"
                               Classes="secondary size-13"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Attachments.HasNote}"
                               Text="{Binding Attachments.Note}" />
                    <Border Classes="form danger" IsVisible="{Binding Attachments.IsRemoving}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding Attachments.CancelRemoveCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Attachments.RemovePrompt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding Attachments.CancelRemoveCommand}" />
                          <Button x:Name="RemoveAttachmentConfirm" Classes="danger" Content="{x:Static res:Strings.Remove}" Command="{Binding Attachments.ConfirmRemoveCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <!-- A project tag is written only after the person has seen the environment and the fields it
                         reaches. -->
                    <Border Classes="form" IsVisible="{Binding IsConfirmingTagChange}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmTagChangeCommand}" ctl:FormKeys.Cancel="{Binding CancelTagChangeCommand}">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding TagChangeLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelTagChangeCommand}" />
                          <Button Classes="primary" Content="{Binding TagChangeAction}" Command="{Binding ConfirmTagChangeCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button x:Name="AddField"
                              Classes="ghost sm"
                              Command="{Binding BeginAddFieldCommand}"
                              AutomationProperties.Name="{x:Static res:Strings.AddField}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="plus" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.AddFieldLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button x:Name="AddAttachment"
                              Classes="ghost sm"
                              Command="{Binding Attachments.AddCommand}"
                              AutomationProperties.Name="{x:Static res:Strings.AddAttachment}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ctl:KpIcon Icon="plus" Size="14" />
                          <TextBlock Text="{x:Static res:Strings.AddAttachmentLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>

                    <Border Classes="form" IsVisible="{Binding IsAddingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmAddFieldCommand}" ctl:FormKeys.Cancel="{Binding CancelAddFieldCommand}" ctl:FormKeys.Draft="{Binding AddFieldDraft}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.AddAField}" />
                        <StackPanel Spacing="6">
                          <TextBlock Classes="label" Text="{x:Static res:Strings.FieldName}" />
                          <TextBox x:Name="NewFieldName" AutomationProperties.Name="{x:Static res:Strings.FieldName}"
                                   Classes="mono"
                                   Text="{Binding DraftFieldName}"
                                   PlaceholderText="STRIPE_SECRET_KEY"
                                   Width="320"
                                   HorizontalAlignment="Left" />
                          <TextBlock x:Name="NewFieldNameProblem"
                                     Classes="caption danger"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasNewFieldNameProblem}"
                                     ctl:Announcer.Says="{Binding NewFieldNameProblem}" Text="{Binding NewFieldNameProblem}" />
                        </StackPanel>
                        <TextBlock Classes="label" Text="{x:Static res:Strings.FieldValue}" />
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ctl:MaskedInput x:Name="NewFieldValue"
                                           AllowsPaste="True"
                                           Sink="{Binding NewFieldValue}"
                                           MaskedLength="{Binding NewFieldValue.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.FieldValue}" />
                          <Button Grid.Column="1" x:Name="NewFieldGenerate"
                                Classes="icon ghost"
                                VerticalAlignment="Center"
                                Command="{Binding GenerateIntoCommand}"
                                CommandParameter="{Binding NewFieldValue}"
                                ToolTip.Tip="{x:Static res:Strings.GenerateAValue}"
                                AutomationProperties.Name="{x:Static res:Strings.GenerateAValue}">
                          <ctl:KpIcon Icon="wand-2" Size="16" />
                        </Button>
                        </Grid>
                        <Panel IsVisible="{Binding NewFieldValue.IsGenerated}">
                          <views:GeneratorOptions DataContext="{Binding Generator}" />
                        </Panel>
                        <TextBlock Classes="caption" IsVisible="{Binding NewFieldValue.Note.Length}" Text="{Binding NewFieldValue.Note}" />
                        <ToggleSwitch x:Name="NewFieldProtected"
                                      AutomationProperties.Name="{x:Static res:Strings.ProtectThisField}"
                                      IsChecked="{Binding NewFieldProtected}"
                                      OnContent="Protected"
                                      OffContent="Plain" />
                        <TextBlock Classes="caption" Text="{x:Static app:ShortcutText.PasteProtected}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelAddFieldCommand}" />
                          <Button Classes="primary" Content="{x:Static res:Strings.Add}" Command="{Binding ConfirmAddFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="form" IsVisible="{Binding IsReplacingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmReplaceFieldCommand}" ctl:FormKeys.Cancel="{Binding CancelReplaceFieldCommand}" ctl:FormKeys.Draft="{Binding ReplaceFieldDraft}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="body primary" AutomationProperties.HeadingLevel="2" Text="{Binding ReplaceFieldPrompt}" ctl:MachineRuns.Words="{Binding ReplacingFieldName}" />
                        <TextBlock Classes="label" Text="{x:Static res:Strings.NewFieldValue}" />
                        <Grid ColumnSpacing="8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ctl:MaskedInput x:Name="ReplacementFieldValue"
                                           AllowsPaste="True"
                                           Sink="{Binding ReplacementFieldValue}"
                                           MaskedLength="{Binding ReplacementFieldValue.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.NewFieldValue}" />
                          <Button Grid.Column="1" x:Name="ReplacementFieldGenerate"
                                Classes="icon ghost"
                                VerticalAlignment="Center"
                                Command="{Binding GenerateIntoCommand}"
                                CommandParameter="{Binding ReplacementFieldValue}"
                                ToolTip.Tip="{x:Static res:Strings.GenerateAValue}"
                                AutomationProperties.Name="{x:Static res:Strings.GenerateAValue}">
                          <ctl:KpIcon Icon="wand-2" Size="16" />
                        </Button>
                        </Grid>
                        <Panel IsVisible="{Binding ReplacementFieldValue.IsGenerated}">
                          <views:GeneratorOptions DataContext="{Binding Generator}" />
                        </Panel>
                        <TextBlock Classes="caption" IsVisible="{Binding ReplacementFieldValue.Note.Length}" Text="{Binding ReplacementFieldValue.Note}" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.TheOldValueStaysInTheItemsX346d21}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelReplaceFieldCommand}" />
                          <Button Classes="primary" Content="{x:Static res:Strings.Replace}" Command="{Binding ConfirmReplaceFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- A field named as a project variable, or one the item's own {S:…} names, is renamed only after
                         the person has seen what the rename breaks, as a project tag change is. -->
                    <Border Classes="form" IsVisible="{Binding IsRenamingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRenameFieldCommand}" ctl:FormKeys.Cancel="{Binding CancelRenameFieldCommand}" ctl:FormKeys.Draft="{Binding RenameFieldDraft}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="body primary" AutomationProperties.HeadingLevel="2" Text="{Binding RenameFieldPrompt}" ctl:MachineRuns.Words="{Binding RenamingFieldName}" />
                        <StackPanel Spacing="6">
                          <TextBlock Classes="label" Text="{x:Static res:Strings.NewFieldName}" />
                          <TextBox x:Name="RenamedFieldName" AutomationProperties.Name="{x:Static res:Strings.NewFieldName}"
                                   Classes="mono"
                                   Text="{Binding DraftFieldRename}"
                                   Width="320"
                                   HorizontalAlignment="Left" />
                          <TextBlock x:Name="RenamedFieldProblem"
                                     Classes="caption danger"
                                     TextWrapping="Wrap"
                                     IsVisible="{Binding HasRenamedFieldProblem}"
                                     ctl:Announcer.Says="{Binding RenamedFieldProblem}" Text="{Binding RenamedFieldProblem}" />
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.TheValueAndItsProtectionGoWithX9050e5}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="FieldRenameLines" ItemsSource="{Binding FieldRenameLines}" IsVisible="{Binding IsConfirmingFieldRename}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRenameFieldCommand}" />
                          <Button x:Name="RenameFieldSave" Classes="primary" Content="{x:Static res:Strings.Rename}" Command="{Binding ConfirmRenameFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="form danger" IsVisible="{Binding IsRemovingField}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelRemoveFieldCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding RemoveFieldPrompt}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="KeepField" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRemoveFieldCommand}" />
                          <Button Classes="danger" Content="{x:Static res:Strings.Remove}" Command="{Binding ConfirmRemoveFieldCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- When it was made, rotated and expires; an expiry KeePassXC set reads Expired in danger text once the session's clock passes it. -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.Created}" />
                        <TextBlock x:Name="CreatedText" Classes="secondary size-13" Text="{Binding Created}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.Rotated}" />
                        <TextBlock x:Name="RotatedText" Classes="secondary size-13" Text="{Binding Rotated}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasExpiry}">
                        <TextBlock Classes="muted size-13" Text="{Binding ExpiryLabel}" />
                        <TextBlock x:Name="ExpiryText"
                                   Classes="size-13"
                                   Classes.secondary="{Binding !IsExpired}"
                                   Classes.danger="{Binding IsExpired}"
                                   Text="{Binding Expiry}" />
                      </StackPanel>
                      <TextBlock Classes="muted size-13" Text="{x:Static res:Strings.PressAValueToCopyIt}" />
                    </WrapPanel>
                  </StackPanel>

                  <!-- Edit in place: the rows above, as inputs. Return saves unless the field takes lines; Escape asks about a draft. -->
                  <Border Classes="group" x:Name="ItemEdit" IsVisible="{Binding IsEditing}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding SaveCommand}" ctl:FormKeys.Cancel="{Binding CancelCommand}" ctl:FormKeys.Draft="{Binding EditDraft}">
                    <ctl:GroupedRows>
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Username}">
                      <TextBox Classes="mono" Text="{Binding DraftUsername}" AutomationProperties.Name="{x:Static res:Strings.Username}" />
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.NewPassword}">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ctl:MaskedInput x:Name="ReplacementPassword"
                                           Grid.Column="0"
                                           AllowsPaste="True"
                                           Sink="{Binding NewPassword}"
                                           MaskedLength="{Binding NewPassword.MaskedLength}"
                                           AutomationProperties.Name="{x:Static res:Strings.NewPassword}" />
                          <Button x:Name="ReplacementPasswordGenerate"
                                  Grid.Column="1"
                                  Classes="icon ghost"
                                  VerticalAlignment="Center"
                                  Command="{Binding OpenGeneratorCommand}"
                                  ToolTip.Tip="{x:Static res:Strings.GenerateAPassword}"
                                  AutomationProperties.Name="{x:Static res:Strings.GenerateAPassword}">
                            <ctl:KpIcon Icon="wand-2" Size="16" />
                          </Button>
                        </Grid>
                        <Border x:Name="ReplacementPasswordGeneratorPanel" Classes="menu" Padding="12" IsVisible="{Binding HasGeneratorPanel}">
                          <views:GeneratorPanel DataContext="{Binding GeneratorPanel}" />
                        </Border>
                        <TextBlock Classes="caption" IsVisible="{Binding !NewPassword.IsGenerated}" Text="{x:Static res:Strings.LeaveThisEmptyToKeepTheCurrentX151c53}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" IsVisible="{Binding NewPassword.IsGenerated}" Text="{x:Static res:Strings.GeneratedSavePutsItInPlaceOfXefb5c1}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" IsVisible="{Binding NewPassword.Note.Length}" Text="{Binding NewPassword.Note}" />
                      </StackPanel>
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.URL}">
                      <TextBox Classes="mono" Text="{Binding DraftUrl}" AutomationProperties.Name="{x:Static res:Strings.URL}" />
                    </ctl:FieldRow>
                    <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Notes}">
                      <TextBox Text="{Binding DraftNotes}" AutomationProperties.Name="{x:Static res:Strings.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top" />
                    </ctl:FieldRow>
                  </ctl:GroupedRows>
                  </Border>

                </StackPanel>
              </Grid>
            </ScrollViewer>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

        </Panel>
      </DockPanel>
    </ctl:ListDetail>

  </DockPanel>

</UserControl>
