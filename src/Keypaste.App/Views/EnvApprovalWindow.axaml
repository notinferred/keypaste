<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    xmlns:sys="using:System"
                    x:Class="Keypaste.App.Views.EnvApprovalWindow"
                    x:DataType="vm:EnvApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: a run is asking for a project's variables"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Fixed heights, as in ApprovalWindow: the command, directory and names are what the runner
       sent, so each sits in a box that wraps and scrolls and none of them can move the question or
       the buttons (THREATS.md T-2, T-30). Only the header and the requester line are trimmed to one
       line; the environment, which the person decides on, has a fixed row of its own beneath the
       header, drawn whole, and no part of a command is hidden past an edge. No button is the
       default: Enter approves nothing, and Escape denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <StackPanel Spacing="8">
        <Grid Classes="prompt-head" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
          <Border Grid.Column="0" Classes="prompt-tile">
            <ctl:KpIcon Icon="terminal" Size="20" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Name="TitleText" Classes="prompt-title size-16" Text="{Binding Title}" />
            <DockPanel HorizontalAlignment="Left">
              <TextBlock DockPanel.Dock="Left" Classes="prompt-sub size-13" Text="project " />
              <TextBlock Name="ProjectText" Classes="prompt-sub size-13" Text="{Binding Project}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Classes="dot waiting" />
            <TextBlock Name="CountdownText" Classes="prompt-countdown size-12" Text="{Binding Countdown}" />
          </StackPanel>
        </Grid>

        <Grid Classes="prompt-environment" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="prompt-sub size-13" Text="environment" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="ProfileText" Classes="prompt-environment size-12-5" Text="{Binding Profile}" />
        </Grid>
      </StackPanel>

      <TextBlock Name="RequesterText" Classes="prompt-sub size-13" TextTrimming="CharacterEllipsis"
                 Text="{Binding Requester, StringFormat='asked by {0}'}"
                 IsVisible="{Binding Requester, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="prompt-call size-12" Height="58">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,8" Spacing="2">
            <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed size-13" Text="{Binding Scrubbed}"
                       IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="run" />
              <TextBlock Grid.Row="0" Grid.Column="1" Name="CommandText" Classes="value" Text="{Binding Command}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="in" />
              <TextBlock Grid.Row="1" Grid.Column="1" Name="DirectoryText" Text="{Binding Directory}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- The names, one row each with its tag. A name wraps rather than ending in an ellipsis: two
           long names that share a prefix must still read as two different variables. -->
      <Border Classes="prompt-list size-12-5" Height="110">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ItemsControl Name="KeysList" ItemsSource="{Binding Keys}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnvApprovalKey">
                  <Border Classes="prompt-row" MinHeight="36" Padding="12,6">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                      <TextBlock Classes="key" Text="{Binding Key}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="tag size-13" Text="inject only" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Classes="entry size-12" Text="{Binding Entry}" TextWrapping="Wrap"
                                 IsVisible="{Binding Entry, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="NoKeysText" Text="(none)" Margin="12,8" IsVisible="{Binding HasNoKeys}" />
            <TextBlock Name="FileLinesText" Classes="tag size-13" Text="{Binding FileLines}" TextWrapping="Wrap"
                       Margin="12,8"
                       IsVisible="{Binding FileLines, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <TextBlock Classes="prompt-note size-13"
                 Text="The command is what the run says it will start. Allow only a run you started: every value goes into its environment." />

      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
          <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                  IsCancel="True" Command="{Binding DenyCommand}" />
          <Button Grid.Column="1" Name="AllowOnce" Classes="prompt primary" Content="Allow once"
                  Command="{Binding AllowOnceCommand}" />
        </Grid>
      </StackPanel>

    </StackPanel>
  </Border>

</views:PromptWindow>
