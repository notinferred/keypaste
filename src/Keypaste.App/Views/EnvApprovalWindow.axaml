<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.EnvApprovalWindow"
                    x:DataType="vm:EnvApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: a run is asking for a project's variables"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Fixed heights, as in ApprovalWindow: the command, directory and names are what the runner
       sent, so each sits in a box that wraps and scrolls and none of them can move the question or
       the buttons (THREATS.md T-2, T-30). Only the header and the requester line are trimmed to one
       line; no part of a command is hidden past an edge. No button is the default: Enter approves
       nothing, and Escape denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <Grid Classes="prompt-head" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="prompt-tile">
          <ctl:KpIcon Icon="terminal" Size="18" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Name="TitleText" Classes="prompt-title" Text="{Binding Title}" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Name="ProjectText" Classes="prompt-sub" Text="{Binding Project}"
                       MaxWidth="160" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="prompt-sub" Text=" · profile " />
            <TextBlock Name="ProfileText" Classes="prompt-sub" Text="{Binding Profile}"
                       MaxWidth="100" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="dot waiting" />
          <TextBlock Name="CountdownText" Classes="prompt-countdown" Text="{Binding Countdown}" />
        </StackPanel>
      </Grid>

      <TextBlock Name="RequesterText" Classes="prompt-sub" TextTrimming="CharacterEllipsis"
                 Text="{Binding Requester, StringFormat='asked by {0}'}"
                 IsVisible="{Binding Requester, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Classes="prompt-call" Height="58">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12,10">
          <StackPanel Spacing="2">
            <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed" Text="{Binding Scrubbed}"
                       IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="run" />
              <TextBlock Grid.Row="0" Grid.Column="1" Name="CommandText" Classes="value" Text="{Binding Command}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="in" />
              <TextBlock Grid.Row="1" Grid.Column="1" Name="DirectoryText" Text="{Binding Directory}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- The names, one row each: the rows draw the dividers and the tags, and KeysText draws the
           names over them at the same line height, so the list reads as one text. A name too long
           for its column ends in an ellipsis before the tag rather than running under it. -->
      <Border Classes="prompt-list" Height="110">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Panel>
              <ItemsControl ItemsSource="{Binding KeyNames}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="prompt-row" Height="36">
                      <TextBlock Classes="tag" Text="inject only" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Name="KeysText" Text="{Binding Keys}" LineHeight="36" Margin="12,0,104,0"
                         TextTrimming="CharacterEllipsis" ClipToBounds="True" />
            </Panel>
            <TextBlock Name="FileLinesText" Classes="tag" Text="{Binding FileLines}" TextWrapping="Wrap" FontSize="11.5"
                       Margin="12,8"
                       IsVisible="{Binding FileLines, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <TextBlock Classes="prompt-note"
                 Text="The command is what the run says it will start. Allow only a run you started: every value goes into its environment." />

      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
          <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                  IsCancel="True" Command="{Binding DenyCommand}" />
          <Button Grid.Column="1" Name="AllowOnce" Classes="prompt" Content="Allow once"
                  Command="{Binding AllowOnceCommand}" />
          <Button Grid.Column="2" Name="Approve" Classes="prompt primary" Content="{Binding TimedLabel}"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding OffersTimed}" Command="{Binding ApproveCommand}" />
        </Grid>
        <TextBlock Name="TimedCaptionText" Classes="caption" Text="{Binding TimedCaption}"
                   IsVisible="{Binding TimedCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

    </StackPanel>
  </Border>

</views:PromptWindow>
