<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.EnvApprovalWindow"
                    x:DataType="vm:EnvApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: a run is asking for an environment"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card for keypaste run, asked every time with Allow once only. The command, directory and names are what the
       runner sent, so they sit in a block of fixed height that wraps and scrolls: none can move the question or the buttons,
       and no part of a command is hidden past an edge (THREATS.md T-2, T-30). The stage is drawn whole beside the folder.
       Return presses the primary only once it is armed; Escape denies. -->

  <Border Classes="claim">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <StackPanel Spacing="4">
          <TextBlock Name="TitleText" Classes="claim-title size-16" Text="{Binding Title}" />
          <StackPanel Orientation="Horizontal" Spacing="6" Height="20">
            <ctl:KpIcon Classes="claim-muted" Icon="layers" Size="14" VerticalAlignment="Center" />
            <TextBlock Name="ProjectText" Classes="claim-muted size-12-5" Text="{Binding Project}" MaxWidth="380" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <Border Classes="claim-block" Height="148">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Name="ScrubbedText" Classes="claim-muted size-12-5" Text="{Binding Scrubbed}" TextWrapping="Wrap"
                         IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock Classes="mono" Text="$" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Grid.Column="1" Name="CommandText" Classes="mono" Text="{Binding Command}" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="claim-line size-12-5" Text="It can read:" />
                <ItemsControl Name="KeysList" ItemsSource="{Binding Keys}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvApprovalKey">
                      <Border Classes="claim-chip" ToolTip.Tip="{Binding Entry}">
                        <TextBlock Classes="key mono size-12" Text="{Binding Key}" TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="NoKeysText" Classes="claim-muted size-12-5" Text="nothing" IsVisible="{Binding HasNoKeys}" />
                <TextBlock Name="FileLinesText" Classes="mono" Text="{Binding FileLines}" TextWrapping="Wrap"
                           IsVisible="{Binding FileLines, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <ctl:KpIcon Classes="claim-muted" Icon="folder" Size="14" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Name="DirectoryText" Classes="mono" Text="{Binding Directory}" MaxWidth="240" TextWrapping="Wrap" Foreground="{DynamicResource KpTextMuted}" />
                <TextBlock Grid.Column="2" Classes="claim-muted size-12-5" Text="&#x00B7;" VerticalAlignment="Top" />
                <TextBlock Grid.Column="3" Name="ProfileText" Classes="claim-agent size-12-5" Text="{Binding Profile}" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <TextBlock Name="ConsequenceText" Classes="claim-line size-12-5" Text="{Binding Consequence}" />

          <StackPanel Spacing="8">
            <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                <TextBlock Classes="size-12-5" Text="Details" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Grid Classes="claim-facts size-12-5" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="4" Margin="20,0,0,0" IsVisible="{Binding #DetailsToggle.IsChecked}">
              <TextBlock Grid.Row="0" Classes="fact" Text="Items" />
              <TextBlock Grid.Row="0" Grid.Column="1" Name="EntriesText" Classes="mono" Text="{Binding Entries}" />
              <TextBlock Grid.Row="1" Classes="fact" Text="Asked by" />
              <TextBlock Grid.Row="1" Grid.Column="1" Name="RequesterText" Text="{Binding AskedBy}" />
              <TextBlock Grid.Row="2" Classes="fact" Text="Process" />
              <TextBlock Grid.Row="2" Grid.Column="1" Name="ProcessText" Classes="mono" Text="{Binding Process}" />
            </Grid>
          </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <ctl:HeaderRow Classes="claim-foot" Spacing="8">
        <ctl:SteadyDigits Name="CountdownText" Classes="claim-muted size-12-5" Text="{Binding DeniesIn}" VerticalAlignment="Center"
                          TextWrapping="NoWrap" IsVisible="{Binding IsChoosing}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                  IsVisible="{Binding IsChoosing}" Command="{Binding DenyCommand}" />
          <Button Name="AllowOnce" Classes="claim keyed primary" Content="Allow once" Tag="&#x21A9;"
                  IsVisible="{Binding IsChoosing}" Command="{Binding AllowOnceCommand}" />
        </StackPanel>
      </ctl:HeaderRow>
    </StackPanel>
  </Border>

</views:PromptWindow>
