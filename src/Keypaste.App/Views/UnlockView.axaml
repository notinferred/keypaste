<UserControl xmlns:res="using:Keypaste.App.Resources"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel"
             Background="{DynamicResource KpBgApp}">

  <!-- Every vault locked, drawn as the window's shell draws a locked vault: the vaults this computer opened as locked sidebar
       rows, choosing one shows its unlock form, and Add vault… at the sidebar's foot. With none yet, the welcome alone. -->
  <Panel DragDrop.AllowDrop="True">
    <Grid ColumnDefinitions="Auto,*">

      <Border Name="RecentSidebar"
              Grid.Column="0"
              Width="{x:Static views:WindowChrome.SidebarWidth}"
              Background="{DynamicResource KpBgSidebar}"
              BorderBrush="{DynamicResource KpBorderSubtle}"
              BorderThickness="0,0,1,0"
              IsVisible="{Binding HasRecent}">
        <DockPanel Margin="8,0,8,8">
          <Border DockPanel.Dock="Top" Height="{x:Static views:WindowChrome.TitleBarHeight}" Margin="0,0,0,10" />
          <Button Name="AddVault"
                  DockPanel.Dock="Bottom"
                  Classes="ghost sm"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Margin="0,8,0,0"
                  AutomationProperties.Name="{x:Static res:Strings.AddVaultLabel}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:KpIcon Icon="plus" Size="16" />
              <TextBlock Text="{x:Static res:Strings.AddVaultLabel}" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <ctl:ButtonMenu>
                <MenuItem Name="OpenVault" Header="{x:Static res:Strings.OpenAVault}" Command="{Binding BrowseCommand}" />
                <MenuItem Name="CreateVault" Header="{x:Static res:Strings.CreateAVault}" Command="{Binding StartCreateCommand}" />
              </ctl:ButtonMenu>
            </Button.Flyout>
          </Button>

          <TextBlock DockPanel.Dock="Top" Classes="section-heading" Margin="8,0,8,4" Text="{Binding RecentHeading}" />

          <ListBox Name="RecentList"
                   Classes="nav"
                   AutomationProperties.Name="{x:Static res:Strings.RecentVaults}"
                   ItemsSource="{Binding Recent}"
                   SelectedItem="{Binding SelectedRecent}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentVaultItem">
                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Location}">
                  <TextBlock Classes="vault" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ctl:KpIcon Grid.Column="1" Icon="lock" Size="14" IsVisible="{Binding Exists}" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{x:Static res:Strings.Missing}" IsVisible="{Binding !Exists}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Panel Margin="24,40" HorizontalAlignment="Center" VerticalAlignment="Center">

          <views:UnlockForm Name="Form" IsVisible="{Binding !ShowsWelcome}" />

          <!-- No vault chosen: the mark, then making or opening one; KeePassXC's own vaults first where it has any. -->
          <StackPanel Name="Welcome" Width="300" Spacing="16" IsVisible="{Binding ShowsWelcome}">
            <ctl:BrandMark Width="56" HorizontalAlignment="Center" />

            <StackPanel Spacing="6" IsVisible="{Binding OffersKeePassXc}">
              <TextBlock Classes="section-heading" Text="{x:Static res:Strings.KeePassXcLastOpened}" />
              <Border Classes="group">
                <ListBox Name="KeePassXcList"
                         Classes="nav"
                         AutomationProperties.Name="{x:Static res:Strings.KeePassXCsDatabases}"
                         ItemsSource="{Binding KeePassXc}"
                         SelectedItem="{Binding SelectedKeePassXc}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeePassXcDatabaseItem">
                      <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Location}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Name="CreateFirst" Classes="primary" Content="{x:Static res:Strings.CreateAVault}" Command="{Binding StartCreateCommand}" />
              <Button Name="OpenFirst" Content="{x:Static res:Strings.OpenAVault}" Command="{Binding BrowseCommand}" />
            </StackPanel>

            <Button Name="WhatsAVault" Classes="link" HorizontalAlignment="Center" Content="{x:Static res:Strings.WhatsAVault}">
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <TextBlock MaxWidth="280" TextWrapping="Wrap" Classes="size-13" Text="{x:Static res:Strings.AVaultIsAnEncryptedFile}" />
                </Flyout>
              </Button.Flyout>
            </Button>

            <TextBlock Classes="size-13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource KpDanger}"
                       ctl:Announcer.Says="{Binding Message}"
                       Text="{Binding Message}"
                       IsVisible="{Binding HasLooseError}" />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Grid>
    <ctl:DropCue Name="Cue" />
  </Panel>

</UserControl>
