<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel"
             Background="{DynamicResource KpSurface0}">

  <!-- The app's first impression. A centred card, generous padding, the vault's file name as the
       heading, a quiet recent list and one primary button. No key art, no shield, no padlock. -->

  <Border HorizontalAlignment="Center" VerticalAlignment="Center"
          Width="460"
          Background="{DynamicResource KpSurface1}"
          BorderBrush="{DynamicResource KpBorderSubtle}"
          BorderThickness="1"
          CornerRadius="{DynamicResource KpRadiusMd}"
          Padding="{DynamicResource KpCardPadding}"
          DragDrop.AllowDrop="True">

    <StackPanel Spacing="16">

      <TextBlock Text="keypaste"
                 FontSize="13"
                 Foreground="{DynamicResource KpTextMuted}" />

      <!-- Opening an existing vault. -->
      <StackPanel Spacing="16" IsVisible="{Binding IsOpening}">

        <TextBlock Text="{Binding SelectedName}"
                   IsVisible="{Binding HasSelection}"
                   FontSize="22"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KpTextPrimary}" />

        <TextBlock Text="Open a vault"
                   IsVisible="{Binding !HasSelection}"
                   FontSize="22"
                   Foreground="{DynamicResource KpTextPrimary}" />

        <TextBlock Text="No vaults yet. Create one, drag a .kdbx file here, or browse for one."
                   IsVisible="{Binding HasNoRecent}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource KpTextSecondary}" />

        <ListBox ItemsSource="{Binding Recent}"
                 IsVisible="{Binding HasRecent}"
                 MaxHeight="150"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectedItem="{Binding SelectedRecent}"
                 x:Name="RecentList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentVaultItem">
              <StackPanel Spacing="1" ToolTip.Tip="{Binding Path}">
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource KpTextPrimary}" />
                <TextBlock Text="missing"
                           IsVisible="{Binding !Exists}"
                           FontSize="11"
                           Foreground="{DynamicResource KpTextMuted}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ctl:MaskedInput x:Name="Password"
                         MaskedLength="{Binding MaskedLength}"
                         Placeholder="Master password"
                         IsEnabled="{Binding HasSelection}" />
      </StackPanel>

      <!-- Making one. The path is already chosen by the time this shows. -->
      <StackPanel Spacing="16" IsVisible="{Binding IsCreating}">

        <TextBlock Text="{Binding NewVaultName}"
                   FontSize="22"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KpTextPrimary}" />

        <TextBlock Text="Choose a master password. There is no way to recover it."
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource KpTextSecondary}" />

        <ctl:MaskedInput x:Name="NewPassword"
                         MaskedLength="{Binding NewMaskedLength}"
                         Placeholder="New master password" />

        <ctl:MaskedInput x:Name="ConfirmPassword"
                         MaskedLength="{Binding ConfirmMaskedLength}"
                         Placeholder="Confirm master password" />
      </StackPanel>

      <TextBlock Text="{Binding Message}"
                 IsVisible="{Binding HasMessage}"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="{DynamicResource KpTextSecondary}" />

      <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsOpening}">
        <Button Grid.Column="0"
                Content="Create…"
                Command="{Binding StartCreateCommand}" />
        <Button Grid.Column="1"
                Content="Browse…"
                Margin="8,0,0,0"
                Command="{Binding BrowseCommand}" />
        <Button Grid.Column="3"
                Content="Unlock"
                IsDefault="True"
                Command="{Binding UnlockCommand}"
                Classes="accent" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsCreating}">
        <Button Grid.Column="0"
                Content="Cancel"
                Command="{Binding CancelCreateCommand}" />
        <Button Grid.Column="2"
                Content="Create vault"
                IsDefault="True"
                Command="{Binding CreateCommand}"
                Classes="accent" />
      </Grid>

      <TextBlock Text="Opening…"
                 IsVisible="{Binding Busy}"
                 FontSize="12"
                 Foreground="{DynamicResource KpTextMuted}" />

    </StackPanel>
  </Border>

</UserControl>
