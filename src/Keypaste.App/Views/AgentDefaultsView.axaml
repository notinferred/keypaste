<UserControl xmlns:res="using:Keypaste.App.Resources"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.AgentDefaultsView"
             x:DataType="vm:AgentRulesViewModel">

  <!-- Settings › Agents: what every agent can see and gets when it asks, unless its own rule in Agents says otherwise. No amber:
       the confirmation's button, for an Allow or a switch turned on, is a secondary one, so the screen keeps its one. -->
  <StackPanel Name="AgentRulesCard" Classes="sections">
    <Border Name="AgentRulesIgnored" Classes="group padded" IsVisible="{Binding IsIgnored}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <ctl:KpIcon Icon="triangle-alert" Size="16" Foreground="{DynamicResource KpDanger}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Name="AgentRulesIgnoredText" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}"
                   ctl:Announcer.Says="{Binding Ignored}" Text="{Binding Ignored}" />
      </Grid>
    </Border>
    <TextBlock Name="AgentRulesProblem" Classes="body danger" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" ctl:Announcer.Says="{Binding Problem}" Text="{Binding Problem}" />

    <StackPanel Classes="section" IsVisible="{Binding !HasProblem}">
      <TextBlock Classes="section-heading" Text="{x:Static res:Strings.CanSee}" />
      <Border Classes="group">
        <ctl:GroupedRows>
          <ctl:FieldRow Label="{x:Static res:Strings.Usernames}">
            <ToggleSwitch Name="ShowUsernames"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{x:Static res:Strings.AgentsSeeUsernames}"
                          ToolTip.Tip="{x:Static res:Strings.AgentsAlwaysSeeAnItemsTitleGroupTagsAndURL}"
                          IsChecked="{Binding ShowsUsername}" />
          </ctl:FieldRow>
          <ctl:FieldRow Label="{x:Static res:Strings.HostsAndReferences}">
            <ToggleSwitch Name="ShowHostsAndReferences"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{x:Static res:Strings.AgentsSeeHostsAndReferences}"
                          AutomationProperties.HelpText="{x:Static res:Strings.AgentsSeeAnItemsHostFieldAndWhichItemsItReferences}"
                          ToolTip.Tip="{x:Static res:Strings.AgentsSeeAnItemsHostFieldAndWhichItemsItReferences}"
                          IsChecked="{Binding ShowsLinkedHosts}" />
          </ctl:FieldRow>
        </ctl:GroupedRows>
      </Border>
    </StackPanel>

    <StackPanel Classes="section" IsVisible="{Binding !HasProblem}">
      <TextBlock Classes="section-heading" Text="{x:Static res:Strings.WhenItAsks}" />
      <Border Classes="group">
        <ItemsControl Name="CategoryRules" ItemsSource="{Binding Rows}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <ctl:GroupedRows />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryRow">
              <ctl:FieldRow Label="{Binding Name}">
                <Border Classes="segmented" HorizontalAlignment="Left">
                  <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CategoryChoice">
                        <ctl:ChoiceSegment Name="RuleChoice" Classes="segment"
                                           IsChecked="{Binding IsChosen, Mode=OneWay}"
                                           Command="{Binding $parent[UserControl].((vm:AgentRulesViewModel)DataContext).ChooseCommand}"
                                           CommandParameter="{Binding}"
                                           AutomationProperties.Name="{Binding Words}">
                          <TextBlock Text="{Binding Words}" VerticalAlignment="Center" />
                        </ctl:ChoiceSegment>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </ctl:FieldRow>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.EachKindOfValueIsAskedAllowedOrBlocked}" />

      <Border Name="GrantConfirmation" Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True"
              ctl:FormKeys.Cancel="{Binding CancelGrantCommand}">
        <StackPanel Spacing="8">
          <TextBlock Name="GrantConfirmationText" Text="{Binding ConfirmText}" TextWrapping="Wrap" Classes="primary size-13" />
          <TextBlock Name="GrantConfirmationCaption" Classes="caption" TextWrapping="Wrap" Text="{Binding ConfirmCaption}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="CancelGrant" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelGrantCommand}" />
            <Button Name="ConfirmGrant" Classes="sm" Content="{Binding ConfirmAction}" Command="{Binding ConfirmGrantCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Name="AgentRulesMessage" Classes="caption" TextWrapping="Wrap" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
    </StackPanel>
  </StackPanel>

</UserControl>
