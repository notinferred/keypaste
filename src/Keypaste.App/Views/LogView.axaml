<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.LogView"
             x:DataType="vm:LogViewModel"
             views:TableColumns.Table="{Binding Table}"
             Background="{DynamicResource KpBgApp}">

  <!-- With the content tight the table has no room to scroll to its Result, so Where gives way to it and moves to the Values cell's tooltip. -->
  <UserControl.Styles>
    <Style Selector="ListBox#Rows > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel#LogTable">
      <Setter Property="MinWidth" Value="680" />
    </Style>
    <Style Selector="Grid.tight-content StackPanel#LogTable">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Grid.tight-content views|LogColumns">
      <Setter Property="ShowsWhere" Value="False" />
    </Style>
    <Style Selector="Grid.tight-content TextBlock.where, Grid.tight-content views|ColumnGrip.where">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.tight-content TextBlock.secrets">
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding SecretsAndWhere}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Name="LogPage" Margin="24,16,24,24">
      <StackPanel Spacing="16">

        <!-- The heading, then whether the log holds and how many records show, the file's path on its tooltip. -->
        <ctl:HeaderRow Spacing="16">
          <!-- Not the handoff's "stored inside the vault, signed": the log is plaintext machine state, hash-chained. -->
          <TextBlock Classes="h1" Text="{x:Static res:Strings.Activity}" ToolTip.Tip="{x:Static vm:LogViewModel.Subtitle}" VerticalAlignment="Center" />

          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <StackPanel Name="LogStatus" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Background="Transparent"
                        IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Binding LogPath}" AutomationProperties.Name="{Binding Status}">
              <ctl:KpIcon Icon="check" Size="14" IsVisible="{Binding !StatusIsEdited}" Foreground="{DynamicResource KpOk}" />
              <ctl:KpIcon Icon="alert-triangle" Size="14" IsVisible="{Binding StatusIsEdited}" Foreground="{DynamicResource KpDanger}" />
              <TextBlock Name="StatusText" Classes="size-13" Text="{Binding Status}" VerticalAlignment="Center"
                         Classes.danger="{Binding StatusIsEdited}" Classes.secondary="{Binding !StatusIsEdited}" />
            </StackPanel>
            <Button Classes="icon ghost sm"
                    Name="RefreshLog"
                    ToolTip.Tip="{x:Static res:Strings.ReadTheLogAgain}"
                    AutomationProperties.Name="{x:Static res:Strings.Refresh}"
                    Command="{Binding RefreshCommand}">
              <ctl:KpIcon Icon="refresh-cw" Size="14" />
            </Button>
          </StackPanel>
        </ctl:HeaderRow>

        <Border Classes="segmented" Name="Filter" HorizontalAlignment="Left" IsVisible="{Binding HasTable}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.All}" IsChecked="{Binding ShowAll}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.Agents}" IsChecked="{Binding ShowAgents}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.You}" IsChecked="{Binding ShowYou}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.Denied}" IsChecked="{Binding ShowDenied}" />
          </StackPanel>
        </Border>

        <!-- One sentence about a file that is unreadable or unchecked; an edited one says so in the status. A log never written to is the empty state below. -->
        <Border Classes="card filled"
                Padding="12,8"
                IsVisible="{Binding HasNotice}">
          <Grid ColumnDefinitions="Auto,*">
            <ctl:KpIcon Grid.Column="0"
                        Icon="info"
                        Size="14"
                        Margin="0,0,8,0"
                        IsVisible="{Binding !IsBroken}"
                        Foreground="{DynamicResource KpTextMuted}" />
            <ctl:KpIcon Grid.Column="0"
                        Icon="alert-triangle"
                        Size="14"
                        Margin="0,0,8,0"
                        IsVisible="{Binding IsBroken}"
                        Foreground="{DynamicResource KpWarn}" />
            <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                       Name="Message"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Classes="size-13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextSecondary}" />
          </Grid>
        </Border>

        <!-- Check log integrity's verdict: a line, at most one sentence, and behind Learn more the breaks and what the check can't prove. -->
        <Border Classes="card"
                Name="Verdict"
                Padding="14,12"
                IsVisible="{Binding VerdictShown}"
                ToolTip.Tip="{Binding Verdict.Path}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Panel VerticalAlignment="Top" Margin="0,2,0,0">
              <ctl:KpIcon Icon="check" Size="14" IsVisible="{Binding Verdict.IsOk}" Foreground="{DynamicResource KpOk}" />
              <ctl:KpIcon Icon="alert-triangle" Size="14" IsVisible="{Binding Verdict.IsDanger}" Foreground="{DynamicResource KpDanger}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Name="VerdictHeadline" Text="{Binding Verdict.Headline}" Classes="size-13" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource KpTextPrimary}" ctl:Announcer.Says="{Binding Verdict.Headline}" />
              <TextBlock Text="{Binding Verdict.Sentence}" IsVisible="{Binding Verdict.HasSentence}" Classes="size-13" TextWrapping="Wrap"
                         Foreground="{DynamicResource KpTextSecondary}" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Name="LearnMore" Classes="link" Content="{x:Static res:Strings.LearnMore}" Command="{Binding LearnMoreCommand}" />
                <Button Name="CopyHash" Classes="link" Content="{x:Static res:Strings.CopyLatestHash}"
                        IsVisible="{Binding Verdict.HasHash}" Command="{Binding CopyHashCommand}" />
              </StackPanel>
              <StackPanel Name="VerdictLimits" Spacing="8" IsVisible="{Binding LimitsShown}">
                <ItemsControl ItemsSource="{Binding Verdict.Breaks}" IsVisible="{Binding Verdict.HasBreaks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="size-13" Foreground="{DynamicResource KpTextPrimary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Verdict.Paragraphs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock ctl:MachineRuns.InText="True" Text="{Binding}" TextWrapping="Wrap" Classes="size-13" LineHeight="19"
                                 MaxWidth="640" HorizontalAlignment="Left" Foreground="{DynamicResource KpTextSecondary}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Name="HideVerdict" Classes="ghost sm" VerticalAlignment="Top" Content="{x:Static res:Strings.Hide}" Command="{Binding HideVerdictCommand}" />
          </Grid>
        </Border>

        <!-- Nothing has been written yet, which is normal: said once, in the middle of the page. -->
        <ctl:EmptyState Name="Empty"
                        Icon="activity"
                        Text="{x:Static res:Strings.NoActivityYet}"
                        Helper="{Binding Message}"
                        IsVisible="{Binding IsEmpty}"
                        VerticalAlignment="Top"
                        Margin="0,56,0,0">
          <Button Name="ConnectFromLog"
                  Classes="sm"
                  Content="{x:Static res:Strings.ConnectAnAIToolEllipsis}"
                  IsVisible="{Binding OffersConnect}"
                  Command="{Binding ConnectCommand}" />
        </ctl:EmptyState>

        <StackPanel Spacing="12">
        <!-- The heads are labels; the edges between them size the columns. Nothing here sorts. -->
        <Border Classes="table" IsVisible="{Binding HasTable}">
          <ScrollViewer Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <!-- As wide as the table when it fits, so its star columns trim; at most 680 narrower, where it scrolls. -->
            <StackPanel Name="LogTable" Width="{Binding #TableScroll.Viewport.Width}">

              <Border Classes="table-head top" Padding="16,6">
                <views:LogColumns>
                  <views:ColumnHead Grid.Column="0" Column="time" />
                  <views:ColumnGrip Grid.Column="0" Column="time" />
                  <views:ColumnHead Grid.Column="1" Column="actor" />
                  <views:ColumnGrip Grid.Column="1" Column="actor" />
                  <views:ColumnHead Grid.Column="2" Column="action" />
                  <views:ColumnGrip Grid.Column="2" Column="action" />
                  <views:ColumnHead Grid.Column="3" Column="secrets" />
                  <views:ColumnGrip Grid.Column="3" Column="secrets" />
                  <views:ColumnHead Grid.Column="4" Classes="where" Column="where" />
                  <views:ColumnGrip Grid.Column="4" Classes="where" Column="where" />
                  <views:ColumnHead Grid.Column="5" Column="result" />
                </views:LogColumns>
              </Border>

              <ListBox Name="Rows"
                       AutomationProperties.Name="{x:Static res:Strings.Activity}"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemsSource="{Binding Rows}"
                       SelectedItem="{Binding Chosen}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogRow">
                    <StackPanel>

                      <!-- The first row of a day carries the day, so the TIME column can stay a clock. -->
                      <Border IsVisible="{Binding StartsDay}"
                              Padding="16,6"
                              BorderThickness="0,1,0,0"
                              BorderBrush="{DynamicResource KpBorderSubtle}"
                              Background="{DynamicResource KpBgPanel}">
                        <TextBlock Text="{Binding Day}"
                                   Classes="size-13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource KpTextMuted}" />
                      </Border>

                      <Panel>
                        <Border Classes="table-row" ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding RowName}">
                          <views:LogColumns>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Time}"
                                       ToolTip.Tip="{Binding When}"
                                       FontFamily="{DynamicResource KpMono}"
                                       Classes="size-12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextMuted}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Actor}"
                                       Classes="size-13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Action}"
                                       Classes="size-13"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextSecondary}" />

                            <!-- Value names are machine words; "names only" is a note about them, in the interface face. -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Secrets}"
                                       IsVisible="{Binding !NamesOnly}"
                                       FontFamily="{DynamicResource KpMono}"
                                       Classes="size-12 secrets"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Secrets}"
                                       IsVisible="{Binding NamesOnly}"
                                       Classes="size-13 muted"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Where}"
                                       ToolTip.Tip="{Binding WhereInFull}"
                                       Classes="size-13 where"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextSecondary}" />

                            <!-- What came of it, its marks beside it: Edited where the chain breaks, unchecked where it can't vouch, and the unread reason's warning. -->
                            <Grid Grid.Column="5" ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                              <Border Grid.Column="0"
                                      Classes="dot"
                                      Margin="0,0,6,0"
                                      IsVisible="{Binding !Edited}"
                                      Classes.ok="{Binding IsOk}"
                                      Classes.danger="{Binding IsDanger}"
                                      Classes.info="{Binding IsInfo}" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,6,0" Background="Transparent"
                                          IsVisible="{Binding Edited}" ToolTip.Tip="{Binding EditedWords}">
                                <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpDanger}" />
                                <TextBlock Text="{x:Static res:Strings.Edited}" Classes="size-13 danger" FontWeight="Medium" VerticalAlignment="Center" />
                              </StackPanel>
                              <!-- It may run into the row's end padding before it trims. -->
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Result}"
                                         Margin="0,0,-12,0"
                                         Classes="size-13"
                                         FontWeight="Medium"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center"
                                         Classes.ok="{Binding IsOk}"
                                         Classes.danger="{Binding IsDanger}"
                                         Classes.info="{Binding IsInfo}"
                                         Classes.muted="{Binding IsMuted}" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="16,0,0,0">
                                <Border Name="UnreadReason"
                                        Background="Transparent"
                                        IsVisible="{Binding ReasonUnread}"
                                        ToolTip.Tip="{x:Static res:Strings.ServedFromAnEarlierApprovalUnderAXde6ddd}"
                                        AutomationProperties.Name="{x:Static res:Strings.ServedFromAnEarlierApprovalUnderAXde6ddd}">
                                  <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpTextSecondary}" />
                                </Border>
                                <Border Name="UncheckedRecord"
                                        Background="Transparent"
                                        IsVisible="{Binding Unchecked}"
                                        ToolTip.Tip="{x:Static res:Strings.KeypasteCantVouchForThisRecord}"
                                        AutomationProperties.Name="{x:Static res:Strings.KeypasteCantVouchForThisRecord}">
                                  <ctl:KpIcon Icon="info" Size="14" Foreground="{DynamicResource KpTextMuted}" />
                                </Border>
                              </StackPanel>
                            </Grid>

                          </views:LogColumns>
                        </Border>

                      </Panel>

                      <!-- A chosen line opens to keypaste's account of it and the full time. -->
                      <Border IsVisible="{Binding $parent[ListBoxItem].IsSelected}" Padding="16,0,16,12">
                        <StackPanel Spacing="4">
                          <TextBlock ctl:MachineRuns.InText="True" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource KpTextSecondary}" />
                          <TextBlock Name="SubjectInFull" Text="{Binding Subject}" IsVisible="{Binding HasSubject}" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource KpMono}" Classes="size-12" Foreground="{DynamicResource KpTextSecondary}" />
                          <TextBlock Text="{Binding When}" FontFamily="{DynamicResource KpMono}" Classes="size-12" Foreground="{DynamicResource KpTextMuted}" />
                        </StackPanel>
                      </Border>

                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Classes="table-row" IsVisible="{Binding FilterEmpty}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{x:Static res:Strings.NothingInThisLogMatchesThisFilter}"
                             Classes="size-13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource KpTextMuted}" />
                  <Button Classes="sm"
                          Name="ShowWholeLog"
                          Content="{x:Static res:Strings.ShowAll}"
                          IsVisible="{Binding OffersShowAll}"
                          Command="{Binding ShowWholeLogCommand}"
                          AutomationProperties.Name="{x:Static res:Strings.ShowAll}" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- Lines of the file that are not records, said once under the table. -->
        <Grid Name="Notes" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasUnreadableNote}">
          <ctl:KpIcon Icon="info" Size="14" VerticalAlignment="Center" Foreground="{DynamicResource KpTextMuted}" />
          <TextBlock Grid.Column="1" Classes="size-13 secondary" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding UnreadableNote}" />
        </Grid>
        </StackPanel>

      </StackPanel>
    </Grid>
  </ScrollViewer>

</UserControl>
