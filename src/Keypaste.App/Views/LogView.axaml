<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.LogView"
             x:DataType="vm:LogViewModel"
             views:TableColumns.Table="{Binding Table}"
             Background="{DynamicResource KpBgApp}">

  <!-- With the content tight the table has no room to scroll to its Result, so Where gives way to it and moves to the Secrets cell's tooltip. -->
  <UserControl.Styles>
    <Style Selector="ListBox#Rows > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="StackPanel#LogTable">
      <Setter Property="MinWidth" Value="680" />
    </Style>
    <Style Selector="Grid.tight-content StackPanel#LogTable">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Grid.tight-content views|LogColumns">
      <Setter Property="ShowsWhere" Value="False" />
    </Style>
    <Style Selector="Grid.tight-content TextBlock.where, Grid.tight-content Button.where, Grid.tight-content views|ColumnGrip.where">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.tight-content TextBlock.secrets">
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding SecretsAndWhere}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Name="LogPage" Margin="24,16,24,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="880" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="16">

        <!-- The actions go on a line of their own under the title when the two do not fit side by side. -->
        <ctl:HeaderRow Spacing="16">
          <!-- Not the handoff's "stored inside the vault, signed": the log is plaintext machine state, hash-chained. -->
          <TextBlock Classes="list-title" Text="{x:Static res:Strings.Activity}" ToolTip.Tip="{x:Static vm:LogViewModel.Subtitle}" VerticalAlignment="Bottom" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <Button Classes="ghost sm"
                    Name="VerifyChain"
                    IsVisible="{Binding OffersVerify}"
                    Content="{Binding VerifyLabel}"
                    Command="{Binding VerifyCommand}" />
            <Button Classes="icon ghost sm"
                    Name="RefreshLog"
                    ToolTip.Tip="{x:Static res:Strings.ReadTheLogAgain}"
                    AutomationProperties.Name="{x:Static res:Strings.Refresh}"
                    Command="{Binding RefreshCommand}">
              <ctl:KpIcon Icon="refresh-cw" Size="14" />
            </Button>
          </StackPanel>
        </ctl:HeaderRow>

        <Border Classes="segmented" Name="Filter" HorizontalAlignment="Left" IsVisible="{Binding HasTable}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.All}" IsChecked="{Binding ShowAll}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.Agents}" IsChecked="{Binding ShowAgents}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.You}" IsChecked="{Binding ShowYou}" />
            <RadioButton Classes="segment" GroupName="LogFilter" Content="{x:Static res:Strings.Denied}" IsChecked="{Binding ShowDenied}" />
          </StackPanel>
        </Border>

        <!-- One sentence about a file that is unreadable, unchecked or edited. A log never written to is the empty state below. -->
        <Border Classes="card filled"
                Padding="12,8"
                IsVisible="{Binding HasNotice}">
          <Grid ColumnDefinitions="Auto,*">
            <ctl:KpIcon Grid.Column="0"
                        Icon="info"
                        Size="14"
                        Margin="0,0,8,0"
                        IsVisible="{Binding !IsBroken}"
                        Foreground="{DynamicResource KpTextMuted}" />
            <ctl:KpIcon Grid.Column="0"
                        Icon="alert-triangle"
                        Size="14"
                        Margin="0,0,8,0"
                        IsVisible="{Binding IsBroken}"
                        Foreground="{DynamicResource KpWarn}" />
            <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                       Name="Message"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Classes="size-13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextSecondary}" />
          </Grid>
        </Border>

        <!-- The chain's verdict on request: a status line, the hash worth keeping, and what the check proves. -->
        <Border Classes="card"
                Name="Verdict"
                Padding="16,12"
                IsVisible="{Binding VerdictShown}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0"
                      Classes="dot"
                      Classes.ok="{Binding Verdict.IsOk}"
                      Classes.danger="{Binding Verdict.IsDanger}"
                      Margin="0,0,8,0" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Verdict.Headline}"
                         Classes="size-14"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextPrimary}" />
              <Button Grid.Column="2"
                      Classes="ghost sm"
                      Name="CopyHash"
                      Margin="12,-4,-6,-4"
                      IsVisible="{Binding Verdict.HasHash}"
                      Command="{Binding CopyHashCommand}"
                      AutomationProperties.Name="{x:Static res:Strings.CopyLatestHash}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:KpIcon Icon="copy" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.CopyLatestHash}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <SelectableTextBlock Text="{Binding Verdict.Hash}"
                                 IsVisible="{Binding Verdict.HasHash}"
                                 Margin="16,0,0,0"
                                 FontFamily="{DynamicResource KpMono}"
                                 Classes="size-12"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource KpTextMuted}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Verdict.Breaks}" IsVisible="{Binding Verdict.HasBreaks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}"
                             TextWrapping="Wrap"
                             Classes="size-13"
                             FontWeight="Medium"
                             Foreground="{DynamicResource KpTextPrimary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Verdict.Paragraphs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock ctl:MachineRuns.InText="True" Text="{Binding}"
                             TextWrapping="Wrap"
                             Classes="size-13"
                             LineHeight="19"
                             MaxWidth="760"
                             HorizontalAlignment="Left"
                             Foreground="{DynamicResource KpTextSecondary}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding Verdict.Path}">
              <ctl:KpIcon Grid.Column="0"
                          Icon="file-lock-2"
                          Size="14"
                          Margin="0,0,8,0"
                          Foreground="{DynamicResource KpTextMuted}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding ShortPath}"
                         FontFamily="{DynamicResource KpMono}"
                         Classes="size-12"
                         TextTrimming="PathSegmentEllipsis"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextMuted}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Nothing has been written yet, which is normal: said once, in the middle of the page. -->
        <StackPanel Name="Empty"
                    IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center"
                    Margin="0,56,0,0"
                    Spacing="8">
          <Border Classes="tile" Width="44" Height="44" CornerRadius="10" HorizontalAlignment="Center">
            <ctl:KpIcon Icon="activity" Size="20" Foreground="{DynamicResource KpTextMuted}" />
          </Border>
          <TextBlock Text="{x:Static res:Strings.NoActivityYet}"
                     Margin="0,4,0,0"
                     Classes="dialog-title"
                     HorizontalAlignment="Center" />
          <TextBlock ctl:MachineRuns.InText="True" Text="{Binding Message}"
                     MaxWidth="380"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Classes="size-13"
                     Foreground="{DynamicResource KpTextSecondary}" />
          <Button Name="OpenAgentsFromLog"
                  Classes="sm"
                  HorizontalAlignment="Center"
                  Margin="0,4,0,0"
                  Content="{x:Static res:Strings.OpenAgents}"
                  IsVisible="{Binding OffersAgents}"
                  Command="{Binding OpenAgentsCommand}" />
        </StackPanel>

        <StackPanel Spacing="12">
        <!-- The table's heads sort it and the edges between them size it; neither touches the chain or the file. -->
        <Border Classes="table" IsVisible="{Binding HasTable}">
          <ScrollViewer Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <!-- As wide as the table when it fits, so its star columns trim; at most 680 narrower, where it scrolls. -->
            <StackPanel Name="LogTable" Width="{Binding #TableScroll.Viewport.Width}">

              <Border Classes="table-head top" Padding="16,6">
                <views:LogColumns>
                  <views:ColumnHead Grid.Column="0" Column="time" />
                  <views:ColumnGrip Grid.Column="0" Column="time" />
                  <views:ColumnHead Grid.Column="1" Column="actor" />
                  <views:ColumnGrip Grid.Column="1" Column="actor" />
                  <views:ColumnHead Grid.Column="2" Column="action" />
                  <views:ColumnGrip Grid.Column="2" Column="action" />
                  <views:ColumnHead Grid.Column="3" Column="secrets" />
                  <views:ColumnGrip Grid.Column="3" Column="secrets" />
                  <views:ColumnHead Grid.Column="4" Classes="where" Column="where" />
                  <views:ColumnGrip Grid.Column="4" Classes="where" Column="where" />
                  <views:ColumnHead Grid.Column="5" Column="result" />
                </views:LogColumns>
              </Border>

              <ListBox Name="Rows"
                       AutomationProperties.Name="{x:Static res:Strings.Activity}"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ItemsSource="{Binding Rows}"
                       SelectedItem="{Binding Chosen}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogRow">
                    <StackPanel>

                      <!-- The first row of a day carries the day, so the TIME column can stay a clock. -->
                      <Border IsVisible="{Binding StartsDay}"
                              Padding="16,6"
                              BorderThickness="0,1,0,0"
                              BorderBrush="{DynamicResource KpBorderSubtle}"
                              Background="{DynamicResource KpBgPanel}">
                        <TextBlock Text="{Binding Day}"
                                   Classes="size-13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource KpTextMuted}" />
                      </Border>

                      <Panel>
                        <Border Classes="table-row" ToolTip.Tip="{Binding Detail}" AutomationProperties.Name="{Binding RowName}">
                          <views:LogColumns>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Time}"
                                       ToolTip.Tip="{Binding When}"
                                       FontFamily="{DynamicResource KpMono}"
                                       Classes="size-12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextMuted}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Actor}"
                                       Classes="size-13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Action}"
                                       Classes="size-13"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextSecondary}" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Secrets}"
                                       FontFamily="{DynamicResource KpMono}"
                                       Classes="size-12 secrets"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Where}"
                                       FontFamily="{DynamicResource KpMono}"
                                       Classes="size-12 where"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextMuted}" />

                            <Grid Grid.Column="5" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                              <Border Grid.Column="0"
                                      Classes="dot"
                                      Margin="0,0,6,0"
                                      Classes.ok="{Binding IsOk}"
                                      Classes.danger="{Binding IsDanger}"
                                      Classes.info="{Binding IsInfo}" />
                              <!-- It may run into the row's end padding before it trims. -->
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Result}"
                                         Margin="0,0,-12,0"
                                         Classes="size-13"
                                         FontWeight="Medium"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center"
                                         Classes.ok="{Binding IsOk}"
                                         Classes.danger="{Binding IsDanger}"
                                         Classes.info="{Binding IsInfo}"
                                         Classes.muted="{Binding IsMuted}" />
                              <Border Grid.Column="2"
                                      Margin="4,0,0,0"
                                      Background="Transparent"
                                      IsVisible="{Binding ReasonUnread}"
                                      ToolTip.Tip="{x:Static res:Strings.ServedFromAnEarlierApprovalUnderAXde6ddd}">
                                <ctl:KpIcon Icon="alert-triangle" Size="14" Foreground="{DynamicResource KpTextSecondary}" />
                              </Border>
                            </Grid>

                          </views:LogColumns>
                        </Border>

                        <!-- A row the chain cannot vouch for is marked at its edge, so the TIME column stays aligned. Red, not amber: several rows can be marked. -->
                        <Border IsVisible="{Binding Unverified}"
                                Width="2"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource KpDanger}" />
                      </Panel>

                      <!-- A chosen line opens to keypaste's account of it and the full time. -->
                      <Border IsVisible="{Binding $parent[ListBoxItem].IsSelected}" Padding="16,0,16,12">
                        <StackPanel Spacing="4">
                          <TextBlock ctl:MachineRuns.InText="True" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource KpTextSecondary}" />
                          <TextBlock Name="SubjectInFull" Text="{Binding Subject}" IsVisible="{Binding HasSubject}" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource KpMono}" Classes="size-12" Foreground="{DynamicResource KpTextSecondary}" />
                          <TextBlock Text="{Binding When}" FontFamily="{DynamicResource KpMono}" Classes="size-12" Foreground="{DynamicResource KpTextMuted}" />
                        </StackPanel>
                      </Border>

                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Border Classes="table-row" IsVisible="{Binding FilterEmpty}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{x:Static res:Strings.NothingInThisLogMatchesThisFilter}"
                             Classes="size-13"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource KpTextMuted}" />
                  <Button Classes="sm"
                          Name="ShowWholeLog"
                          Content="{x:Static res:Strings.ShowAll}"
                          IsVisible="{Binding OffersShowAll}"
                          Command="{Binding ShowWholeLogCommand}"
                          AutomationProperties.Name="{x:Static res:Strings.ShowAll}" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- What the marks mean, and how much of the log is shown. -->
        <StackPanel Spacing="6" IsVisible="{Binding HasTable}">
          <StackPanel Name="Notes" Spacing="4" IsVisible="{Binding HasNotes}">
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasUnverifiedNote}">
              <Border Width="2" Height="12" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource KpDanger}" />
              <TextBlock Classes="size-13"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextSecondary}"
                         Text="{x:Static vm:LogViewModel.UnverifiedLegend}" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasUnreadNote}">
              <ctl:KpIcon Icon="alert-triangle" Size="14" VerticalAlignment="Center" Foreground="{DynamicResource KpTextSecondary}" />
              <TextBlock Grid.Column="1"
                         Classes="size-13"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextSecondary}"
                         TextWrapping="Wrap"
                         Text="{x:Static res:Strings.ServedFromAnEarlierApprovalUnderAXde6ddd}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasUnreadableNote}">
              <ctl:KpIcon Icon="info" Size="14" VerticalAlignment="Center" Foreground="{DynamicResource KpTextMuted}" />
              <TextBlock Classes="size-13"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextSecondary}"
                         Text="{Binding UnreadableNote}" />
            </StackPanel>
          </StackPanel>

          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBlock Grid.Column="0"
                       Name="Summary"
                       Text="{Binding Summary}"
                       Classes="size-13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Grid.Column="1"
                       Text="·"
                       Margin="8,0"
                       Classes="size-13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ShortPath}"
                       ToolTip.Tip="{Binding LogPath}"
                       FontFamily="{DynamicResource KpMono}"
                       Classes="size-12"
                       TextTrimming="PathSegmentEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextMuted}" />
          </Grid>
        </StackPanel>
        </StackPanel>

      </StackPanel>
    </Grid>
  </ScrollViewer>

</UserControl>
