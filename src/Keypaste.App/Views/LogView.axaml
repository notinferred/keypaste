<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.LogView"
             x:DataType="vm:LogViewModel"
             Background="{DynamicResource KpBgApp}">

  <!-- The design's page: padding 28/32, content at most 1080 wide and left-aligned. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1080" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="20">

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Bottom">
            <TextBlock Classes="h1" Text="Activity" />
            <TextBlock Classes="subtitle"
                       Text="Every agent request, grant, token run and share. Kept on this machine, hash-chained, append-only." />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="16,0,0,0"
                      VerticalAlignment="Bottom">
            <Button Classes="ghost sm"
                    Name="VerifyChain"
                    Content="{Binding VerifyLabel}"
                    Command="{Binding VerifyCommand}" />
            <Button Classes="icon ghost sm"
                    Name="RefreshLog"
                    ToolTip.Tip="Read the log again"
                    AutomationProperties.Name="Refresh"
                    Command="{Binding RefreshCommand}">
              <ctl:KpIcon Icon="refresh-cw" Size="14" />
            </Button>
            <Border Classes="segmented" Name="Filter" IsEnabled="{Binding HasTable}">
              <StackPanel Orientation="Horizontal">
                <RadioButton Classes="segment" GroupName="LogFilter" Content="All" IsChecked="{Binding ShowAll}" />
                <RadioButton Classes="segment" GroupName="LogFilter" Content="Agents" IsChecked="{Binding ShowAgents}" />
                <RadioButton Classes="segment" GroupName="LogFilter" Content="You" IsChecked="{Binding ShowYou}" />
                <RadioButton Classes="segment" GroupName="LogFilter" Content="Denied" IsChecked="{Binding ShowDenied}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- One sentence about the file as a whole. A broken chain is marked, but a log never written to is normal. -->
        <Border Classes="card filled"
                Padding="12,10"
                IsVisible="{Binding HasMessage}">
          <Grid ColumnDefinitions="Auto,*">
            <ctl:KpIcon Grid.Column="0"
                        Icon="info"
                        Size="14"
                        Margin="0,0,10,0"
                        IsVisible="{Binding !IsBroken}"
                        Foreground="{DynamicResource KpTextMuted}" />
            <ctl:KpIcon Grid.Column="0"
                        Icon="alert-triangle"
                        Size="14"
                        Margin="0,0,10,0"
                        IsVisible="{Binding IsBroken}"
                        Foreground="{DynamicResource KpWarn}" />
            <TextBlock Grid.Column="1"
                       Name="Message"
                       Text="{Binding Message}"
                       TextWrapping="Wrap"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextSecondary}" />
          </Grid>
        </Border>

        <!-- The chain's verdict, in the core's words, on request. -->
        <Border Classes="terminal"
                Padding="16,12"
                IsVisible="{Binding VerdictShown}">
          <SelectableTextBlock Name="Verdict"
                               Text="{Binding VerdictText}"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource KpMono}"
                               FontSize="12"
                               Foreground="{DynamicResource KpTextSecondary}" />
        </Border>

        <Border Classes="table" IsVisible="{Binding HasTable}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel MinWidth="680">

              <Border Classes="table-head">
                <Grid ColumnDefinitions="64,110,100,1.6*,*,100" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Classes="th" Text="TIME" />
                  <TextBlock Grid.Column="1" Classes="th" Text="ACTOR" />
                  <TextBlock Grid.Column="2" Classes="th" Text="ACTION" />
                  <TextBlock Grid.Column="3" Classes="th" Text="SECRETS" />
                  <TextBlock Grid.Column="4" Classes="th" Text="WHERE" />
                  <TextBlock Grid.Column="5" Classes="th" Text="RESULT" />
                </Grid>
              </Border>

                  <ItemsControl Name="Rows" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LogRow">
                        <Border Classes="table-row" ToolTip.Tip="{Binding Detail}">
                          <Grid ColumnDefinitions="64,110,100,1.6*,*,100" ColumnSpacing="12">

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Text="?"
                                         IsVisible="{Binding Unverified}"
                                         FontFamily="{DynamicResource KpMono}"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource KpWarn}"
                                         ToolTip.Tip="The hash chain does not vouch for this row." />
                              <TextBlock Text="{Binding Time}"
                                         ToolTip.Tip="{Binding When}"
                                         FontFamily="{DynamicResource KpMono}"
                                         FontSize="11.5"
                                         Foreground="{DynamicResource KpTextMuted}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Actor}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Action}"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextSecondary}" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Secrets}"
                                       FontFamily="{DynamicResource KpMono}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextPrimary}" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Where}"
                                       FontFamily="{DynamicResource KpMono}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource KpTextMuted}" />

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Border Classes="dot"
                                      Classes.ok="{Binding IsOk}"
                                      Classes.danger="{Binding IsDanger}"
                                      Classes.info="{Binding IsInfo}" />
                              <TextBlock Text="{Binding Result}"
                                         FontSize="12.5"
                                         FontWeight="Medium"
                                         VerticalAlignment="Center"
                                         Classes.ok="{Binding IsOk}"
                                         Classes.danger="{Binding IsDanger}"
                                         Classes.info="{Binding IsInfo}"
                                         Classes.muted="{Binding IsMuted}" />
                              <TextBlock Text="(!)"
                                         IsVisible="{Binding ReasonUnread}"
                                         FontFamily="{DynamicResource KpMono}"
                                         FontSize="11"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource KpWarn}"
                                         ToolTip.Tip="Served from an earlier approval, under a reason that person never saw." />
                            </StackPanel>

                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Classes="table-row" IsVisible="{Binding FilterEmpty}">
                    <TextBlock Text="Nothing in this log matches this filter."
                               FontSize="12.5"
                               Foreground="{DynamicResource KpTextMuted}" />
                  </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- What the table is and is not showing, and what its marks mean, in the core's words (D-0032). -->
        <StackPanel Spacing="4" Margin="0,-8,0,0" IsVisible="{Binding HasTable}">
          <SelectableTextBlock Name="Notes"
                               Text="{Binding Notes}"
                               IsVisible="{Binding HasNotes}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource KpTextSecondary}" />
          <SelectableTextBlock Name="Summary"
                               Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource KpMono}"
                               FontSize="11"
                               Foreground="{DynamicResource KpTextMuted}" />
        </StackPanel>

      </StackPanel>
    </Grid>
  </ScrollViewer>

</UserControl>
