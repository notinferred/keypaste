<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.CrashChoiceView"
             x:DataType="vm:CrashChoiceViewModel">

  <UserControl.Styles>
    <!-- Quieter than the way into a vault beside it, with a hairline so each still reads as a button. -->
    <Style Selector="Button.equal">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.equal /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderControl}" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <!-- Two equal buttons with no default and no amber: Return answers nothing until someone moves to one, and the screen's one amber stays on what it is for. -->
    <StackPanel Name="CrashChoice" Spacing="8" IsVisible="{Binding IsAsking}">
      <TextBlock Classes="caption"
                 LineHeight="18"
                 Text="A report holds the version, system, screen and where the code failed, never your vault, a path or who you are." />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
        <Button Grid.Column="0"
                Name="SendCrashReports"
                Classes="equal ghost"
                Content="Send crash reports"
                Command="{Binding SendCommand}" />
        <Button Grid.Column="1"
                Name="DontSend"
                Classes="equal ghost"
                Content="Don't send"
                Command="{Binding DontSendCommand}" />
      </Grid>

      <views:TermsLink DataContext="{Binding Terms}" HorizontalAlignment="Center" />
    </StackPanel>

    <TextBlock Name="CrashChoiceOutcome"
               Classes="caption"
               Focusable="True"
               TextWrapping="Wrap"
               IsVisible="{Binding HasOutcome}"
               ctl:Announcer.Says="{Binding Outcome}"
               Text="{Binding Outcome}" />
  </Panel>

</UserControl>
