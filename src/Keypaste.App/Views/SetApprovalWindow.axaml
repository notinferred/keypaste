<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.SetApprovalWindow"
                    x:DataType="vm:SetApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent is asking for several credentials together"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Fixed heights, as in the single prompt: the client, the items and the reason are the agent's or the vault's, so none of them
       can move the question or the buttons (THREATS.md T-2). The list holds four rows, the most a set names, whatever it names.
       A set is allowed once or denied whole, with no always answer, and no button is the default: Enter approves nothing,
       and Escape denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <Grid Classes="prompt-head" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <Border Grid.Column="0" Classes="prompt-tile">
          <ctl:KpIcon Icon="bot" Size="20" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,Auto">
            <TextBlock Grid.Column="0" Name="ClientText" Classes="prompt-title size-16" Text="{Binding Client}"
                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Name="WantsText" Classes="prompt-title size-16" Text="{Binding Wants}" />
          </Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="prompt-sub size-13" Text="via MCP · label " />
            <TextBlock Name="LabelText" Classes="prompt-sub size-13" Text="{Binding Label}"
                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="dot waiting" />
          <TextBlock Name="CountdownText" Classes="prompt-countdown size-12" Text="{Binding Countdown}" />
        </StackPanel>
      </Grid>

      <Border Classes="prompt-call size-12" Padding="12,8">
        <TextBlock Name="ToolText" Text="{Binding Tool}" />
      </Border>

      <Border Classes="prompt-list size-12-5" Height="148">
        <ItemsControl Name="FieldsList" ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LinkedFieldRow">
              <Border Classes="prompt-row" Height="37" Padding="12,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Classes="value" Text="{Binding Entry}" MaxWidth="250" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text=" · " />
                    <TextBlock Text="{Binding Field}" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="tag size-13" Text="value goes to the agent" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="The agent says it needs this because" />
        <Border Classes="prompt-reason" Height="77">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8" Spacing="6">
              <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed size-13" Text="{Binding Scrubbed}"
                         IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="prompt-scrubbed size-13" Text="{Binding Truncation}"
                         IsVisible="{Binding Truncation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="ReasonText" Text="{Binding Reason}" TextWrapping="Wrap" Classes="size-13" LineHeight="19.5"
                         Foreground="{DynamicResource KpTextSecondary}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Name="AttributionText" Classes="caption" Text="{Binding Attribution}" />
      </StackPanel>

      <TextBlock Name="ExplainerText" Classes="prompt-note size-13" Text="{Binding Explainer}" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
        <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                IsCancel="True" Command="{Binding DenyCommand}" />
        <Button Grid.Column="1" Name="AllowOnce" Classes="prompt primary" Content="Allow once"
                Command="{Binding AllowOnceCommand}" />
      </Grid>

    </StackPanel>
  </Border>

</views:PromptWindow>
