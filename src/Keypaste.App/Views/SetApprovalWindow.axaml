<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.SetApprovalWindow"
                    x:DataType="vm:SetApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent is asking for linked secrets"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- A claim card for a linked set, allowed once as a whole or denied: no Always allow. The fields sit in a box of fixed
       height that scrolls, as the agent's words do (THREATS.md T-2). Return presses the primary only once it is armed; Escape denies. -->

  <Border Classes="claim" Classes.arming="{Binding IsArming}">
    <StackPanel>
      <StackPanel Classes="claim-body">
        <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
        <views:PromptHead />

        <TextBlock Name="TitleText" Classes="claim-title size-15">
          <Run Text="Give " /><Run Text="{Binding Agent}" /><Run Text=" these " /><Run Text="{Binding Count}" /><Run Text=" values?" />
        </TextBlock>

        <Border Classes="claim-block" Height="96">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="FieldsList" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LinkedFieldRow">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                    <ctl:KpIcon Classes="claim-muted" Icon="key" Size="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="field mono" Text="{Binding Field}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="claim-muted size-13" Text="&#x00B7;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="entry claim-muted size-13" Text="{Binding Item}" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

          <StackPanel Spacing="4">
            <TextBlock Name="SaysText" Classes="claim-label size-11" Text="{Binding SaysLabel}" Background="Transparent" ToolTip.Tip="{Binding QuoteNote}" />
            <Border Classes="claim-quote">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DockPanel Classes="claim-quote-text">
                  <Border Classes="claim-quote-bar" />
                  <TextBlock Name="ReasonText" Classes="size-13" Text="{Binding Quoted}" />
                </DockPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>

        <TextBlock Name="ConsequenceText" Classes="claim-line size-13" Text="{Binding Consequence}" />

          <StackPanel Spacing="8">
            <ToggleButton Name="DetailsToggle" Classes="claim-details" AutomationProperties.Name="Details">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-right" Size="14" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
                <TextBlock Classes="size-13" Text="Details" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <Grid Classes="claim-facts size-13" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="4" Margin="20,0,0,0" IsVisible="{Binding #DetailsToggle.IsChecked}">
              <TextBlock Grid.Row="0" Classes="fact" Text="Tool" />
              <TextBlock Grid.Row="0" Grid.Column="1" Name="ToolText" Classes="mono" Text="{Binding Tool}" />
              <TextBlock Grid.Row="1" Classes="fact" Text="Label" />
              <TextBlock Grid.Row="1" Grid.Column="1" Name="LabelText" Text="{Binding Label}" />
              <TextBlock Grid.Row="2" Classes="fact" Text="Items" />
              <TextBlock Grid.Row="2" Grid.Column="1" Name="EntriesText" Classes="mono" Text="{Binding Entries}" />
              <TextBlock Grid.Row="3" Classes="fact" Text="Calls itself" />
              <TextBlock Grid.Row="3" Grid.Column="1" Name="ClientText" Text="{Binding Client}" />
              <TextBlock Grid.Row="4" Classes="fact" Text="Process" />
              <TextBlock Grid.Row="4" Grid.Column="1" Name="ProcessText" Classes="mono" Text="{Binding Process}" />
            </Grid>
          </StackPanel>
      </StackPanel>

      <Border Classes="claim-rule" />

      <StackPanel Classes="claim-foot">
        <Button Name="Deny" Classes="claim keyed" Content="Deny" Tag="esc"
                IsVisible="{Binding IsChoosing}" Command="{Binding DenyCommand}" />
        <Button Name="AllowOnce" Classes="claim keyed primary" Content="Allow once" Tag="&#x21A9;"
                IsVisible="{Binding IsChoosing}" Command="{Binding AllowOnceCommand}" />
      </StackPanel>
      <ProgressBar Name="TimeBar" Classes="claim-time" Value="{Binding TimeLeft}" AutomationProperties.Name="{Binding DeniesIn}" />
    </StackPanel>
  </Border>

</views:PromptWindow>
