<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.fact-value">
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="32,12,32,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Classes="h1"
                 Text="{x:Static res:Strings.Diagnostics}"
                 ToolTip.Tip="{x:Static res:Strings.TheVaultTheFolderAndTheVersionXa37320}" />

      <Border Classes="group">
        <ctl:GroupedRows>
          <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.Vault}">
            <SelectableTextBlock Classes="fact-value size-12" Text="{Binding VaultPath}" />
          </ctl:FieldRow>
          <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.KeypasteHome}">
            <SelectableTextBlock Classes="fact-value size-12" Text="{Binding HomePath}" />
          </ctl:FieldRow>
          <ctl:FieldRow Classes="stacked mono-label" Label="{x:Static res:Strings.KEYPASTEHOMECapitals}">
            <SelectableTextBlock Classes="fact-value size-12" Text="{Binding HomeOverride}" />
          </ctl:FieldRow>
          <ctl:FieldRow Label="{x:Static res:Strings.Version}">
            <SelectableTextBlock Classes="fact-value size-12" Text="{Binding Version}" />
          </ctl:FieldRow>
          <ctl:FieldRow Classes="stacked" Label="{x:Static res:Strings.AnsweringAgents}">
            <SelectableTextBlock Name="AnsweringAgents" Classes="fact-value size-12" Text="{Binding AnsweringAgents}" />
          </ctl:FieldRow>
        </ctl:GroupedRows>
      </Border>

      <!-- The crash reports waiting, each as the exact JSON a request would carry, with Delete (D-0594). -->
      <Border Name="CrashReportsCard" Classes="group" Padding="16,12" IsVisible="{Binding HasCrashReports}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="bug" Size="16" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Classes="dialog-title" Text="{x:Static res:Strings.CrashReports}" />
          </StackPanel>
          <TextBlock Name="CrashReportsSummary" Classes="caption" TextWrapping="Wrap" Text="{Binding ReportsSummary}" />
          <ItemsControl Name="CrashReportRows" ItemsSource="{Binding Reports}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CrashReportRow">
                <Border BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,12">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <SelectableTextBlock Grid.Column="0" Classes="fact-value size-12" Text="{Binding Json}" />
                      <Button Grid.Column="1" Classes="sm ghost" Content="{x:Static res:Strings.Delete}" VerticalAlignment="Top"
                              IsVisible="{Binding !IsConfirming}"
                              Command="{Binding AskDeleteCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding CancelDeleteCommand}">
                      <TextBlock Text="{x:Static res:Strings.DeleteThisReportItWontBeSent}" Classes="size-13" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="ghost sm size-12" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelDeleteCommand}" />
                      <Button Grid.Column="2" Name="ConfirmDeleteReport" Classes="danger sm size-12" Content="{x:Static res:Strings.DeleteReport}" Command="{Binding DeleteCommand}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>
