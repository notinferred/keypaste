<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource KpBgApp}">

  <UserControl.Resources>
    <views:DepthToIndent x:Key="Indent" />
  </UserControl.Resources>

  <!-- Implicit templates, matched by the type of whatever Content holds. Adding a destination
       means a line in Destinations.All, a view model in ShellViewModel.Show and a template here. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:EntriesViewModel">
      <views:EntriesView />
    </DataTemplate>

    <DataTemplate DataType="vm:EnvSetsViewModel">
      <views:EnvSetsView />
    </DataTemplate>

    <DataTemplate DataType="vm:TrashViewModel">
      <views:TrashView />
    </DataTemplate>

    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentActivityViewModel">
      <views:AgentActivityView />
    </DataTemplate>

    <DataTemplate DataType="vm:SharingViewModel">
      <views:SharingView />
    </DataTemplate>

    <DataTemplate DataType="vm:ScopedTokensViewModel">
      <views:ScopedTokensView />
    </DataTemplate>

    <DataTemplate DataType="vm:DiagnosticsViewModel">
      <views:DiagnosticsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AdvancedViewModel">
      <views:AdvancedView />
    </DataTemplate>

  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Border.content.padded">
      <Setter Property="Padding" Value="18,10,18,16" />
    </Style>

    <!-- A sidebar row is announced by its place or project, the rows being view models rather than text. -->
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Title}" />
    </Style>

    <Style Selector="Button.titlebar-lock">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.titlebar-lock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <Style Selector="Button.titlebar-lock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Grid RowDefinitions="40,*">

      <!-- Titlebar: the window's title area, drawn by the app, draggable everywhere but its controls. -->
      <Border Grid.Row="0"
              Name="TitleBar"
              Background="{DynamicResource KpBgPanel}"
              BorderBrush="{DynamicResource KpBorderSubtle}"
              BorderThickness="0,0,0,1"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid Name="TitleColumns" ColumnDefinitions="232,Auto,*">

          <!-- Only while the sidebar is away: Agents, Settings and the groups would otherwise have nothing on screen pointing to them. -->
          <Button Grid.Column="1"
                  Name="ShowSidebar"
                  Classes="icon ghost sm"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !ShowsSidebar}"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="Show sidebar"
                  AutomationProperties.Name="Show sidebar"
                  WindowDecorationProperties.ElementRole="User">
            <ctl:KpIcon Icon="panel-left" Size="16" />
          </Button>

          <!-- The idle warning's first line, said once as the warning comes, while the ticking text below stays quiet. -->
          <Border Grid.Column="2" ctl:Announcer.Says="{Binding CountdownAnnouncement}" />

          <Grid Grid.Column="2"
                ColumnDefinitions="Auto,*,Auto"
                HorizontalAlignment="Right"
                Margin="8,0,12,0"
                VerticalAlignment="Center">

            <!-- Muted, never red. An auto-lock is the most normal thing this app does. -->
            <TextBlock Classes="mono sm muted"
                       Text="{Binding Countdown}"
                       IsVisible="{Binding HasCountdown}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <Grid Grid.Column="1"
                  ColumnDefinitions="Auto,*"
                  Margin="8,0,14,0"
                  ToolTip.Tip="{Binding VaultStatusDetail}"
                  WindowDecorationProperties.ElementRole="User">
              <Border Classes="dot"
                      Margin="0,0,6,0"
                      Classes.ok="{Binding VaultStatusOk}"
                      Classes.warn="{Binding VaultStatusAccent}"
                      Classes.danger="{Binding VaultStatusDanger}" />
              <!-- A long file name gives way in its middle, so the save state at the end always shows. -->
              <TextBlock Grid.Column="1"
                         Name="VaultStatusLine"
                         Classes="mono sm muted"
                         Text="{Binding VaultStatus}"
                         TextTrimming="PrefixCharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>

            <Button Grid.Column="2"
                    Classes="titlebar-lock"
                    Command="{Binding LockCommand}"
                    ToolTip.Tip="Lock now"
                    AutomationProperties.Name="Lock now"
                    WindowDecorationProperties.ElementRole="User">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:KpIcon Icon="lock" Size="12" />
                <TextBlock Text="lock" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

        </Grid>
      </Border>

      <Grid Name="BodyColumns" Grid.Row="1" ColumnDefinitions="232,*">

        <!-- The sidebar. Nav is a ListBox on purpose: arrow keys, Home/End and type-ahead all work
             for free, the accessibility roles are right, and there is no custom key handling to get
             wrong. SelectedMain drives navigation. -->
        <Border Name="Sidebar"
                Grid.Column="0"
                ZIndex="2"
                Width="{x:Static views:WindowChrome.SidebarWidth}"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowsSidebar}"
                Classes="sidebar"
                Classes.overlay="{Binding SidebarOverlays}"
                Background="{DynamicResource KpBgPanel}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <DockPanel Margin="10,16">

            <ctl:BrandWordmark DockPanel.Dock="Top"
                               HorizontalAlignment="Left"
                               Margin="10,2,8,22"
                               Width="104" />

            <!-- Trash and Settings, quieter, at the bottom. -->
            <ListBox Name="FooterNav"
                     AutomationProperties.Name="More places"
                     DockPanel.Dock="Bottom"
                     Classes="nav quiet"
                     Margin="0,12,0,0"
                     ItemsSource="{Binding FooterNav}"
                     SelectedItem="{Binding SelectedFooter}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" AutomationProperties.Name="{Binding Title}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Items with the vault's group tree under it, the projects, then Agents: one list, so the
                 arrow keys walk the sidebar as it reads, and Left and Right fold a row as in KeePassXC's
                 tree. -->
            <ListBox Name="Nav"
                     AutomationProperties.Name="Places"
                     Classes="nav"
                     ItemsSource="{Binding SidebarRows}"
                     SelectedItem="{Binding SelectedSidebarRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.HelpText="{Binding Detail}"
                        ToolTip.Tip="{Binding Detail}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="16" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Name="AgentsDotWords"
                                 Classes="mono sm muted"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding DotWords}"
                                 IsVisible="{Binding DotWords, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Border Name="AgentsDot"
                              Classes="dot"
                              Classes.ok="{Binding DotLive}"
                              Classes.danger="{Binding DotDanger}"
                              IsVisible="{Binding HasDot}" />
                    </StackPanel>
                    <Button Grid.Column="4"
                            Classes="icon ghost fold"
                            Margin="2,-2,-8,-2"
                            IsVisible="{Binding IsExpandable}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FoldLabel}"
                            AutomationProperties.Name="{Binding FoldLabel}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:GroupRow">
                  <Grid ColumnDefinitions="16,Auto,*"
                        Margin="{Binding Depth, Converter={StaticResource Indent}}"
                        AutomationProperties.Name="{Binding Title}">
                    <Button Grid.Column="0"
                            Classes="icon ghost fold"
                            Margin="-2"
                            IsVisible="{Binding HasChildren}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FoldLabel}"
                            AutomationProperties.Name="{Binding FoldLabel}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="12" />
                    </Button>
                    <ctl:KpIcon Grid.Column="1" Icon="folder" Size="14" Margin="4,0,8,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:SidebarHeading">
                  <TextBlock Classes="th" Text="{Binding Label}" />
                </DataTemplate>
                <DataTemplate DataType="vm:ProjectRow">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Margin="14,0,0,0"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding Name}">
                    <ctl:KpIcon Grid.Column="0" Icon="folder-git-2" Size="14" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1"
                               Classes="mono size-12"
                               FontWeight="Normal"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               FontWeight="Normal"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>

          </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

          <!-- A screen under a place, such as History under Agents, goes back up to it. -->
          <!-- A row of its own, so nothing a page scrolls can sit under the link or be hidden by it; the screens under a place keep 16 less at their top for this. -->
          <Border Grid.Row="0"
                  Name="BackStrip"
                  IsVisible="{Binding HasBack}">
            <Button Name="Back"
                    Classes="ghost sm"
                    HorizontalAlignment="Left"
                    Margin="24,12,0,0"
                    AutomationProperties.Name="{Binding BackTitle, StringFormat='Back to {0}'}"
                    Command="{Binding BackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-right" Size="13" RenderTransform="rotate(180deg)" />
                <TextBlock Text="{Binding BackTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>

          <!-- Until a screen draws its own title (Destination.OwnsHeader), the shell draws it. -->
          <TextBlock Grid.Row="1"
                     Classes="h1"
                     Text="{Binding CurrentTitle}"
                     IsVisible="{Binding ShowsHeader}"
                     Margin="18,14,18,0" />

          <StackPanel Grid.Row="2">
            <!-- Another program's save keypaste did not merge: agents are refused until a reload. -->
            <Border IsVisible="{Binding HasVaultChanged}"
                    CornerRadius="{DynamicResource KpRadiusCard}"
                    Background="{DynamicResource KpDangerTint}"
                    Padding="12,8"
                    Margin="18,10,18,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="alert-triangle" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource KpDanger}" />
                <TextBlock Grid.Column="1"
                           Name="VaultChanged"
                           Text="{Binding VaultChanged}"
                           TextWrapping="Wrap"
                           Classes="size-12-5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <Button Grid.Column="2"
                        Name="Reload"
                        Classes="sm"
                        Content="Reload"
                        Margin="12,0,0,0"
                        Command="{Binding ReloadCommand}" />
              </Grid>
            </Border>

            <!-- What a restore did, a fragile keyfile, that this vault was just chosen, or what a merge saved and named. Quiet. -->
            <Border IsVisible="{Binding HasNotice}"
                    Classes="card"
                    BorderBrush="{DynamicResource KpBorderSubtle}"
                    Padding="12,8"
                    Margin="18,10,18,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="info" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource KpTextSecondary}" />
                <TextBlock Grid.Column="1"
                           Name="Notice"
                           ctl:Announcer.Says="{Binding Notice}"
                           Text="{Binding Notice}"
                           TextWrapping="Wrap"
                           Classes="size-12-5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <Button Grid.Column="2"
                        Classes="ghost sm"
                        Content="Dismiss"
                        Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" />
              </Grid>
            </Border>
          </StackPanel>

          <Border Grid.Row="3" Classes="content" Classes.padded="{Binding ShowsHeader}">
            <ContentControl Content="{Binding Content}" />
          </Border>

        </Grid>
      </Grid>
    </Grid>

    <!-- Share…, from an item's ⋯ menu, modal over the whole window. -->
    <Border Classes="backdrop" IsVisible="{Binding HasShare}" Padding="24">
      <views:ShareDialogView DataContext="{Binding Share}" />
    </Border>

    <Border Classes="backdrop" IsVisible="{Binding HasGeneratorDialog}" Padding="24">
      <views:GeneratePasswordView DataContext="{Binding GeneratorDialog}" />
    </Border>

    <!-- The import dialogs, modal over the whole window: a KeePass database's, or another app's export's. -->
    <Border Classes="backdrop" IsVisible="{Binding HasKdbxImport}" Padding="24">
      <views:KdbxImportView DataContext="{Binding Import}" />
    </Border>
    <Border Classes="backdrop" IsVisible="{Binding HasExportImport}" Padding="24">
      <views:ExportImportView DataContext="{Binding ExportImport}" />
    </Border>

    <!-- A save waiting for the YubiKey. Modal, so nothing else is edited while the save is half done. -->
    <Border Classes="backdrop" IsVisible="{Binding IsWaitingForTouch}" Padding="24">
      <Border Name="TouchDialog" Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="dot waiting" />
            <TextBlock Text="Touch your YubiKey" Classes="size-14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="The vault is saved once the key answers. Cancel leaves the change unsaved." />
          <Button Classes="ghost" Content="Cancel" HorizontalAlignment="Left" Command="{Binding CancelTouchCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Asked before a place change or an Escape loses what was typed. Above every other dialog, since Share's Escape asks too. -->
    <Border Classes="backdrop" IsVisible="{Binding HasDiscardPrompt}" Padding="24">
      <Border Name="DiscardDialog"
              Classes="dialog"
              KeyboardNavigation.TabNavigation="Cycle"
              MaxWidth="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Name="DiscardPrompt" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding DiscardPrompt}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="What you typed has not been saved." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="KeepDraft" Classes="ghost" Content="Cancel" Command="{Binding KeepDraftCommand}" />
            <Button Name="ConfirmDiscard" Classes="danger" Content="Discard" Command="{Binding ConfirmDiscardCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Toasts, bottom right. The clipboard countdown is one; Toasts says anything else. -->
    <StackPanel HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Spacing="8"
                MaxWidth="420">

      <!-- Never KpDanger: a working auto-clear is the most normal thing this feature does. -->
      <Border Name="ClipboardToast" Classes="toast" IsVisible="{Binding Clipboard.IsVisible}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:KpIcon Icon="clipboard-check" Size="15" Foreground="{DynamicResource KpOk}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       ctl:Announcer.Says="{Binding Clipboard.Label, StringFormat='{}{0} copied.'}"
                       Text="{Binding Clipboard.Label, StringFormat='{}{0} copied.'}" />
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       Text="{Binding Clipboard.SecondsLeft, StringFormat='Clears in {0}s'}" />
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       Classes="secondary"
                       ctl:Announcer.Says="{Binding Clipboard.Failure}"
                       Text="{Binding Clipboard.Failure}" />
            <Button Classes="link"
                    Content="Clear now"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Clipboard.IsCounting}"
                    Command="{Binding Clipboard.ClearNowCommand}" />
          </StackPanel>
          <ProgressBar Classes="thin"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding Clipboard.Fraction}"
                       IsVisible="{Binding Clipboard.IsCounting}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Toasts.Shown}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Toast">
            <Border Classes="toast" PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                  <ctl:KpIcon Icon="circle-check" Size="15" Foreground="{DynamicResource KpOk}" IsVisible="{Binding IsSuccess}" />
                  <ctl:KpIcon Icon="info" Size="15" Foreground="{DynamicResource KpInfo}" IsVisible="{Binding IsInformation}" />
                  <ctl:KpIcon Icon="alert-triangle" Size="15" Foreground="{DynamicResource KpAccentText}" IsVisible="{Binding IsWarning}" />
                </Panel>
                <TextBlock Grid.Column="1" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                <Button Grid.Column="2"
                        Classes="icon ghost sm"
                        VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="Close"
                        AutomationProperties.Name="Close this message">
                  <ctl:KpIcon Icon="x" Size="12" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

  </Panel>

</UserControl>
