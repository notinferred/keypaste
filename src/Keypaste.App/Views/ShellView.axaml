<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource KpBgApp}">

  <UserControl.Resources>
    <views:DepthToIndent x:Key="Indent" />
  </UserControl.Resources>

  <!-- Implicit templates, matched by the type of whatever Content holds. Adding a destination
       means a line in Destinations.All, a view model in ShellViewModel.Show and a template here. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:EntriesViewModel">
      <views:EntriesView />
    </DataTemplate>

    <DataTemplate DataType="vm:EnvSetsViewModel">
      <views:EnvSetsView />
    </DataTemplate>

    <DataTemplate DataType="vm:TrashViewModel">
      <views:TrashView />
    </DataTemplate>

    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentActivityViewModel">
      <views:AgentActivityView />
    </DataTemplate>

    <DataTemplate DataType="vm:SharingViewModel">
      <views:SharingView />
    </DataTemplate>

  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Border.content.padded">
      <Setter Property="Padding" Value="18,10,18,16" />
    </Style>

    <!-- A sidebar row is announced by its place or project, the rows being view models rather than text. -->
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Title}" />
    </Style>

    <Style Selector="Button.titlebar-lock">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.titlebar-lock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <Style Selector="Button.titlebar-lock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Grid RowDefinitions="40,*">

      <!-- Titlebar: the window's title area, drawn by the app, draggable everywhere but its controls. -->
      <Border Grid.Row="0"
              Name="TitleBar"
              Background="{DynamicResource KpBgPanel}"
              BorderBrush="{DynamicResource KpBorderSubtle}"
              BorderThickness="0,0,0,1"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="232,*,Auto" Margin="{x:Static views:WindowChrome.CaptionInset}">

          <!-- The app's only search. It searches Items, and says where: every item, or the group in view. -->
          <TextBox Grid.Column="1"
                   Name="ShellSearch"
                   Classes="search"
                   MaxWidth="440"
                   Margin="16,0"
                   VerticalAlignment="Center"
                   Text="{Binding Search}"
                   PlaceholderText="{Binding SearchPlaceholder}"
                   AutomationProperties.Name="Search"
                   WindowDecorationProperties.ElementRole="User">
            <TextBox.InnerLeftContent>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                <ctl:KpIcon Icon="search" Size="13" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
                <Border Name="SearchScope"
                        Classes="chip"
                        IsVisible="{Binding HasSearchScope}"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SearchScope}" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                    <Button Name="ClearSearchScope"
                            Classes="icon ghost sm"
                            Width="16" Height="16" MinHeight="16" Padding="0"
                            ToolTip.Tip="Search every item"
                            AutomationProperties.Name="Search every item"
                            Command="{Binding ClearScopeCommand}">
                      <ctl:KpIcon Icon="x" Size="10" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Border Classes="keycap" Margin="0,0,5,0">
                <TextBlock Text="{x:Static vm:ShellViewModel.SearchShortcut}" />
              </Border>
            </TextBox.InnerRightContent>
          </TextBox>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="6"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center">

            <!-- Muted, never red. An auto-lock is the most normal thing this app does. -->
            <TextBlock Classes="mono sm muted"
                       Text="{Binding Countdown}"
                       IsVisible="{Binding HasCountdown}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        Margin="8,0"
                        ToolTip.Tip="{Binding VaultStatusDetail}"
                        WindowDecorationProperties.ElementRole="User">
              <Border Classes="dot"
                      Classes.ok="{Binding VaultStatusOk}"
                      Classes.warn="{Binding VaultStatusAccent}"
                      Classes.danger="{Binding VaultStatusDanger}" />
              <TextBlock Classes="mono sm muted"
                         Text="{Binding VaultStatus}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <Button Classes="titlebar-lock"
                    Command="{Binding LockCommand}"
                    ToolTip.Tip="Lock now"
                    AutomationProperties.Name="Lock now"
                    WindowDecorationProperties.ElementRole="User">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ctl:KpIcon Icon="lock" Size="12" />
                <TextBlock Text="lock" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="232,*">

        <!-- The sidebar. Nav is a ListBox on purpose: arrow keys, Home/End and type-ahead all work
             for free, the accessibility roles are right, and there is no custom key handling to get
             wrong. SelectedMain drives navigation. -->
        <Border Grid.Column="0"
                Background="{DynamicResource KpBgPanel}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <DockPanel Margin="10,16">

            <ctl:BrandWordmark DockPanel.Dock="Top"
                               HorizontalAlignment="Left"
                               Margin="10,2,8,22"
                               Width="104" />

            <!-- Trash and Settings, quieter, at the bottom. -->
            <ListBox Name="FooterNav"
                     DockPanel.Dock="Bottom"
                     Classes="nav quiet"
                     Margin="0,12,0,0"
                     ItemsSource="{Binding FooterNav}"
                     SelectedItem="{Binding SelectedFooter}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" AutomationProperties.Name="{Binding Title}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="14" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Items with the vault's group tree under it, the projects, then Agents: one list, so the
                 arrow keys walk the sidebar as it reads, and Left and Right fold a row as in KeePassXC's
                 tree (D-0376). -->
            <ListBox Name="Nav"
                     Classes="nav"
                     ItemsSource="{Binding SidebarRows}"
                     SelectedItem="{Binding SelectedSidebarRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.HelpText="{Binding Detail}"
                        ToolTip.Tip="{Binding Detail}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="16" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="3"
                            Name="AgentsDot"
                            Classes="dot"
                            Classes.ok="{Binding DotLive}"
                            Margin="8,0,0,0"
                            IsVisible="{Binding HasDot}" />
                    <Button Grid.Column="4"
                            Classes="icon ghost fold"
                            Margin="4,0,-6,0"
                            IsVisible="{Binding IsExpandable}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Show or hide the groups"
                            AutomationProperties.Name="Show or hide the groups">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:GroupRow">
                  <Grid ColumnDefinitions="16,Auto,*"
                        Margin="{Binding Depth, Converter={StaticResource Indent}}"
                        AutomationProperties.Name="{Binding Title}">
                    <Button Grid.Column="0"
                            Classes="icon ghost fold"
                            IsVisible="{Binding HasChildren}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title, StringFormat='Show or hide the groups in {0}'}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="12" />
                    </Button>
                    <ctl:KpIcon Grid.Column="1" Icon="folder" Size="14" Margin="4,0,8,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:SidebarHeading">
                  <TextBlock Classes="th" Text="{Binding Label}" AutomationProperties.Name="{Binding Title}" />
                </DataTemplate>
                <DataTemplate DataType="vm:ProjectRow">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Margin="14,0,0,0"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding Name}">
                    <ctl:KpIcon Grid.Column="0" Icon="folder-git-2" Size="14" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1"
                               Classes="mono"
                               FontSize="12"
                               FontWeight="Normal"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="mono sm muted"
                               FontWeight="Normal"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>

          </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

          <!-- A screen under a place, such as History under Agents, goes back up to it (D-0374). -->
          <Button Grid.Row="0"
                  Name="Back"
                  ZIndex="1"
                  Classes="ghost sm"
                  IsVisible="{Binding HasBack}"
                  HorizontalAlignment="Left"
                  Margin="24,12,0,-16"
                  AutomationProperties.Name="{Binding BackTitle, StringFormat='Back to {0}'}"
                  Command="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ctl:KpIcon Icon="chevron-right" Size="13" RenderTransform="rotate(180deg)" />
              <TextBlock Text="{Binding BackTitle}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Until a screen draws its own title (Destination.OwnsHeader), the shell draws it. -->
          <TextBlock Grid.Row="1"
                     Classes="h1"
                     Text="{Binding CurrentTitle}"
                     IsVisible="{Binding ShowsHeader}"
                     Margin="18,14,18,0" />

          <!-- Said once, after a restore landed here. Quiet: the restore worked, and this is what it did. -->
          <Border Grid.Row="2"
                  IsVisible="{Binding HasNotice}"
                  Classes="card"
                  BorderBrush="{DynamicResource KpBorderSubtle}"
                  Padding="12,8"
                  Margin="18,10,18,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ctl:KpIcon Grid.Column="0" Icon="info" Size="14" Margin="0,0,10,0" Foreground="{DynamicResource KpTextSecondary}" />
              <TextBlock Grid.Column="1"
                         Name="Notice"
                         Text="{Binding Notice}"
                         TextWrapping="Wrap"
                         FontSize="12.5"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource KpTextSecondary}" />
              <Button Grid.Column="2"
                      Classes="ghost sm"
                      Content="Dismiss"
                      Margin="12,0,0,0"
                      Command="{Binding DismissNoticeCommand}" />
            </Grid>
          </Border>

          <Border Grid.Row="3" Classes="content" Classes.padded="{Binding ShowsHeader}">
            <ContentControl Content="{Binding Content}" />
          </Border>

        </Grid>
      </Grid>
    </Grid>

    <!-- Share…, from an item's ⋯ menu, modal over the whole window. -->
    <Border Classes="backdrop" IsVisible="{Binding HasShare}" Padding="24">
      <views:ShareDialogView DataContext="{Binding Share}" />
    </Border>

    <!-- The KDBX import dialog, modal over the whole window. -->
    <Border Classes="backdrop" IsVisible="{Binding HasImport}" Padding="24">
      <views:KdbxImportView DataContext="{Binding Import}" />
    </Border>

    <!-- A save waiting for the YubiKey. Modal, so nothing else is edited while the save is half done. -->
    <Border Classes="backdrop" IsVisible="{Binding IsWaitingForTouch}" Padding="24">
      <Border Name="TouchDialog" Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="dot waiting" />
            <TextBlock Text="Touch your YubiKey" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="The vault is saved once the key answers. Cancel leaves the change unsaved." />
          <Button Classes="ghost" Content="Cancel" HorizontalAlignment="Left" Command="{Binding CancelTouchCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Toasts, bottom right. The clipboard countdown is one; ShowToast says anything else. -->
    <StackPanel HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="20"
                Spacing="8"
                MaxWidth="420">

      <!-- Never KpDanger: a working auto-clear is the most normal thing this feature does. -->
      <Border Name="ClipboardToast" Classes="toast" IsVisible="{Binding Clipboard.IsVisible}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:KpIcon Icon="clipboard-check" Size="15" Foreground="{DynamicResource KpOk}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       Text="{Binding Clipboard.Label, StringFormat='{}{0} copied.'}" />
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       Text="{Binding Clipboard.SecondsLeft, StringFormat='Clears in {0}s'}" />
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       Classes="secondary"
                       Text="{Binding Clipboard.Failure}" />
            <Button Classes="link"
                    Content="Clear now"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Clipboard.IsCounting}"
                    Command="{Binding Clipboard.ClearNowCommand}" />
          </StackPanel>
          <ProgressBar Classes="thin"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding Clipboard.Fraction}"
                       IsVisible="{Binding Clipboard.IsCounting}" />
        </StackPanel>
      </Border>

      <Border Name="Toast" Classes="toast" IsVisible="{Binding HasToast}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ctl:KpIcon Icon="circle-check" Size="15" Foreground="{DynamicResource KpOk}" />
          <TextBlock Text="{Binding Toast}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
        </StackPanel>
      </Border>

    </StackPanel>

  </Panel>

</UserControl>
