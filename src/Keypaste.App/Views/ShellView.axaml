<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             ctl:PressToCopy.Clipboard="{Binding Clipboard}"
             Background="Transparent">

  <UserControl.Resources>
  </UserControl.Resources>

  <!-- Implicit templates, matched by the type of whatever Content holds. Adding a destination
       means a line in Destinations.All, a view model in ShellViewModel.Show and a template here. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:EntriesViewModel">
      <views:EntriesView />
    </DataTemplate>

    <DataTemplate DataType="vm:EnvSetsViewModel">
      <views:EnvSetsView />
    </DataTemplate>

    <DataTemplate DataType="vm:TrashViewModel">
      <views:TrashView />
    </DataTemplate>

    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentActivityViewModel">
      <views:AgentActivityView />
    </DataTemplate>

    <DataTemplate DataType="vm:SharingViewModel">
      <views:SharingView />
    </DataTemplate>

    <DataTemplate DataType="vm:ScopedTokensViewModel">
      <views:ScopedTokensView />
    </DataTemplate>

    <DataTemplate DataType="vm:DiagnosticsViewModel">
      <views:DiagnosticsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AdvancedViewModel">
      <views:AdvancedView />
    </DataTemplate>

    <DataTemplate DataType="vm:RecommendationsViewModel">
      <views:RecommendationsView />
    </DataTemplate>

    <DataTemplate DataType="vm:LockedVaultViewModel">
      <views:LockedVaultView />
    </DataTemplate>

  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Border.content.padded">
      <Setter Property="Padding" Value="16,8,16,16" />
    </Style>

    <!-- A sidebar row is announced by its title, the rows being view models rather than text. -->
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Title}" />
    </Style>

    <!-- The rail draws no words, so a row is announced with its status and says the rest as a tooltip. -->
    <Style Selector="ListBox.rail > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding RailName}" />
      <Setter Property="AutomationProperties.HelpText" Value="{ReflectionBinding Detail}" />
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding RailTip}" />
      <Setter Property="ToolTip.Placement" Value="Right" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.rail > ListBoxItem ctl|KpIcon">
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
    <Style Selector="ListBox.rail > ListBoxItem:selected ctl|KpIcon">
      <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
    </Style>
    <Style Selector="ListBox.rail > ListBoxItem.later">
      <Setter Property="Opacity" Value="0.45" />
      <Setter Property="Height" Value="45" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ListBox.rail > ListBoxItem.later /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border#TitleBar">
      <Setter Property="Background" Value="{DynamicResource KpBgTitleBar}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- The title bar's search, Outlook's way: centred, a step off the bar, with no line round it until focused. -->
    <Style Selector="TextBox#ShellSearch">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource KpBgSearch}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox#ShellSearch:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource KpBgSearch}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.vibrant-able#Rail">
      <Setter Property="Background" Value="{DynamicResource KpBgRail}" />
    </Style>
    <Style Selector="Border.vibrant-able#Sidebar">
      <Setter Property="Background" Value="{DynamicResource KpBgSidebar}" />
    </Style>
    <Style Selector="Border.vibrant-able.vibrant#Rail">
      <Setter Property="Background" Value="{DynamicResource KpBgRailVibrant}" />
    </Style>
    <Style Selector="Border.vibrant-able.vibrant#Sidebar">
      <Setter Property="Background" Value="{DynamicResource KpBgSidebarVibrant}" />
    </Style>

    <!-- The New button at the sidebar's top: the card's surface, a default line and a chosen segment's shadow, as Outlook draws it. -->
    <Style Selector="Button#SidebarNew">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button#SidebarNew /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="0 1 1.5 0 #0F000000" />
    </Style>

    <!-- A vault's rows sit under its heading only while the account draws one, with a second vault. -->
    <Style Selector="ListBox#Nav.accounts Grid.under-vault">
      <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style Selector="ListBox#Nav Grid.project">
      <Setter Property="Margin" Value="24,0,0,0" />
    </Style>
    <Style Selector="ListBox#Nav.accounts Grid.project">
      <Setter Property="Margin" Value="40,0,0,0" />
    </Style>

    <!-- Add vault… at the sidebar's foot: a quiet row, as a sidebar row draws it. -->
    <Style Selector="Button#AddVault">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Grid RowDefinitions="52,*">

      <!-- The window's title bar, draggable everywhere but its controls: the sidebar's button, the search, and at its end the vault's state while it needs saying and Lock. -->
      <Border Grid.Row="0"
              Name="TitleBar"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid Name="TitleColumns" ColumnDefinitions="80,Auto,*,Auto">

          <Button Grid.Column="1"
                  Name="ShowSidebar"
                  Classes="icon ghost"
                  VerticalAlignment="Center"
                  IsVisible="{Binding ShowsItemsPlace}"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding SidebarWayBack, TargetNullValue={x:Static res:Strings.ShowSidebar}}"
                  AutomationProperties.Name="{x:Static res:Strings.ShowSidebar}"
                  AutomationProperties.HelpText="{Binding SidebarWayBack}"
                  WindowDecorationProperties.ElementRole="User">
            <ctl:KpIcon Icon="panel-left" Size="16" />
          </Button>

          <!-- The app's only search. It searches the place Items lists, from wherever it is focused. -->
          <TextBox Grid.Column="2"
                   Name="ShellSearch"
                   Classes="search"
                   MaxWidth="440"
                   Margin="16,0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   Text="{Binding Search}"
                   PlaceholderText="{Binding SearchPlaceholder}"
                   ToolTip.Tip="{Binding Source={x:Static vm:ShellViewModel.SearchShortcut}, StringFormat='Search, {0}'}"
                   AutomationProperties.Name="{x:Static res:Strings.Search}"
                   WindowDecorationProperties.ElementRole="User">
            <TextBox.InnerLeftContent>
              <ctl:KpIcon Icon="search" Size="14" Margin="2,0,6,0" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
            </TextBox.InnerLeftContent>
          </TextBox>

          <!-- The idle warning's first line, said once as the warning comes, while the ticking text stays quiet. -->
          <Border Grid.Column="2" ctl:Announcer.Says="{Binding CountdownAnnouncement}" />

          <StackPanel Grid.Column="3" Name="TitleEnd" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock Name="TitleCountdown"
                       Classes="size-13 muted"
                       Text="{Binding Countdown}"
                       IsVisible="{Binding HasCountdown}"
                       VerticalAlignment="Center" />
            <!-- The vault's save state, said only while the file does not hold what is open; its file and the time it was saved are the tooltip. -->
            <StackPanel Name="VaultFoot"
                        Orientation="Horizontal"
                        Spacing="6"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !VaultStatusOk}"
                        ToolTip.Tip="{Binding VaultStatusDetail}"
                        WindowDecorationProperties.ElementRole="User">
              <Border Classes="dot"
                      VerticalAlignment="Center"
                      Classes.ok="{Binding VaultStatusOk}"
                      Classes.idle="{Binding VaultStatusPending}"
                      Classes.danger="{Binding VaultStatusDanger}" />
              <TextBlock Name="VaultSaveState"
                         Classes="size-13 muted"
                         Text="{Binding VaultSaveWords}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Button Name="LockButton"
                    Classes="icon ghost"
                    Command="{Binding LockCommand}"
                    ToolTip.Tip="{Binding VaultStatusDetail}"
                    AutomationProperties.Name="{x:Static res:Strings.LockNow}"
                    AutomationProperties.HelpText="{Binding VaultStatusDetail}"
                    WindowDecorationProperties.ElementRole="User">
              <ctl:KpIcon Icon="lock" Size="16" />
            </Button>
          </StackPanel>

        </Grid>
      </Border>

      <!-- The screens' own styles read tight-content for what gives way where the content has little room. -->
      <Grid Name="BodyColumns" Grid.Row="1" ColumnDefinitions="52,240,*" Classes.tight-content="{Binding ContentIsTight}">

        <!-- The rail of places, Outlook's way, at every width. One list, so the arrow keys walk it; Access is kept for later, dimmed. -->
        <Border Name="Rail"
                Grid.Column="0"
                Classes="vibrant-able"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <Panel>
          <ListBox Name="RailNav"
                   Margin="0,10"
                   AutomationProperties.Name="{x:Static res:Strings.Places}"
                   Classes="rail"
                   ItemsSource="{Binding RailPlaces}"
                   SelectedItem="{Binding SelectedRailPlace}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <ctl:RailPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavItem">
                <StackPanel>
                <Panel Width="36" Height="36">
                  <ctl:KpIcon Icon="{Binding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Name="RailAgentsDot"
                          Classes="dot"
                          Margin="0,6,6,0"
                          Classes.ok="{Binding DotLive}"
                          Classes.danger="{Binding DotDanger}"
                          Classes.refusing="{Binding DotDanger}"
                          Classes.stopped="{Binding DotStopped}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsVisible="{Binding HasDot}" />
                  <!-- What needs attention, in the accent as Mail's unread count is: Security's findings, or agents waiting. -->
                  <Border Name="RailBadge"
                          Classes="badge"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,2,2,0"
                          IsVisible="{Binding HasBadge}">
                    <TextBlock Text="{Binding Count}" />
                  </Border>
                </Panel>
                <!-- The hairline under the places, drawn under Access, the last of them. -->
                <Border Name="RailLine" Width="22" Height="1" Margin="0,4" HorizontalAlignment="Center" Background="{DynamicResource KpBorderStrong}" IsVisible="{Binding IsLater}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </Panel>
        </Border>

        <!-- The sidebar of Items: New, Favorites, then the one vault's places, or All Accounts and the local account's vaults with their places; Add vault… at its foot. Nav is a ListBox on purpose: arrow keys, Home/End and type-ahead all work for free, and the accessibility roles are right. -->
        <Border Name="Sidebar"
                Grid.Column="1"
                ZIndex="2"
                Width="{x:Static views:WindowChrome.SidebarWidth}"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowsSidebar}"
                Classes="sidebar vibrant-able"
                Classes.overlay="{Binding SidebarOverlays}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <DockPanel Margin="8,10,8,8">

            <Button Name="SidebarNew"
                    DockPanel.Dock="Top"
                    Margin="2,2,2,10"
                    Command="{Binding NewItemCommand}"
                    ToolTip.Tip="{x:Static res:Strings.NewItemFromTemplateLabel}"
                    AutomationProperties.Name="{x:Static res:Strings.New}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="square-pen" Size="16" />
                <TextBlock Text="{x:Static res:Strings.New}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Name="AddVault"
                    DockPanel.Dock="Bottom"
                    Classes="ghost"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="{x:Static res:Strings.AddVaultLabel}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ctl:KpIcon Icon="plus" Size="16" />
                <TextBlock Text="{x:Static res:Strings.AddVaultLabel}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Name="OpenVaultIntoAccount" Header="{x:Static res:Strings.OpenAVault}" Command="{Binding OpenVaultCommand}" />
                  <MenuItem Name="CreateVaultInAccount" Header="{x:Static res:Strings.CreateAVault}" Command="{Binding CreateVaultCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <ListBox Name="Nav"
                     AutomationProperties.Name="{x:Static res:Strings.Places}"
                     Classes="nav"
                     Classes.accounts="{Binding ShowsAccounts}"
                     ItemsSource="{Binding SidebarRows}"
                     SelectedItem="{Binding SelectedSidebarRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:PlaceRow">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Classes.under-vault="{Binding !IsTop}"
                        AutomationProperties.Name="{Binding Title}">
                    <ctl:KpIcon Icon="{Binding Icon}" Size="16" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="count" Text="{Binding Count}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:AccountRow">
                  <TextBlock Classes="account" Text="{Binding Title}" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding Title}" />
                </DataTemplate>
                <DataTemplate DataType="vm:VaultRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Vault.VaultPath}" AutomationProperties.Name="{Binding Title}">
                    <Button Classes="icon ghost fold"
                            Margin="-4,0,2,0"
                            IsVisible="{Binding IsExpandable}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FoldLabel}"
                            AutomationProperties.Name="{Binding FoldLabel}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="14" />
                    </Button>
                    <TextBlock Grid.Column="1" Classes="vault" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <!-- A merge of another program's save under way, or a change not yet in the file. -->
                      <TextBlock Name="VaultSaveMark" Classes="count" Text="{Binding SaveMark}" IsVisible="{Binding HasSaveMark}" VerticalAlignment="Center" />
                      <ctl:KpIcon Icon="lock" Size="14" IsVisible="{Binding IsLocked}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:ProjectRow">
                  <Grid ColumnDefinitions="*,Auto"
                        Classes="project"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding Name}">
                    <TextBlock Classes="mono size-12"
                               FontWeight="Normal"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="count"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>

          </DockPanel>
        </Border>

        <Grid Grid.Column="2" Name="ContentColumn" Background="{DynamicResource KpBgApp}" RowDefinitions="Auto,Auto,Auto,*">

          <!-- A screen under a place, such as History under Agents, goes back up to it. -->
          <!-- A row of its own, so nothing a page scrolls can sit under the link or be hidden by it; the screens under a place keep 16 less at their top for this. -->
          <Border Grid.Row="0"
                  Name="BackStrip"
                  IsVisible="{Binding HasBack}">
            <Button Name="Back"
                    Classes="ghost sm"
                    HorizontalAlignment="Left"
                    Margin="24,12,0,0"
                    AutomationProperties.Name="{Binding BackTitle, StringFormat={x:Static res:Strings.BackToValue}}"
                    Command="{Binding BackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-left" Size="14" />
                <TextBlock Text="{Binding BackTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>

          <!-- Until a screen draws its own title (Destination.OwnsHeader), the shell draws it. -->
          <TextBlock Grid.Row="1"
                     Classes="h1"
                     Text="{Binding CurrentTitle}"
                     IsVisible="{Binding ShowsHeader}"
                     Margin="16,12,16,0" />

          <StackPanel Grid.Row="2">
            <!-- Another program's save keypaste did not merge: agents are refused until a reload. -->
            <Border IsVisible="{Binding HasVaultChanged}"
                    CornerRadius="{DynamicResource KpRadiusCard}"
                    Background="{DynamicResource KpDangerTint}"
                    Padding="12,8"
                    Margin="16,8,16,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="alert-triangle" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource KpDanger}" />
                <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                           Name="VaultChanged"
                           Text="{Binding VaultChanged}"
                           TextWrapping="Wrap"
                           Classes="size-13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Name="SaveOverFile" Classes="sm" Content="{x:Static res:Strings.SaveWhatsOpenHere}" Margin="12,0,0,0" IsVisible="{Binding OffersSaveOverFile}" Command="{Binding SaveOverFileCommand}" />
                <Button
                        Name="Reload"
                        Classes="sm"
                        Content="{x:Static res:Strings.Reload}"
                        Margin="12,0,0,0"
                        Command="{Binding ReloadCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- What a restore did, that this vault was just chosen, or what a merge saved and named. Quiet. -->
            <Border IsVisible="{Binding HasNotice}"
                    Classes="card"
                    BorderBrush="{DynamicResource KpBorderSubtle}"
                    Padding="12,8"
                    Margin="16,8,16,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="info" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource KpTextSecondary}" />
                <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                           Name="Notice"
                           ctl:Announcer.Says="{Binding Notice}"
                           Text="{Binding Notice}"
                           TextWrapping="Wrap"
                           Classes="size-13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <Button Grid.Column="2"
                        Classes="ghost sm"
                        Content="{x:Static res:Strings.Dismiss}"
                        Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" />
              </Grid>
            </Border>
          </StackPanel>

          <Border Grid.Row="3" Name="ContentArea" Classes="content" Classes.padded="{Binding ShowsHeader}">
            <ContentControl Content="{Binding Content}" />
          </Border>

        </Grid>
      </Grid>
    </Grid>

    <!-- Share…, from an item's ⋯ menu, modal over the whole window. -->
    <Border Classes="backdrop" IsVisible="{Binding HasShare}" Padding="24">
      <views:ShareDialogView DataContext="{Binding Share}" />
    </Border>

    <!-- New item, from the list's add, the File menu, its chord or a generator, as a sheet over the window. -->
    <views:NewItemSheet DataContext="{Binding EntriesInView}" />

    <!-- The one generator's sheet: on its own, or opened from a field of New item, the open item or a project. -->
    <!-- Its DataContext is its own choice of the four, so each reads the shell's. -->
    <views:GeneratePasswordView>
      <views:GeneratePasswordView.DataContext>
        <MultiBinding Converter="{x:Static views:FirstOpen.Generator}">
          <Binding Path="$parent[views:ShellView].((vm:ShellViewModel)DataContext).GeneratorDialog" />
          <Binding Path="$parent[views:ShellView].((vm:ShellViewModel)DataContext).EntriesInView.NewItem.GeneratorPanel" />
          <Binding Path="$parent[views:ShellView].((vm:ShellViewModel)DataContext).EntriesInView.Detail.GeneratorPanel" />
          <Binding Path="$parent[views:ShellView].((vm:ShellViewModel)DataContext).ProjectsInView.OpenProject.GeneratorPanel" />
        </MultiBinding>
      </views:GeneratePasswordView.DataContext>
    </views:GeneratePasswordView>

    <!-- The import dialogs, modal over the whole window: a KeePass database's, or another app's export's. -->
    <Border Classes="backdrop" IsVisible="{Binding HasKdbxImport}" Padding="24">
      <views:KdbxImportView DataContext="{Binding Import}" />
    </Border>
    <Border Classes="backdrop" IsVisible="{Binding HasExportImport}" Padding="24">
      <views:ExportImportView DataContext="{Binding ExportImport}" />
    </Border>

    <!-- A save waiting for the YubiKey. Modal, so nothing else is edited while the save is half done. -->
    <Border Classes="backdrop" IsVisible="{Binding IsWaitingForTouch}" Padding="24">
      <Border Name="TouchDialog" Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="dot waiting" />
            <TextBlock Text="{x:Static res:Strings.TouchYourYubiKey}" Classes="size-14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.TheVaultIsSavedOnceTheKeyX6aa2e0}" />
          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" HorizontalAlignment="Left" Command="{Binding CancelTouchCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Asked before a place change or an Escape loses what was typed. Above every other dialog, since Share's Escape asks too. -->
    <Border Classes="backdrop" IsVisible="{Binding HasDiscardPrompt}" Padding="24">
      <Border Name="DiscardDialog"
              Classes="dialog"
              KeyboardNavigation.TabNavigation="Cycle"
              MaxWidth="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Name="DiscardPrompt" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding DiscardPrompt}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.WhatYouTypedHasNotBeenSaved}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="KeepDraft" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding KeepDraftCommand}" />
            <Button Name="ConfirmDiscard" Classes="danger" Content="{x:Static res:Strings.Discard}" Command="{Binding ConfirmDiscardCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- A file or an item being dragged: what it would land on, and what it would do. -->
    <ctl:DropCue Name="Cue" />

    <!-- A file the system or a second start named. Asked because only the person may lock this vault for it, so Cancel holds the keyboard and Return is not the action. -->
    <Border Classes="backdrop" IsVisible="{Binding HasHandedPrompt}" Padding="24">
      <Border Name="HandedDialog"
              Classes="dialog"
              KeyboardNavigation.TabNavigation="Cycle"
              MaxWidth="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Name="HandedPrompt" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding HandedPrompt}" />
          <TextBlock Name="HandedLocation" Classes="mono muted size-12" TextWrapping="Wrap" Text="{Binding HandedLocation}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.KeypasteWasAskedToOpenThisFileX50ed11}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="KeepVault" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding KeepVaultCommand}" />
            <Button Name="LockAndOpen" Content="{x:Static res:Strings.LockAndOpen}" Command="{Binding LockAndOpenCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Toasts, centred under the titlebar and clear of Items' search and New. The clipboard countdown is one; Toasts says anything else. -->
    <StackPanel Name="ToastStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="{x:Static views:WindowChrome.ToastMargin}"
                Spacing="8"
                MaxWidth="420">

      <!-- Never KpDanger: a working auto-clear is the most normal thing this feature does. -->
      <Border Name="ClipboardToast" Classes="toast" IsVisible="{Binding Clipboard.IsVisible}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="clipboard-check" Size="16" Foreground="{DynamicResource KpOk}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       ctl:Announcer.Says="{Binding Clipboard.Label, StringFormat={x:Static res:Strings.ValueCopied}}"
                       Text="{Binding Clipboard.Label, StringFormat={x:Static res:Strings.ValueCopied}}" />
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       Text="{Binding Clipboard.SecondsLeft, StringFormat={x:Static res:Strings.ClearsInValueS}}" />
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       Classes="secondary"
                       ctl:Announcer.Says="{Binding Clipboard.Failure}"
                       Text="{Binding Clipboard.Failure}" />
            <Button Classes="link"
                    Content="{x:Static res:Strings.ClearNow}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Clipboard.IsCounting}"
                    Command="{Binding Clipboard.ClearNowCommand}" />
          </StackPanel>
          <ProgressBar Classes="thin"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding Clipboard.Fraction}"
                       IsVisible="{Binding Clipboard.IsCounting}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Toasts.Shown}" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Toast">
            <Border Classes="toast" PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                  <ctl:KpIcon Icon="circle-check" Size="16" Foreground="{DynamicResource KpOk}" IsVisible="{Binding IsSuccess}" />
                  <ctl:KpIcon Icon="info" Size="16" Foreground="{DynamicResource KpInfo}" IsVisible="{Binding IsInformation}" />
                  <ctl:KpIcon Icon="alert-triangle" Size="16" Foreground="{DynamicResource KpAccentText}" IsVisible="{Binding IsWarning}" />
                </Panel>
                <TextBlock Grid.Column="1" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                <Button Grid.Column="2"
                        Classes="icon ghost sm"
                        VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Close}"
                        AutomationProperties.Name="{x:Static res:Strings.CloseThisMessage}">
                  <ctl:KpIcon Icon="x" Size="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

  </Panel>

</UserControl>
