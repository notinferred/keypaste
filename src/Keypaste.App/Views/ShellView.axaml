<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:nav="using:Keypaste.App.Navigation"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource KpSurface0}">

  <!-- Implicit templates, matched by the type of whatever Content holds. Adding a destination in
       4.2 means adding a view model and a template here, and nothing else. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:EmptyStateViewModel">
      <StackPanel Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Line}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource KpTextSecondary}" />
        <TextBlock Text="{Binding Aside}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource KpTextMuted}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentActivityViewModel">
      <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Status}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource KpTextPrimary}" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource KpTextMuted}"
                   Text="This app does not answer agent requests yet — a running keypaste agent still does, in its own terminal. The live feed with approve and deny arrives in the next release." />
        <Button Content="Check again" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="220,*">

    <!-- The sidebar is a ListBox on purpose: arrow keys, Home/End and type-ahead all work for
         free, the accessibility roles are right, and there is no custom key handling to get
         wrong. SelectedItem drives navigation. -->
    <Border Grid.Column="0"
            Background="{DynamicResource KpSurface1}"
            BorderBrush="{DynamicResource KpBorderSubtle}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,20" Spacing="2">
          <TextBlock Text="{Binding VaultName}"
                     ToolTip.Tip="{Binding VaultPath}"
                     FontSize="14"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource KpTextPrimary}" />
          <TextBlock Text="unlocked"
                     FontSize="11"
                     Foreground="{DynamicResource KpTextMuted}" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                Content="Lock now"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="8,12,8,0"
                Command="{Binding LockCommand}" />

        <ListBox Name="Nav"
                 ItemsSource="{Binding Destinations_}"
                 SelectedItem="{Binding Current}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="nav:Destination">
              <TextBlock Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <Border Grid.Row="0"
              BorderBrush="{DynamicResource KpBorderSubtle}"
              BorderThickness="0,0,0,1"
              Padding="24,18">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Text="{Binding CurrentTitle}"
                     FontSize="18"
                     Foreground="{DynamicResource KpTextPrimary}" />

          <!-- Muted, never red. An auto-lock is the most normal thing this app does. -->
          <TextBlock Grid.Column="1"
                     Text="{Binding Countdown}"
                     IsVisible="{Binding HasCountdown}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource KpTextMuted}" />
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding Content}" Margin="24" />

    </Grid>
  </Grid>

</UserControl>
