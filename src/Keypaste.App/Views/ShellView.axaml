<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:views="using:Keypaste.App.Views"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource KpBgApp}">

  <UserControl.Resources>
    <views:DepthToIndent x:Key="Indent" />
  </UserControl.Resources>

  <!-- Implicit templates, matched by the type of whatever Content holds. Adding a destination
       means a line in Destinations.All, a view model in ShellViewModel.Show and a template here. -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="vm:EntriesViewModel">
      <views:EntriesView />
    </DataTemplate>

    <DataTemplate DataType="vm:EnvSetsViewModel">
      <views:EnvSetsView />
    </DataTemplate>

    <DataTemplate DataType="vm:TrashViewModel">
      <views:TrashView />
    </DataTemplate>

    <DataTemplate DataType="vm:LogViewModel">
      <views:LogView />
    </DataTemplate>

    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AgentActivityViewModel">
      <views:AgentActivityView />
    </DataTemplate>

    <DataTemplate DataType="vm:SharingViewModel">
      <views:SharingView />
    </DataTemplate>

    <DataTemplate DataType="vm:ScopedTokensViewModel">
      <views:ScopedTokensView />
    </DataTemplate>

    <DataTemplate DataType="vm:DiagnosticsViewModel">
      <views:DiagnosticsView />
    </DataTemplate>

    <DataTemplate DataType="vm:AdvancedViewModel">
      <views:AdvancedView />
    </DataTemplate>

    <DataTemplate DataType="vm:RecommendationsViewModel">
      <views:RecommendationsView />
    </DataTemplate>

  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Border.content.padded">
      <Setter Property="Padding" Value="16,8,16,16" />
    </Style>

    <!-- A sidebar row is announced by its place or project, the rows being view models rather than text. -->
    <Style Selector="ListBox.nav > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Title}" />
    </Style>

    <!-- The rail draws no words, so a row is announced with its status and says the rest as a tooltip. -->
    <Style Selector="ListBox.rail > ListBoxItem">
      <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding RailName}" />
      <Setter Property="AutomationProperties.HelpText" Value="{ReflectionBinding Detail}" />
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding RailTip}" />
      <Setter Property="ToolTip.Placement" Value="Right" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border#TitleBar">
      <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border#TitleBar.beside-sidebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Grid RowDefinitions="40,*">

      <!-- The window's title area, draggable everywhere but its controls. It holds what the sidebar's foot would hold only while there is no sidebar or rail. -->
      <Border Grid.Row="0"
              Name="TitleBar"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Grid Name="TitleColumns" ColumnDefinitions="232,Auto,*">

          <!-- The sidebar's surface, carried up under the traffic lights while the sidebar shows beside the content. -->
          <Border Name="TitleOverSidebar"
                  Background="{DynamicResource KpBgPanel}"
                  BorderBrush="{DynamicResource KpBorderSubtle}"
                  BorderThickness="0,0,1,0" />

          <!-- Only while the person has hidden the sidebar: Agents, Settings and the groups would otherwise have nothing on screen pointing to them. In a narrow window, where the rail is what a person expects to see, it says so in words. -->
          <Button Grid.Column="1"
                  Name="ShowSidebar"
                  Classes="ghost sm"
                  Classes.icon="{Binding !IsNarrow}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding SidebarHidden}"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{Binding SidebarWayBack, TargetNullValue='Show sidebar'}"
                  AutomationProperties.Name="{x:Static res:Strings.ShowSidebar}"
                  AutomationProperties.HelpText="{Binding SidebarWayBack}"
                  WindowDecorationProperties.ElementRole="User">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:KpIcon Icon="panel-left" Size="16" />
              <TextBlock Text="{x:Static res:Strings.ShowSidebar}" VerticalAlignment="Center" IsVisible="{Binding IsNarrow}" />
            </StackPanel>
          </Button>

          <!-- The idle warning's first line, said once as the warning comes, while the ticking text stays quiet. -->
          <Border Grid.Column="2" ctl:Announcer.Says="{Binding CountdownAnnouncement}" />

          <!-- With the sidebar and the rail away, the foot is drawn here so the vault's state and Lock stay in view. -->
          <Grid Grid.Column="2"
                ColumnDefinitions="Auto,*"
                Margin="8,0,12,0"
                VerticalAlignment="Center">
            <TextBlock Name="TitleCountdown"
                       Classes="size-13 muted"
                       Text="{Binding Countdown}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasCountdown" />
                  <Binding Path="SidebarHidden" />
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
            <Decorator Name="TitleFootSlot" Grid.Column="1" />
          </Grid>

        </Grid>
      </Border>

      <!-- The screens' own styles read tight-content for what gives way where the content has little room. -->
      <Grid Name="BodyColumns" Grid.Row="1" ColumnDefinitions="232,*" Classes.tight-content="{Binding ContentIsTight}">

        <!-- The rail, under the titlebar and so clear of the traffic lights and the menu button. The places are one list, so the arrow keys walk them; what does not fit in icons opens from its button. -->
        <Border Name="Rail"
                Grid.Column="0"
                IsVisible="{Binding ShowsRail}"
                Background="{DynamicResource KpBgPanel}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <DockPanel Margin="8">
            <Button Name="RailGroups"
                    DockPanel.Dock="Top"
                    Classes="icon ghost"
                    Width="40"
                    Height="40"
                    Margin="0,0,0,8"
                    Command="{Binding OpenSidebarOverlayCommand}"
                    ToolTip.Tip="{x:Static res:Strings.ShowGroupsAndProjects}"
                    ToolTip.Placement="Right"
                    AutomationProperties.Name="{x:Static res:Strings.ShowGroupsAndProjects}">
              <ctl:KpIcon Icon="panel-left" Size="20" />
            </Button>

            <!-- The sidebar's foot in the rail's terms: the countdown near a lock, and Lock, with the save state on its dot. -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
              <Panel Name="RailCountdown"
                     Width="40"
                     Height="24"
                     Background="Transparent"
                     IsVisible="{Binding HasCountdown}"
                     ToolTip.Tip="{Binding Countdown}"
                     ToolTip.Placement="Right"
                     AutomationProperties.Name="{Binding Countdown}">
                <ctl:KpIcon Icon="hourglass" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource KpTextMuted}" />
              </Panel>
              <Button Name="RailLock"
                      Classes="icon ghost"
                      Width="40"
                      Height="40"
                      Command="{Binding LockCommand}"
                      ToolTip.Tip="{Binding VaultStatusDetail}"
                      ToolTip.Placement="Right"
                      AutomationProperties.Name="{x:Static res:Strings.LockNow}"
                      AutomationProperties.HelpText="{Binding VaultStatusDetail}">
                <Panel Width="28" Height="28">
                  <ctl:KpIcon Icon="lock" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Border Classes="dot"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Classes.ok="{Binding VaultStatusOk}"
                          Classes.idle="{Binding VaultStatusPending}"
                          Classes.danger="{Binding VaultStatusDanger}" />
                </Panel>
              </Button>
            </StackPanel>

            <ListBox Name="RailNav"
                     AutomationProperties.Name="{x:Static res:Strings.Places}"
                     Classes="nav rail"
                     ItemsSource="{Binding RailPlaces}"
                     SelectedItem="{Binding SelectedRailPlace}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <ctl:RailPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <Panel Width="28" Height="28">
                    <ctl:KpIcon Icon="{Binding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Name="RailAgentsDot"
                            Classes="dot"
                            Classes.ok="{Binding DotLive}"
                            Classes.danger="{Binding DotDanger}"
                            Classes.refusing="{Binding DotDanger}"
                            Classes.stopped="{Binding DotStopped}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsVisible="{Binding HasDot}" />
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- The sidebar. Nav is a ListBox on purpose: arrow keys, Home/End and type-ahead all work
             for free, the accessibility roles are right, and there is no custom key handling to get
             wrong. SelectedMain drives navigation. -->
        <Border Name="Sidebar"
                Grid.Column="0"
                ZIndex="2"
                Width="{x:Static views:WindowChrome.SidebarWidth}"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowsSidebar}"
                Classes="sidebar"
                Classes.overlay="{Binding SidebarOverlays}"
                Background="{DynamicResource KpBgPanel}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="0,0,1,0">
          <DockPanel Margin="8,4,8,8">

            <!-- The vault's file and save state, and Lock: what the title bar held. -->
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Name="FootCountdown"
                         Classes="size-13 muted"
                         Text="{Binding Countdown}"
                         IsVisible="{Binding HasCountdown}"
                         TextWrapping="Wrap"
                         Margin="8,8,0,0" />
              <Decorator Name="SidebarFootSlot">
                <Border Name="VaultFoot" Classes="vault-foot">
                  <Grid ColumnDefinitions="*,Auto">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="{Binding VaultStatusDetail}"
                        WindowDecorationProperties.ElementRole="User">
                    <Border Classes="dot"
                            Margin="0,0,6,0"
                            Classes.ok="{Binding VaultStatusOk}"
                            Classes.idle="{Binding VaultStatusPending}"
                            Classes.danger="{Binding VaultStatusDanger}" />
                    <!-- A long file name gives way in its middle, so the save state at the end always shows. -->
                    <TextBlock Grid.Column="1"
                               Name="VaultFileName"
                               Classes="mono size-12 muted"
                               Text="{Binding VaultName}"
                               TextTrimming="PrefixCharacterEllipsis"
                               VerticalAlignment="Center" />
                    <!-- Drawn, because Instrument Sans's middle dot advances 1.3 and inks past that, against the next word. -->
                    <Border Grid.Column="2" Width="2" Height="2" CornerRadius="4" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource KpTextMuted}" />
                    <TextBlock Grid.Column="3"
                               Name="VaultSaveState"
                               Classes="size-13 muted"
                               Text="{Binding VaultSaveWords}"
                               VerticalAlignment="Center" />
                  </Grid>
                    <Button Grid.Column="1"
                            Name="LockButton"
                            Classes="foot-lock size-12"
                            Margin="4,0,0,0"
                            Command="{Binding LockCommand}"
                            ToolTip.Tip="{x:Static res:Strings.LockNow}"
                            AutomationProperties.Name="{x:Static res:Strings.LockNow}"
                            WindowDecorationProperties.ElementRole="User"
                            Content="{x:Static res:Strings.LockLabel}" />
                  </Grid>
                </Border>
              </Decorator>
            </StackPanel>

            <!-- Trash and Settings, quieter, at the bottom. -->
            <ListBox Name="FooterNav"
                     AutomationProperties.Name="{x:Static res:Strings.MorePlaces}"
                     DockPanel.Dock="Bottom"
                     Classes="nav quiet"
                     Margin="0,12,0,0"
                     ItemsSource="{Binding FooterNav}"
                     SelectedItem="{Binding SelectedFooter}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" AutomationProperties.Name="{Binding Title}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="16" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="label muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Items with the vault's group tree under it, the projects, then Agents: one list, so the
                 arrow keys walk the sidebar as it reads, and Left and Right fold a row as in KeePassXC's
                 tree. -->
            <ListBox Name="Nav"
                     AutomationProperties.Name="{x:Static res:Strings.Places}"
                     Classes="nav"
                     ItemsSource="{Binding SidebarRows}"
                     SelectedItem="{Binding SelectedSidebarRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.DataTemplates>
                <DataTemplate DataType="vm:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.HelpText="{Binding Detail}"
                        ToolTip.Tip="{Binding Detail}">
                    <ctl:KpIcon Grid.Column="0" Icon="{Binding Icon}" Size="16" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="label muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                      <TextBlock Name="AgentsDotWords"
                                 Classes="label muted"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding DotWords}"
                                 IsVisible="{Binding DotWords, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Border Name="AgentsDot"
                              Classes="dot"
                              Classes.ok="{Binding DotLive}"
                              Classes.danger="{Binding DotDanger}"
                              Classes.refusing="{Binding DotDanger}"
                              Classes.stopped="{Binding DotStopped}"
                              IsVisible="{Binding HasDot}" />
                    </StackPanel>
                    <Button Grid.Column="4"
                            Classes="icon ghost fold"
                            Margin="2,-2,-8,-2"
                            IsVisible="{Binding IsExpandable}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FoldLabel}"
                            AutomationProperties.Name="{Binding FoldLabel}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="14" />
                    </Button>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:GroupRow">
                  <Grid ColumnDefinitions="16,Auto,*"
                        Margin="{Binding Depth, Converter={StaticResource Indent}}"
                        AutomationProperties.Name="{Binding Title}">
                    <Button Grid.Column="0"
                            Classes="icon ghost fold"
                            Margin="-2"
                            IsVisible="{Binding HasChildren}"
                            Command="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FoldCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding FoldLabel}"
                            AutomationProperties.Name="{Binding FoldLabel}">
                      <ctl:KpIcon Icon="{Binding Chevron}" Size="14" />
                    </Button>
                    <ctl:KpIcon Grid.Column="1" Icon="folder" Size="16" Margin="4,0,8,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:SidebarHeading">
                  <TextBlock Classes="th" Text="{Binding Label}" />
                </DataTemplate>
                <DataTemplate DataType="vm:ProjectRow">
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Margin="16,0,0,0"
                        AutomationProperties.Name="{Binding Title}"
                        ToolTip.Tip="{Binding Name}">
                    <ctl:KpIcon Grid.Column="0" Icon="folder-git-2" Size="16" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Classes="mono size-12"
                               FontWeight="Normal"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Classes="label muted"
                               Text="{Binding Count}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.DataTemplates>
            </ListBox>

          </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

          <!-- A screen under a place, such as History under Agents, goes back up to it. -->
          <!-- A row of its own, so nothing a page scrolls can sit under the link or be hidden by it; the screens under a place keep 16 less at their top for this. -->
          <Border Grid.Row="0"
                  Name="BackStrip"
                  IsVisible="{Binding HasBack}">
            <Button Name="Back"
                    Classes="ghost sm"
                    HorizontalAlignment="Left"
                    Margin="24,12,0,0"
                    AutomationProperties.Name="{Binding BackTitle, StringFormat={x:Static res:Strings.BackToValue}}"
                    Command="{Binding BackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ctl:KpIcon Icon="chevron-left" Size="14" />
                <TextBlock Text="{Binding BackTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Border>

          <!-- Until a screen draws its own title (Destination.OwnsHeader), the shell draws it. -->
          <TextBlock Grid.Row="1"
                     Classes="h1"
                     Text="{Binding CurrentTitle}"
                     IsVisible="{Binding ShowsHeader}"
                     Margin="16,12,16,0" />

          <StackPanel Grid.Row="2">
            <!-- Another program's save keypaste did not merge: agents are refused until a reload. -->
            <Border IsVisible="{Binding HasVaultChanged}"
                    CornerRadius="{DynamicResource KpRadiusCard}"
                    Background="{DynamicResource KpDangerTint}"
                    Padding="12,8"
                    Margin="16,8,16,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="alert-triangle" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource KpDanger}" />
                <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                           Name="VaultChanged"
                           Text="{Binding VaultChanged}"
                           TextWrapping="Wrap"
                           Classes="size-13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Name="SaveOverFile" Classes="sm" Content="{x:Static res:Strings.SaveWhatsOpenHere}" Margin="12,0,0,0" IsVisible="{Binding OffersSaveOverFile}" Command="{Binding SaveOverFileCommand}" />
                <Button
                        Name="Reload"
                        Classes="sm"
                        Content="{x:Static res:Strings.Reload}"
                        Margin="12,0,0,0"
                        Command="{Binding ReloadCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- What a restore did, that this vault was just chosen, or what a merge saved and named. Quiet. -->
            <Border IsVisible="{Binding HasNotice}"
                    Classes="card"
                    BorderBrush="{DynamicResource KpBorderSubtle}"
                    Padding="12,8"
                    Margin="16,8,16,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ctl:KpIcon Grid.Column="0" Icon="info" Size="14" Margin="0,0,8,0" Foreground="{DynamicResource KpTextSecondary}" />
                <TextBlock ctl:MachineRuns.InText="True" Grid.Column="1"
                           Name="Notice"
                           ctl:Announcer.Says="{Binding Notice}"
                           Text="{Binding Notice}"
                           TextWrapping="Wrap"
                           Classes="size-13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource KpTextSecondary}" />
                <Button Grid.Column="2"
                        Classes="ghost sm"
                        Content="{x:Static res:Strings.Dismiss}"
                        Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" />
              </Grid>
            </Border>
          </StackPanel>

          <Border Grid.Row="3" Name="ContentArea" Classes="content" Classes.padded="{Binding ShowsHeader}">
            <ContentControl Content="{Binding Content}" />
          </Border>

        </Grid>
      </Grid>
    </Grid>

    <!-- Share…, from an item's ⋯ menu, modal over the whole window. -->
    <Border Classes="backdrop" IsVisible="{Binding HasShare}" Padding="24">
      <views:ShareDialogView DataContext="{Binding Share}" />
    </Border>

    <Border Classes="backdrop" IsVisible="{Binding HasGeneratorDialog}" Padding="24">
      <views:GeneratePasswordView DataContext="{Binding GeneratorDialog}" />
    </Border>

    <!-- The import dialogs, modal over the whole window: a KeePass database's, or another app's export's. -->
    <Border Classes="backdrop" IsVisible="{Binding HasKdbxImport}" Padding="24">
      <views:KdbxImportView DataContext="{Binding Import}" />
    </Border>
    <Border Classes="backdrop" IsVisible="{Binding HasExportImport}" Padding="24">
      <views:ExportImportView DataContext="{Binding ExportImport}" />
    </Border>

    <!-- A save waiting for the YubiKey. Modal, so nothing else is edited while the save is half done. -->
    <Border Classes="backdrop" IsVisible="{Binding IsWaitingForTouch}" Padding="24">
      <Border Name="TouchDialog" Classes="dialog" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="dot waiting" />
            <TextBlock Text="{x:Static res:Strings.TouchYourYubiKey}" Classes="size-14" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextPrimary}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{x:Static res:Strings.TheVaultIsSavedOnceTheKeyX6aa2e0}" />
          <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" HorizontalAlignment="Left" Command="{Binding CancelTouchCommand}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Asked before a place change or an Escape loses what was typed. Above every other dialog, since Share's Escape asks too. -->
    <Border Classes="backdrop" IsVisible="{Binding HasDiscardPrompt}" Padding="24">
      <Border Name="DiscardDialog"
              Classes="dialog"
              KeyboardNavigation.TabNavigation="Cycle"
              MaxWidth="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Name="DiscardPrompt" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding DiscardPrompt}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.WhatYouTypedHasNotBeenSaved}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="KeepDraft" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding KeepDraftCommand}" />
            <Button Name="ConfirmDiscard" Classes="danger" Content="{x:Static res:Strings.Discard}" Command="{Binding ConfirmDiscardCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- A file or an item being dragged: what it would land on, and what it would do. -->
    <ctl:DropCue Name="Cue" />

    <!-- A file the system or a second start named. Asked because only the person may lock this vault for it, so Cancel holds the keyboard and Return is not the action. -->
    <Border Classes="backdrop" IsVisible="{Binding HasHandedPrompt}" Padding="24">
      <Border Name="HandedDialog"
              Classes="dialog"
              KeyboardNavigation.TabNavigation="Cycle"
              MaxWidth="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Name="HandedPrompt" Classes="dialog-title" TextWrapping="Wrap" Text="{Binding HandedPrompt}" />
          <TextBlock Name="HandedLocation" Classes="mono muted size-12" TextWrapping="Wrap" Text="{Binding HandedLocation}" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.KeypasteWasAskedToOpenThisFileX50ed11}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="KeepVault" Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding KeepVaultCommand}" />
            <Button Name="LockAndOpen" Content="{x:Static res:Strings.LockAndOpen}" Command="{Binding LockAndOpenCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Toasts, centred under the titlebar and clear of Items' search and New. The clipboard countdown is one; Toasts says anything else. -->
    <StackPanel Name="ToastStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="{x:Static views:WindowChrome.ToastMargin}"
                Spacing="8"
                MaxWidth="420">

      <!-- Never KpDanger: a working auto-clear is the most normal thing this feature does. -->
      <Border Name="ClipboardToast" Classes="toast" IsVisible="{Binding Clipboard.IsVisible}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="clipboard-check" Size="16" Foreground="{DynamicResource KpOk}" />
            <TextBlock VerticalAlignment="Center"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       ctl:Announcer.Says="{Binding Clipboard.Label, StringFormat={x:Static res:Strings.ValueCopied}}"
                       Text="{Binding Clipboard.Label, StringFormat={x:Static res:Strings.ValueCopied}}" />
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       IsVisible="{Binding Clipboard.IsCounting}"
                       Text="{Binding Clipboard.SecondsLeft, StringFormat={x:Static res:Strings.ClearsInValueS}}" />
            <TextBlock VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="320"
                       Classes="secondary"
                       ctl:Announcer.Says="{Binding Clipboard.Failure}"
                       Text="{Binding Clipboard.Failure}" />
            <Button Classes="link"
                    Content="{x:Static res:Strings.ClearNow}"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Clipboard.IsCounting}"
                    Command="{Binding Clipboard.ClearNowCommand}" />
          </StackPanel>
          <ProgressBar Classes="thin"
                       Minimum="0"
                       Maximum="1"
                       Value="{Binding Clipboard.Fraction}"
                       IsVisible="{Binding Clipboard.IsCounting}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Toasts.Shown}" ClipToBounds="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Toast">
            <Border Classes="toast" PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                  <ctl:KpIcon Icon="circle-check" Size="16" Foreground="{DynamicResource KpOk}" IsVisible="{Binding IsSuccess}" />
                  <ctl:KpIcon Icon="info" Size="16" Foreground="{DynamicResource KpInfo}" IsVisible="{Binding IsInformation}" />
                  <ctl:KpIcon Icon="alert-triangle" Size="16" Foreground="{DynamicResource KpAccentText}" IsVisible="{Binding IsWarning}" />
                </Panel>
                <TextBlock Grid.Column="1" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                <Button Grid.Column="2"
                        Classes="icon ghost sm"
                        VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Close}"
                        AutomationProperties.Name="{x:Static res:Strings.CloseThisMessage}">
                  <ctl:KpIcon Icon="x" Size="14" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>

  </Panel>

</UserControl>
