<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!-- The design's MCP approval dialog, shared by the three prompt windows. The window is chromeless
       and transparent, so the card and its shadow are all there is of it; where the platform cannot
       draw transparency, PromptWindow marks the window opaque and the card fills it edge to edge. -->

  <Style Selector="Border.prompt">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusDialog}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="BoxShadow" Value="0 24 64 0 #8C000000" />
  </Style>
  <Style Selector=".opaque Border.prompt">
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- Another window has focus: the card recedes by colour alone, so nothing moves, and the allows are disarmed. -->
  <Style Selector=".inactive Border.prompt">
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #59000000" />
  </Style>
  <Style Selector=".inactive TextBlock.prompt-title">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector=".inactive Border.prompt-tile">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
  </Style>

  <!-- The header is one fixed row of single lines, whatever the agent calls itself or wherever it
       runs: a title and a subtitle, or a third line where a window sets its height for one. -->
  <Style Selector="Grid.prompt-head">
    <Setter Property="Height" Value="40" />
  </Style>
  <Style Selector="Grid.prompt-head TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="1" />
  </Style>

  <!-- A run prompt's environment, on a fixed row of its own beneath the header: the name in the mono
       face, wrapping and never trimmed, which one of at most 32 characters never needs to. -->
  <Style Selector="Grid.prompt-environment">
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="TextBlock.prompt-environment">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <Style Selector="Border.prompt-tile">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.prompt-title">
    <Setter Property="AutomationProperties.HeadingLevel" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.16" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.prompt-sub">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>

  <!-- Time left is said, not signalled: the prompt's one amber element is its primary answer. -->
  <Style Selector="Grid.prompt-head Border.dot.waiting">
    <Setter Property="Background" Value="{DynamicResource KpTextMuted}" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="TextBlock.prompt-countdown">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The tool call: what was asked, machine-readable, on the app ink. -->
  <Style Selector="Border.prompt-call">
    <Setter Property="Background" Value="{DynamicResource KpBgApp}" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
  </Style>
  <Style Selector="Border.prompt-call TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="LineHeight" Value="18.4" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Border.prompt-call TextBlock.value">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <!-- The secrets list: one bordered row per name, its tag on the right. -->
  <Style Selector="Border.prompt-list">
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.prompt-list TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <!-- What a row's value does or where it comes from is words. -->
  <Style Selector="Border.prompt-list TextBlock.tag">
    <Setter Property="FontFamily" Value="{DynamicResource KpSans}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <!-- The item a run's variable comes from is a path, quieter than the name above it. -->
  <Style Selector="Border.prompt-list TextBlock.source">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Border.prompt-row">
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <!-- A divider sits between rows, never after the last, so a short list ends in padding. -->
  <Style Selector="ContentPresenter:nth-last-child(1) > Border.prompt-row">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- The agent's reason: its words, in a box of their own that scrolls. -->
  <Style Selector="Border.prompt-reason">
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
  </Style>

  <Style Selector="TextBlock.prompt-note">
    <Setter Property="LineHeight" Value="19.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>

  <Style Selector="TextBlock.prompt-scrubbed">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="Button.prompt">
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Button.prompt.primary, Button.prompt.danger">
    <Setter Property="Padding" Value="16,0" />
  </Style>
  <!-- While arming, Allow once keeps its fill and shape; only its label fades, and stays readable because a person is reading the prompt by then. -->
  <Style Selector="Button.prompt:not(.primary):not(.danger):not(.ghost):disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>

  <!-- The claim card every agent's prompt is: keypaste's header and who is asking, as keypaste checked it, then the
       question, the item, the agent's own words, one plain consequence and Details; a hairline; the footer's quiet
       countdown and at most three buttons, the narrowest answer the primary. -->

  <Style Selector="Border.claim">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 22 60 0 #73000000" />
  </Style>
  <Style Selector=".opaque Border.claim">
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector=".inactive Border.claim">
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
  </Style>
  <Style Selector=".inactive TextBlock.claim-title">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <!-- The body and the footer keep the card's 20 padding; the hairline between them runs edge to edge. -->
  <Style Selector="StackPanel.claim-body">
    <Setter Property="Margin" Value="20,20,20,16" />
    <Setter Property="Spacing" Value="12" />
  </Style>
  <Style Selector="Border.claim-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource KpBorderSubtle}" />
  </Style>
  <!-- The countdown beside the buttons, or over them where the system's font draws them too wide to share the line. -->
  <Style Selector="ctl|HeaderRow.claim-foot">
    <Setter Property="Margin" Value="20,12,20,16" />
  </Style>

  <!-- Small words that label what follows: keypaste, and whose words the quote is. -->
  <Style Selector="TextBlock.claim-label">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="TextBlock.claim-line">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.claim-muted">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="ctl|KpIcon.claim-muted">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="TextBlock.claim-agent">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="StackPanel.claim-verified">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource KpOk}" />
  </Style>
  <Style Selector="StackPanel.claim-verified TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource KpOk}" />
  </Style>
  <Style Selector="StackPanel.claim-verified ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpOk}" />
  </Style>

  <!-- The question: a heading, wrapping, whose field or item name is in the mono a step down. -->
  <Style Selector="TextBlock.claim-title">
    <Setter Property="AutomationProperties.HeadingLevel" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.16" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Run.claim-name">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- The agent's words: a box two lines tall whatever it says, scrolling past them, so no reason moves the buttons (THREATS T-2);
       the quote's rule at its start is exactly as tall as the words, and the rest of the box stays empty. -->
  <Style Selector="Border.claim-quote">
    <Setter Property="Height" Value="38" />
  </Style>
  <Style Selector="DockPanel.claim-quote-text">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.claim-quote-bar">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Setter Property="Width" Value="3" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="Background" Value="{DynamicResource KpBorderDefault}" />
  </Style>
  <Style Selector="Border.claim-quote TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- A run's command and what it can read, on the grouped ground. -->
  <Style Selector="Border.claim-block">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.claim-chip">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.claim-chip TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- Details: a quiet disclosure; open, its rows are label and value, values in the mono where they are paths or names. -->
  <Style Selector="ToggleButton.claim-details">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ToggleButton.claim-details /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.claim-details:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.claim-details:checked /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.claim-details:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="ToggleButton.claim-details:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.claim-details ctl|KpIcon">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="ToggleButton.claim-details:checked ctl|KpIcon">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <Style Selector="Grid.claim-facts TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Grid.claim-facts TextBlock.fact">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Grid.claim-facts TextBlock.mono">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- The footer's buttons: 28 tall, each with the key that answers it after its label, quieter than the label. -->
  <Style Selector="Button.claim">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.claim.keyed">
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="x:String">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding}" VerticalAlignment="Center" />
          <TextBlock Classes="claim-key size-11" Text="{ReflectionBinding $parent[Button].Tag}" VerticalAlignment="Center" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.claim TextBlock.claim-key">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Button.claim.primary TextBlock.claim-key">
    <Setter Property="Foreground" Value="{DynamicResource KpOnAccent}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <!-- While arming, every button keeps its shape and its label stays readable; only its ink fades. -->
  <Style Selector="Button.claim:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>
  <Style Selector="Button.claim.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpTextMuted}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- After this sheet's own rules, so a size named on an element holds over them here as it does elsewhere. -->
  <StyleInclude Source="avares://keypaste-app/Theme/TextSizes.axaml" />

</Styles>
