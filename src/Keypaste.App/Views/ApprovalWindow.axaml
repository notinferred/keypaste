<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Keypaste.App.ViewModels"
        x:Class="Keypaste.App.Views.ApprovalWindow"
        x:DataType="vm:ApprovalViewModel"
        Icon="avares://keypaste-app/Assets/keypaste.ico"
        Title="keypaste: an agent is asking for a credential"
        Width="520" Height="500"
        MinWidth="520" MaxWidth="520" MinHeight="500" MaxHeight="500"
        CanResize="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource KpSurface0}">

  <!-- Every row has a fixed height, so nothing the agent writes can move the question, the entry or
       the buttons (THREATS.md T-2). The reason is one plain TextBlock in a box that scrolls, and no
       button is the default: Enter approves nothing, and Escape denies. -->

  <Grid RowDefinitions="36,150,40,24,*,40,56" Margin="24">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Text="An agent is asking for a credential"
                 FontSize="18"
                 Foreground="{DynamicResource KpTextPrimary}" />
      <TextBlock Grid.Column="1"
                 Name="CountdownText"
                 Text="{Binding Countdown}"
                 FontFamily="{DynamicResource KpMono}"
                 Foreground="{DynamicResource KpTextMuted}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="110,*" RowDefinitions="30,30,30,30,30">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Requested by" Foreground="{DynamicResource KpTextMuted}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Name="ClientText" Text="{Binding Client}" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource KpTextPrimary}" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Client label" Foreground="{DynamicResource KpTextMuted}" />
      <TextBlock Grid.Row="1" Grid.Column="1" Name="LabelText" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource KpTextPrimary}" />
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Entry" Foreground="{DynamicResource KpTextMuted}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Name="EntryText" Text="{Binding Entry}" TextTrimming="CharacterEllipsis"
                 FontFamily="{DynamicResource KpMono}"
                 Foreground="{DynamicResource KpTextPrimary}" />
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Field" Foreground="{DynamicResource KpTextMuted}" />
      <TextBlock Grid.Row="3" Grid.Column="1" Name="FieldText" Text="{Binding Field}"
                 Foreground="{DynamicResource KpTextPrimary}" />
      <TextBlock Grid.Row="4" Grid.Column="0" Text="For" Foreground="{DynamicResource KpTextMuted}" />
      <TextBlock Grid.Row="4" Grid.Column="1" Name="LifetimeText" Text="{Binding Lifetime}"
                 Foreground="{DynamicResource KpTextPrimary}" />
    </Grid>

    <TextBlock Grid.Row="2"
               Name="ScrubbedText"
               Text="{Binding Scrubbed}"
               TextWrapping="Wrap"
               FontSize="12"
               Foreground="{DynamicResource KpTextSecondary}" />

    <TextBlock Grid.Row="3"
               Text="The agent says it needs this because:"
               Foreground="{DynamicResource KpTextMuted}" />

    <Border Grid.Row="4" Theme="{StaticResource KpCard}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="12">
        <TextBlock Name="ReasonText"
                   Text="{Binding Reason}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource KpTextSecondary}" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="5"
               Text="{Binding Attribution}"
               TextWrapping="Wrap"
               Margin="0,8,0,0"
               FontSize="12"
               Foreground="{DynamicResource KpTextMuted}" />

    <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8">
      <Button Name="Deny"
              Content="Deny"
              Width="90"
              IsCancel="True"
              Command="{Binding DenyCommand}" />
      <Button Name="AllowOnce"
              Content="Allow once"
              Width="110"
              Command="{Binding AllowOnceCommand}" />
      <Button Name="Approve"
              Content="{Binding TimedLabel}"
              MinWidth="150"
              IsVisible="{Binding OffersTimed}"
              Command="{Binding ApproveCommand}" />
    </StackPanel>

  </Grid>

</Window>
