<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.ApprovalWindow"
                    x:DataType="vm:ApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent is asking for a credential"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Every block has a fixed height, so nothing the agent writes can move the question, the entry or
       the buttons (THREATS.md T-2). The reason is one plain TextBlock in a box that scrolls, and no
       button is the default: Enter approves nothing, and Escape denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <Grid Classes="prompt-head" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="prompt-tile">
          <ctl:KpIcon Icon="bot" Size="18" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <Grid ColumnDefinitions="Auto,Auto">
            <TextBlock Grid.Column="0" Name="ClientText" Classes="prompt-title" Text="{Binding Client}"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Classes="prompt-title" Text=" wants 1 secret" />
          </Grid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Classes="prompt-sub" Text="via MCP · label " />
            <TextBlock Name="LabelText" Classes="prompt-sub" Text="{Binding Label}"
                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="dot waiting" />
          <TextBlock Name="CountdownText" Classes="prompt-countdown" Text="{Binding Countdown}" />
        </StackPanel>
      </Grid>

      <Border Classes="prompt-call" Padding="12,10">
        <StackPanel>
          <TextBlock Text="tool: keypaste.request_credential" />
          <TextBlock Name="EntryText" Classes="value" Text="{Binding Entry}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <StackPanel Spacing="8">
        <Border Classes="prompt-list">
          <Grid ColumnDefinitions="*,Auto" Height="36" Margin="12,0">
            <TextBlock Grid.Column="0" Name="FieldText" Text="{Binding Field}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="tag" Text="value goes to the agent" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal">
          <TextBlock Classes="prompt-note" TextWrapping="NoWrap" Text="You can allow it " />
          <TextBlock Name="LifetimeText" Classes="prompt-note" TextWrapping="NoWrap" Text="{Binding Lifetime}"
                     Foreground="{DynamicResource KpTextSecondary}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="The agent says it needs this because" />
        <Border Classes="prompt-reason" Height="77">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12,9">
            <StackPanel Spacing="6">
              <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed" Text="{Binding Scrubbed}"
                         IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="prompt-scrubbed" Text="{Binding Truncation}"
                         IsVisible="{Binding Truncation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="ReasonText" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="13" LineHeight="19.5"
                         Foreground="{DynamicResource KpTextSecondary}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Classes="caption" Text="{Binding Attribution}" />
      </StackPanel>

      <TextBlock Classes="prompt-note"
                 Text="Allowing returns the value itself to the agent, which can read it and pass it on. Allow only a request you expected." />

      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
        <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                IsCancel="True" Command="{Binding DenyCommand}" />
        <Button Grid.Column="1" Name="AllowOnce" Classes="prompt" Content="Allow once"
                Command="{Binding AllowOnceCommand}" />
        <Button Grid.Column="2" Name="Approve" Classes="prompt primary" Content="{Binding TimedLabel}"
                HorizontalAlignment="Right"
                IsVisible="{Binding OffersTimed}" Command="{Binding ApproveCommand}" />
      </Grid>

    </StackPanel>
  </Border>

</views:PromptWindow>
