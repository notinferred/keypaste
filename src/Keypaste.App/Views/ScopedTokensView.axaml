<UserControl xmlns:res="using:Keypaste.App.Resources"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.ScopedTokensView"
             x:DataType="vm:ScopedTokensViewModel"
             Background="{DynamicResource KpBgApp}">

  <UserControl.Styles>
    <!-- A row's Revoke… shows only while the row is pointed at or holds the keyboard; its menu offers it too. -->
    <Style Selector="Border.table-row Button.row-action">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.table-row:pointerover Button.row-action, Border.table-row:focus-within Button.row-action">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <views:SettingsFrame Section="{x:Static vm:SettingsSectionChoice.ScopedTokens}">
    <views:SettingsFrame.Page>
      <StackPanel Classes="sections">

        <!-- New token, Create token and Copy are never shown together, so each is this screen's one primary. -->
        <StackPanel Classes="section" IsVisible="{Binding !HasNoRows}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Classes="caption" ctl:MachineRuns.InText="True" TextWrapping="Wrap" VerticalAlignment="Center" Text="{x:Static res:Strings.ATokenLetsAScriptOrCIX41bca7}" />
            <Button Grid.Column="1" Name="NewToken" Classes="primary" VerticalAlignment="Center"
                    IsVisible="{Binding CanOpenForm}" Command="{Binding OpenFormCommand}" AutomationProperties.Name="{x:Static res:Strings.NewToken}"
                    Content="{x:Static res:Strings.NewTokenLabel}" />
          </Grid>
        </StackPanel>

        <ctl:EmptyState Name="NoTokens" Icon="ticket" Text="{x:Static res:Strings.NoTokensYet}" Helper="{x:Static res:Strings.ATokenLetsAScriptOrCIX41bca7}"
                        IsVisible="{Binding HasNoRows}">
          <Button Name="NewTokenFromEmpty" Classes="primary sm"
                  Content="{x:Static res:Strings.NewTokenLabel}"
                  IsVisible="{Binding CanOpenForm}"
                  Command="{Binding OpenFormCommand}"
                  AutomationProperties.Name="{x:Static res:Strings.NewToken}" />
        </ctl:EmptyState>

        <Border Name="TokenForm" Classes="group padded" IsVisible="{Binding IsFormOpen}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding CreateCommand}" ctl:FormKeys.Cancel="{Binding CancelFormCommand}" ctl:FormKeys.Draft="{Binding FormDraft}">
          <StackPanel Spacing="12">
            <Grid Name="TokenFields" ColumnDefinitions="*,2*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{x:Static res:Strings.Name}" />
                <TextBox Classes="mono" Text="{Binding Name}" PlaceholderText="ci-staging"
                         AutomationProperties.Name="{x:Static res:Strings.TokenName}" />
                <TextBlock x:Name="TokenNameProblem" ctl:ShowInView.Scrolls="True" Classes="caption danger" TextWrapping="Wrap"
                           IsVisible="{Binding HasNameProblem}" ctl:Announcer.Says="{Binding NameProblem}" Text="{Binding NameProblem}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="label" Text="{x:Static res:Strings.Scope}" />
                <TextBox Classes="mono" Text="{Binding Scope}" PlaceholderText="read:acme-api/staging/*"
                         AutomationProperties.Name="{x:Static res:Strings.TokenScope}" />
                <TextBlock x:Name="TokenScopeProblem" ctl:ShowInView.Scrolls="True" Classes="caption danger" TextWrapping="Wrap"
                           IsVisible="{Binding HasScopeProblem}" ctl:Announcer.Says="{Binding ScopeProblem}" Text="{Binding ScopeProblem}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="label" Text="{x:Static res:Strings.Expires}" />
                <Border Classes="segmented inset" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="segment" GroupName="TokenExpiry" Content="{x:Static res:Strings.N7Days}"
                                 IsChecked="{Binding Expiry, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=7d}"
                                 Command="{Binding SetExpiryCommand}" CommandParameter="7d" />
                    <RadioButton Classes="segment" GroupName="TokenExpiry" Content="{x:Static res:Strings.N30Days}"
                                 IsChecked="{Binding Expiry, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=30d}"
                                 Command="{Binding SetExpiryCommand}" CommandParameter="30d" />
                    <RadioButton Classes="segment" GroupName="TokenExpiry" Content="{x:Static res:Strings.N90Days}"
                                 IsChecked="{Binding Expiry, Mode=OneWay, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=90d}"
                                 Command="{Binding SetExpiryCommand}" CommandParameter="90d" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Classes="caption" TextWrapping="Wrap" ctl:MachineRuns.InText="True"
                         Text="{x:Static res:Strings.ReadProjectStageKeyOrStarForTheWholeSet}" />
              <Button Grid.Column="1" Name="LearnMoreScopes" Classes="link" VerticalAlignment="Top" Content="{x:Static res:Strings.LearnMore}"
                      AutomationProperties.Name="{x:Static res:Strings.LearnMoreAboutTokenScopes}">
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedRight">
                    <StackPanel MaxWidth="320" Spacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="mono size-12" TextWrapping="Wrap" Text="{x:Static res:Strings.ScopeOfAWholeSetExample}" />
                        <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ScopeOfAWholeSet}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Classes="mono size-12" TextWrapping="Wrap" Text="{x:Static res:Strings.ScopeOfOneKeyExample}" />
                        <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ScopeOfOneKey}" />
                      </StackPanel>
                      <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ScopeNamesNoProtectedStageHere}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <TextBlock Classes="body danger" TextWrapping="Wrap" ctl:Announcer.Says="{Binding FormError}" Text="{Binding FormError}" IsVisible="{Binding HasFormError}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Classes="ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelFormCommand}" />
              <Button Name="CreateToken" Classes="primary" Content="{x:Static res:Strings.CreateToken}" Command="{Binding CreateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="group padded" IsVisible="{Binding HasMinted}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:KpIcon Icon="alert-triangle" Size="16" Foreground="{DynamicResource KpTextSecondary}" />
              <TextBlock Classes="body strong" TextWrapping="Wrap" Text="{x:Static res:Strings.CopyThisTokenNowKeypasteCantShowItAgain}" />
            </StackPanel>
            <Border Classes="field" Background="{DynamicResource KpBgApp}" BorderBrush="{DynamicResource KpBorderDefault}" MinHeight="40">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <!-- Drawn, not a TextBlock: its peer contributes nothing to the automation tree. -->
                  <ctl:RevealedValue Name="MintedToken"
                                     Source="{Binding Minted}"
                                     MaskedLength="24"
                                     FontFamily="{DynamicResource KpMono}"
                                     VerticalAlignment="Center"
                                     ClipToBounds="True"
                                     Foreground="{DynamicResource KpTextPrimary}" />
                  <ctl:RevealButton Grid.Column="1"
                                    Name="RevealToken"
                                    Classes="ghost sm"
                                    VerticalAlignment="Center"
                                    Target="{Binding #MintedToken}"
                                    ShowsWord="True"
                                    Subject="{x:Static res:Strings.TheTokenAsAnObject}" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Name="DoneToken" Content="{x:Static res:Strings.Done}" Command="{Binding DoneMintedCommand}" />
              <Button Name="CopyToken" Classes="primary" Command="{Binding CopyMintedCommand}" AutomationProperties.Name="{x:Static res:Strings.CopyToken}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ctl:KpIcon Icon="copy" Size="14" />
                  <TextBlock Text="{x:Static res:Strings.Copy}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Classes="body danger" TextWrapping="Wrap" ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />

        <Border Classes="table" IsVisible="{Binding !HasNoRows}">
          <StackPanel>
            <Border Classes="table-head top">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="0.6*" MinWidth="64" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="th" Text="{x:Static res:Strings.NAMECapitals}" />
                <TextBlock Grid.Column="1" Classes="th" Text="{x:Static res:Strings.TOKEN}" />
                <TextBlock Grid.Column="2" Classes="th" Text="{x:Static res:Strings.SCOPECapitals}" />
                <TextBlock Grid.Column="3" Classes="th" TextTrimming="CharacterEllipsis" ToolTip.Tip="{x:Static res:Strings.EXPIRESCapitals}" Text="{x:Static res:Strings.EXPIRESCapitals}" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScopedTokenRow">
                  <Border Classes="table-row" Padding="16,8" MinHeight="44">
                    <Panel VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Cancel="{Binding $parent[ItemsControl].((vm:ScopedTokensViewModel)DataContext).CancelRevokeCommand}">
                        <TextBlock Text="{Binding ConfirmText}" Classes="size-13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost sm" Content="{x:Static res:Strings.Cancel}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:ScopedTokensViewModel)DataContext).CancelRevokeCommand}" />
                        <Button Grid.Column="2" Classes="danger sm" Content="{x:Static res:Strings.RevokeToken}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.RevokeValue}}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:ScopedTokensViewModel)DataContext).RevokeCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <Grid ColumnSpacing="12" IsVisible="{Binding !IsConfirming}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.1*" />
                          <ColumnDefinition Width="1*" />
                          <ColumnDefinition Width="1.5*" />
                          <ColumnDefinition Width="0.6*" MinWidth="64" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Classes="size-13" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="mono secondary size-12" Text="{Binding Prefix}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="mono secondary size-12" Text="{Binding Scope}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Scope}" />
                        <TextBlock Grid.Column="3" Classes="size-13" Text="{Binding Expires}" VerticalAlignment="Center"
                                   Classes.muted="{Binding !IsExpired}" Classes.danger="{Binding IsExpired}" />
                        <Button Grid.Column="4" Classes="ghost sm row-action" Content="{x:Static res:Strings.RevokeEllipsis}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static res:Strings.RevokeValue}}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:ScopedTokensViewModel)DataContext).AskRevokeCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </views:SettingsFrame.Page>
  </views:SettingsFrame>

</UserControl>
