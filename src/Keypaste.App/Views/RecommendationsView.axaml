<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.RecommendationsView"
             x:DataType="vm:RecommendationsViewModel">

  <UserControl.Styles>
    <!-- A recommendation is a FieldRow whose content spans the row: the issue, then its actions. -->
    <Style Selector="ctl|FieldRow.wide /template/ TextBlock#Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ctl|FieldRow.wide /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector=":is(Control).kind-head">
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </UserControl.Styles>

  <!-- Keys left in notes, named by entry and key, never by value (C.2); project tags another app dropped (V.11); weak,
       reused or expired passwords, named by item and problem, never by value (V.9). One list of grouped rows by kind; each issue carries its action and Dismiss. No amber here. -->
  <ScrollViewer>
    <StackPanel Margin="32,12,32,24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.Recommendations}" />
        <Button Name="LearnMoreRecommendations" Classes="link" VerticalAlignment="Bottom" Content="{x:Static res:Strings.LearnMore}"
                AutomationProperties.Name="{x:Static res:Strings.LearnMoreAboutRecommendations}">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <TextBlock MaxWidth="320" Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.KeysLeftInNotesPasswordsThatAreXc4a5b0}" />
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <TextBlock Name="RecommendationsEmpty" Classes="caption" IsVisible="{Binding IsEmpty}" Text="{x:Static res:Strings.NoKeysFoundInNotesNoWeakX50d3ee}" />

      <StackPanel Spacing="6" IsVisible="{Binding HasConflictedCopies}">
        <TextBlock Classes="th kind-head" AutomationProperties.HeadingLevel="2" Text="{x:Static res:Strings.ChangesFromAnotherDevice}" />
        <Border Classes="group">
          <ItemsControl Name="ConflictedCopiesList" ItemsSource="{Binding ConflictedCopies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConflictedCopyRow">
                <ctl:FieldRow Classes="wide">
                  <StackPanel Spacing="8">
                    <TextBlock ctl:MachineRuns.InText="True" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding Name}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.ASyncToolKeptThisCopyBecauseTwoDevicesSavedAtOnce}" />
                    <TextBlock Name="ConflictedCopyReview" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding Review}" IsVisible="{Binding IsReviewed}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource KpDanger}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="ReviewConflictedCopy" Classes="sm" Content="{x:Static res:Strings.ReviewAndMerge}" IsVisible="{Binding OffersReview}" Command="{Binding ReviewChangesCommand}" />
                      <Button Name="CancelConflictedCopy" Classes="sm ghost" Content="{x:Static res:Strings.Cancel}" IsVisible="{Binding IsReviewed}" IsEnabled="{Binding IsIdle}" Command="{Binding CancelReviewCommand}" />
                      <Button Name="MergeConflictedCopy" Classes="sm" Content="{x:Static res:Strings.Merge}" IsVisible="{Binding IsReviewed}" IsEnabled="{Binding IsIdle}" Command="{Binding MergeCommand}" />
                    </StackPanel>
                  </StackPanel>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <StackPanel Name="FragileKeyFileCard" Spacing="6" IsVisible="{Binding HasFragileKeyFile}">
        <TextBlock Classes="th kind-head" AutomationProperties.HeadingLevel="2" Text="{x:Static res:Strings.KeyFile}" />
        <Border Classes="group">
          <ctl:FieldRow Classes="wide">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock ctl:MachineRuns.InText="True" Classes="size-13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding FragileKeyFileWarning}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Name="DismissFragileKeyFile" Classes="sm ghost" Content="{x:Static res:Strings.Dismiss}" IsVisible="{Binding FragileKeyFileNeedsReview}" Command="{Binding DismissFragileKeyFileCommand}" />
                <Button Name="ReviewFragileKeyFileAgain" Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" IsVisible="{Binding FragileKeyFileDismissed}" Command="{Binding ReviewFragileKeyFileAgainCommand}" />
              </StackPanel>
            </Grid>
          </ctl:FieldRow>
        </Border>
      </StackPanel>

      <TextBlock Name="RecommendationsMessage"
                 Classes="caption"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasMessage}"
                 ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                 Foreground="{DynamicResource KpTextSecondary}" />

      <StackPanel Name="NoteKeysCard" Spacing="6" IsVisible="{Binding HasNoteKeys}">
        <Grid ColumnDefinitions="*,Auto" Classes="kind-head">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="th" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" Text="{x:Static res:Strings.KeysLeftInNotes}" />
            <Button Name="LearnMoreNoteKeys" Classes="link" Content="{x:Static res:Strings.LearnMore}"
                    AutomationProperties.Name="{x:Static res:Strings.LearnMoreAboutKeysLeftInNotes}">
              <Button.Flyout>
                <Flyout Placement="Bottom">
                  <TextBlock MaxWidth="320" Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.EachValueBecomesAProtectedFieldNamedX966a34}" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Name="SelectAllRecommendations" Classes="sm ghost" Content="{x:Static res:Strings.SelectAll}" Command="{Binding SelectAllCommand}" />
            <Button Name="MoveSelected" Classes="sm" Content="{x:Static res:Strings.MoveSelected}" Command="{Binding MoveSelectedCommand}" />
          </StackPanel>
        </Grid>
        <Border Classes="group">
          <ItemsControl Name="RecommendationRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecommendationRow">
                <ctl:FieldRow Classes="wide" AutomationProperties.Name="{Binding Description}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Background="Transparent">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding NeedsReview}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Key, StringFormat={x:Static res:Strings.SelectValue}}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Name="RecommendationTokenKind"
                                   Text="{Binding TokenKind}"
                                   IsVisible="{Binding IsToken}"
                                   Classes="size-13-5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource KpTextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="RecommendationKey"
                                   Classes="mono size-13"
                                   Text="{Binding Key}"
                                   Foreground="{DynamicResource KpTextPrimary}"
                                   VerticalAlignment="Center" />
                        <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                          <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="sm" Content="{x:Static res:Strings.MoveToAField}" AutomationProperties.Name="{Binding Key, StringFormat={x:Static res:Strings.MoveValueToAField}}" IsVisible="{Binding NeedsReview}" Command="{Binding MoveCommand}" />
                      <Button Classes="sm ghost" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Key, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                      <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Key, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                    </StackPanel>
                  </Grid>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- V.11: a tag goes back only after the person has seen the environment and fields it reaches. -->
      <StackPanel Name="LostTagsCard" Spacing="6" IsVisible="{Binding HasLostTags}">
        <TextBlock Classes="th kind-head" AutomationProperties.HeadingLevel="2" Text="{x:Static res:Strings.ProjectTagsDropped}" />
        <Border Classes="group">
          <ItemsControl Name="LostTagRows" ItemsSource="{Binding LostTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LostTagRow">
                <ctl:FieldRow Classes="wide">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Background="Transparent"
                          AutomationProperties.Name="{Binding Description}">
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Name="LostTag"
                                     Classes="mono size-13"
                                     Text="{Binding Tag}"
                                     Foreground="{DynamicResource KpTextPrimary}"
                                     VerticalAlignment="Center" />
                          <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                            <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Where}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="sm" Content="{x:Static res:Strings.RestoreTag}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.RestoreValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding RestoreCommand}" />
                        <Button Classes="sm ghost" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                        <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                      </StackPanel>
                    </Grid>
                    <Border Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRestoreCommand}" ctl:FormKeys.Cancel="{Binding CancelRestoreCommand}">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Confirmation}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="sm ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRestoreCommand}" />
                          <Button Classes="sm" Content="{x:Static res:Strings.AddTag}" Command="{Binding ConfirmRestoreCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- V.9: each problem says its reason once, in a tooltip on its heading; a row names the item and what is its own. -->
      <ItemsControl Name="PasswordGroups" ItemsSource="{Binding PasswordGroups}" IsVisible="{Binding HasPasswords}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PasswordGroup">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8" Classes="kind-head">
                <TextBlock Name="PasswordProblem" Classes="th" AutomationProperties.HeadingLevel="2" VerticalAlignment="Center" Text="{Binding Heading}" />
                <Button Classes="link" Content="{x:Static res:Strings.LearnMore}"
                        AutomationProperties.Name="{Binding Heading, StringFormat={x:Static res:Strings.LearnMoreAboutValue}}">
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <StackPanel MaxWidth="320" Spacing="8">
                        <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{Binding Reason}" />
                        <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ReplaceAWeakOrReusedPasswordOnX22ee0c}" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <Border Classes="group">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PasswordRow">
                      <ctl:FieldRow Classes="wide">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Background="Transparent"
                              AutomationProperties.Name="{Binding Description}">
                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Name="PasswordItem" Classes="mono size-13" TextWrapping="Wrap" Text="{Binding Line}" Foreground="{DynamicResource KpTextPrimary}" VerticalAlignment="Center" />
                            <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                              <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                            </Border>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="sm ghost" Content="{x:Static res:Strings.OpenItem}" Command="{Binding OpenCommand}"
                                    AutomationProperties.Name="{Binding OpenLabel}" />
                            <Button Classes="sm ghost" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                            <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                          </StackPanel>
                        </Grid>
                      </ctl:FieldRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>

</UserControl>
