<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.RecommendationsView"
             x:DataType="vm:RecommendationsViewModel">

  <UserControl.Styles>
    <!-- A recommendation is a FieldRow whose content spans the row: the issue, then its actions. -->
    <Style Selector="ctl|FieldRow.wide /template/ TextBlock#Label">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ctl|FieldRow.wide /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <!-- Dismiss shows while its row is pointed at or holds focus; it stays in the row's menu. -->
    <Style Selector="ctl|FieldRow.wide Button.on-point">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ctl|FieldRow.wide:pointerover Button.on-point, ctl|FieldRow.wide:focus-within Button.on-point">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="32,12,32,24" />
    </Style>
    <Style Selector="StackPanel.page.under">
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </UserControl.Styles>

  <!-- Each finding names its item and key or problem, never a value; pressing its row opens the item. No amber here. -->
  <ScrollViewer>
    <StackPanel Classes="sections page" Classes.under="{Binding IsListedUnderAnother}">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" IsVisible="{Binding ShowsPageHeader}">
        <TextBlock Classes="h1" Text="{x:Static res:Strings.Security}" />
        <Button Grid.Column="1" Name="LearnMoreRecommendations" Classes="link" VerticalAlignment="Bottom" Content="{x:Static res:Strings.LearnMore}"
                AutomationProperties.Name="{x:Static res:Strings.LearnMoreAboutRecommendations}">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel MaxWidth="320" Spacing="8">
                <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.KeysLeftInNotesPasswordsThatAreXc4a5b0}" />
                <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.EachValueBecomesAProtectedFieldNamedX966a34}" />
                <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ReplaceAWeakOrReusedPasswordOnX22ee0c}" />
                <TextBlock Classes="size-13" TextWrapping="Wrap" Text="{x:Static res:Strings.ReplaceAnItemBeforeItExpires}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <!-- With several vaults open, which vault's check the page shows, or every vault's. -->
        <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding OffersVaultChoice}">
          <TextBlock Classes="label" Text="{x:Static res:Strings.VaultLabel}" />
          <ComboBox Name="SecurityVault"
                    MinWidth="140"
                    AutomationProperties.Name="{x:Static res:Strings.VaultLabel}"
                    ItemsSource="{Binding VaultChoices}"
                    SelectedItem="{Binding ShownVault}" />
        </StackPanel>
      </Grid>

      <TextBlock Classes="dialog-title" AutomationProperties.HeadingLevel="2" Text="{Binding VaultHeading}" IsVisible="{Binding ShowsVaultHeading}" />

      <ctl:EmptyState Name="RecommendationsEmpty" IsVisible="{Binding IsEmpty}" Icon="shield-check" Text="{x:Static res:Strings.NoKeysFoundInNotesNoWeakX50d3ee}" />

      <StackPanel Classes="section" IsVisible="{Binding HasConflictedCopies}">
        <TextBlock Classes="section-heading" AutomationProperties.HeadingLevel="3" Text="{x:Static res:Strings.ChangesFromAnotherDevice}" />
        <Border Classes="group">
          <ItemsControl Name="ConflictedCopiesList" ItemsSource="{Binding ConflictedCopies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConflictedCopyRow">
                <ctl:FieldRow Classes="wide">
                  <StackPanel Spacing="8">
                    <TextBlock ctl:MachineRuns.InText="True" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding Name}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{x:Static res:Strings.ASyncToolKeptThisCopyBecauseTwoDevicesSavedAtOnce}" />
                    <TextBlock Name="ConflictedCopyReview" Classes="size-13" TextWrapping="Wrap" Foreground="{DynamicResource KpTextPrimary}" Text="{Binding Review}" IsVisible="{Binding IsReviewed}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource KpDanger}" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Name="ReviewConflictedCopy" Classes="sm" Content="{x:Static res:Strings.ReviewAndMerge}" IsVisible="{Binding OffersReview}" Command="{Binding ReviewChangesCommand}" />
                      <Button Name="CancelConflictedCopy" Classes="sm ghost" Content="{x:Static res:Strings.Cancel}" IsVisible="{Binding IsReviewed}" IsEnabled="{Binding IsIdle}" Command="{Binding CancelReviewCommand}" />
                      <Button Name="MergeConflictedCopy" Classes="sm" Content="{x:Static res:Strings.Merge}" IsVisible="{Binding IsReviewed}" IsEnabled="{Binding IsIdle}" Command="{Binding MergeCommand}" />
                    </StackPanel>
                  </StackPanel>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <StackPanel Name="FragileKeyFileCard" Classes="section" IsVisible="{Binding HasFragileKeyFile}">
        <TextBlock Classes="section-heading" AutomationProperties.HeadingLevel="3" Text="{x:Static res:Strings.KeyFile}" />
        <Border Classes="group">
          <ctl:FieldRow Classes="wide">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock ctl:MachineRuns.InText="True" Classes="size-13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource KpTextSecondary}" Text="{Binding FragileKeyFileWarning}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Name="DismissFragileKeyFile" Classes="sm ghost on-point" Content="{x:Static res:Strings.Dismiss}" IsVisible="{Binding FragileKeyFileNeedsReview}" Command="{Binding DismissFragileKeyFileCommand}" />
                <Button Name="ReviewFragileKeyFileAgain" Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" IsVisible="{Binding FragileKeyFileDismissed}" Command="{Binding ReviewFragileKeyFileAgainCommand}" />
              </StackPanel>
            </Grid>
          </ctl:FieldRow>
        </Border>
      </StackPanel>

      <TextBlock Name="RecommendationsMessage"
                 Classes="caption"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasMessage}"
                 ctl:Announcer.Says="{Binding Message}" Text="{Binding Message}"
                 Foreground="{DynamicResource KpTextSecondary}" />

      <StackPanel Name="NoteKeysCard" Classes="section" IsVisible="{Binding HasNoteKeys}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="section-heading" AutomationProperties.HeadingLevel="3" VerticalAlignment="Center" Text="{x:Static res:Strings.KeysLeftInNotes}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding OffersBulkMove}">
            <Button Name="SelectAllRecommendations" Classes="sm ghost" Content="{x:Static res:Strings.SelectAll}" Command="{Binding SelectAllCommand}" />
            <Button Name="MoveSelected" Classes="sm" Content="{x:Static res:Strings.MoveSelected}" Command="{Binding MoveSelectedCommand}" />
          </StackPanel>
        </Grid>
        <Border Classes="group">
          <ItemsControl Name="RecommendationRows" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecommendationRow">
                <ctl:FieldRow Classes="wide" AutomationProperties.Name="{Binding Description}">
                  <StackPanel Spacing="8">
                    <Grid Classes="opens-item" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Background="Transparent">
                      <CheckBox IsChecked="{Binding IsSelected}"
                                IsVisible="{Binding $parent[views:RecommendationsView].((vm:RecommendationsViewModel)DataContext).OffersBulkMove}"
                                IsEnabled="{Binding NeedsReview}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.SelectValue}}" />
                      <ToggleButton Grid.Column="1" Classes="disclosure" IsVisible="{Binding HasSeveralKeys}" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static res:Strings.ShowEachKey}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.ShowEachKeyInValue}}">
                        <Panel>
                          <ctl:KpIcon Icon="chevron-right" Size="14" IsVisible="{Binding !IsExpanded}" />
                          <ctl:KpIcon Icon="chevron-down" Size="14" IsVisible="{Binding IsExpanded}" />
                        </Panel>
                      </ToggleButton>
                      <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding EntryPath}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Name="RecommendationTokenKind" Classes="size-13" FontWeight="Medium" Foreground="{DynamicResource KpTextPrimary}" VerticalAlignment="Center"
                                     Text="{Binding Keys[0].TokenKind}" IsVisible="{Binding HasOneKey}" />
                          <TextBlock Name="RecommendationKey" Classes="size-13" Classes.mono="{Binding HasOneKey}" Text="{Binding Heading}" Foreground="{DynamicResource KpTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                            <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" Classes.mono="{Binding HasSeveralKeys}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="sm" Content="{x:Static res:Strings.MoveToFields}" AutomationProperties.AutomationId="{Binding Entry, StringFormat='MoveToFields:{0}'}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.MoveTheKeysOfValueToFields}}" IsVisible="{Binding NeedsReview}" Command="{Binding MoveCommand}" />
                        <Button Classes="sm" Content="{x:Static res:Strings.MoveToStage}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.MoveTheKeysOfValueToAStage}}" IsVisible="{Binding NeedsReview}" Command="{Binding AskMoveToStageCommand}" />
                        <Button Classes="sm ghost on-point" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                        <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                      </StackPanel>
                    </Grid>
                    <!-- Each key, ticked to move with the rest. -->
                    <ItemsControl Name="RecommendationKeys" ItemsSource="{Binding Keys}" IsVisible="{Binding IsExpanded}" Margin="32,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteKeyRow">
                          <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding $parent[ItemsControl].((vm:RecommendationRow)DataContext).NeedsReview}" AutomationProperties.Name="{Binding Key}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Classes="mono size-13" Text="{Binding Key}" VerticalAlignment="Center" />
                              <TextBlock Classes="caption" Text="{Binding TokenKind}" IsVisible="{Binding IsToken}" VerticalAlignment="Center" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The stage a project tag puts the item in, and every variable it brings, shown before anything is written. -->
                    <Border Classes="form" IsVisible="{Binding IsChoosingStage}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmMoveToStageCommand}" ctl:FormKeys.Cancel="{Binding CancelMoveToStageCommand}">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="{x:Static res:Strings.StageLabel}" />
                        <ComboBox Name="RecommendationStage" MinWidth="200" ItemsSource="{Binding Stages}" SelectedItem="{Binding ChosenStage}" AutomationProperties.Name="{x:Static res:Strings.StageLabel}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding StagePreview}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="sm ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelMoveToStageCommand}" />
                          <Button Classes="sm primary" Content="{x:Static res:Strings.Move}" Command="{Binding ConfirmMoveToStageCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- A tag goes back only after the person has seen the stage and fields it reaches. -->
      <StackPanel Name="LostTagsCard" Classes="section" IsVisible="{Binding HasLostTags}">
        <TextBlock Classes="section-heading" AutomationProperties.HeadingLevel="3" Text="{x:Static res:Strings.ProjectTagsDropped}" />
        <Border Classes="group">
          <ItemsControl Name="LostTagRows" ItemsSource="{Binding LostTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LostTagRow">
                <ctl:FieldRow Classes="wide">
                  <StackPanel Spacing="8">
                    <Grid Classes="opens-item" ColumnDefinitions="*,Auto" ColumnSpacing="12" Background="Transparent"
                          AutomationProperties.Name="{Binding Description}">
                      <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding EntryPath}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Name="LostTag"
                                     Classes="mono size-13"
                                     Text="{Binding Tag}"
                                     Foreground="{DynamicResource KpTextPrimary}"
                                     VerticalAlignment="Center" />
                          <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                            <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="caption" Text="{Binding Where}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="sm" Content="{x:Static res:Strings.RestoreTag}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.RestoreValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding RestoreCommand}" />
                        <Button Classes="sm ghost on-point" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                        <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Tag, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                      </StackPanel>
                    </Grid>
                    <Border Classes="form" IsVisible="{Binding IsConfirming}" ctl:ShowInView.OnShow="True" ctl:FormKeys.Confirm="{Binding ConfirmRestoreCommand}" ctl:FormKeys.Cancel="{Binding CancelRestoreCommand}">
                      <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Confirmation}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="sm ghost" Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelRestoreCommand}" />
                          <Button Classes="sm primary" Content="{x:Static res:Strings.AddTag}" Command="{Binding ConfirmRestoreCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ctl:FieldRow>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Each problem's reason is its heading's tooltip; a row names the item and, muted under it, what is its own. -->
      <ItemsControl Name="PasswordGroups" ItemsSource="{Binding PasswordGroups}" IsVisible="{Binding HasPasswords}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="20" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PasswordGroup">
            <StackPanel Classes="section">
              <TextBlock Name="PasswordProblem" Classes="section-heading" AutomationProperties.HeadingLevel="3" Text="{Binding Heading}" ToolTip.Tip="{Binding Reason}" />
              <Border Classes="group">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PasswordRow">
                      <ctl:FieldRow Classes="wide">
                        <Grid Classes="opens-item" ColumnDefinitions="*,Auto" ColumnSpacing="12" Background="Transparent"
                              AutomationProperties.Name="{Binding Description}">
                          <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding EntryPath}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Name="PasswordItem" Classes="size-13" TextTrimming="CharacterEllipsis" Text="{Binding Entry}" Foreground="{DynamicResource KpTextPrimary}" VerticalAlignment="Center" />
                              <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                                <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="sm ghost on-point" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                            <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                          </StackPanel>
                        </Grid>
                      </ctl:FieldRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Reminders before an item expires and of the needs-update tag: the page opens only when pressed, and keypaste changes nothing at the provider. -->
      <ItemsControl Name="ReminderGroups" ItemsSource="{Binding ReminderGroups}" IsVisible="{Binding HasReminders}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="20" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReminderGroup">
            <StackPanel Classes="section">
              <TextBlock Name="ReminderReason" Classes="section-heading" AutomationProperties.HeadingLevel="3" Text="{Binding Heading}" ToolTip.Tip="{Binding Reason}" />
              <Border Classes="group">
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><ctl:GroupedRows /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReminderRow">
                      <ctl:FieldRow Classes="wide">
                        <Grid Classes="opens-item" ColumnDefinitions="*,Auto" ColumnSpacing="12" Background="Transparent"
                              AutomationProperties.Name="{Binding Description}">
                          <StackPanel Spacing="2" VerticalAlignment="Center" ToolTip.Tip="{Binding EntryPath}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Name="ReminderItem" Classes="size-13" TextTrimming="CharacterEllipsis" Text="{Binding Entry}" Foreground="{DynamicResource KpTextPrimary}" VerticalAlignment="Center" />
                              <Border Classes="chip outline state" VerticalAlignment="Center" IsVisible="{Binding IsDismissed}">
                                <TextBlock Text="{x:Static res:Strings.Dismissed}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Name="OpenReminderPage" Classes="sm ghost" Content="{Binding PageLabel}" Command="{Binding OpenPageCommand}" IsVisible="{Binding HasPage}"
                                    ToolTip.Tip="{Binding PageAddress}" AutomationProperties.Name="{Binding PageDescription}" />
                            <Button Classes="sm ghost on-point" Content="{x:Static res:Strings.Dismiss}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.DismissValue}}" IsVisible="{Binding NeedsReview}" Command="{Binding DismissCommand}" />
                            <Button Classes="sm ghost" Content="{x:Static res:Strings.ReviewAgain}" AutomationProperties.Name="{Binding Entry, StringFormat={x:Static res:Strings.ReviewValueAgain}}" IsVisible="{Binding IsDismissed}" Command="{Binding ReviewAgainCommand}" />
                          </StackPanel>
                        </Grid>
                      </ctl:FieldRow>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Every vault's check, each under its title, while the filter shows them all. -->
      <ItemsControl Name="OtherVaultsChecks" ItemsSource="{Binding AlsoShown}" IsVisible="{Binding ShowsVaultHeading}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecommendationsViewModel">
            <views:RecommendationsView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>

</UserControl>
