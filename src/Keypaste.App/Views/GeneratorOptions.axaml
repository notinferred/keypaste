<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:vm="using:Keypaste.App.ViewModels"
             x:Class="Keypaste.App.Views.GeneratorOptions"
             x:DataType="vm:GeneratorViewModel">

  <!-- What a generated password is made of (V.12): characters, or words from the EFF list with their count and
       separator, and what that is worth. One markup for every form and the Generate password dialog. It holds no
       secret; the value goes straight into the field it was generated for. -->

  <StackPanel Spacing="8">
    <Border Classes="segmented inset" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="segment" Content="{x:Static res:Strings.Characters}" IsChecked="{Binding UseCharacters}" />
        <RadioButton Classes="segment" Content="{x:Static res:Strings.Words}" IsChecked="{Binding UseWords}" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UseWords}">
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="{x:Static res:Strings.Words}" />
        <NumericUpDown Width="104"
                       Minimum="{Binding MinimumWords}"
                       Maximum="{Binding MaximumWords}"
                       Increment="1"
                       FormatString="0"
                       AutomationProperties.Name="{x:Static res:Strings.Words}"
                       Value="{Binding WordCount}" />
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="{x:Static res:Strings.Separator}" />
        <TextBox Width="44"
                 MaxLength="1"
                 Classes="mono"
                 AutomationProperties.Name="{x:Static res:Strings.Separator}"
                 Text="{Binding Separator}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Classes="caption" Text="{Binding Strength}" />
    <TextBlock Classes="caption" IsVisible="{Binding UseWords}" Text="{Binding Provenance}" />
    <TextBlock Classes="caption secondary"
               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               ctl:Announcer.Says="{Binding Error}" Text="{Binding Error}" />
  </StackPanel>

</UserControl>
