<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Keypaste.App.ViewModels"
        xmlns:ctl="using:Keypaste.App.Controls"
        xmlns:res="using:Keypaste.App.Resources"
        x:Class="Keypaste.App.Views.QuickSearchWindow"
        x:DataType="vm:QuickSearchViewModel"
        Icon="avares://keypaste-app/Assets/keypaste.ico"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- A card that is all there is of the window, as a prompt's is; where the platform cannot draw transparency it fills the window. -->
    <Style Selector="Border.quick-search">
      <Setter Property="Width" Value="600" />
      <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusDialog}" />
      <Setter Property="Margin" Value="24" />
      <Setter Property="BoxShadow" Value="0 24 64 0 #8C000000" />
    </Style>
    <Style Selector=".opaque Border.quick-search">
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <Style Selector="TextBox.quick-search-field">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="8,0,4,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.quick-search-rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource KpLine1}" />
    </Style>
  </Window.Styles>

  <!-- Quick search: a search over every unlocked vault and its matches by title, username and vault, never a value. Return copies
       the chosen password through the clipboard's countdown and closes, so the app in use has the keyboard back; the title is
       fixed, since system switchers show it. -->
  <Border Name="Card" Classes="quick-search">
    <StackPanel>
      <!-- What a screen reader is told once: why a key copied nothing. -->
      <TextBlock Classes="live" />
      <TextBox Name="QuickSearchField"
               Classes="search quick-search-field size-15"
               Margin="12,8"
               Text="{Binding Search}"
               PlaceholderText="{x:Static res:Strings.Search}"
               AutomationProperties.Name="{x:Static res:Strings.QuickSearch}"
               AutomationProperties.HelpText="{x:Static res:Strings.QuickSearchHint}">
        <TextBox.InnerLeftContent>
          <ctl:KpIcon Icon="search" Size="16" Margin="2,0,8,0" Foreground="{DynamicResource KpTextMuted}" VerticalAlignment="Center" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <Border Classes="quick-search-rule" />

      <Panel Margin="8">
        <TextBlock Name="QuickSearchHint" Classes="caption" Margin="8,6" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.QuickSearchHint}" IsVisible="{Binding ShowsHint}" />
        <TextBlock Name="QuickSearchNoMatch" Classes="caption" Margin="8,6" TextWrapping="Wrap"
                   Text="{Binding NoMatch}" IsVisible="{Binding ShowsNoMatch}" />
        <ListBox Name="QuickSearchResults"
                 Classes="rows"
                 MaxHeight="378"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{x:Static res:Strings.QuickSearchResults}"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected}"
                 IsVisible="{Binding HasRows}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickSearchRow">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Background="Transparent">
                <ctl:Monogram Title="{Binding Row.DisplayTitle}" Id="{Binding Row.Hue}" Mark="{Binding Row.Mark}" Size="30" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Name="QuickSearchTitle" Classes="row-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Name="QuickSearchUsername" Classes="caption" Text="{Binding Username}" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding HasUsername}" />
                </StackPanel>
                <TextBlock Name="QuickSearchVault" Grid.Column="2" Classes="size-11 muted" VerticalAlignment="Center"
                           MaxWidth="120" TextTrimming="CharacterEllipsis" Text="{Binding Vault}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>

      <TextBlock Name="QuickSearchMessage" Classes="caption danger" Margin="16,0,16,8" TextWrapping="Wrap"
                 Text="{Binding Message}" IsVisible="{Binding HasMessage}" ctl:Announcer.Says="{Binding Message}" />

      <Border Classes="quick-search-rule" />

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16,12">
        <TextBlock Name="QuickSearchKeys" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{x:Static vm:QuickSearchViewModel.OtherKeys}" />
        <Button Name="OpenInKeypaste" Grid.Column="1" Classes="sm"
                Content="{x:Static res:Strings.OpenInKeypaste}"
                Command="{Binding OpenInWindowCommand}"
                AutomationProperties.Name="{x:Static res:Strings.OpenInKeypaste}"
                ToolTip.Tip="{x:Static vm:QuickSearchViewModel.OpenTip}" />
        <Button Name="CopyPassword" Grid.Column="2" Classes="sm primary"
                Content="{x:Static res:Strings.CopyPassword}"
                Command="{Binding CopyPasswordCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CopyPassword}"
                ToolTip.Tip="{x:Static vm:QuickSearchViewModel.CopyTip}" />
      </Grid>
    </StackPanel>
  </Border>

</Window>
