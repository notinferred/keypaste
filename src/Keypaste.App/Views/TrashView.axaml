<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             x:Class="Keypaste.App.Views.TrashView"
             x:DataType="vm:TrashViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <TextBlock Grid.Row="0"
               Text="{Binding Note}"
               TextWrapping="Wrap"
               MaxWidth="560"
               HorizontalAlignment="Left"
               FontSize="12"
               Foreground="{DynamicResource KpTextSecondary}"
               Margin="0,0,0,12" />

    <Border Grid.Row="1"
            IsVisible="{Binding HasNotice}"
            Background="{DynamicResource KpAccentQuiet}"
            CornerRadius="{DynamicResource KpRadiusSm}"
            Padding="12,8"
            Margin="0,0,0,12">
      <TextBlock Text="{Binding Notice}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource KpTextSecondary}" />
    </Border>

    <Border Grid.Row="2"
            IsVisible="{Binding HasError}"
            Background="{DynamicResource KpAccentQuiet}"
            CornerRadius="{DynamicResource KpRadiusSm}"
            Padding="12,8"
            Margin="0,0,0,12">
      <TextBlock Text="{Binding Error}"
                 TextWrapping="Wrap"
                 FontSize="12"
                 Foreground="{DynamicResource KpTextSecondary}" />
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                IsVisible="{Binding !IsEmpty}">
      <Button Content="Restore" Command="{Binding RestoreCommand}" />
      <Button Content="Delete for good" Command="{Binding PurgeCommand}" />
    </StackPanel>

    <TextBlock Grid.Row="4"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyNote}"
               TextWrapping="Wrap"
               MaxWidth="480"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Foreground="{DynamicResource KpTextSecondary}" />

    <!-- Names, where they came from and when. A row carries no field value: RecycledEntry has
         none, and this list is held for as long as the screen is open. -->
    <ListBox Grid.Row="4"
             IsVisible="{Binding !IsEmpty}"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TrashRow">
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock Text="{Binding DisplayTitle}"
                       Foreground="{DynamicResource KpTextPrimary}" />
            <TextBlock Text="{Binding Summary}"
                       FontSize="11"
                       Foreground="{DynamicResource KpTextMuted}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="5" Spacing="12" Margin="0,12,0,0">

      <!-- The one place KpDanger appears here. A restore is ordinary; erasing a value is not. -->
      <Border IsVisible="{Binding IsConfirmingPurge}"
              BorderBrush="{DynamicResource KpDanger}"
              BorderThickness="1"
              CornerRadius="{DynamicResource KpRadiusSm}"
              Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PurgePrompt}" TextWrapping="Wrap"
                     Foreground="{DynamicResource KpTextPrimary}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Delete for good" Command="{Binding ConfirmPurgeCommand}"
                    Foreground="{DynamicResource KpDanger}" />
            <Button Content="Keep it" Command="{Binding CancelPurgeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding ReaderFloor}"
                 TextWrapping="Wrap"
                 MaxWidth="560"
                 HorizontalAlignment="Left"
                 FontSize="11"
                 Foreground="{DynamicResource KpTextMuted}" />
    </StackPanel>

  </Grid>
</UserControl>
