<UserControl xmlns:res="using:Keypaste.App.Resources"
  xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             x:Class="Keypaste.App.Views.AdvancedView"
             x:DataType="vm:AdvancedViewModel">

  <ScrollViewer>
    <StackPanel Margin="32,12,32,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Classes="h1"
                 Text="{x:Static res:Strings.Advanced}"
                 ToolTip.Tip="{x:Static res:Strings.WhatTheEverydayScreensLeaveOutEachX739fe5}" />

      <Border Classes="group">
        <ctl:GroupedRows>
          <ctl:FieldRow Label="{x:Static res:Strings.ShareLinks}">
            <TextBlock Name="ShareLinksNote" Classes="size-13" Foreground="{DynamicResource KpTextSecondary}" TextWrapping="Wrap" Text="{Binding ShareLinksNote}" />
            <ctl:FieldRow.Actions>
              <Button Name="OpenShareLinks" Classes="ghost sm"
                      AutomationProperties.Name="{x:Static res:Strings.OpenTheShareLinks}"
                      Command="{Binding OpenShareLinksCommand}">
                <ctl:KpIcon Icon="chevron-right" Size="14" />
              </Button>
            </ctl:FieldRow.Actions>
          </ctl:FieldRow>
          <ctl:FieldRow Label="{x:Static res:Strings.ScopedTokens}">
            <ctl:FieldRow.Actions>
              <Button Name="OpenScopedTokens" Classes="ghost sm"
                      ToolTip.Tip="{x:Static res:Strings.LetAScriptOrCIJobRunX39c663}"
                      AutomationProperties.Name="{x:Static res:Strings.OpenTheScopedTokens}"
                      Command="{Binding OpenScopedTokensCommand}">
                <ctl:KpIcon Icon="chevron-right" Size="14" />
              </Button>
            </ctl:FieldRow.Actions>
          </ctl:FieldRow>
          <ctl:FieldRow Label="{x:Static res:Strings.Diagnostics}">
            <ctl:FieldRow.Actions>
              <Button Name="OpenDiagnostics" Classes="ghost sm"
                      ToolTip.Tip="{x:Static res:Strings.TheVaultTheFolderAndTheVersionXee7732}"
                      AutomationProperties.Name="{x:Static res:Strings.OpenDiagnostics}"
                      Command="{Binding OpenDiagnosticsCommand}">
                <ctl:KpIcon Icon="chevron-right" Size="14" />
              </Button>
            </ctl:FieldRow.Actions>
          </ctl:FieldRow>
        </ctl:GroupedRows>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>
