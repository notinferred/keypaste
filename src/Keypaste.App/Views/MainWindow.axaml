<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Keypaste.App.Views"
        xmlns:ctl="using:Keypaste.App.Controls"
        x:Class="Keypaste.App.Views.MainWindow"
        Title="keypaste"
        Icon="avares://keypaste-app/Assets/keypaste.ico"
        Width="{x:Static views:WindowChrome.DefaultWidth}" Height="{x:Static views:WindowChrome.DefaultHeight}"
        MinWidth="{x:Static views:WindowChrome.MinimumWidth}" MinHeight="{x:Static views:WindowChrome.MinimumHeight}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{x:Static views:WindowChrome.TitleBarHeight}"
        Background="{DynamicResource KpBgApp}"
        WindowStartupLocation="CenterScreen">

  <!-- One window for the app's whole life. Unlock and the shell are two content states of it, not
       two windows: re-creating a window on lock loses its position and monitor, steals focus on
       macOS, and would mean two of every key binding and idle observer.

       The client area extends into the title area. The shell draws its own titlebar there; any
       other content gets DragStrip, so the window can still be moved from its top edge. -->

  <Panel>
    <TextBlock Classes="live" />
    <ContentControl Name="Root" />
    <Border Name="DragStrip"
            Height="{x:Static views:WindowChrome.TitleBarHeight}"
            VerticalAlignment="Top"
            Background="Transparent"
            WindowDecorationProperties.ElementRole="TitleBar" />

    <!-- Windows and Linux have no menu bar, so the menus open from here, over the titlebar's empty first column
         and the drag strip alike (Q.2); macOS draws its traffic lights where this would sit. -->
    <Button Name="MenuButton"
            Classes="icon ghost sm"
            IsVisible="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="8,6,0,0"
            ToolTip.Tip="Menu"
            AutomationProperties.Name="Menu"
            WindowDecorationProperties.ElementRole="User">
      <ctl:KpIcon Icon="menu" Size="16" />
    </Button>
  </Panel>

</Window>
