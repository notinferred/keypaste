<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.RunApprovalWindow"
                    x:DataType="vm:RunApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent wants to run a command with your secrets"
                    Width="460"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Fixed heights, as in the other prompt windows: the program, command, directory and reason are
       the agent's, so each sits in a box that wraps and scrolls and none of them can move the
       question or the buttons (THREATS.md T-2, T-35). Nothing is trimmed or ellipsized, so no part of
       a command is hidden past an edge. No button is the default: Enter approves nothing, and Escape
       denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="prompt-tile" VerticalAlignment="Top">
          <ctl:KpIcon Icon="bot" Size="18" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Name="TitleText" Classes="prompt-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Name="SubtitleText" Classes="prompt-sub" Text="{Binding Subtitle}" TextWrapping="Wrap" />
          <TextBlock Name="ClientText" Classes="prompt-sub" Text="{Binding Client}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="dot waiting" />
          <TextBlock Name="CountdownText" Classes="prompt-countdown" Text="{Binding Countdown}" />
        </StackPanel>
      </Grid>

      <Border Classes="prompt-call" Height="104">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12,10">
          <StackPanel>
            <TextBlock Name="ToolText" Text="{Binding Tool}" />
            <TextBlock Name="CommandText" Classes="value" Text="{Binding Command}" TextWrapping="Wrap" />
            <TextBlock Name="ProgramText" Text="{Binding Program}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="in " />
              <TextBlock Grid.Column="1" Name="DirectoryText" Text="{Binding Directory}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Classes="prompt-list" Height="116">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="VariablesList" ItemsSource="{Binding Variables}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunVariableRow">
                <Border Classes="prompt-row" Padding="12,7">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Classes="tag" Text="{Binding Source}" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="tag" Text="{Binding Tag}" TextWrapping="Wrap" MaxWidth="170"
                               TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="The agent says it needs this because" />
        <Border Classes="prompt-reason" Height="76">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="12,9">
            <StackPanel Spacing="6">
              <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed" Text="{Binding Scrubbed}"
                         IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="prompt-scrubbed" Text="{Binding Truncation}"
                         IsVisible="{Binding Truncation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="ReasonText" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="13" LineHeight="19.5"
                         Foreground="{DynamicResource KpTextSecondary}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Name="AttributionText" Classes="caption" Text="{Binding Attribution}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Name="ExplainerText" Classes="prompt-note" Text="{Binding Explainer}" />
        <TextBlock Name="OnceOnlyText" Classes="prompt-note" Text="{Binding OnceOnlyText}"
                   Foreground="{DynamicResource KpTextSecondary}"
                   IsVisible="{Binding OnceOnlyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
          <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                  IsCancel="True" Command="{Binding DenyCommand}" />
          <Button Grid.Column="1" Name="AllowOnce" Classes="prompt" Content="Allow once"
                  Command="{Binding AllowOnceCommand}" />
          <Button Grid.Column="2" Name="Approve" Classes="prompt primary" Content="{Binding TimedLabel}"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding OffersTimed}" Command="{Binding ApproveCommand}" />
        </Grid>
        <TextBlock Name="TimedCaptionText" Classes="caption" Text="{Binding TimedCaption}"
                   IsVisible="{Binding TimedCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

    </StackPanel>
  </Border>

</views:PromptWindow>
