<views:PromptWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Keypaste.App.ViewModels"
                    xmlns:views="using:Keypaste.App.Views"
                    xmlns:ctl="using:Keypaste.App.Controls"
                    x:Class="Keypaste.App.Views.RunApprovalWindow"
                    x:DataType="vm:RunApprovalViewModel"
                    Icon="avares://keypaste-app/Assets/keypaste.ico"
                    Title="keypaste: an agent wants to run a command with your secrets"
                    Width="508"
                    SizeToContent="Height"
                    CanResize="False"
                    WindowDecorations="None"
                    TransparencyLevelHint="Transparent"
                    Background="Transparent"
                    Topmost="True"
                    WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <StyleInclude Source="avares://keypaste-app/Views/PromptStyles.axaml" />
  </Window.Styles>

  <!-- Fixed heights, as in the other prompt windows: the client, program, command, directory and
       reason are the agent's, so none of them can move the question or the buttons (THREATS.md T-2,
       T-35). The header is one fixed row whose lines are trimmed; the environment, which the person
       decides on, has a fixed row of its own beneath it, drawn whole; the call box below holds the
       command and directory whole, wrapping and scrolling, so no part of either is hidden past an
       edge. No button is the default: Enter approves nothing, and Escape denies. -->

  <Border Classes="prompt">
    <StackPanel Spacing="16">

      <StackPanel Spacing="8">
        <Grid Classes="prompt-head" Height="57" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock Classes="live" ctl:Announcer.Says="{Binding Opening}" />
          <Border Grid.Column="0" Classes="prompt-tile">
            <ctl:KpIcon Icon="bot" Size="20" HorizontalAlignment="Center" Foreground="{DynamicResource KpTextPrimary}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Name="TitleText" Classes="prompt-title size-16" Text="{Binding Title}" />
            <TextBlock Name="SubtitleText" Classes="prompt-sub size-13" Text="{Binding Subtitle}" />
            <TextBlock Name="ClientText" Classes="prompt-sub size-13" Text="{Binding Client}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Classes="dot waiting" />
            <TextBlock Name="CountdownText" Classes="prompt-countdown size-12" Text="{Binding Countdown}" />
          </StackPanel>
        </Grid>

        <Grid Classes="prompt-environment" ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="prompt-sub size-13" Text="environment" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Name="ProfileText" Classes="prompt-environment size-12-5" Text="{Binding Profile}" />
        </Grid>
      </StackPanel>

      <Border Classes="prompt-call size-12" Height="94">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,8">
            <TextBlock Name="ToolText" Text="{Binding Tool}" />
            <TextBlock Name="CommandText" Classes="value" Text="{Binding Command}" TextWrapping="Wrap" />
            <TextBlock Name="ProgramText" Text="{Binding Program}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="in " />
              <TextBlock Grid.Column="1" Name="DirectoryText" Text="{Binding Directory}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Classes="prompt-list size-12-5" Height="131">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl Name="VariablesList" ItemsSource="{Binding Variables}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RunVariableRow">
                <Border Classes="prompt-row" Padding="12,6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                      <TextBlock Classes="source size-12" Text="{Binding Source}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="tag size-13" Text="{Binding Tag}" TextWrapping="Wrap" MaxWidth="170"
                               TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="The agent says it needs this because" />
        <Border Classes="prompt-reason" Height="77">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,8" Spacing="6">
              <TextBlock Name="ScrubbedText" Classes="prompt-scrubbed size-13" Text="{Binding Scrubbed}"
                         IsVisible="{Binding Scrubbed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="prompt-scrubbed size-13" Text="{Binding Truncation}"
                         IsVisible="{Binding Truncation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="ReasonText" Text="{Binding Reason}" TextWrapping="Wrap" Classes="size-13" LineHeight="19.5"
                         Foreground="{DynamicResource KpTextSecondary}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <TextBlock Name="AttributionText" Classes="caption" Text="{Binding Attribution}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Name="ExplainerText" Classes="prompt-note size-13" Text="{Binding Explainer}" />
        <TextBlock Name="OnceOnlyText" Classes="prompt-note size-13" Text="{Binding OnceOnlyText}"
                   Foreground="{DynamicResource KpTextSecondary}"
                   IsVisible="{Binding OnceOnlyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <TextBlock Name="AlwaysCaptionText" Classes="prompt-note size-13" Text="{Binding AlwaysCaption}"
                 Height="32" TextWrapping="Wrap" MaxLines="2" LineHeight="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
        <Button Grid.Column="0" Name="Deny" Classes="prompt ghost" Content="Deny"
                IsCancel="True" Command="{Binding DenyCommand}" />
        <Button Grid.Column="1" Name="AllowOnce" Classes="prompt primary" Content="Allow once"
                Command="{Binding AllowOnceCommand}" />
        <Button Grid.Column="2" Name="AlwaysAllow" Classes="prompt" Content="Always allow"
                IsVisible="{Binding OffersAlways}" Command="{Binding AlwaysAllowCommand}" />
      </Grid>

    </StackPanel>
  </Border>

</views:PromptWindow>
