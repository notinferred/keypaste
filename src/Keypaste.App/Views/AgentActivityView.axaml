<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:ctl="using:Keypaste.App.Controls"
             xmlns:clients="using:Keypaste.Core.Clients"
             xmlns:views="using:Keypaste.App.Views"
             x:Class="Keypaste.App.Views.AgentActivityView"
             x:DataType="vm:AgentActivityViewModel"
             Background="{DynamicResource KpBgApp}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- A capped star column keeps the page at the left gutter; a MaxWidth on a stretched panel centres it. -->
    <Grid Margin="32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1016" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="28">

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
          <StackPanel Spacing="6">
            <TextBlock Classes="h1" Text="Agents" />
            <TextBlock Classes="subtitle" TextWrapping="Wrap"
                       Text="Connect your AI tools and choose what each may see. A request waits for your answer in its own window, unless you set that agent to Automatic, which never covers commands." />
          </StackPanel>
          <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,8,0,0"
                IsVisible="{Binding IsServing}">
            <Border Classes="dot ok" VerticalAlignment="Center" />
            <!-- Runs on one line: whitespace between them would be drawn as a space. -->
            <TextBlock Grid.Column="1" Classes="caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run Text="Answering agents from this app · " /><Run Text="{Binding Serving}" FontFamily="{DynamicResource KpMono}" /></TextBlock>
          </Grid>
          <!-- Agents › History: what agents and tokens asked for (D-0374). -->
          <Button Grid.Column="1" Name="AgentHistory"
                  Classes="ghost"
                  Padding="12,0"
                  Height="30"
                  VerticalAlignment="Bottom"
                  IsVisible="{Binding OffersHistory}"
                  Command="{Binding OpenHistoryCommand}"
                  AutomationProperties.Name="History">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:KpIcon Icon="history" Size="13" />
              <TextBlock Text="History" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="card" IsVisible="{Binding IsUnavailable}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ctl:KpIcon Icon="alert-triangle" Size="15" Foreground="{DynamicResource KpWarn}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock Grid.Column="1" Classes="body secondary" Text="{Binding Status}" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!-- Only the prompt window answers (T-2): a row names what was asked, never the agent's reason, and
             Show the prompt brings that window forward with Deny focused and its allows disarmed (D-0456). -->
        <StackPanel Spacing="10" IsVisible="{Binding HasWaiting}">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <ctl:KpIcon Icon="clock" Size="15" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Grid.Column="1" Classes="section" Text="Waiting for you" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="caption" Text="Answer in the prompt window" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="table">
            <ItemsControl ItemsSource="{Binding Waiting}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityRow">
                  <Border Padding="16,14" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Client}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="mono secondary" FontSize="12" Text="{Binding Asked}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="mono amber" FontSize="11" Text="{Binding LeftText}" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Name="ShowPrompt" Classes="sm" Content="Show the prompt" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:AgentActivityViewModel)DataContext).ShowPromptCommand}"
                              AutomationProperties.Name="Show the prompt" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsAvailable}">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <ctl:KpIcon Icon="hourglass" Size="15" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Grid.Column="1" Classes="section" Text="Allowances" VerticalAlignment="Center" />
            <Button Grid.Column="2" Name="EndAllAllowances" Classes="danger sm" FontSize="12" Content="End all" HorizontalAlignment="Right" VerticalAlignment="Center"
                    IsVisible="{Binding HasGrants}" Command="{Binding EndAllCommand}"
                    AutomationProperties.Name="End all allowances" />
          </Grid>
          <TextBlock Classes="caption" IsVisible="{Binding NoGrants}"
                     Text="No allowance is in force, so the next request asks you." />
          <Border Classes="table" IsVisible="{Binding HasGrants}">
            <ItemsControl ItemsSource="{Binding Grants}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActivityRow">
                  <Border Padding="16,14" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Client}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="mono secondary" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="mono sm secondary" Text="{Binding LeftText}" />
                        <ProgressBar Classes="thin" MinWidth="0" Minimum="0" Maximum="1" Value="{Binding Fraction}" />
                      </StackPanel>
                      <Button Grid.Column="2" Name="EndAllowance" Classes="danger sm" FontSize="12" Content="End" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:AgentActivityViewModel)DataContext).EndCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding EndName}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- The AI tools found on this computer and the agents of this vault, each with its settings (D-0455).
             Names are what agents say about themselves and the names their connections were given: display
             only (T-3, T-36). -->
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="plug" Size="15" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Classes="section" Text="AI tools" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Found on this computer, and any agent that asked in the last 30 days. Settings follow each one's name." />
          <TextBlock Classes="caption" Text="Looking for AI tools on this computer…" IsVisible="{Binding IsLooking}" />
          <TextBlock Classes="caption" Text="{Binding NoTools}" IsVisible="{Binding HasNoTools}" TextWrapping="Wrap" />
          <Border Classes="card" IsVisible="{Binding HasClientsProblem}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Name="ClientsProblemText" Classes="body danger" Text="{Binding ClientsProblem}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Name="ResetClients" Content="Reset" VerticalAlignment="Center" Command="{Binding ResetClientsCommand}" />
            </Grid>
          </Border>
          <Border Classes="table">
            <ItemsControl Name="AgentRows" ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentRow">
                  <Border Padding="16,14" BorderBrush="{DynamicResource KpBorderSubtle}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                      <Border Classes="tile" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource KpMono}" FontSize="12" Foreground="{DynamicResource KpTextPrimary}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                          <!-- Top, so a status that wraps keeps its dot on the first line. -->
                          <Border Classes="dot" Classes.ok="{Binding IsLive}" VerticalAlignment="Top" Margin="0,5,0,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"
                                     Classes.ok="{Binding IsLive}" Classes.muted="{Binding !IsLive}" />
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" IsVisible="{Binding !HasSettings}" TextWrapping="Wrap"><Run Text="Connect it from this list, or start its bridge with " /><Run Text="--client-label" FontFamily="{DynamicResource KpMono}" /><Run Text=", to give it settings of its own." /></TextBlock>
                      </StackPanel>
                      <Button Grid.Column="2" Name="ConnectTool" VerticalAlignment="Top"
                              Content="Connect"
                              IsVisible="{Binding OffersConnect}"
                              Command="{Binding $parent[UserControl].((vm:AgentActivityViewModel)DataContext).ConnectCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Title, StringFormat='Connect {0}'}" />

                      <!-- The plan core composed, run only on Run it (D-0333). -->
                      <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Classes="card filled" IsVisible="{Binding HasConnection}">
                        <StackPanel Spacing="12" DataContext="{Binding Connection}" x:DataType="vm:ConnectClientViewModel">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="dialog-title" Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Name="CloseConnection" Classes="icon ghost sm" VerticalAlignment="Top"
                                    Command="{Binding $parent[UserControl].((vm:AgentActivityViewModel)DataContext).CloseConnectionCommand}"
                                    AutomationProperties.Name="Close">
                              <ctl:KpIcon Icon="x" Size="14" />
                            </Button>
                          </Grid>
                          <StackPanel Spacing="10" IsVisible="{Binding HasPreview}">
                            <Border Classes="terminal">
                              <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Name="ConnectPlan"
                                                     Text="{Binding Preview}"
                                                     Margin="14,12"
                                                     FontFamily="{DynamicResource KpMono}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource KpGrey3}"
                                                     AutomationProperties.Name="What Run it will do" />
                              </ScrollViewer>
                            </Border>
                            <TextBlock Classes="caption" Text="{Binding PreviewNote}" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Name="RunConnection" Content="Run it"
                                      Classes.primary="{Binding $parent[UserControl].((vm:AgentActivityViewModel)DataContext).FormsArePrimary}"
                                      Command="{Binding ConfirmCommand}" />
                              <Button Name="CancelConnection" Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBlock Classes="body" Text="{Binding Message}" IsVisible="{Binding HasMessage}" MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap" />
                          <StackPanel Spacing="10" IsVisible="{Binding OffersCheck}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Name="CheckConnection" Content="Check the connection" Command="{Binding CheckCommand}" />
                              <ComboBox Name="CheckItem"
                                        ItemsSource="{Binding CheckEntries}"
                                        SelectedItem="{Binding SelectedCheckEntry}"
                                        IsVisible="{Binding IsPicking}"
                                        MinWidth="240"
                                        AutomationProperties.Name="Item to ask for">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="clients:McpListedEntry">
                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource KpMono}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Button Name="AskCheckItem" Content="Ask for it" Command="{Binding AskCommand}" IsVisible="{Binding IsPicking}" />
                            </StackPanel>
                            <TextBlock Classes="body secondary" Text="{Binding CheckMessage}" IsVisible="{Binding HasCheckMessage}"
                                       MaxWidth="640" HorizontalAlignment="Left" TextWrapping="Wrap" />
                          </StackPanel>
                        </StackPanel>
                      </Border>

                      <!-- An Expander, so a screen reader hears it open or closed; the panel is G.8's, and its edits survive each refresh. -->
                      <Expander Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="AgentSettings" Margin="0,6,0,0"
                                Header="Settings"
                                IsVisible="{Binding HasSettings}"
                                IsExpanded="{Binding IsOpen, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Title, StringFormat='Settings for {0}'}">
                        <StackPanel Spacing="14">
                          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding OffersToolActions}">
                            <Button Name="ConnectToolAgain" Content="Connect again"
                                    IsVisible="{Binding OffersConnectAgain}"
                                    Command="{Binding $parent[UserControl].((vm:AgentActivityViewModel)DataContext).ConnectAgainCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Connect {0} again'}" />
                            <Button Name="DisconnectTool" Classes="danger" Content="Disconnect"
                                    IsVisible="{Binding OffersDisconnect}"
                                    Command="{Binding $parent[UserControl].((vm:AgentActivityViewModel)DataContext).DisconnectCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Disconnect {0}'}" />
                          </StackPanel>
                          <Panel IsVisible="{Binding Settings, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <views:AgentSettingsView DataContext="{Binding Settings}" />
                          </Panel>
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- The records since this unlock as `keypaste log` renders them (D-0331); the activity log in
             Settings › Advanced has the whole file. -->
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ctl:KpIcon Icon="history" Size="15" Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Classes="section" Text="Since you unlocked" />
          </StackPanel>
          <TextBlock Classes="caption" Text="{Binding HistoryMessage}" IsVisible="{Binding HasHistoryMessage}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding HistoryHeading}" IsVisible="{Binding HasHistory}" TextWrapping="Wrap" />
          <Border Classes="terminal" IsVisible="{Binding HasHistory}">
            <!-- The inset is the text's margin: a ScrollViewer's own Padding is left out of its measured height. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="360">
              <SelectableTextBlock Name="SessionHistory"
                                   Text="{Binding History}"
                                   Margin="14,12"
                                   FontFamily="{DynamicResource KpMono}"
                                   FontSize="12"
                                   Foreground="{DynamicResource KpGrey3}"
                                   AutomationProperties.Name="Records since you unlocked" />
            </ScrollViewer>
          </Border>
        </StackPanel>

      </StackPanel>
    </Grid>
  </ScrollViewer>

</UserControl>
