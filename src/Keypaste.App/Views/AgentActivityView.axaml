<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Keypaste.App.ViewModels"
             xmlns:clients="using:Keypaste.Core.Clients"
             x:Class="Keypaste.App.Views.AgentActivityView"
             x:DataType="vm:AgentActivityViewModel"
             Background="{DynamicResource KpSurface0}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="{DynamicResource KpCardPadding}">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="Agent Activity"
                   FontSize="22"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource KpTextPrimary}" />
        <Button Grid.Column="1"
                Content="Refresh"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}" />
      </Grid>

      <TextBlock Text="{Binding Status}"
                 TextWrapping="Wrap"
                 MaxWidth="640"
                 HorizontalAlignment="Left"
                 Foreground="{DynamicResource KpTextPrimary}" />

      <TextBlock Text="{Binding Unavailable}"
                 IsVisible="{Binding IsUnavailable}"
                 TextWrapping="Wrap"
                 FontSize="13"
                 Foreground="{DynamicResource KpTextSecondary}" />

      <!-- The preview is core's McpSetupPlan.Display, and Connect runs that same plan. -->
      <Panel IsVisible="{Binding Connect, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="8" DataContext="{Binding Connect}" x:DataType="vm:ConnectClientViewModel">
        <TextBlock Text="Connect a client" FontSize="16" Foreground="{DynamicResource KpTextPrimary}" />
        <TextBlock Text="Points an AI client at this vault. It can then list the names its exposure allows and ask for one credential at a time, which you answer here."
                   TextWrapping="Wrap"
                   MaxWidth="640"
                   HorizontalAlignment="Left"
                   FontSize="13"
                   Foreground="{DynamicResource KpTextSecondary}" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Client" VerticalAlignment="Center" Margin="0,0,12,8"
                     Foreground="{DynamicResource KpTextSecondary}" />
          <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MinWidth="240"
                    ItemsSource="{Binding Clients}"
                    SelectedItem="{Binding SelectedClient}"
                    AutomationProperties.Name="Client">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="clients:McpClient">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Label" VerticalAlignment="Center" Margin="0,0,12,8"
                     Foreground="{DynamicResource KpTextSecondary}" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                   Text="{Binding Label}"
                   AutomationProperties.Name="Label" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Exposure" VerticalAlignment="Center" Margin="0,0,12,0"
                     Foreground="{DynamicResource KpTextSecondary}" />
          <TextBox Grid.Row="2" Grid.Column="1"
                   Text="{Binding Exposure}"
                   PlaceholderText="env/** (the default). Separate more patterns with commas."
                   AutomationProperties.Name="Exposure" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Preview connect" Command="{Binding PreviewConnectCommand}" />
          <Button Content="Preview remove" Command="{Binding PreviewRemoveCommand}" />
        </StackPanel>
        <StackPanel Spacing="8" IsVisible="{Binding HasPreview}">
          <Border Background="{DynamicResource KpSurface1}"
                  BorderBrush="{DynamicResource KpBorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource KpRadiusMd}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="16">
              <SelectableTextBlock Text="{Binding Preview}"
                                   FontFamily="{DynamicResource KpMono}"
                                   FontSize="12"
                                   Foreground="{DynamicResource KpTextPrimary}" />
            </ScrollViewer>
          </Border>
          <TextBlock Text="{Binding PreviewNote}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                     FontSize="13" Foreground="{DynamicResource KpTextSecondary}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Run it" Command="{Binding ConfirmCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" MaxWidth="640"
                   HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource KpTextPrimary}" />
        <Button Content="Check the connection" Command="{Binding CheckCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPicking}">
          <ComboBox ItemsSource="{Binding CheckEntries}"
                    SelectedItem="{Binding SelectedCheckEntry}"
                    MinWidth="240"
                    AutomationProperties.Name="Entry to ask for">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="clients:McpListedEntry">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Ask for it" Command="{Binding AskCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding CheckMessage}" IsVisible="{Binding HasCheckMessage}" TextWrapping="Wrap" MaxWidth="640"
                   HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource KpTextPrimary}" />
      </StackPanel>
      </Panel>

      <StackPanel Spacing="8" IsVisible="{Binding IsAvailable}">
        <TextBlock Text="Waiting for you" FontSize="16" Foreground="{DynamicResource KpTextPrimary}" />
        <TextBlock Text="Nothing is waiting for an answer."
                   IsVisible="{Binding NothingWaiting}"
                   FontSize="13"
                   Foreground="{DynamicResource KpTextMuted}" />
        <ItemsControl ItemsSource="{Binding Waiting}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityRow">
              <Border Theme="{StaticResource KpCard}" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding What}" FontSize="14" Foreground="{DynamicResource KpTextPrimary}" />
                  <TextBlock Text="{Binding Who}" FontSize="12" Foreground="{DynamicResource KpTextSecondary}" />
                  <TextBlock Text="{Binding Left}" FontSize="12" Foreground="{DynamicResource KpTextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding IsAvailable}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Grants in force" FontSize="16"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource KpTextPrimary}" />
          <Button Grid.Column="1" Content="Revoke all" Command="{Binding RevokeAllCommand}" />
        </Grid>
        <TextBlock Text="No grant is in force, so the next credential request is asked about."
                   IsVisible="{Binding NoGrants}"
                   FontSize="13"
                   Foreground="{DynamicResource KpTextMuted}" />
        <ItemsControl ItemsSource="{Binding Grants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityRow">
              <Border Theme="{StaticResource KpCard}" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding What}" FontSize="14" Foreground="{DynamicResource KpTextPrimary}" />
                    <TextBlock Text="{Binding Who}" FontSize="12" Foreground="{DynamicResource KpTextSecondary}" />
                    <TextBlock Text="{Binding Left}" FontSize="12" Foreground="{DynamicResource KpTextMuted}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Revoke"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:AgentActivityViewModel)DataContext).RevokeCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Who reaches this vault and how each is asked (D-0360, D-0361). Names are what clients say
           about themselves and the labels in their configuration: display only (T-3, T-36). -->
      <StackPanel Spacing="8">
        <TextBlock Text="MCP clients" FontSize="16" Foreground="{DynamicResource KpTextPrimary}" />
        <StackPanel Spacing="6" IsVisible="{Binding HasClientsProblem}">
          <TextBlock Name="ClientsProblemText" Text="{Binding ClientsProblem}" TextWrapping="Wrap" MaxWidth="640"
                     HorizontalAlignment="Left" FontSize="13" Foreground="{DynamicResource KpDanger}" />
          <Button Name="ResetClients" Content="Reset" HorizontalAlignment="Left" Command="{Binding ResetClientsCommand}" />
        </StackPanel>
        <ItemsControl Name="ClientCards" ItemsSource="{Binding Clients}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClientCardRow">
              <Border Theme="{StaticResource KpCard}" Width="260" Margin="0,0,8,8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="32,*,Auto">
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource KpSurface2}">
                      <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontFamily="{DynamicResource KpMono}" FontSize="12" Foreground="{DynamicResource KpTextPrimary}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource KpTextPrimary}" />
                      <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="11.5"
                                 Foreground="{DynamicResource KpTextMuted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Border Classes="dot" Classes.ok="{Binding IsConnected}" Classes.idle="{Binding !IsConnected}" />
                      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="POLICY" FontSize="11" Foreground="{DynamicResource KpTextMuted}" />
                  <ComboBox ItemsSource="{Binding Options}"
                            SelectedItem="{Binding PolicyText}"
                            IsEnabled="{Binding CanSetPolicy}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Policy" />
                  <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="11.5"
                             IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{DynamicResource KpTextMuted}" />
                  <TextBlock Text="{Binding LastSeenText, StringFormat='last seen {0}'}" FontSize="11.5"
                             IsVisible="{Binding LastSeenText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Foreground="{DynamicResource KpTextMuted}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="A client appears once its bridge has asked for something. A label is written in the client's configuration, so an agent that can edit that file can change it: put the strictest policy on every other client (*)."
                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" FontSize="12"
                   Foreground="{DynamicResource KpTextMuted}" />
      </StackPanel>

      <!-- This session's audit records as `keypaste log` renders them (D-0331); the Log screen has
           the whole file. -->
      <StackPanel Spacing="8">
        <TextBlock Text="This session's history" FontSize="16" Foreground="{DynamicResource KpTextPrimary}" />
        <TextBlock Text="{Binding AuditPath}"
                   FontFamily="{DynamicResource KpMono}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource KpTextMuted}" />
        <TextBlock Text="{Binding HistoryMessage}"
                   IsVisible="{Binding HasHistoryMessage}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource KpTextSecondary}" />
        <Border IsVisible="{Binding HasHistory}"
                Background="{DynamicResource KpSurface1}"
                BorderBrush="{DynamicResource KpBorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource KpRadiusMd}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="360" Padding="16">
            <SelectableTextBlock Text="{Binding History}"
                                 FontFamily="{DynamicResource KpMono}"
                                 FontSize="12"
                                 Foreground="{DynamicResource KpTextPrimary}" />
          </ScrollViewer>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
