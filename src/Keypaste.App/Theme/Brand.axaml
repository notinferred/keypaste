<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:Keypaste.App.Controls">

  <!-- The icon and the wordmark, drawn from Theme/BrandOutlines.axaml: the ink in KpMarkInk, the dot
       amber. They are never set side by side (BRAND). -->
  <ControlTheme x:Key="{x:Type ctl:BrandMark}" TargetType="ctl:BrandMark">
    <Setter Property="InkGeometry" Value="{DynamicResource KpGlyphInkGeometry}" />
    <Setter Property="DotGeometry" Value="{DynamicResource KpGlyphDotGeometry}" />
    <Setter Property="InkBrush" Value="{DynamicResource KpMarkInk}" />
    <Setter Property="DotBrush" Value="{DynamicResource KpMarkDot}" />

    <!-- One-colour use: the dot takes the ink. -->
    <Style Selector="^.mono">
      <Setter Property="DotBrush" Value="{DynamicResource KpMarkInk}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ctl:BrandWordmark}" TargetType="ctl:BrandWordmark">
    <Setter Property="InkGeometry" Value="{DynamicResource KpWordmarkInkGeometry}" />
    <Setter Property="DotGeometry" Value="{DynamicResource KpWordmarkDotGeometry}" />
    <Setter Property="InkBrush" Value="{DynamicResource KpMarkInk}" />
    <Setter Property="DotBrush" Value="{DynamicResource KpMarkDot}" />
    <Setter Property="AutomationProperties.Name" Value="keypaste" />

    <Style Selector="^.mono">
      <Setter Property="DotBrush" Value="{DynamicResource KpMarkInk}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
