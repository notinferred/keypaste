<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!--
    Grouped rows, the design's one container on every screen: inset panels as System Settings draws them.
      StackPanel.sections    a page's column of sections, 20 apart, at most 640 wide from the page's left edge
      StackPanel.section     one section: its heading, its group and a caption under it, 6 apart
      TextBlock.section-heading  the heading over a group, Locking or Custom fields: 12/600 secondary, in line with the rows' labels
      Border.group           a group's surface, a step off the window with no line round it and radius 10, filling its column and holding a
                             ctl:GroupedRows of rows with hairlines between them; each row insets itself 14
      Border.group.padded    the same surface round content that is not rows, a notice or a form, inset 14 by 12
      ctl:FieldRow           a row: label, value, quiet actions; add stacked to put the label above, adaptive to put it above only while the row is narrow, mono-label for a machine name;
                             ctl:FieldRow.LabelWidth on an ancestor gives its rows one label column that dragging resizes
      ctl:PressToCopy        a value that copies when pressed, on Button
  -->

  <Style Selector="StackPanel.sections">
    <Setter Property="Spacing" Value="20" />
    <Setter Property="MaxWidth" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="StackPanel.section">
    <Setter Property="Spacing" Value="6" />
  </Style>

  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.group.padded">
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style Selector="ctl|FieldRow">
    <Setter Property="Margin" Value="14,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <Border Name="Rule" Height="1" VerticalAlignment="Top" Background="{DynamicResource KpBorderSubtle}" IsVisible="False" />
        <Grid Name="Columns" ColumnDefinitions="130,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,6">
          <TextBlock Name="Label"
                     Classes="label"
                     Text="{TemplateBinding Label}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <Border Name="LabelGrip"
                  Grid.RowSpan="2"
                  Width="8"
                  HorizontalAlignment="Right"
                  Background="Transparent"
                  Cursor="SizeWestEast"
                  IsVisible="False" />
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <ContentPresenter Name="Actions"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Actions}" />
        </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- A row's label, as System Settings draws one: 12/400 in the secondary text. -->
  <Style Selector="ctl|FieldRow /template/ TextBlock#Label">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ctl|FieldRow:resizable /template/ Border#LabelGrip">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ctl|FieldRow.stacked /template/ Border#LabelGrip, ctl|FieldRow.adaptive:narrow /template/ Border#LabelGrip, ctl|FieldRow:no-value /template/ Border#LabelGrip">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ctl|FieldRow:follows /template/ Border#Rule">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ctl|FieldRow:no-value /template/ TextBlock#Label">
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="ctl|FieldRow.stacked /template/ TextBlock#Label, ctl|FieldRow.adaptive:narrow /template/ TextBlock#Label">
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="ctl|FieldRow.stacked /template/ ContentPresenter#PART_ContentPresenter, ctl|FieldRow.adaptive:narrow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Grid.Row" Value="1" />
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="2" />
  </Style>
  <Style Selector="ctl|FieldRow.stacked /template/ ContentPresenter#Actions, ctl|FieldRow.adaptive:narrow /template/ ContentPresenter#Actions">
    <Setter Property="Grid.Row" Value="1" />
  </Style>
  <!-- A narrow row with no value gives its actions the whole line under its label, so a long action never runs past the row. -->
  <Style Selector="ctl|FieldRow.adaptive:narrow:no-value /template/ ContentPresenter#Actions">
    <Setter Property="Grid.Column" Value="0" />
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="ctl|FieldRow.mono-label /template/ TextBlock#Label">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector=":is(TextBlock).section-heading">
    <Setter Property="AutomationProperties.HeadingLevel" Value="3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="Margin" Value="14,0,0,0" />
  </Style>
  <Style Selector="ctl|FieldRow.top-label /template/ TextBlock#Label">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style Selector="Button.press-to-copy">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource KpRadiusField}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ContentPresenter Name="Value"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="Center" />
            <Panel Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
              <ctl:KpIcon Name="CopyGlyph" Icon="copy" Size="14" Foreground="{DynamicResource KpTextMuted}" Opacity="0" />
              <ctl:KpIcon Name="CheckGlyph" Icon="check" Size="14" Foreground="{DynamicResource KpOk}" Opacity="0" />
            </Panel>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.press-to-copy:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
  </Style>
  <!-- Fluent's Button shrinks on a press, which would resample the value drawn in it; the pressed surface is feedback enough. -->
  <Style Selector="Button.press-to-copy:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.press-to-copy:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="Button.press-to-copy:pointerover /template/ ctl|KpIcon#CopyGlyph, Button.press-to-copy:focus-visible /template/ ctl|KpIcon#CopyGlyph">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.press-to-copy:copied /template/ ctl|KpIcon#CopyGlyph">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.press-to-copy:copied /template/ ctl|KpIcon#CheckGlyph">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- On a group's panel the window's hover is nearly its ground, so a pointed control in a group takes the active ground and a press a step beyond. -->
  <Style Selector="Border.group Button.press-to-copy:pointerover /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="Border.group Button.press-to-copy:pressed /template/ Border#Surface">
    <Setter Property="Background" Value="{DynamicResource KpBgActiveHover}" />
  </Style>
  <Style Selector="Border.group Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Border.group ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Border.group Button.ghost:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="Border.group Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Border.group ToggleButton.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActiveHover}" />
  </Style>
  <Style Selector="Button.press-to-copy:disabled">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- A row of the two-line list: a tile, title and one secondary line, and an optional time. -->
  <Style Selector="ListBox.two-line > ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- Items' and Trash's rows, as Mail draws a message: a monogram, two lines and the time, a little tighter. -->
  <Style Selector="ListBox.two-line.monograms > ListBoxItem">
    <Setter Property="Padding" Value="10,6,12,6" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <!-- A day's heading over the rows that changed in it, as Outlook heads mail: 11/600, muted, never chosen. -->
  <Style Selector="ListBox.two-line > ListBoxItem.heading">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,8,10,4" />
  </Style>
  <Style Selector="ListBox.two-line > ListBoxItem.heading /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector=":is(TextBlock).row-section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Border.row-tile">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusTile}" />
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>

</Styles>
