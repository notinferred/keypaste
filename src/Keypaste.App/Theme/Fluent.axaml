<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Fluent's own resource keys, re-pointed at the tokens so every stock control is on-brand before
    any view asks for a class. Application resources are looked up before FluentTheme's, which is
    what makes this an override rather than a fork. Values are literal because a theme dictionary
    cannot alias another theme dictionary's brush reliably; each one is a token from Tokens.axaml.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SystemRegionBrush" Color="#111214" />
      <Color x:Key="SystemRegionColor">#111214</Color>

      <SolidColorBrush x:Key="ButtonBackground" Color="#2A2C30" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33363B" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24262A" />
      <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#1D1E22" />
      <SolidColorBrush x:Key="ButtonForeground" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#55575C" />
      <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2C30" />
      <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#55575C" />

      <SolidColorBrush x:Key="ToggleButtonBackground" Color="#2A2C30" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#33363B" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#24262A" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1D1E22" />
      <SolidColorBrush x:Key="ToggleButtonForeground" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#F2F2F0" />
      <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#55575C" />

      <SolidColorBrush x:Key="TextControlBackground" Color="#111214" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#111214" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#111214" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#18191C" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2C2E33" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A3D43" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#26282C" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#F2F2F0" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2F2F0" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F2F0" />
