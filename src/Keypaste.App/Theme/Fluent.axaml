  <!-- Focus: a 2px ink gap, then a 2px amber ring. -->
  <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F2B544" />
  <Thickness x:Key="SystemControlFocusVisualPrimaryThickness">2</Thickness>
  <Thickness x:Key="SystemControlFocusVisualSecondaryThickness">2</Thickness>
  <Thickness x:Key="SystemControlFocusVisualMargin">-4</Thickness>

  <FontFamily x:Key="ContentControlThemeFontFamily">avares://keypaste-app/Assets/Fonts#Instrument Sans</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

</ResourceDictionary>
