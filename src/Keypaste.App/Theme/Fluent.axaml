      <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#8E9096" />

      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#111214" />

      <SolidColorBrush x:Key="ToolTipBackground" Color="#24262A" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A3D43" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#F2F2F0" />

