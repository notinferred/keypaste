<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:Keypaste.App.Controls">

  <!-- Control themes for this app's own controls. Stock controls are restyled by class in
       Buttons.axaml, Inputs.axaml, Lists.axaml, Surfaces.axaml and Typography.axaml. -->

  <ControlTheme x:Key="{x:Type ctl:MaskedInput}" TargetType="ctl:MaskedInput">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Frame"
                Background="{DynamicResource TextControlBackground}"
                BorderBrush="{DynamicResource KpBorderDefault}"
                BorderThickness="1"
                CornerRadius="{DynamicResource KpRadiusField}"
                Padding="{DynamicResource KpFieldPadding}">
          <Panel>
            <TextBlock Text="{TemplateBinding Placeholder}"
                       IsVisible="{TemplateBinding IsEmpty}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextMuted}" />
            <TextBlock Text="{TemplateBinding Display}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource KpTextPrimary}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource KpBorderStrong}" />
    </Style>

    <!-- A keyboard-first app whose focus is invisible is not keyboard-first. This is never
         removed, and that is a review rule rather than a preference. -->
    <Style Selector="^:focus /template/ Border#Frame">
      <Setter Property="BorderBrush" Value="{DynamicResource KpFocusRing}" />
      <Setter Property="BoxShadow" Value="{StaticResource KpFieldGlow}" />
    </Style>

    <Style Selector="^:disabled /template/ Border#Frame">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="KpCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ctl:KpIcon}" TargetType="ctl:KpIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>

  <!-- A disclosure, such as an agent's Settings on Agents: a ghost header with a chevron, and its
       content below while open. The header toggle carries the Expander's own name, so a reader hears
       which disclosure it is and whether it is open. -->
  <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="12">
          <ToggleButton Name="PART_ExpanderHeader"
                        Classes="disclosure"
                        HorizontalAlignment="Left"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding $parent[Expander].(AutomationProperties.Name)}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ctl:KpIcon Name="Chevron" Icon="chevron-right" Size="13" />
              <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ContentPresenter Name="PART_ContentPresenter"
                            IsVisible="{TemplateBinding IsExpanded}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:expanded /template/ ctl|KpIcon#Chevron">
      <Setter Property="Icon" Value="chevron-down" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
