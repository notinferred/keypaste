<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!--
    Buttons. With no class a button is the design's default button, 30px tall: the surface with a hairline round it. Classes:
      primary (or Fluent's accent)  filled with the system's accent; the one primary action in a view
      ghost                         plain: no fill or line until hovered: Deny, Cancel; the same while its menu is open
      danger                        danger tint: Revoke, Delete; at 13px like every button
      icon                          a 30px square for an icon alone; add ghost for no fill, sm for a 28px row action
      link                          text colour, no box, a 20px target: "Choose…"
      more                          the 30px ⋯ button whose Flyout is a ctl:ButtonMenu
      disclosure                    an Expander's header toggle: ghost, whether open or not
      sm / lg                       28px / 34px tall instead of 30px
      busy                          while its work runs: keeps its fill, ignores presses; put a KpIcon.spinning in it
    Every button draws the 2px gap and 2px accent ring outside its bounds while focused from the keyboard.
    Put a KpIcon and a TextBlock in a StackPanel (Orientation Horizontal, Spacing 6) for an icon
    button; the icon takes the button's foreground.
  -->

  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- The focus ring is drawn 4px outside the button, which a button clips to its bounds by default. -->
    <Setter Property="ClipToBounds" Value="False" />
  </Style>
  <Style Selector="Button, ToggleButton">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- What has no surface of its own has no line round it either. -->
  <Style Selector="Button.primary, ToggleButton.primary, Button.ghost, ToggleButton.ghost, Button.link, Button.danger, Button.fold,
                   ToggleButton.disclosure, Button.more">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.sm, ToggleButton.sm">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Button.lg">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <!-- primary / accent -->
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>
  <!-- A disabled primary is greyed as macOS greys a default button. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A primary that opens a menu, such as Items' "+": the accent whether its menu is open or not. -->
  <Style Selector="ToggleButton.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.primary /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.primary:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="ToggleButton.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="ToggleButton.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>

  <!-- ghost -->
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter,
                   Button.ghost:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>

  <!-- danger -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTintHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTintPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>

  <!-- icon -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.sm">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- A tree row's fold: a 20px target that keeps the 16px column it sits in, so it takes no room from the row's text. -->
  <Style Selector="Button.fold">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- link -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- A link is text, not a signal: the view's one accent element is its primary action or live signal. -->
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <!-- An item's History, as Mail draws a link in its header: the accent as text, 600. -->
  <Style Selector="Button.link.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link.accent /template/ ContentPresenter#PART_ContentPresenter, Button.link.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>

  <!-- An Expander's header, which stays a ghost button whether it is open or not. -->
  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter,
                   ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>

  <!-- The ⋯ button: plain until hovered, and raised while its menu is open. -->
  <Style Selector="Button.more">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.more /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Button.more:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- A wait is not a refusal: a busy button keeps the look it had, though its command is disabled while it runs. -->
  <Style Selector="Button.busy">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.busy:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
  </Style>
  <Style Selector="Button.primary.busy:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>

</Styles>
