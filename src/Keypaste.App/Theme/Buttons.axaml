<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Buttons. With no class a button is the design's secondary button (#2A2C30). Classes:
      primary (or Fluent's accent)  amber, ink text; the one primary action in a view
      ghost                         no fill until hovered: Deny, Cancel
      danger                        danger tint: Revoke, Delete
      icon                          a 30px square for an icon alone; add ghost for no fill
      link                          amber text, no box: "New token"
      sm / lg                       28px / 34px tall instead of 30px
    Put a KpIcon and a TextBlock in a StackPanel (Orientation Horizontal, Spacing 6) for an icon
    button; the icon takes the button's foreground.
  -->

  <Style Selector="Button, ToggleButton, RepeatButton">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.sm">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.lg">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- primary / accent -->
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
  </Style>
  <!-- A disabled primary stays amber, faded, so a form that is waiting for input keeps its one amber action. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource KpOnAccent}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ghost -->
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>

  <!-- danger -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTintHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpDangerTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- icon -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.sm">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- link -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpAccentHover}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpAccentPress}" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextDisabled}" />
  </Style>

</Styles>
