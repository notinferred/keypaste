<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!--
    Lists. Every ListBoxItem is a row: radius 8, hover raises one step, selected takes the accent's
    tint with no bar, focused from the keyboard draws a 2px accent ring inside its edge, and a KpIcon in a selected row takes the text's colour.
    Classes:
      ListBox.nav   the sidebar: 28px rows, selected takes the same tint
      ListBox.rows  a tall list such as Secrets (52px rows); the default look, named for intent
      ListBox.segmented  the items of the segmented list in Inputs.axaml: the chosen one raised on its track
                    in every state; here so it follows the rules above
  -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusRow}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpAccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:selected ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- Muted text falls under 4.5:1 on a hovered or selected row, so it takes the secondary colour there. -->
  <Style Selector="ListBoxItem:pointerover :is(TextBlock).muted, ListBoxItem:pointerover :is(TextBlock).caption,
                   ListBoxItem:selected :is(TextBlock).muted, ListBoxItem:selected :is(TextBlock).caption">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Items' table: one line a row, as KeePassXC's entry table draws them. -->
  <Style Selector="ListBox.rows.table > ListBoxItem">
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <!-- The sidebar, as Mail and Outlook draw theirs: 28px rows in the body's size, icons in the accent's text colour, counts muted. -->
  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem Button.fold ctl|KpIcon, ListBox.nav > ListBoxItem:selected Button.fold ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem TextBlock.count">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
    <Setter Property="Margin" Value="8,0,0,0" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpAccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpAccentText}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected TextBlock.count">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <!-- A vault's heading: its title in the row title's weight, with room above it outside the row, so a chosen vault's tint is a row's height. -->
  <Style Selector="ListBox.nav > ListBoxItem.vault">
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem TextBlock.vault">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The account's heading names the vaults under it and cannot be chosen. -->
  <Style Selector="ListBox.nav > ListBoxItem.heading">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Bottom" />
    <Setter Property="Padding" Value="8,0,8,2" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem.heading /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem TextBlock.account">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <!-- The Groups row's + shows while the row is pointed at or chosen. -->
  <Style Selector="ListBox.nav > ListBoxItem Button.reveal">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover Button.reveal, ListBox.nav > ListBoxItem:selected Button.reveal, ListBox.nav > ListBoxItem Button.reveal:focus">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Thin, dark scrollbars, which hide or stay as the system says (SystemScrollBars). -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="{DynamicResource KpScrollBarsAutoHide}" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="{DynamicResource KpScrollBarsAutoHide}" />
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="BoxShadow" Value="{StaticResource KpShadowControl}" />
  </Style>

  <!-- Inside the row, since the list scrolls and clips what is drawn outside it. -->
  <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource KpFocusRingInset}" />
  </Style>
</Styles>
