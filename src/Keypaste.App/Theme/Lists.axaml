<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!--
    Lists. Every ListBoxItem is a row: radius 7, hover raises one ink step, selected gets a 10%
    amber tint and a 2px amber bar on the left, and a KpIcon in a selected row takes the text's
    colour: an icon is amber only while its object is live (DESIGN), and a view has one amber element.
    Classes:
      ListBox.nav   the sidebar: 34px rows, selected is #2A2C30 with no bar
      Button.sidebar-row   a sidebar footer row that runs a command, such as Import
      ListBox.rows  a tall list such as Secrets (52px rows); the default look, named for intent
      ListBox.segmented  the items of the segmented list in Inputs.axaml: selected is #2A2C30
                    with no bar in every state; here so it follows the rules above
  -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusButton}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpAccentTint}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="BoxShadow" Value="{DynamicResource KpSelectedBar}" />
  </Style>
  <!-- An inset shadow does not mirror, so under right to left the bar is a border, held on every row so selecting one moves nothing. -->
  <Style Selector="ListBoxItem[FlowDirection=RightToLeft] /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected[FlowDirection=RightToLeft] /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpSelectedBarMirrored}" />
  </Style>
  <Style Selector="ListBoxItem:selected ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <!-- Muted text falls under 4.5:1 on a hovered or selected row, so it takes the secondary colour there. -->
  <Style Selector="ListBoxItem:pointerover :is(TextBlock).muted, ListBoxItem:pointerover :is(TextBlock).caption,
                   ListBoxItem:selected :is(TextBlock).muted, ListBoxItem:selected :is(TextBlock).caption">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Items' table: one line a row, as KeePassXC's entry table draws them. -->
  <Style Selector="ListBox.rows.table > ListBoxItem">
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.nav > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <!-- The group tree under Items is denser than the places, and its heading is a label, not a row. -->
  <Style Selector="ListBox.nav > ListBoxItem.group">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem.heading">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Bottom" />
    <Setter Property="Padding" Value="12,0,12,4" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem.heading /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- The footer rows (Settings, Trash) are quieter than the destinations above them. -->
  <Style Selector="ListBox.nav.quiet > ListBoxItem">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>

  <!-- A sidebar row that runs a command rather than going to a place, such as Import: a footer row's size and colours. -->
  <Style Selector="Button.sidebar-row">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.sidebar-row /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Button.sidebar-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="Button.sidebar-row ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>

  <!-- Thin, dark scrollbars, which hide or stay as the system says (SystemScrollBars). -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="{DynamicResource KpScrollBarsAutoHide}" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="{DynamicResource KpScrollBarsAutoHide}" />
  </Style>

  <Style Selector="ListBox.segmented > ListBoxItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>
  <Style Selector="ListBox.segmented > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.segmented > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
    <Setter Property="BoxShadow" Value="none" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
</Styles>
