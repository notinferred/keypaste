<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Keypaste.App.Views"
        xmlns:ctl="using:Keypaste.App.Controls">

  <!--
    Surfaces, as classes on Border. Depth is lightness; only overlays (dialog, toast) cast shadows.
      card              radius 10, hairline border, no fill, padding 16
      card.filled       the same on the panel: MCP client cards, forms
      dialog            overlay surface: the card, a hairline, radius 14, shadow, padding 20
      toast             a notice under the title bar: the card, a hairline, radius 10, shadow
      backdrop          the modal scrim behind a dialog
      field             a read-only value in a field-shaped box (a kp:// reference)
      terminal          a command or file preview; stays dark in the light theme
      table             a bordered, clipped table; rows inside use table-head / table-row
      chip              a pill on the hover ground; chip.outline for a bordered one; put a
                        TextBlock inside, which is drawn as a label; chip.tag holds a tag, in mono
      keycap            a keyboard shortcut hint
      dot               6px status dot: add ok, warn, danger, info or idle; waiting adds the halo
      tile              the 32px icon square; ctl:Monogram is an item's lettered tile
  -->

  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.card.filled">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
  </Style>

  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusDialog}" />
    <Setter Property="BoxShadow" Value="{StaticResource KpShadowDialog}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource KpBgCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="BoxShadow" Value="{StaticResource KpShadowPopover}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>

  <Style Selector="Border.backdrop">
    <Setter Property="Background" Value="{DynamicResource KpBackdrop}" />
  </Style>
  <Style Selector="Panel.backdrop">
    <Setter Property="Background" Value="{DynamicResource KpBackdrop}" />
  </Style>

  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusField}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style Selector="Border.terminal">
    <Setter Property="Background" Value="{DynamicResource KpTerminal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpLine1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.terminal TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpGrey3}" />
  </Style>

  <Style Selector="Border.table">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.table-head">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <!-- A table's top head takes its card's curve, or its fill runs through the card's line at the corners. -->
  <Style Selector="Border.table-head.top, Border.table ItemsControl > ContentPresenter:nth-child(1) Border.table-head">
    <Setter Property="CornerRadius" Value="10,10,0,0" />
  </Style>
  <!-- The edge between two heads rests as a hairline, and shows as a control while the head row is pointed at or it has focus. -->
  <Style Selector="Border.column-grip-line">
    <Setter Property="Background" Value="{DynamicResource KpBorderSubtle}" />
  </Style>
  <Style Selector="Border.table-head:pointerover Border.column-grip-line, views|ColumnGrip:focus Border.column-grip-line">
    <Setter Property="Background" Value="{DynamicResource KpBorderControl}" />
  </Style>
  <Style Selector="views|ColumnGrip:pointerover Border.column-grip-line">
    <Setter Property="Background" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
  </Style>
  <Style Selector="Border.table-row">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderSubtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.table-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource KpBgPanel}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusChip}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.chip.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpBorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <!-- A tag: a name in words beside its icons, and its remove button while the chip is pointed at or holds the keyboard. -->
  <Style Selector="Border.chip.tag TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A 20px target; the margins keep the 16px it used to take in the chip's row. -->
  <Style Selector="Button.chip-remove">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,-2,-6,-2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="Border.chip.tag Button.chip-remove">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.chip.tag:pointerover Button.chip-remove, Border.chip.tag Button.chip-remove:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- The + after an item's tags that opens the box to add one. -->
  <Style Selector="ToggleButton.chip-add">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusChip}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.chip-add /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.chip-add:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip-add:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <Style Selector="Border.toast :is(TextBlock).muted">
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip.outline > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource KpTextPrimary}" />
  </Style>

  <Style Selector="Border.keycap">
    <Setter Property="Background" Value="{DynamicResource KpBgHover}" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusKeycap}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.keycap > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource KpMono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource KpTextSecondary}" />
  </Style>

  <Style Selector="Border.dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource KpTextMuted}" />
  </Style>
  <Style Selector="Border.dot.ok">
    <Setter Property="Background" Value="{DynamicResource KpOk}" />
  </Style>
  <Style Selector="Border.dot.warn">
    <Setter Property="Background" Value="{DynamicResource KpWarn}" />
  </Style>
  <Style Selector="Border.dot.danger">
    <Setter Property="Background" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="Border.dot.info">
    <Setter Property="Background" Value="{DynamicResource KpInfo}" />
  </Style>
  <Style Selector="Border.dot.idle">
    <Setter Property="Background" Value="{DynamicResource KpIdle}" />
  </Style>
  <Style Selector="Border.dot.waiting">
    <Setter Property="Background" Value="{DynamicResource KpAccentText}" />
    <Setter Property="BoxShadow" Value="{DynamicResource KpWaitingHalo}" />
  </Style>
  <!-- Agents' mark: these two shapes, against a running agent's filled dot, tell its state without colour. -->
  <Style Selector="Border.dot.stopped">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource KpTextMuted}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Border.dot.refusing">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusTile}" />
    <Setter Property="Background" Value="{DynamicResource KpBgActive}" />
  </Style>

  <!-- A count that needs attention, on a rail place: the accent with white, as Mail's unread badge. -->
  <Style Selector="Border.badge">
    <Setter Property="MinWidth" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource KpAccent}" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource KpOnAccent}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource KpBorderSubtle}" />
  </Style>

  <Style Selector="Border.sidebar.overlay">
    <Setter Property="BoxShadow" Value="{StaticResource KpShadowPopover}" />
  </Style>

  <!-- Every menu, a button's, a row's or the menu button's: 28px rows with an icon gutter, the focused or pointed row filled. -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource KpRadiusCard}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="MenuItem.danger">
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>
  <Style Selector="MenuItem.danger ctl|KpIcon">
    <Setter Property="Foreground" Value="{DynamicResource KpDanger}" />
  </Style>

</Styles>
