<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Cli.Tests</RootNamespace>
    <AssemblyName>Keypaste.Cli.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Cli/Keypaste.Cli.csproj" />
  </ItemGroup>

  <!--
    Compiled in rather than copied, for the reason Keypaste.Consistency.Tests gives about
    CliHarness.cs: one statement of who publishes this project, checked in every front end's
    own suite.
  -->
  <ItemGroup>
    <Compile Include="../Keypaste.Core.Tests/PublisherMetadata.cs" Link="PublisherMetadata.cs" />
    <!-- Every vault these tests create takes a token Argon2 cost. -->
    <Compile Include="../Keypaste.Core.Tests/CheapKeyDerivation.cs" Link="CheapKeyDerivation.cs" />
    <!-- A project's variables written as env set writes them, for fixtures. -->
    <Compile Include="../Keypaste.Core.Tests/ProjectVariables.cs" Link="ProjectVariables.cs" />
    <!-- The core's /v1/share fake, so the share verb is tested against the same server. -->
    <Compile Include="../Keypaste.Core.Tests/FakeShareServer.cs" Link="FakeShareServer.cs" />
    <!-- Agents' settings in memory, for the owners these tests start. -->
    <Compile Include="../Keypaste.Core.Tests/FakeAgentRules.cs" Link="FakeAgentRules.cs" />
    <!-- Time zones a test names on any runner, for the end of Automatic on this computer's clock. -->
    <Compile Include="../Keypaste.Core.Tests/TestZones.cs" Link="TestZones.cs" />
    <!-- The software YubiKey the core's hardware-key tests prove against KeePassXC's vectors, for a vault that needs one. -->
    <Compile Include="../Keypaste.Core.Tests/HardwareKeys/SoftwareYubiKey.cs" Link="HardwareKeys/SoftwareYubiKey.cs" />
    <!-- A vault's XML holding what another program wrote, as the core's tests make one. -->
    <Compile Include="../Keypaste.Core.Tests/ForeignXml.cs" Link="ForeignXml.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every vault these open or create for writing takes a claim of its own. -->
    <Compile Include="../Keypaste.Core.Tests/ClaimedVault.cs" Link="ClaimedVault.cs" />
  </ItemGroup>

</Project>
