<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.VaultSaver</RootNamespace>

    <!-- Not a test project: it holds no tests. It lives under tests/ because nothing shipped
         references it, and it exists so Core's save tests can save from a process whose TMP was set
         before the process started, or kill one partway through a save. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Core/Keypaste.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every vault these open or create for writing takes a claim of its own. -->
    <Compile Include="../Keypaste.Core.Tests/ClaimedVault.cs" Link="ClaimedVault.cs" />
  </ItemGroup>

</Project>
