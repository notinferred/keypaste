<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Core.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Core/Keypaste.Core.csproj" />
  </ItemGroup>

  <!-- The programs these tests start, such as the child an agent's run starts in the capture tests: built beside them, never referenced. -->
  <ItemGroup>
    <ProjectReference Include="../Keypaste.EnvReporter/Keypaste.EnvReporter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Keypaste.TxfContender/Keypaste.TxfContender.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Keypaste.VaultSaver/Keypaste.VaultSaver.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
