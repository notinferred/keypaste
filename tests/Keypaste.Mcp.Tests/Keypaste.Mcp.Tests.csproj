<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Mcp.Tests</RootNamespace>
    <AssemblyName>Keypaste.Mcp.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Mcp/Keypaste.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project's variables written as env set writes them, for fixtures. -->
    <Compile Include="../Keypaste.Core.Tests/ProjectVariables.cs" Link="ProjectVariables.cs" />
    <Compile Include="../Keypaste.Core.Tests/Reporter.cs" Link="Reporter.cs" />
    <!-- The owner's own log, which these tests read beside the bridge's. -->
    <Compile Include="../Keypaste.Core.Tests/OwnerLog.cs" Link="OwnerLog.cs" />
    <!-- Agents' settings in memory, for the owners these tests start. -->
    <Compile Include="../Keypaste.Core.Tests/FakeAgentRules.cs" Link="FakeAgentRules.cs" />
    <Compile Include="../Keypaste.Core.Tests/ManualClock.cs" Link="ManualClock.cs" />
    <!-- The core's owner on a real pipe, for the owners these tests start. -->
    <Compile Include="../Keypaste.Core.Tests/ServedOwner.cs" Link="ServedOwner.cs" />
    <!-- Every vault these tests create takes a token Argon2 cost. -->
    <Compile Include="../Keypaste.Core.Tests/CheapKeyDerivation.cs" Link="CheapKeyDerivation.cs" />
  </ItemGroup>

  <!-- The programs these tests start, such as the child an agent's run starts in the capture tests: built beside them, never referenced. -->
  <ItemGroup>
    <ProjectReference Include="../Keypaste.EnvReporter/Keypaste.EnvReporter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Keypaste.PoolStarver/Keypaste.PoolStarver.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every vault these open or create for writing takes a claim of its own. -->
    <Compile Include="../Keypaste.Core.Tests/ClaimedVault.cs" Link="ClaimedVault.cs" />
  </ItemGroup>

</Project>
