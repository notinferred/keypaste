<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Mcp.Tests</RootNamespace>
    <AssemblyName>Keypaste.Mcp.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Mcp/Keypaste.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project's variables written as env set writes them, for fixtures. -->
    <Compile Include="../Keypaste.Core.Tests/ProjectVariables.cs" Link="ProjectVariables.cs" />
    <Compile Include="../Keypaste.Core.Tests/Reporter.cs" Link="Reporter.cs" />
    <!-- The owner's own log, which these tests read beside the bridge's. -->
    <Compile Include="../Keypaste.Core.Tests/OwnerLog.cs" Link="OwnerLog.cs" />
    <!-- Agents' settings in memory, for the owners these tests start. -->
    <Compile Include="../Keypaste.Core.Tests/FakeAgentSettings.cs" Link="FakeAgentSettings.cs" />
    <!-- The core's hand-moved clock and time zones a test names on any runner, for an agent's end to Automatic. -->
    <Compile Include="../Keypaste.Core.Tests/ManualClock.cs" Link="ManualClock.cs" />
    <Compile Include="../Keypaste.Core.Tests/TestZones.cs" Link="TestZones.cs" />
    <!-- Every vault these tests create takes a token Argon2 cost (D-0469). -->
    <Compile Include="../Keypaste.Core.Tests/CheapKeyDerivation.cs" Link="CheapKeyDerivation.cs" />
  </ItemGroup>

  <!-- The child an agent's run starts in the capture tests: built beside these tests, never referenced. -->
  <ItemGroup>
    <ProjectReference Include="../Keypaste.EnvReporter/Keypaste.EnvReporter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
