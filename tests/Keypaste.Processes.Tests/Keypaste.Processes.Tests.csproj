<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the built keypaste and tests/Keypaste.AppDriver as separate processes, for what only crosses a process boundary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Processes.Tests</RootNamespace>
    <AssemblyName>Keypaste.Processes.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
