<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.Consistency.Tests</RootNamespace>
    <AssemblyName>Keypaste.Consistency.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    The CLI harness and the app's clipboard fake are compiled in rather than copied. They are fakes
    that already exist and already match what each front end expects; a second copy here would drift
    from the first the first time a seam changes, and the whole point of this project is that two
    things agree. The clipboard one matters most: it defers to SecretInput for what a paste may
    contain, so a test here cannot be asserting against a second idea of that rule.
  -->
  <ItemGroup>
    <Compile Include="../Keypaste.Cli.Tests/CliHarness.cs" Link="CliHarness.cs" />
    <Compile Include="../Keypaste.App.Tests/Clipboard/FakeClipboard.cs" Link="FakeClipboard.cs" />
  </ItemGroup>

  <!--
    The only project that references both front ends. See README.md in this directory for why it is
    in neither solution, and app.yml for the step that runs it.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.App/Keypaste.App.csproj" />
    <ProjectReference Include="../../src/Keypaste.Cli/Keypaste.Cli.csproj" />
  </ItemGroup>

</Project>
