<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.App.Tests</RootNamespace>
    <AssemblyName>Keypaste.App.Tests</AssemblyName>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.App/Keypaste.App.csproj" />
  </ItemGroup>

  <!--
    Compiled in rather than copied, for the reason Keypaste.Consistency.Tests gives about
    CliHarness.cs: one statement of who publishes this project, checked in every front end's
    own suite.
  -->
  <ItemGroup>
    <Compile Include="../Keypaste.Core.Tests/PublisherMetadata.cs" Link="PublisherMetadata.cs" />
    <!-- The env/<project> layout of earlier releases, which no keypaste writer creates since D-0413. -->
    <Compile Include="../Keypaste.Core.Tests/LegacyVariables.cs" Link="LegacyVariables.cs" />
    <!-- The same software YubiKey the core's hardware-key tests prove against KeePassXC's vectors. -->
    <Compile Include="../Keypaste.Core.Tests/HardwareKeys/SoftwareYubiKey.cs" Link="HardwareKeys/SoftwareYubiKey.cs" />
    <!-- The core's hand-moved clock and /api/share fake, so the app is tested against the same ones. -->
    <Compile Include="../Keypaste.Core.Tests/ManualClock.cs" Link="ManualClock.cs" />
    <Compile Include="../Keypaste.Core.Tests/FakeShareServer.cs" Link="FakeShareServer.cs" />
    <!-- The channels the core's scripted bridge speaks over, which need no thread-pool worker (F.41). -->
    <Compile Include="../Keypaste.Core.Tests/ScriptedBridgeChannels.cs" Link="ScriptedBridgeChannels.cs" />
  </ItemGroup>

</Project>
