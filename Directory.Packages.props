<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- The only runtime dependency in src/, and the narrowest form of it: ModelContextProtocol.Core
       rather than ModelContextProtocol, which costs four transitive packages on net10.0 instead of
       about twelve and brings no generic host. Justified in DECISIONS.md D-0019 as CORE.md law 3.9
       requires. Keypaste.Core — the vault and crypto path — still has none. -->
  <ItemGroup Label="MCP bridge">
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.1" />
  </ItemGroup>

</Project>
