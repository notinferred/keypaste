{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keypaste.com/acaf/v1/record.schema.json",
  "title": "ACAF v1 agent record",
  "type": "object",
  "required": ["acaf"],
  "additionalProperties": false,
  "properties": {
    "acaf": { "const": 1 },
    "see": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\\\]+$" }
    },
    "values": { "type": "boolean" },
    "run": { "type": "boolean" },
    "mode": { "$ref": "#/$defs/mode" },
    "limit": { "$ref": "#/$defs/limit" },
    "projects": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["project", "mode"],
        "additionalProperties": false,
        "properties": {
          "project": { "type": "string", "pattern": "^[^:/\\\\\\u0000-\\u001F\\u007F-\\u009F]+(:[a-z0-9][a-z0-9-]{0,31})?$" },
          "mode": { "$ref": "#/$defs/mode" },
          "limit": { "$ref": "#/$defs/limit" }
        }
      }
    }
  },
  "$defs": {
    "mode": { "enum": ["ask", "allow-for-a-while", "automatic"] },
    "limit": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "perHour": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "until": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    }
  }
}
