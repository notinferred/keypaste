{
  "name": "keypaste-web",
  "private": true,
  "type": "module",
  "description": "keypaste.com's content pages, built with Astro and Starlight into ../dist",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pull": "node scripts/pull.mjs --site keypaste --out src/content/docs --clean --public ../public --jsonld src/generated/jsonld.json",
    "predev": "npm run pull -- --if-missing",
    "dev": "astro dev",
    "prebuild": "npm run pull",
    "build": "astro build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2"
  }
}
