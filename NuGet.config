<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> is load-bearing: without it, machine-level sources (e.g. a local
       Visual Studio offline feed) make restores machine-dependent and open a
       dependency-confusion path. CORE.md law 3.9. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>

</configuration>
