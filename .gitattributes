* text=auto eol=lf

*.sln    text eol=crlf
*.cmd    text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf
*.sh     text eol=lf

# Vendored source is stored byte-for-byte as upstream ships it — KeePassLib uses CRLF.
# Normalising it to LF would make `diff -r` against a fresh upstream checkout report every
# line of every file as changed, which is precisely the re-merge procedure documented in
# third_party/KeePassLib/UPSTREAM.md. The files we author in that directory are excepted
# below and follow the repository convention.
third_party/KeePassLib/**            -text
third_party/KeePassLib/KeePassLib.csproj   text eol=lf
third_party/KeePassLib/UPSTREAM.md         text eol=lf
third_party/KeePassLib/packages.lock.json  text eol=lf

*.kdbx   binary
*.png    binary
*.gif    binary
*.ico    binary

# The demo recording. Covered by `text=auto` above already, but stated because a cast is JSON with
# escapes in it and the binary heuristic is not something to leave to chance on a file the
# recording scripts assert `jq` can parse.
*.cast   text eol=lf

docs/PRODUCT.md  linguist-documentation
