<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Keypaste.CompatFixture</RootNamespace>
    <AssemblyName>keypaste-compat-fixture</AssemblyName>
    <Description>Writes the KDBX fixture that the KeePassXC compatibility gate verifies. Throwaway: replaced by the CLI verbs in Stage 0.3.</Description>

    <!-- Not published, not shipped, not part of the AOT story. -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Keypaste.Core/Keypaste.Core.csproj" />
  </ItemGroup>

</Project>
