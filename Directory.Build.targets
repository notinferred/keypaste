<Project InitialTargets="KeypasteReferenceRules">

  <!-- Which source project may reference which, who may reference the browser relay, and that only the CLI links libsodium
       (D-0611, D-0675). It runs before any other target, so it sees only the references a project declares. -->
  <PropertyGroup>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Infrastructure'">-</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Mvvm'">-</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Core'">KeePassLib;Keypaste.Infrastructure</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.App'">Keypaste.Core;Keypaste.Mvvm</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Mcp'">Keypaste.Core</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Browser'">Keypaste.Core</KeypasteReferences>
    <KeypasteReferences Condition="'$(MSBuildProjectName)' == 'Keypaste.Cli'">Keypaste.Core;Keypaste.Mcp;Keypaste.Browser</KeypasteReferences>
    <KeypasteReachesRelay Condition="'$(MSBuildProjectName)' == 'Keypaste.Cli' or '$(MSBuildProjectName)' == 'Keypaste.Browser.Tests' or '$(MSBuildProjectName)' == 'Keypaste.FakeBrowser'">true</KeypasteReachesRelay>
  </PropertyGroup>

  <Target Name="KeypasteReferenceRules">
    <ItemGroup>
      <_KeypasteReferenced Include="@(ProjectReference->'%(Filename)')" />
      <_KeypasteAllowed Include="$(KeypasteReferences)" />
      <_KeypasteUnexpected Include="@(_KeypasteReferenced)" Exclude="@(_KeypasteAllowed)" Condition="'$(KeypasteReferences)' != ''" />
      <_KeypasteRelay Include="@(_KeypasteReferenced)" Condition="'%(Identity)' == 'Keypaste.Browser' and '$(KeypasteReachesRelay)' != 'true'" />
      <_KeypasteSodium Include="@(DirectPInvoke)" Condition="'%(Identity)' == 'libsodium' and '$(MSBuildProjectName)' != 'Keypaste.Cli'" />
    </ItemGroup>

    <Error Condition="'@(_KeypasteUnexpected)' != ''" Text="$(MSBuildProjectName) may not reference @(_KeypasteUnexpected)" ContinueOnError="ErrorAndContinue" />
    <Error Condition="'@(_KeypasteRelay)' != ''" Text="only the CLI, its tests and the fake browser reference Keypaste.Browser, not $(MSBuildProjectName)" ContinueOnError="ErrorAndContinue" />
    <Error Condition="'@(_KeypasteSodium)' != ''" Text="only the CLI links libsodium, not $(MSBuildProjectName)" />
  </Target>

</Project>
