#!/bin/sh
here="$(dirname "$(readlink -f "$0")")"
# A terminal's keypaste, and through it a connected client's `keypaste mcp`, start `<this AppImage> cli …`, because the mount path changes each launch.
case "${1:-}" in
  cli) shift; exec "$here/usr/bin/keypaste" "$@" ;;
esac
exec "$here/usr/bin/keypaste-app" "$@"
