<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>keypaste-app</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- wix.exe accepts only full or none; Directory.Build.props sets portable for the .NET projects. -->
    <DebugType>none</DebugType>
    <FullVersion Condition="'$(FullVersion)' == ''">$(VersionPrefix)</FullVersion>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(VersionPrefix)</ProductVersion>
    <!-- Per-user files under LocalAppData cannot carry the HKCU key paths ICE38 wants, and ICE91 only warns that they do not follow ALLUSERS, which a perUser package never reads. -->
    <SuppressIces>ICE38;ICE91</SuppressIces>
    <DefineConstants>PayloadDir=$(PayloadDir);FullVersion=$(FullVersion);ProductVersion=$(ProductVersion);AppIcon=$(MSBuildThisFileDirectory)..\..\src\Keypaste.App\Assets\keypaste.ico</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" />
    <HarvestDirectory Include="$(PayloadDir)">
      <ComponentGroupName>Payload</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <PreprocessorVariable>var.PayloadDir</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressCom>true</SuppressCom>
    </HarvestDirectory>
  </ItemGroup>

  <Target Name="RequirePayload" BeforeTargets="HarvestDirectory">
    <Error Condition="'$(PayloadDir)' == '' Or !Exists('$(PayloadDir)keypaste-app.exe')" Text="PayloadDir must name a staged win-x64 payload ending in a separator; got '$(PayloadDir)'" />
  </Target>

</Project>
