<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="keypaste $(var.FullVersion) (internal, unsigned)"
    Manufacturer="keypaste"
    Version="$(var.ProductVersion)"
    UpgradeCode="6f1d9a4e-2b7c-4c55-9d7e-1a3b5c7d9e01"
    Scope="perUser"
    Language="1033">

    <SummaryInformation
      Description="keypaste $(var.FullVersion) internal unsigned candidate"
      Keywords="keypaste;$(var.FullVersion);internal;unsigned"
      Manufacturer="keypaste" />

    <!-- The previous version is removed only once this install commits, so a failure leaves it installed (F.14). -->
    <MajorUpgrade Schedule="afterInstallFinalize" DowngradeErrorMessage="A newer keypaste is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPCOMMENTS" Value="Internal candidate $(var.FullVersion); unsigned; not for distribution" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Icon Id="keypaste.ico" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="keypaste.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="keypaste" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Component Id="InstallFolderRemoval" Directory="INSTALLFOLDER">
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\keypaste\Installer" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="KeypasteShortcut" Name="keypaste" Target="[INSTALLFOLDER]keypaste-app.exe" WorkingDirectory="INSTALLFOLDER" Icon="keypaste.ico" />
      <RegistryValue Root="HKCU" Key="Software\keypaste\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Its key path is the same in every version, so a major upgrade's removal of the old product leaves the PATH entry the new one shares (D-G5-1). -->
    <Component Id="UserPath" Directory="INSTALLFOLDER">
      <Environment Id="UserPathEntry" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" Permanent="no" System="no" />
      <RegistryValue Root="HKCU" Key="Software\keypaste\Installer" Name="UserPath" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="InstallFolderRemoval" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UserPath" />
    </Feature>
  </Package>
</Wix>
